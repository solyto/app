{"type":"tool_use","timestamp":1791393856429,"sessionID":"ses_ee89c2ab9ffergyxR5ZG3Tj4o0","part":{"type":"tool","tool":"read","callID":"call_00_n634rDlQp3CpiPqnTVsr7988","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/Notes.test.ts"},"output":"<path>/workspace/tests/unit/stores/Notes.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { NotesSvelte } from '$lib/state/Notes.svelte';\n3: import { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\n4: import type { Note, NoteCategory } from '$lib/types/note';\n5: \n6: const { navigation } = vi.hoisted(() => ({\n7: \tnavigation: {\n8: \t\tgoto: vi.fn(),\n9: \t\tresolve: (path: string, params: Record<string, string>) => path.replace('[id]', params.id)\n10: \t}\n11: }));\n12: \n13: vi.mock('$app/navigation', () => ({ goto: navigation.goto }));\n14: vi.mock('$app/paths', () => ({ resolve: navigation.resolve }));\n15: \n16: function note(overrides: Partial<Note> = {}): Note {\n17: \treturn {\n18: \t\tid: 'n1',\n19: \t\ttitle: 'Note',\n20: \t\tcontent: '',\n21: \t\tcategory_id: null,\n22: \t\ttags: [],\n23: \t\tis_favorite: false,\n24: \t\tcreated_at: '2026-01-01T00:00:00',\n25: \t\tupdated_at: '2026-01-01T00:00:00',\n26: \t\t...overrides\n27: \t};\n28: }\n29: \n30: function category(id: number, title: string, overrides: Partial<NoteCategory> = {}): NoteCategory {\n31: \treturn {\n32: \t\tid,\n33: \t\ttitle,\n34: \t\tparent_id: null,\n35: \t\tsort_order: 0,\n36: \t\tcreated_at: '',\n37: \t\tupdated_at: '',\n38: \t\tchildren: [],\n39: \t\t...overrides\n40: \t};\n41: }\n42: \n43: beforeEach(() => {\n44: \tresetStoreMocks();\n45: \tpageState.pathname = '/notes';\n46: \tpageState.params = {};\n47: \tnavigation.goto.mockReset();\n48: \tnavigation.goto.mockResolvedValue(undefined);\n49: });\n50: \n51: afterEach(() => {\n52: \tvi.useRealTimers();\n53: });\n54: \n55: describe('Notes store', () => {\n56: \tdescribe('newest / last updated / favorites', () => {\n57: \t\tit('getNewestNotes returns the five most recently created notes', () => {\n58: \t\t\tconst n = new NotesSvelte();\n59: \t\t\tn.notes = [\n60: \t\t\t\tnote({ id: '1', created_at: '2026-01-01T00:00:00' }),\n61: \t\t\t\tnote({ id: '2', created_at: '2026-03-01T00:00:00' }),\n62: \t\t\t\tnote({ id: '3', created_at: '2026-02-01T00:00:00' }),\n63: \t\t\t\tnote({ id: '4', created_at: '2026-05-01T00:00:00' }),\n64: \t\t\t\tnote({ id: '5', created_at: '2026-04-01T00:00:00' }),\n65: \t\t\t\tnote({ id: '6', created_at: '2026-06-01T00:00:00' })\n66: \t\t\t];\n67: \t\t\texpect(n.getNewestNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n68: \t\t});\n69: \n70: \t\tit('getLastUpdatedNotes returns the five most recently updated notes', () => {\n71: \t\t\tconst n = new NotesSvelte();\n72: \t\t\tn.notes = [\n73: \t\t\t\tnote({ id: '1', updated_at: '2026-01-01T00:00:00' }),\n74: \t\t\t\tnote({ id: '2', updated_at: '2026-03-01T00:00:00' }),\n75: \t\t\t\tnote({ id: '3', updated_at: '2026-02-01T00:00:00' }),\n76: \t\t\t\tnote({ id: '4', updated_at: '2026-05-01T00:00:00' }),\n77: \t\t\t\tnote({ id: '5', updated_at: '2026-04-01T00:00:00' }),\n78: \t\t\t\tnote({ id: '6', updated_at: '2026-06-01T00:00:00' })\n79: \t\t\t];\n80: \t\t\texpect(n.getLastUpdatedNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n81: \t\t});\n82: \n83: \t\tit('getFavorites returns only favourite notes', () => {\n84: \t\t\tconst n = new NotesSvelte();\n85: \t\t\tn.notes = [\n86: \t\t\t\tnote({ id: '1', is_favorite: true }),\n87: \t\t\t\tnote({ id: '2', is_favorite: false }),\n88: \t\t\t\tnote({ id: '3', is_favorite: true })\n89: \t\t\t];\n90: \t\t\texpect(n.getFavorites().map((x) => x.id)).toEqual(['1', '3']);\n91: \t\t});\n92: \t});\n93: \n94: \tdescribe('categories', () => {\n95: \t\tit('getNotesForCategory filters by category id', () => {\n96: \t\t\tconst n = new NotesSvelte();\n97: \t\t\tn.notes = [\n98: \t\t\t\tnote({ id: '1', category_id: 1 }),\n99: \t\t\t\tnote({ id: '2', category_id: null }),\n100: \t\t\t\tnote({ id: '3', category_id: 1 })\n101: \t\t\t];\n102: \t\t\texpect(n.getNotesForCategory(1).map((x) => x.id)).toEqual(['1', '3']);\n103: \t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['2']);\n104: \t\t});\n105: \n106: \t\tit('getCategoryTitle resolves top-level categories', () => {\n107: \t\t\tconst n = new NotesSvelte();\n108: \t\t\tn.categories = [category(1, 'Work'), category(2, 'Private')];\n109: \t\t\texpect(n.getCategoryTitle(1)).toBe('Work');\n110: \t\t});\n111: \n112: \t\tit('getCategoryTitle resolves child categories', () => {\n113: \t\t\tconst n = new NotesSvelte();\n114: \t\t\tn.categories = [category(1, 'Work', { children: [category(5, 'Projects')] })];\n115: \t\t\texpect(n.getCategoryTitle(5)).toBe('Projects');\n116: \t\t});\n117: \n118: \t\tit('getCategoryTitle returns a dash for unknown categories', () => {\n119: \t\t\tconst n = new NotesSvelte();\n120: \t\t\tn.categories = [category(1, 'Work')];\n121: \t\t\texpect(n.getCategoryTitle(99)).toBe('-');\n122: \t\t});\n123: \t});\n124: \n125: \tdescribe('collapsed categories', () => {\n126: \t\tit('loads persisted collapsed categories from storage', () => {\n127: \t\t\tstorage.getJson.mockReturnValue([1, 2]);\n128: \t\t\tconst n = new NotesSvelte();\n129: \t\t\texpect(n.collapsedCategories).toEqual([1, 2]);\n130: \t\t\texpect(storage.getJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n131: \t\t});\n132: \n133: \t\tit('defaults to an empty list when nothing is stored', () => {\n134: \t\t\tstorage.getJson.mockReturnValue(null);\n135: \t\t\tconst n = new NotesSvelte();\n136: \t\t\texpect(n.collapsedCategories).toEqual([]);\n137: \t\t});\n138: \n139: \t\tit('toggleCollapseCategory adds and removes ids and persists', () => {\n140: \t\t\tconst n = new NotesSvelte();\n141: \t\t\tn.toggleCollapseCategory(3);\n142: \t\t\texpect(n.isCategoryCollapsed(3)).toBe(true);\n143: \t\t\texpect(storage.setJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY, [\n144: \t\t\t\t3\n145: \t\t\t]);\n146: \n147: \t\t\tn.toggleCollapseCategory(3);\n148: \t\t\texpect(n.isCategoryCollapsed(3)).toBe(false);\n149: \t\t\texpect(storage.setJson).toHaveBeenCalledWith(\n150: \t\t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n151: \t\t\t\t[]\n152: \t\t\t);\n153: \t\t});\n154: \t});\n155: \n156: \tdescribe('active note', () => {\n157: \t\tit('selectNote sets the active note by id', () => {\n158: \t\t\tconst n = new NotesSvelte();\n159: \t\t\tn.notes = [note({ id: '1' }), note({ id: '2' })];\n160: \t\t\tn.selectNote('2');\n161: \t\t\texpect(n.activeNote?.id).toBe('2');\n162: \t\t});\n163: \n164: \t\tit('selectNote clears the active note when the id is unknown', () => {\n165: \t\t\tconst n = new NotesSvelte();\n166: \t\t\tn.notes = [note({ id: '1' })];\n167: \t\t\tn.selectNote('missing');\n168: \t\t\texpect(n.activeNote).toBeNull();\n169: \t\t});\n170: \n171: \t\tit('checkUrlForActiveNote selects the note from the page params', () => {\n172: \t\t\tpageState.params = { id: 'n7' };\n173: \t\t\tconst n = new NotesSvelte();\n174: \t\t\tn.notes = [note({ id: 'n7' }), note({ id: 'n8' })];\n175: \t\t\tn.checkUrlForActiveNote();\n176: \t\t\texpect(n.activeNote?.id).toBe('n7');\n177: \t\t});\n178: \t});\n179: \n180: \tdescribe('openCreateNoteModal', () => {\n181: \t\tit('sets the create parent and opens the note modal', async () => {\n182: \t\t\tconst n = new NotesSvelte();\n183: \t\t\tawait n.openCreateNoteModal(5);\n184: \n185: \t\t\texpect(n.createParent).toBe(5);\n186: \t\t\texpect(n.createType).toBe('note');\n187: \t\t\texpect(n.modalOpen).toBe(true);\n188: \t\t});\n189: \n190: \t\tit('clears a stale create parent when given null', async () => {\n191: \t\t\tconst n = new NotesSvelte();\n192: \t\t\tn.createParent = 5;\n193: \t\t\tawait n.openCreateNoteModal(null);\n194: \n195: \t\t\texpect(n.createParent).toBeNull();\n196: \t\t\texpect(n.createType).toBe('note');\n197: \t\t\texpect(n.modalOpen).toBe(true);\n198: \t\t});\n199: \t});\n200: \n201: \tdescribe('create', () => {\n202: \t\tit('does nothing when the input is empty', async () => {\n203: \t\t\tconst n = new NotesSvelte();\n204: \t\t\tn.inputValue = '';\n205: \t\t\tawait expect(n.create()).resolves.toBeNull();\n206: \t\t\texpect(api.create).not.toHaveBeenCalled();\n207: \t\t});\n208: \n209: \t\tit('creates a note, reloads and navigates to it', async () => {\n210: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n9', title: 'Draft' }) });\n211: \t\t\tapi.list.mockResolvedValue({ data: [note({ id: 'n9' })] });\n212: \n213: \t\t\tconst n = new NotesSvelte();\n214: \t\t\tn.inputValue = 'Draft';\n215: \t\t\tconst result = await n.create();\n216: \n217: \t\t\texpect(result?.id).toBe('n9');\n218: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n219: \t\t\t\ttitle: 'Draft'\n220: \t\t\t});\n221: \t\t\texpect(n.activeNote?.id).toBe('n9');\n222: \t\t\texpect(n.inputValue).toBe('');\n223: \t\t\texpect(navigation.goto).toHaveBeenCalledWith('/notes/n9');\n224: \t\t});\n225: \n226: \t\tit('passes the parent category id when creating inside a category', async () => {\n227: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n10', category_id: 5 }) });\n228: \n229: \t\t\tconst n = new NotesSvelte();\n230: \t\t\tn.inputValue = 'Child';\n231: \t\t\tn.createParent = 5;\n232: \t\t\tawait n.create();\n233: \n234: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n235: \t\t\t\ttitle: 'Child',\n236: \t\t\t\tcategory_id: 5\n237: \t\t\t});\n238: \t\t});\n239: \n240: \t\tit('collapses the parent category when it was not collapsed yet', async () => {\n241: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n11', category_id: 5 }) });\n242: \n243: \t\t\tconst n = new NotesSvelte();\n244: \t\t\tn.inputValue = 'Child';\n245: \t\t\tn.createParent = 5;\n246: \t\t\tawait n.create();\n247: \n248: \t\t\texpect(n.isCategoryCollapsed(5)).toBe(true);\n249: \t\t\texpect(storage.setJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY, [\n250: \t\t\t\t5\n251: \t\t\t]);\n252: \t\t});\n253: \n254: \t\tit('returns null and resets the input when creation fails', async () => {\n255: \t\t\tapi.create.mockResolvedValue(null);\n256: \n257: \t\t\tconst n = new NotesSvelte();\n258: \t\t\tn.inputValue = 'Doomed';\n259: \t\t\tawait expect(n.create()).resolves.toBeNull();\n260: \t\t\texpect(n.inputValue).toBe('');\n261: \t\t\texpect(navigation.goto).not.toHaveBeenCalled();\n262: \t\t});\n263: \t});\n264: \n265: \tdescribe('createCategory', () => {\n266: \t\tit('does nothing when the input is empty', async () => {\n267: \t\t\tconst n = new NotesSvelte();\n268: \t\t\tn.inputValue = '';\n269: \t\t\tawait expect(n.createCategory()).resolves.toBeNull();\n270: \t\t\texpect(api.create).not.toHaveBeenCalled();\n271: \t\t});\n272: \n273: \t\tit('creates a top-level category', async () => {\n274: \t\t\tapi.create.mockResolvedValue({ data: category(3, 'Ideas') });\n275: \n276: \t\t\tconst n = new NotesSvelte();\n277: \t\t\tn.inputValue = 'Ideas';\n278: \t\t\tconst result = await n.createCategory();\n279: \n280: \t\t\texpect(result?.id).toBe(3);\n281: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'), {\n282: \t\t\t\ttitle: 'Ideas'\n283: \t\t\t});\n284: \t\t});\n285: \n286: \t\tit('creates a child category with a parent id', async () => {\n287: \t\t\tapi.create.mockResolvedValue({ data: category(4, 'Sub') });\n288: \n289: \t\t\tconst n = new NotesSvelte();\n290: \t\t\tn.inputValue = 'Sub';\n291: \t\t\tn.createParent = 2;\n292: \t\t\tawait n.createCategory();\n293: \n294: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'), {\n295: \t\t\t\ttitle: 'Sub',\n296: \t\t\t\tparent_id: 2\n297: \t\t\t});\n298: \t\t});\n299: \n300: \t\tit('updates an existing category in edit mode', async () => {\n301: \t\t\tapi.update.mockResolvedValue({ data: category(7, 'Renamed') });\n302: \n303: \t\t\tconst n = new NotesSvelte();\n304: \t\t\tn.inputValue = 'Renamed';\n305: \t\t\tn.rightClickId = 7;\n306: \t\t\tawait n.createCategory(true);\n307: \n308: \t\t\texpect(api.update).toHaveBeenCalledWith(\n309: \t\t\t\texpect.stringContaining('/notes/categories'),\n310: \t\t\t\t7,\n311: \t\t\t\t{ title: 'Renamed' }\n312: \t\t\t);\n313: \t\t});\n314: \n315: \t\tit('reloads the categories after creating one', async () => {\n316: \t\t\tapi.create.mockResolvedValue({ data: category(3, 'Ideas') });\n317: \t\t\tapi.list.mockResolvedValue({ data: [category(3, 'Ideas')] });\n318: \n319: \t\t\tconst n = new NotesSvelte();\n320: \t\t\tn.inputValue = 'Ideas';\n321: \t\t\tawait n.createCategory();\n322: \n323: \t\t\texpect(api.list).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'));\n324: \t\t\texpect(n.categories).toHaveLength(1);\n325: \t\t});\n326: \n327: \t\tit('collapses the parent category when it was not collapsed yet', async () => {\n328: \t\t\tapi.create.mockResolvedValue({ data: category(4, 'Sub') });\n329: \n330: \t\t\tconst n = new NotesSvelte();\n331: \t\t\tn.inputValue = 'Sub';\n332: \t\t\tn.createParent = 2;\n333: \t\t\tawait n.createCategory();\n334: \n335: \t\t\texpect(n.isCategoryCollapsed(2)).toBe(true);\n336: \t\t});\n337: \t});\n338: });\n\n(End of file - total 338 lines)\n</content>","metadata":{"preview":"import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { NotesSvelte } from '$lib/state/Notes.svelte';\nimport { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\nimport type { Note, NoteCategory } from '$lib/types/note';\n\nconst { navigation } = vi.hoisted(() => ({\n\tnavigation: {\n\t\tgoto: vi.fn(),\n\t\tresolve: (path: string, params: Record<string, string>) => path.replace('[id]', params.id)\n\t}\n}));\n\nvi.mock('$app/navigation', () => ({ goto: navigation.goto }));\nvi.mock('$app/paths', () => ({ resolve: navigation.resolve }));\n\nfunction note(overrides: Partial<Note> = {}): Note {\n\treturn {\n\t\tid: 'n1',\n\t\ttitle: 'Note',\n\t\tcontent: '',","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/stores/Notes.test.ts","text":"import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { NotesSvelte } from '$lib/state/Notes.svelte';\nimport { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\nimport type { Note, NoteCategory } from '$lib/types/note';\n\nconst { navigation } = vi.hoisted(() => ({\n\tnavigation: {\n\t\tgoto: vi.fn(),\n\t\tresolve: (path: string, params: Record<string, string>) => path.replace('[id]', params.id)\n\t}\n}));\n\nvi.mock('$app/navigation', () => ({ goto: navigation.goto }));\nvi.mock('$app/paths', () => ({ resolve: navigation.resolve }));\n\nfunction note(overrides: Partial<Note> = {}): Note {\n\treturn {\n\t\tid: 'n1',\n\t\ttitle: 'Note',\n\t\tcontent: '',\n\t\tcategory_id: null,\n\t\ttags: [],\n\t\tis_favorite: false,\n\t\tcreated_at: '2026-01-01T00:00:00',\n\t\tupdated_at: '2026-01-01T00:00:00',\n\t\t...overrides\n\t};\n}\n\nfunction category(id: number, title: string, overrides: Partial<NoteCategory> = {}): NoteCategory {\n\treturn {\n\t\tid,\n\t\ttitle,\n\t\tparent_id: null,\n\t\tsort_order: 0,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\tchildren: [],\n\t\t...overrides\n\t};\n}\n\nbeforeEach(() => {\n\tresetStoreMocks();\n\tpageState.pathname = '/notes';\n\tpageState.params = {};\n\tnavigation.goto.mockReset();\n\tnavigation.goto.mockResolvedValue(undefined);\n});\n\nafterEach(() => {\n\tvi.useRealTimers();\n});\n\ndescribe('Notes store', () => {\n\tdescribe('newest / last updated / favorites', () => {\n\t\tit('getNewestNotes returns the five most recently created notes', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [\n\t\t\t\tnote({ id: '1', created_at: '2026-01-01T00:00:00' }),\n\t\t\t\tnote({ id: '2', created_at: '2026-03-01T00:00:00' }),\n\t\t\t\tnote({ id: '3', created_at: '2026-02-01T00:00:00' }),\n\t\t\t\tnote({ id: '4', created_at: '2026-05-01T00:00:00' }),\n\t\t\t\tnote({ id: '5', created_at: '2026-04-01T00:00:00' }),\n\t\t\t\tnote({ id: '6', created_at: '2026-06-01T00:00:00' })\n\t\t\t];\n\t\t\texpect(n.getNewestNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n\t\t});\n\n\t\tit('getLastUpdatedNotes returns the five most recently updated notes', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [\n\t\t\t\tnote({ id: '1', updated_at: '2026-01-01T00:00:00' }),\n\t\t\t\tnote({ id: '2', updated_at: '2026-03-01T00:00:00' }),\n\t\t\t\tnote({ id: '3', updated_at: '2026-02-01T00:00:00' }),\n\t\t\t\tnote({ id: '4', updated_at: '2026-05-01T00:00:00' }),\n\t\t\t\tnote({ id: '5', updated_at: '2026-04-01T00:00:00' }),\n\t\t\t\tnote({ id: '6', updated_at: '2026-06-01T00:00:00' })\n\t\t\t];\n\t\t\texpect(n.getLastUpdatedNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n\t\t});\n\n\t\tit('getFavorites returns only favourite notes', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [\n\t\t\t\tnote({ id: '1', is_favorite: true }),\n\t\t\t\tnote({ id: '2', is_favorite: false }),\n\t\t\t\tnote({ id: '3', is_favorite: true })\n\t\t\t];\n\t\t\texpect(n.getFavorites().map((x) => x.id)).toEqual(['1', '3']);\n\t\t});\n\t});\n\n\tdescribe('categories', () => {\n\t\tit('getNotesForCategory filters by category id', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [\n\t\t\t\tnote({ id: '1', category_id: 1 }),\n\t\t\t\tnote({ id: '2', category_id: null }),\n\t\t\t\tnote({ id: '3', category_id: 1 })\n\t\t\t];\n\t\t\texpect(n.getNotesForCategory(1).map((x) => x.id)).toEqual(['1', '3']);\n\t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['2']);\n\t\t});\n\n\t\tit('getCategoryTitle resolves top-level categories', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.categories = [category(1, 'Work'), category(2, 'Private')];\n\t\t\texpect(n.getCategoryTitle(1)).toBe('Work');\n\t\t});\n\n\t\tit('getCategoryTitle resolves child categories', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.categories = [category(1, 'Work', { children: [category(5, 'Projects')] })];\n\t\t\texpect(n.getCategoryTitle(5)).toBe('Projects');\n\t\t});\n\n\t\tit('getCategoryTitle returns a dash for unknown categories', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.categories = [category(1, 'Work')];\n\t\t\texpect(n.getCategoryTitle(99)).toBe('-');\n\t\t});\n\t});\n\n\tdescribe('collapsed categories', () => {\n\t\tit('loads persisted collapsed categories from storage', () => {\n\t\t\tstorage.getJson.mockReturnValue([1, 2]);\n\t\t\tconst n = new NotesSvelte();\n\t\t\texpect(n.collapsedCategories).toEqual([1, 2]);\n\t\t\texpect(storage.getJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n\t\t});\n\n\t\tit('defaults to an empty list when nothing is stored', () => {\n\t\t\tstorage.getJson.mockReturnValue(null);\n\t\t\tconst n = new NotesSvelte();\n\t\t\texpect(n.collapsedCategories).toEqual([]);\n\t\t});\n\n\t\tit('toggleCollapseCategory adds and removes ids and persists', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.toggleCollapseCategory(3);\n\t\t\texpect(n.isCategoryCollapsed(3)).toBe(true);\n\t\t\texpect(storage.setJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY, [\n\t\t\t\t3\n\t\t\t]);\n\n\t\t\tn.toggleCollapseCategory(3);\n\t\t\texpect(n.isCategoryCollapsed(3)).toBe(false);\n\t\t\texpect(storage.setJson).toHaveBeenCalledWith(\n\t\t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n\t\t\t\t[]\n\t\t\t);\n\t\t});\n\t});\n\n\tdescribe('active note', () => {\n\t\tit('selectNote sets the active note by id', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [note({ id: '1' }), note({ id: '2' })];\n\t\t\tn.selectNote('2');\n\t\t\texpect(n.activeNote?.id).toBe('2');\n\t\t});\n\n\t\tit('selectNote clears the active note when the id is unknown', () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [note({ id: '1' })];\n\t\t\tn.selectNote('missing');\n\t\t\texpect(n.activeNote).toBeNull();\n\t\t});\n\n\t\tit('checkUrlForActiveNote selects the note from the page params', () => {\n\t\t\tpageState.params = { id: 'n7' };\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.notes = [note({ id: 'n7' }), note({ id: 'n8' })];\n\t\t\tn.checkUrlForActiveNote();\n\t\t\texpect(n.activeNote?.id).toBe('n7');\n\t\t});\n\t});\n\n\tdescribe('openCreateNoteModal', () => {\n\t\tit('sets the create parent and opens the note modal', async () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tawait n.openCreateNoteModal(5);\n\n\t\t\texpect(n.createParent).toBe(5);\n\t\t\texpect(n.createType).toBe('note');\n\t\t\texpect(n.modalOpen).toBe(true);\n\t\t});\n\n\t\tit('clears a stale create parent when given null', async () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.createParent = 5;\n\t\t\tawait n.openCreateNoteModal(null);\n\n\t\t\texpect(n.createParent).toBeNull();\n\t\t\texpect(n.createType).toBe('note');\n\t\t\texpect(n.modalOpen).toBe(true);\n\t\t});\n\t});\n\n\tdescribe('create', () => {\n\t\tit('does nothing when the input is empty', async () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = '';\n\t\t\tawait expect(n.create()).resolves.toBeNull();\n\t\t\texpect(api.create).not.toHaveBeenCalled();\n\t\t});\n\n\t\tit('creates a note, reloads and navigates to it', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n9', title: 'Draft' }) });\n\t\t\tapi.list.mockResolvedValue({ data: [note({ id: 'n9' })] });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Draft';\n\t\t\tconst result = await n.create();\n\n\t\t\texpect(result?.id).toBe('n9');\n\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n\t\t\t\ttitle: 'Draft'\n\t\t\t});\n\t\t\texpect(n.activeNote?.id).toBe('n9');\n\t\t\texpect(n.inputValue).toBe('');\n\t\t\texpect(navigation.goto).toHaveBeenCalledWith('/notes/n9');\n\t\t});\n\n\t\tit('passes the parent category id when creating inside a category', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n10', category_id: 5 }) });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Child';\n\t\t\tn.createParent = 5;\n\t\t\tawait n.create();\n\n\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n\t\t\t\ttitle: 'Child',\n\t\t\t\tcategory_id: 5\n\t\t\t});\n\t\t});\n\n\t\tit('collapses the parent category when it was not collapsed yet', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n11', category_id: 5 }) });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Child';\n\t\t\tn.createParent = 5;\n\t\t\tawait n.create();\n\n\t\t\texpect(n.isCategoryCollapsed(5)).toBe(true);\n\t\t\texpect(storage.setJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY, [\n\t\t\t\t5\n\t\t\t]);\n\t\t});\n\n\t\tit('returns null and resets the input when creation fails', async () => {\n\t\t\tapi.create.mockResolvedValue(null);\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Doomed';\n\t\t\tawait expect(n.create()).resolves.toBeNull();\n\t\t\texpect(n.inputValue).toBe('');\n\t\t\texpect(navigation.goto).not.toHaveBeenCalled();\n\t\t});\n\t});\n\n\tdescribe('createCategory', () => {\n\t\tit('does nothing when the input is empty', async () => {\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = '';\n\t\t\tawait expect(n.createCategory()).resolves.toBeNull();\n\t\t\texpect(api.create).not.toHaveBeenCalled();\n\t\t});\n\n\t\tit('creates a top-level category', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: category(3, 'Ideas') });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Ideas';\n\t\t\tconst result = await n.createCategory();\n\n\t\t\texpect(result?.id).toBe(3);\n\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'), {\n\t\t\t\ttitle: 'Ideas'\n\t\t\t});\n\t\t});\n\n\t\tit('creates a child category with a parent id', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: category(4, 'Sub') });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Sub';\n\t\t\tn.createParent = 2;\n\t\t\tawait n.createCategory();\n\n\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'), {\n\t\t\t\ttitle: 'Sub',\n\t\t\t\tparent_id: 2\n\t\t\t});\n\t\t});\n\n\t\tit('updates an existing category in edit mode', async () => {\n\t\t\tapi.update.mockResolvedValue({ data: category(7, 'Renamed') });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Renamed';\n\t\t\tn.rightClickId = 7;\n\t\t\tawait n.createCategory(true);\n\n\t\t\texpect(api.update).toHaveBeenCalledWith(\n\t\t\t\texpect.stringContaining('/notes/categories'),\n\t\t\t\t7,\n\t\t\t\t{ title: 'Renamed' }\n\t\t\t);\n\t\t});\n\n\t\tit('reloads the categories after creating one', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: category(3, 'Ideas') });\n\t\t\tapi.list.mockResolvedValue({ data: [category(3, 'Ideas')] });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Ideas';\n\t\t\tawait n.createCategory();\n\n\t\t\texpect(api.list).toHaveBeenCalledWith(expect.stringContaining('/notes/categories'));\n\t\t\texpect(n.categories).toHaveLength(1);\n\t\t});\n\n\t\tit('collapses the parent category when it was not collapsed yet', async () => {\n\t\t\tapi.create.mockResolvedValue({ data: category(4, 'Sub') });\n\n\t\t\tconst n = new NotesSvelte();\n\t\t\tn.inputValue = 'Sub';\n\t\t\tn.createParent = 2;\n\t\t\tawait n.createCategory();\n\n\t\t\texpect(n.isCategoryCollapsed(2)).toBe(true);\n\t\t});\n\t});\n});","lineStart":1,"lineEnd":338,"totalLines":338,"truncated":false}},"title":"tests/unit/stores/Notes.test.ts","time":{"start":1791393856333,"end":1791393856419}},"id":"prt_11764fb35001mNdDVpG49o0lFz","sessionID":"ses_ee89c2ab9ffergyxR5ZG3Tj4o0","messageID":"msg_11764f2ed001jm1N2Ny3jdQBVt"}}
