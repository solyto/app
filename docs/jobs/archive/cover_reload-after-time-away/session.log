;\n39: \trightClickType = $state<'note' | 'category'>('note');\n40: \trightClickId = $state<number | string | null>(null);\n41: \tdraggedNote = $state<Note | null>(null);\n42: \tdragTarget = $state<NoteCategory | null>(null);\n43: \tinput = $state<HTMLInputElement | null>(null);\n44: \tinputValue = $state<string>('');\n45: \tauth = getAuth();\n46: \tts = getTranslation();\n47: \tnotifications = getUiNotifications();\n48: \tapiService: ApiService;\n49: \tlocalStorage = new LocalStorageService();\n50: \n51: \tconstructor() {\n52: \t\tthis.apiService = this.auth.apiService;\n53: \t\tthis.loadCollapsedCategories();\n54: \t}\n55: \n56: \tasync load(): Promise<void> {\n57: \t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n58: \t\tif (res) {\n59: \t\t\tthis.loaded = true;\n60: \t\t\tthis.notes = res.data as Note[];\n61: \t\t\tthis.newestNotes = this.getNewestNotes();\n62: \t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n63: \t\t\tthis.favoriteNotes = this.getFavorites();\n64: \t\t\tthis.checkUrlForActiveNote();\n65: \t\t}\n66: \t}\n67: \n68: \tloadCollapsedCategories(): void {\n69: \t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n70: \t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n71: \t}\n72: \n73: \tsaveCollapsedCategories(): void {\n74: \t\tthis.localStorage.setJson(\n75: \t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n76: \t\t\tthis.collapsedCategories\n77: \t\t);\n78: \t}\n79: \n80: \tcheckUrlForActiveNote(): void {\n81: \t\tif (page.params.id) {\n82: \t\t\tthis.selectNote(page.params.id);\n83: \t\t}\n84: \t}\n85: \n86: \tasync loadCategories(): Promise<void> {\n87: \t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n88: \t\tif (res) this.categories = res.data as NoteCategory[];\n89: \t}\n90: \n91: \ttoggleCollapseCategory(categoryId: number): void {\n92: \t\tif (this.collapsedCategories.includes(categoryId)) {\n93: \t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n94: \t\t} else {\n95: \t\t\tthis.collapsedCategories.push(categoryId);\n96: \t\t}\n97: \n98: \t\tthis.saveCollapsedCategories();\n99: \t}\n100: \n101: \tisCategoryCollapsed(categoryId: number): boolean {\n102: \t\treturn this.collapsedCategories.includes(categoryId);\n103: \t}\n104: \n105: \tgetNotesForCategory(categoryId: number | null): Note[] {\n106: \t\treturn this.notes.filter((n) => n.category_id === categoryId);\n107: \t}\n108: \n109: \tgetCategoryTitle(categoryId: number): string {\n110: \t\tfor (const cat of this.categories) {\n111: \t\t\tif (cat.id === categoryId) return cat.title;\n112: \t\t\tif (cat.children) {\n113: \t\t\t\tfor (const child of cat.children) {\n114: \t\t\t\t\tif (child.id === categoryId) return child.title;\n115: \t\t\t\t}\n116: \t\t\t}\n117: \t\t}\n118: \n119: \t\treturn '-';\n120: \t}\n121: \n122: \tgetLastUpdatedNotes(): Note[] {\n123: \t\treturn [...this.notes]\n124: \t\t\t.sort(\n125: \t\t\t\t(a, b) =>\n126: \t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n127: \t\t\t)\n128: \t\t\t.slice(0, 5);\n129: \t}\n130: \n131: \tgetNewestNotes(): Note[] {\n132: \t\treturn [...this.notes]\n133: \t\t\t.sort(\n134: \t\t\t\t(a, b) =>\n135: \t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n136: \t\t\t)\n137: \t\t\t.slice(0, 5);\n138: \t}\n139: \n140: \tgetFavorites(): Note[] {\n141: \t\treturn [...this.notes].filter((n) => n.is_favorite);\n142: \t}\n143: \n144: \tselectNote(noteId: string): void {\n145: \t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n146: \t}\n147: \n148: \tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n149: \t\tif (type === 'category' && edit && this.rightClickId) {\n150: \t\t\tthis.inputValue =\n151: \t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n152: \t\t} else {\n153: \t\t\tthis.inputValue = '';\n154: \t\t}\n155: \n156: \t\tthis.createType = type;\n157: \t\tthis.modalOpen = true;\n158: \n159: \t\tawait tick();\n160: \n161: \t\tsetTimeout(() => this.input?.focus(), 100);\n162: \t}\n163: \n164: \tcloseModal(): void {\n165: \t\tthis.modalOpen = false;\n166: \t}\n167: \n168: \tasync openCreateNoteModal(parent: number | null): Promise<void> {\n169: \t\tthis.createParent = parent;\n170: \t\tawait this.openModal('note');\n171: \t}\n172: \n173: \topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n174: \t\tevent.preventDefault();\n175: \n176: \t\tthis.rightClickType = type;\n177: \t\tthis.rightClickMenuX = event.clientX;\n178: \t\tthis.rightClickMenuY = event.clientY;\n179: \t\tthis.rightClickId = id;\n180: \t\tthis.createParent = type === 'category' ? id as number : null;\n181: \t\tthis.rightClickMenuOpen = true;\n182: \t}\n183: \n184: \tcloseRightClickMenu(): void {\n185: \t\tthis.rightClickMenuOpen = false;\n186: \t}\n187: \n188: \tasync dragToCategory(): Promise<void> {\n189: \t\tif (this.draggedNote === null) return;\n190: \n191: \t\tconst request: UpdateNoteRequest = {\n192: \t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n193: \t\t};\n194: \t\tconst ok = await this.apiService.update(\n195: \t\t\tapiRoutes.notes.update,\n196: \t\t\tthis.draggedNote.id,\n197: \t\t\trequest\n198: \t\t);\n199: \t\tif (ok) await this.load();\n200: \t\treturn Promise.resolve();\n201: \t}\n202: \n203: \tasync create(): Promise<Note | null> {\n204: \t\tif (this.inputValue === '') {\n205: \t\t\treturn null;\n206: \t\t}\n207: \n208: \t\tconst request: CreateNoteRequest =\n209: \t\t\tthis.createParent !== null\n210: \t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n211: \t\t\t\t: { title: this.inputValue };\n212: \t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n213: \n214: \t\tif (!res) {\n215: \t\t\t// Keep the modal and the user's input intact so the note (and the\n216: \t\t\t// failure) is not silently swallowed; a 401 is recovered upstream.\n217: \t\t\tthis.notifications.error(this.ts.get.notes.create_error);\n218: \t\t\tthis.rightClickMenuOpen = false;\n219: \t\t\treturn null;\n220: \t\t}\n221: \n222: \t\tconst note = res.data as Note;\n223: \n224: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n225: \t\t\tthis.toggleCollapseCategory(this.createParent);\n226: \t\t}\n227: \n228: \t\tthis.inputValue = '';\n229: \t\tthis.createParent = null;\n230: \t\tthis.rightClickMenuOpen = false;\n231: \t\tthis.modalOpen = false;\n232: \n233: \t\tawait this.load();\n234: \t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n235: \t\tawait goto(resolve(urls.note, { id: note.id }));\n236: \n237: \t\treturn note;\n238: \t}\n239: \n240: \tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n241: \t\tif (this.inputValue === '') {\n242: \t\t\treturn null;\n243: \t\t}\n244: \n245: \t\tlet res;\n246: \n247: \t\tif (edit && this.rightClickId) {\n248: \t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n249: \t\t\tres = await this.apiService.update(\n250: \t\t\t\tapiRoutes.notes.updateCategory,\n251: \t\t\t\tthis.rightClickId,\n252: \t\t\t\trequest\n253: \t\t\t);\n254: \t\t} else {\n255: \t\t\tconst request: CreateNoteCategoryRequest =\n256: \t\t\t\tthis.createParent !== null\n257: \t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n258: \t\t\t\t\t: { title: this.inputValue };\n259: \t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n260: \t\t}\n261: \n262: \t\tif (!res) {\n263: \t\t\t// Keep the modal and the user's input intact (see create()).\n264: \t\t\tthis.notifications.error(this.ts.get.notes.create_folder_error);\n265: \t\t\tthis.rightClickMenuOpen = false;\n266: \t\t\treturn null;\n267: \t\t}\n268: \n269: \t\tawait this.loadCategories();\n270: \n271: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n272: \t\t\tthis.toggleCollapseCategory(this.createParent);\n273: \t\t}\n274: \n275: \t\tthis.inputValue = '';\n276: \t\tthis.createParent = null;\n277: \t\tthis.rightClickMenuOpen = false;\n278: \t\tthis.modalOpen = false;\n279: \n280: \t\treturn typeof res === 'object' ? (res.data as NoteCategory) : null;\n281: \t}\n282: \n283: \tasync saveContent(): Promise<boolean> {\n284: \t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n285: \t\tconst ok = await this.apiService.update(\n286: \t\t\tapiRoutes.notes.update,\n287: \t\t\tthis.activeNote!.id,\n288: \t\t\trequest\n289: \t\t);\n290: \t\tif (ok) await this.load();\n291: \t\treturn ok;\n292: \t}\n293: \n294: \tasync changeTitle(title: string): Promise<boolean> {\n295: \t\tconst request: UpdateNoteRequest = { title: title };\n296: \t\tconst ok = await this.apiService.update(\n297: \t\t\tapiRoutes.notes.update,\n298: \t\t\tthis.activeNote!.id,\n299: \t\t\trequest\n300: \t\t);\n301: \t\tif (ok) await this.load();\n302: \t\treturn ok;\n303: \t}\n304: \n305: \tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n306: \t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n307: \t\tconst ok = await this.apiService.update(\n308: \t\t\tapiRoutes.notes.update,\n309: \t\t\tthis.activeNote!.id,\n310: \t\t\trequest\n311: \t\t);\n312: \t\tif (ok) await this.load();\n313: \t\treturn ok;\n314: \t}\n315: \n316: \tasync addTag(tagId: number): Promise<boolean> {\n317: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n318: \t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n319: \t\tconst ok = await this.apiService.update(\n320: \t\t\tapiRoutes.notes.update,\n321: \t\t\tthis.activeNote!.id,\n322: \t\t\trequest\n323: \t\t);\n324: \n325: \t\tif (ok) await this.load();\n326: \t\treturn ok;\n327: \t}\n328: \n329: \tasync removeTag(tagId: number): Promise<boolean> {\n330: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n331: \t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n332: \t\tconst ok = await this.apiService.update(\n333: \t\t\tapiRoutes.notes.update,\n334: \t\t\tthis.activeNote!.id,\n335: \t\t\trequest\n336: \t\t);\n337: \n338: \t\tif (ok) await this.load();\n339: \t\treturn ok;\n340: \t}\n341: \n342: \tasync delete(): Promise<boolean> {\n343: \t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n344: \t\t\treturn false;\n345: \t\t}\n346: \n347: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n348: \t\tif (ok) {\n349: \t\t\tif (this.activeNote?.id === this.rightClickId) {\n350: \t\t\t\tawait goto(resolve(urls.notes));\n351: \t\t\t}\n352: \n353: \t\t\tawait this.load();\n354: \t\t\tthis.closeRightClickMenu();\n355: \t\t}\n356: \t\treturn ok;\n357: \t}\n358: \n359: \tasync deleteActiveNote(): Promise<boolean> {\n360: \t\tif (!this.activeNote) return false;\n361: \n362: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n363: \t\tif (ok) {\n364: \t\t\tawait goto(resolve(urls.notes));\n365: \t\t\tawait this.load();\n366: \t\t}\n367: \t\treturn ok;\n368: \t}\n369: \n370: \tasync deleteCategory(): Promise<boolean> {\n371: \t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n372: \t\t\treturn false;\n373: \t\t}\n374: \n375: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n376: \t\tif (ok) await this.loadCategories();\n377: \t\tthis.closeRightClickMenu();\n378: \t\treturn ok;\n379: \t}\n380: \n381: \tasync importFile(file: File): Promise<boolean> {\n382: \t\tconst formData = new FormData();\n383: \t\tformData.append('file', file);\n384: \t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n385: \n386: \t\tif (ok) {\n387: \t\t\tawait this.load();\n388: \t\t\treturn true;\n389: \t\t}\n390: \n391: \t\treturn false;\n392: \t}\n393: }\n394: \n395: const NOTES_KEY = Symbol('SOLYTO_NOTES');\n396: \n397: export function setNotes(): NotesSvelte {\n398: \treturn setContext(NOTES_KEY, new NotesSvelte());\n399: }\n400: \n401: export function getNotes(): NotesSvelte {\n402: \treturn getContext<NotesSvelte>(NOTES_KEY);\n403: }\n\n(End of file - total 403 lines)\n</content>","metadata":{"preview":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { getTranslation } from '$lib/state/Translation.svelte';\nimport { getUiNotifications } from '$lib/state/UiNotifications.svelte';\nimport { page } from '$app/state';\nimport { goto } from '$app/navigation';\nimport { urls } from '$lib/config/urls';\nimport { resolve } from '$app/paths';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport { SvelteDate } from 'svelte/reactivity';","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Notes.svelte.ts","text":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { getTranslation } from '$lib/state/Translation.svelte';\nimport { getUiNotifications } from '$lib/state/UiNotifications.svelte';\nimport { page } from '$app/state';\nimport { goto } from '$app/navigation';\nimport { urls } from '$lib/config/urls';\nimport { resolve } from '$app/paths';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport { SvelteDate } from 'svelte/reactivity';\n\nexport class NotesSvelte {\n\tstatic readonly LS_COLLAPSED_CATEGORIES_KEY: string = 'notes.collapsedCategories';\n\n\tloaded = $state<boolean>(false);\n\tnotes = $state<Note[]>([]);\n\tnewestNotes = $state<Note[]>([]);\n\tlastUpdatedNotes = $state<Note[]>([]);\n\tfavoriteNotes = $state<Note[]>([]);\n\tcategories = $state<NoteCategory[]>([]);\n\tcollapsedCategories = $state<number[]>([]);\n\tactiveNote = $state<Note | null>(null);\n\tmodalOpen = $state<boolean>(false);\n\tcreateType = $state<'note' | 'category'>('note');\n\tcreateParent = $state<number | null>(null);\n\trightClickMenuOpen = $state<boolean>(false);\n\trightClickMenuX = $state<number>(0);\n\trightClickMenuY = $state<number>(0);\n\trightClickType = $state<'note' | 'category'>('note');\n\trightClickId = $state<number | string | null>(null);\n\tdraggedNote = $state<Note | null>(null);\n\tdragTarget = $state<NoteCategory | null>(null);\n\tinput = $state<HTMLInputElement | null>(null);\n\tinputValue = $state<string>('');\n\tauth = getAuth();\n\tts = getTranslation();\n\tnotifications = getUiNotifications();\n\tapiService: ApiService;\n\tlocalStorage = new LocalStorageService();\n\n\tconstructor() {\n\t\tthis.apiService = this.auth.apiService;\n\t\tthis.loadCollapsedCategories();\n\t}\n\n\tasync load(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n\t\tif (res) {\n\t\t\tthis.loaded = true;\n\t\t\tthis.notes = res.data as Note[];\n\t\t\tthis.newestNotes = this.getNewestNotes();\n\t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n\t\t\tthis.favoriteNotes = this.getFavorites();\n\t\t\tthis.checkUrlForActiveNote();\n\t\t}\n\t}\n\n\tloadCollapsedCategories(): void {\n\t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n\t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n\t}\n\n\tsaveCollapsedCategories(): void {\n\t\tthis.localStorage.setJson(\n\t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n\t\t\tthis.collapsedCategories\n\t\t);\n\t}\n\n\tcheckUrlForActiveNote(): void {\n\t\tif (page.params.id) {\n\t\t\tthis.selectNote(page.params.id);\n\t\t}\n\t}\n\n\tasync loadCategories(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n\t\tif (res) this.categories = res.data as NoteCategory[];\n\t}\n\n\ttoggleCollapseCategory(categoryId: number): void {\n\t\tif (this.collapsedCategories.includes(categoryId)) {\n\t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n\t\t} else {\n\t\t\tthis.collapsedCategories.push(categoryId);\n\t\t}\n\n\t\tthis.saveCollapsedCategories();\n\t}\n\n\tisCategoryCollapsed(categoryId: number): boolean {\n\t\treturn this.collapsedCategories.includes(categoryId);\n\t}\n\n\tgetNotesForCategory(categoryId: number | null): Note[] {\n\t\treturn this.notes.filter((n) => n.category_id === categoryId);\n\t}\n\n\tgetCategoryTitle(categoryId: number): string {\n\t\tfor (const cat of this.categories) {\n\t\t\tif (cat.id === categoryId) return cat.title;\n\t\t\tif (cat.children) {\n\t\t\t\tfor (const child of cat.children) {\n\t\t\t\t\tif (child.id === categoryId) return child.title;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\treturn '-';\n\t}\n\n\tgetLastUpdatedNotes(): Note[] {\n\t\treturn [...this.notes]\n\t\t\t.sort(\n\t\t\t\t(a, b) =>\n\t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n\t\t\t)\n\t\t\t.slice(0, 5);\n\t}\n\n\tgetNewestNotes(): Note[] {\n\t\treturn [...this.notes]\n\t\t\t.sort(\n\t\t\t\t(a, b) =>\n\t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n\t\t\t)\n\t\t\t.slice(0, 5);\n\t}\n\n\tgetFavorites(): Note[] {\n\t\treturn [...this.notes].filter((n) => n.is_favorite);\n\t}\n\n\tselectNote(noteId: string): void {\n\t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n\t}\n\n\tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n\t\tif (type === 'category' && edit && this.rightClickId) {\n\t\t\tthis.inputValue =\n\t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n\t\t} else {\n\t\t\tthis.inputValue = '';\n\t\t}\n\n\t\tthis.createType = type;\n\t\tthis.modalOpen = true;\n\n\t\tawait tick();\n\n\t\tsetTimeout(() => this.input?.focus(), 100);\n\t}\n\n\tcloseModal(): void {\n\t\tthis.modalOpen = false;\n\t}\n\n\tasync openCreateNoteModal(parent: number | null): Promise<void> {\n\t\tthis.createParent = parent;\n\t\tawait this.openModal('note');\n\t}\n\n\topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n\t\tevent.preventDefault();\n\n\t\tthis.rightClickType = type;\n\t\tthis.rightClickMenuX = event.clientX;\n\t\tthis.rightClickMenuY = event.clientY;\n\t\tthis.rightClickId = id;\n\t\tthis.createParent = type === 'category' ? id as number : null;\n\t\tthis.rightClickMenuOpen = true;\n\t}\n\n\tcloseRightClickMenu(): void {\n\t\tthis.rightClickMenuOpen = false;\n\t}\n\n\tasync dragToCategory(): Promise<void> {\n\t\tif (this.draggedNote === null) return;\n\n\t\tconst request: UpdateNoteRequest = {\n\t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n\t\t};\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.draggedNote.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn Promise.resolve();\n\t}\n\n\tasync create(): Promise<Note | null> {\n\t\tif (this.inputValue === '') {\n\t\t\treturn null;\n\t\t}\n\n\t\tconst request: CreateNoteRequest =\n\t\t\tthis.createParent !== null\n\t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n\t\t\t\t: { title: this.inputValue };\n\t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n\n\t\tif (!res) {\n\t\t\t// Keep the modal and the user's input intact so the note (and the\n\t\t\t// failure) is not silently swallowed; a 401 is recovered upstream.\n\t\t\tthis.notifications.error(this.ts.get.notes.create_error);\n\t\t\tthis.rightClickMenuOpen = false;\n\t\t\treturn null;\n\t\t}\n\n\t\tconst note = res.data as Note;\n\n\t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n\t\t\tthis.toggleCollapseCategory(this.createParent);\n\t\t}\n\n\t\tthis.inputValue = '';\n\t\tthis.createParent = null;\n\t\tthis.rightClickMenuOpen = false;\n\t\tthis.modalOpen = false;\n\n\t\tawait this.load();\n\t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n\t\tawait goto(resolve(urls.note, { id: note.id }));\n\n\t\treturn note;\n\t}\n\n\tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n\t\tif (this.inputValue === '') {\n\t\t\treturn null;\n\t\t}\n\n\t\tlet res;\n\n\t\tif (edit && this.rightClickId) {\n\t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n\t\t\tres = await this.apiService.update(\n\t\t\t\tapiRoutes.notes.updateCategory,\n\t\t\t\tthis.rightClickId,\n\t\t\t\trequest\n\t\t\t);\n\t\t} else {\n\t\t\tconst request: CreateNoteCategoryRequest =\n\t\t\t\tthis.createParent !== null\n\t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n\t\t\t\t\t: { title: this.inputValue };\n\t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n\t\t}\n\n\t\tif (!res) {\n\t\t\t// Keep the modal and the user's input intact (see create()).\n\t\t\tthis.notifications.error(this.ts.get.notes.create_folder_error);\n\t\t\tthis.rightClickMenuOpen = false;\n\t\t\treturn null;\n\t\t}\n\n\t\tawait this.loadCategories();\n\n\t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n\t\t\tthis.toggleCollapseCategory(this.createParent);\n\t\t}\n\n\t\tthis.inputValue = '';\n\t\tthis.createParent = null;\n\t\tthis.rightClickMenuOpen = false;\n\t\tthis.modalOpen = false;\n\n\t\treturn typeof res === 'object' ? (res.data as NoteCategory) : null;\n\t}\n\n\tasync saveContent(): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync changeTitle(title: string): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { title: title };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync addTag(tagId: number): Promise<boolean> {\n\t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n\t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync removeTag(tagId: number): Promise<boolean> {\n\t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n\t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync delete(): Promise<boolean> {\n\t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n\t\t\treturn false;\n\t\t}\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n\t\tif (ok) {\n\t\t\tif (this.activeNote?.id === this.rightClickId) {\n\t\t\t\tawait goto(resolve(urls.notes));\n\t\t\t}\n\n\t\t\tawait this.load();\n\t\t\tthis.closeRightClickMenu();\n\t\t}\n\t\treturn ok;\n\t}\n\n\tasync deleteActiveNote(): Promise<boolean> {\n\t\tif (!this.activeNote) return false;\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n\t\tif (ok) {\n\t\t\tawait goto(resolve(urls.notes));\n\t\t\tawait this.load();\n\t\t}\n\t\treturn ok;\n\t}\n\n\tasync deleteCategory(): Promise<boolean> {\n\t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n\t\t\treturn false;\n\t\t}\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n\t\tif (ok) await this.loadCategories();\n\t\tthis.closeRightClickMenu();\n\t\treturn ok;\n\t}\n\n\tasync importFile(file: File): Promise<boolean> {\n\t\tconst formData = new FormData();\n\t\tformData.append('file', file);\n\t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n\n\t\tif (ok) {\n\t\t\tawait this.load();\n\t\t\treturn true;\n\t\t}\n\n\t\treturn false;\n\t}\n}\n\nconst NOTES_KEY = Symbol('SOLYTO_NOTES');\n\nexport function setNotes(): NotesSvelte {\n\treturn setContext(NOTES_KEY, new NotesSvelte());\n}\n\nexport function getNotes(): NotesSvelte {\n\treturn getContext<NotesSvelte>(NOTES_KEY);\n}","lineStart":1,"lineEnd":403,"totalLines":403,"truncated":false}},"title":"src/lib/state/Notes.svelte.ts","time":{"start":1791395424951,"end":1791395424981}},"id":"prt_1177cea96001zZjXr0qfnODbEU","sessionID":"ses_ee88373fcffeJtlBmOFhabpoTz","messageID":"msg_1177cdb0b0019HkY2GTYAPc5ke"}}
