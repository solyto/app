> | null = null;\n46: \tprivate visibilityHandler: (() => void) | null = null;\n47: \tprivate onlineHandler: (() => void) | null = null;\n48: \n49: \tconstructor() {\n50: \t\tthis.apiService = new ApiService(null);\n51: \t\t// ApiService asks back here when any request hits a 401; the handler\n52: \t\t// adopts another tab's token or refreshes this session, last resort logout.\n53: \t\tthis.apiService.setUnauthorizedHandler(() => this.recoverFromUnauthorized());\n54: \t\tthis.load().then();\n55: \t\tthis.startSessionMonitor();\n56: \t}\n57: \n58: \tprivate async load(): Promise<void> {\n59: \t\tconst savedAuth = this.localStorage.getJson(Auth.LS_AUTH_KEY);\n60: \n61: \t\tif (!savedAuth) return;\n62: \n63: \t\tconst { user, authToken } = savedAuth as { user: User; authToken: AuthToken }\n64: \n65: \t\tif (!authToken || !user) return;\n66: \n67: \t\tconst expiresAt = new SvelteDate(authToken.expires_at).getTime();\n68: \n69: \t\tif (expiresAt > Date.now()) {\n70: \t\t\tthis.user = user;\n71: \t\t\tthis.authToken = authToken;\n72: \t\t\tthis.apiService.updateAuthToken(this.getToken()!);\n73: \t\t\tthis.loggedIn = true;\n74: \n75: \t\t\tif (this.shouldRefresh(expiresAt)) {\n76: \t\t\t\tawait this.refresh();\n77: \t\t\t}\n78: \n79: \t\t\tawait this.loadAdditionalData();\n80: \n81: \t\t\tthis.save();\n82: \t\t} else {\n83: \t\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n84: \t\t}\n85: \t}\n86: \n87: \tpublic async loadAdditionalData(): Promise<void> {\n88: \t\tif (!this.user) return;\n89: \t\tconst res = await this.apiService.get(apiRoutes.users.get, null);\n90: \t\tif (res) this.user = res.data as User;\n91: \t\tthis.save();\n92: \t}\n93: \n94: \tpublic save(): void {\n95: \t\tthis.localStorage.setJson(Auth.LS_AUTH_KEY, {\n96: \t\t\tuser: this.user,\n97: \t\t\tauthToken: this.authToken\n98: \t\t});\n99: \t}\n100: \n101: \tprivate clear(): void {\n102: \t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n103: \t\tthis.user = null;\n104: \t\tthis.authToken = null;\n105: \t\tthis.loggedIn = false;\n106: \t\t// Every store shares this ApiService instance, so clearing it here makes\n107: \t\t// sure no request keeps sending the revoked token.\n108: \t\tthis.apiService.updateAuthToken(null);\n109: \t}\n110: \n111: \tasync login(email: string, password: string): Promise<boolean> {\n112: \t\tconst request: LoginRequest = { email, password, platform: PLATFORM };\n113: \t\tconst res = await this.apiService.post(apiRoutes.auth.login, request);\n114: \n115: \t\tif (!res) return Promise.resolve(false);\n116: \t\tconst login = res.data as LoginResponse;\n117: \n118: \t\tthis.user = login.user;\n119: \t\tthis.authToken = {\n120: \t\t\ttoken: login.token,\n121: \t\t\ttoken_type: login.token_type,\n122: \t\t\texpires_at: login.token_expires_at\n123: \t\t};\n124: \t\tthis.loggedIn = true;\n125: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n126: \n127: \t\tthis.save();\n128: \t\tawait this.loadAdditionalData();\n129: \n130: \t\treturn Promise.resolve(true);\n131: \t}\n132: \n133: \tprivate shouldRefresh(expiresAt: number): boolean {\n134: \t\tconst thresholdDays = IS_NATIVE ? 14 : 5;\n135: \t\treturn expiresAt < Date.now() + thresholdDays * 24 * 60 * 60 * 1000;\n136: \t}\n137: \n138: \tasync refresh(): Promise<boolean> {\n139: \t\t// Single-flight: concurrent 401 recoveries and the resume check share one\n140: \t\t// refresh request instead of racing each other with the same token.\n141: \t\tif (this.refreshInFlight) return this.refreshInFlight;\n142: \n143: \t\tthis.refreshInFlight = this.performRefresh().finally(() => {\n144: \t\t\tthis.refreshInFlight = null;\n145: \t\t});\n146: \n147: \t\treturn this.refreshInFlight;\n148: \t}\n149: \n150: \tprivate async performRefresh(): Promise<boolean> {\n151: \t\tthis.apiService.updateAuthToken(this.getToken());\n152: \t\tconst res = await this.apiService.post(apiRoutes.auth.refresh, {});\n153: \n154: \t\tif (!res) return false;\n155: \t\tconst refresh = res.data as LoginResponse;\n156: \n157: \t\tthis.user = refresh.user;\n158: \t\tthis.authToken = {\n159: \t\t\ttoken: refresh.token,\n160: \t\t\ttoken_type: refresh.token_type,\n161: \t\t\texpires_at: refresh.token_expires_at\n162: \t\t};\n163: \t\tthis.loggedIn = true;\n164: \t\tthis.apiService.updateAuthToken(this.getToken());\n165: \n166: \t\tthis.save();\n167: \n168: \t\treturn true;\n169: \t}\n170: \n171: \tlogout(): void {\n172: \t\tthis.clear();\n173: \t}\n174: \n175: \t/**\n176: \t * Recovery ladder for a 401 from a non-auth endpoint, invoked by ApiService.\n177: \t * Returns true when the request is worth retrying with the (new) token.\n178: \t */\n179: \tasync recoverFromUnauthorized(): Promise<boolean> {\n180: \t\tif (this.recoveryInFlight) return this.recoveryInFlight;\n181: \n182: \t\tthis.recoveryInFlight = this.performRecovery().finally(() => {\n183: \t\t\tthis.recoveryInFlight = null;\n184: \t\t});\n185: \n186: \t\treturn this.recoveryInFlight;\n187: \t}\n188: \n189: \tprivate async performRecovery(): Promise<boolean> {\n190: \t\t// (a) Another tab may already have refreshed the persisted session;\n191: \t\t// adopt its token rather than racing it with our own refresh.\n192: \t\tif (this.adoptExternalSession()) return true;\n193: \n194: \t\t// (b) Refresh this session (single-flight).\n195: \t\ttry {\n196: \t\t\tif (await this.refresh()) return true;\n197: \t\t} catch {\n198: \t\t\t// Transient network error while refreshing: keep the session, the\n199: \t\t\t// resume/online checks re-validate once the network is back.\n200: \t\t\treturn false;\n201: \t\t}\n202: \n203: \t\t// (c) The refresh was answered with a definitive auth rejection.\n204: \t\tthis.logout();\n205: \t\treturn false;\n206: \t}\n207: \n208: \tprivate adoptExternalSession(): boolean {\n209: \t\tconst savedAuth = this.localStorage.getJson(Auth.LS_AUTH_KEY) as\n210: \t\t\t| { user: User; authToken: AuthToken }\n211: \t\t\t| null;\n212: \n213: \t\tif (!savedAuth?.authToken?.token || !savedAuth.user) return false;\n214: \t\tif (savedAuth.authToken.token === this.getToken()) return false;\n215: \t\tif (new SvelteDate(savedAuth.authToken.expires_at).getTime() <= Date.now()) return false;\n216: \n217: \t\tthis.user = savedAuth.user;\n218: \t\tthis.authToken = savedAuth.authToken;\n219: \t\tthis.loggedIn = true;\n220: \t\tthis.apiService.updateAuthToken(savedAuth.authToken.token);\n221: \n222: \t\treturn true;\n223: \t}\n224: \n225: \tprivate startSessionMonitor(): void {\n226: \t\tif (!browser || this.visibilityHandler) return;\n227: \n228: \t\tthis.visibilityHandler = () => {\n229: \t\t\tif (document.hidden) {\n230: \t\t\t\tthis.stopSessionCheckInterval();\n231: \t\t\t} else {\n232: \t\t\t\tthis.validateSession();\n233: \t\t\t\tthis.startSessionCheckInterval();\n234: \t\t\t}\n235: \t\t};\n236: \n237: \t\tthis.onlineHandler = () => {\n238: \t\t\tthis.validateSession();\n239: \t\t};\n240: \n241: \t\tdocument.addEventListener('visibilitychange', this.visibilityHandler);\n242: \t\twindow.addEventListener('online', this.onlineHandler);\n243: \n244: \t\tif (!document.hidden) this.startSessionCheckInterval();\n245: \t}\n246: \n247: \tprivate startSessionCheckInterval(): void {\n248: \t\tthis.stopSessionCheckInterval();\n249: \t\tthis.sessionCheckInterval = setInterval(\n250: \t\t\t() => this.validateSession(),\n251: \t\t\tSESSION_CHECK_INTERVAL_MS\n252: \t\t);\n253: \t}\n254: \n255: \tprivate stopSessionCheckInterval(): void {\n256: \t\tif (this.sessionCheckInterval !== null) {\n257: \t\t\tclearInterval(this.sessionCheckInterval);\n258: \t\t\tthis.sessionCheckInterval = null;\n259: \t\t}\n260: \t}\n261: \n262: \t/**\n263: \t * Re-validates the session when the app resumes (visibility/online) and on a\n264: \t * low-frequency interval. The routine case is a local date comparison; only a\n265: \t * near/expired token triggers a network refresh, followed by a user re-fetch\n266: \t * so the in-memory profile (incl. the image path) stays current.\n267: \t */\n268: \tprivate async validateSession(): Promise<void> {\n269: \t\tif (!this.loggedIn || !this.authToken) return;\n270: \n271: \t\tconst expiresAt = new SvelteDate(this.authToken.expires_at).getTime();\n272: \n273: \t\tif (expiresAt <= Date.now() || this.shouldRefresh(expiresAt)) {\n274: \t\t\ttry {\n275: \t\t\t\tif (!(await this.refresh())) {\n276: \t\t\t\t\t// The refresh endpoint rejected the token: the session is over.\n277: \t\t\t\t\tthis.logout();\n278: \t\t\t\t\treturn;\n279: \t\t\t\t}\n280: \t\t\t} catch {\n281: \t\t\t\t// Network error — leave the session alone, re-check on next resume.\n282: \t\t\t\treturn;\n283: \t\t\t}\n284: \t\t}\n285: \n286: \t\tawait this.loadAdditionalData();\n287: \t}\n288: \n289: \tisAdmin(): boolean {\n290: \t\treturn this.user?.role === 'admin' || this.user?.role === 'super_admin';\n291: \t}\n292: \n293: \tasync register(request: RegisterRequest): Promise<AuthActionResponse> {\n294: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.register, request);\n295: \t}\n296: \n297: \tasync verify(request: VerifyRequest): Promise<VerifyActionResponse> {\n298: \t\treturn this.apiService.postRaw<VerifyActionResponse>(apiRoutes.auth.verify, request);\n299: \t}\n300: \n301: \tasync forgotPassword(email: string, platform: string): Promise<void> {\n302: \t\tawait this.apiService.post(apiRoutes.auth.forgotPassword, { email, platform });\n303: \t}\n304: \n305: \tasync resetPassword(token: string, email: string, password: string, passwordConfirmation: string): Promise<AuthActionResponse> {\n306: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.resetPassword, {\n307: \t\t\ttoken,\n308: \t\t\temail,\n309: \t\t\tpassword,\n310: \t\t\tpassword_confirmation: passwordConfirmation\n311: \t\t});\n312: \t}\n313: \n314: \tasync passkeyAuthenticationOptions(): Promise<PasskeyAuthenticationOptions | null> {\n315: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.authenticateOptions, {});\n316: \t\treturn (res?.data ?? null) as PasskeyAuthenticationOptions | null;\n317: \t}\n318: \n319: \tasync passkeyAuthenticate(response: object): Promise<void> {\n320: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.authenticate, { response, platform: PLATFORM });\n321: \t\tif (!res.success) {\n322: \t\t\tthrow new Error(res.message ?? 'Passkey authentication failed');\n323: \t\t}\n324: \t\tconst data = res.data as LoginResponse;\n325: \t\tthis.user = data.user;\n326: \t\tthis.authToken = {\n327: \t\t\ttoken: data.token,\n328: \t\t\ttoken_type: data.token_type,\n329: \t\t\texpires_at: data.token_expires_at\n330: \t\t};\n331: \t\tthis.loggedIn = true;\n332: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n333: \t\tthis.save();\n334: \t\tawait this.loadAdditionalData();\n335: \t}\n336: \n337: \tasync passkeyRegistrationOptions(): Promise<PasskeyRegistrationOptions | null> {\n338: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.registerOptions, {});\n339: \t\treturn (res?.data ?? null) as PasskeyRegistrationOptions | null;\n340: \t}\n341: \n342: \tasync passkeyRegister(response: object, name: string): Promise<void> {\n343: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.register, { response, name });\n344: \t\tif (!res.success) {\n345: \t\t\tthrow new Error(res.message ?? 'Registration failed');\n346: \t\t}\n347: \t}\n348: \n349: \tasync getPasskeys(): Promise<Passkey[]> {\n350: \t\tconst res = await this.apiService.get(apiRoutes.auth.passkeys.list, null);\n351: \t\treturn (res?.data ?? []) as Passkey[];\n352: \t}\n353: \n354: \tasync deletePasskey(id: string): Promise<void> {\n355: \t\tawait this.apiService.delete(apiRoutes.auth.passkeys.delete, id);\n356: \t}\n357: \n358: \tasync renamePasskey(id: string, name: string): Promise<void> {\n359: \t\tawait this.apiService.update(apiRoutes.auth.passkeys.update, id, { name });\n360: \t}\n361: \n362: \tgetToken(): string | null {\n363: \t\treturn this.authToken?.token ?? null;\n364: \t}\n365: \n366: \tasync updateNavigation(navigation: string): Promise<boolean> {\n367: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateNavigationSettings, {\n368: \t\t\tnavigation\n369: \t\t});\n370: \t\treturn Promise.resolve(res);\n371: \t}\n372: \n373: \tasync updateTimezone(timezone: string): Promise<boolean> {\n374: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateTimezone, {\n375: \t\t\ttimezone\n376: \t\t});\n377: \t\treturn Promise.resolve(res);\n378: \t}\n379: \n380: \tasync updateDateFormat(dateFormat: string): Promise<boolean> {\n381: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateDateFormat, {\n382: \t\t\tdate_format: dateFormat\n383: \t\t});\n384: \t\treturn Promise.resolve(res);\n385: \t}\n386: \n387: \tasync updateTimeFormat(timeFormat: string): Promise<boolean> {\n388: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateTimeFormat, {\n389: \t\t\ttime_format: timeFormat\n390: \t\t});\n391: \t\treturn Promise.resolve(res);\n392: \t}\n393: \n394: \tasync updateLanguage(language: string): Promise<boolean> {\n395: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateLanguage, {\n396: \t\t\tlanguage\n397: \t\t});\n398: \t\tif (res) await this.loadAdditionalData();\n399: \t\treturn Promise.resolve(res);\n400: \t}\n401: \n402: \tasync completeOnboarding(): Promise<boolean> {\n403: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.completeOnboarding, {});\n404: \t\tif (res && this.user?.settings) {\n405: \t\t\tthis.user.settings.first_visit = false;\n406: \t\t\tthis.save();\n407: \t\t}\n408: \t\treturn Promise.resolve(res);\n409: \t}\n410: \n411: \tasync setOpenaiApiKey(key: string | null): Promise<boolean> {\n412: \t\tconst res = await this.apiService.put(apiRoutes.users.settings.updateOpenaiApiKey, { key });\n413: \t\tawait this.loadAdditionalData();\n414: \t\treturn Promise.resolve(res);\n415: \t}\n416: \n417: \tasync setProfileImage(file: File): Promise<boolean> {\n418: \t\tif (!file.type.startsWith('image/')) {\n419: \t\t\treturn Promise.resolve(false);\n420: \t\t}\n421: \n422: \t\tconst formData = new FormData();\n423: \t\tformData.append('profile_image', file);\n424: \n425: \t\tconst res = await this.apiService.postFormData(\n426: \t\t\tapiRoutes.users.updateProfileImage,\n427: \t\t\tformData\n428: \t\t);\n429: \t\tawait this.loadAdditionalData();\n430: \t\treturn Promise.resolve(res);\n431: \t}\n432: \n433: \tasync getPublicProfile(userId: string): Promise<User | null> {\n434: \t\tif (this.profileCache.has(userId)) return this.profileCache.get(userId)!;\n435: \t\tconst res = await this.apiService.get(apiRoutes.users.getPublicProfile, userId);\n436: \t\tconst user = res?.data as User | null;\n437: \t\tif (user) this.profileCache.set(userId, user);\n438: \t\treturn user;\n439: \t}\n440: \n441: \tgetDateInUserPreferredFormat(input: string | Date): string {\n442: \t\treturn formatDate(input, this?.user?.settings?.date_format ?? null);\n443: \t}\n444: \n445: \tgetDateWithoutYearInUserPreferredFormat(input: string | Date): string {\n446: \t\treturn formatDateWithoutYear(input, this?.user?.settings?.date_format ?? null);\n447: \t}\n448: \n449: \tgetDateWithWeekdayInUserPreferredFormat(input: string | Date): string {\n450: \t\treturn formatDateWithWeekday(input, this?.user?.settings?.date_format ?? null, this?.user?.settings?.language ?? undefined);\n451: \t}\n452: \n453: \tgetDateTimeInUserPreferredFormat(input: string | Date): string {\n454: \t\treturn formatDateTime(\n455: \t\t\tinput,\n456: \t\t\tthis?.user?.settings?.date_format ?? null,\n457: \t\t\tthis?.user?.settings?.time_format ?? null\n458: \t\t);\n459: \t}\n460: \n461: \tgetTimeInUserPreferredFormat(input: string | Date): string {\n462: \t\treturn formatTime(input, this?.user?.settings?.time_format ?? null);\n463: \t}\n464: \n465: \tgetTimeWithSecondsInUserPreferredFormat(input: string | Date): string {\n466: \t\treturn formatTimeWithSeconds(input, this?.user?.settings?.time_format ?? null);\n467: \t}\n468: \n469: \tgetTemperatureInUserPreferredFormat(temperature: number): number {\n470: \t\tif (this?.user?.settings?.temperature_unit === 'c') return temperature;\n471: \n472: \t\treturn Math.round((temperature * 9) / 5 + 32);\n473: \t}\n474: }\n475: \n476: const AUTH_KEY = Symbol('SOLYTO_AUTH');\n477: \n478: export function setAuth(): Auth {\n479: \treturn setContext(AUTH_KEY, new Auth());\n480: }\n481: \n482: export function getAuth(): Auth {\n483: \treturn getContext<Auth>(AUTH_KEY);\n484: }\n\n(End of file - total 484 lines)\n</content>","metadata":{"preview":"import type {\n\tAuthToken,\n\tUser,\n\tLoginRequest,\n\tLoginResponse,\n\tRegisterRequest,\n\tVerifyRequest,\n\tAuthActionResponse,\n\tVerifyActionResponse,\n\tPasskeyActionResponse,\n\tPasskeyAuthenticationOptions,\n\tPasskeyRegistrationOptions,\n\tPasskey\n} from '$lib/types/auth';\nimport { IS_NATIVE, PLATFORM } from '$lib/config/platform';\nimport { browser } from '$app/environment';\nimport { setContext, getContext } from 'svelte';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Auth.svelte.ts","text":"import type {\n\tAuthToken,\n\tUser,\n\tLoginRequest,\n\tLoginResponse,\n\tRegisterRequest,\n\tVerifyRequest,\n\tAuthActionResponse,\n\tVerifyActionResponse,\n\tPasskeyActionResponse,\n\tPasskeyAuthenticationOptions,\n\tPasskeyRegistrationOptions,\n\tPasskey\n} from '$lib/types/auth';\nimport { IS_NATIVE, PLATFORM } from '$lib/config/platform';\nimport { browser } from '$app/environment';\nimport { setContext, getContext } from 'svelte';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport ApiService from '$lib/services/ApiService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { SvelteDate, SvelteMap } from 'svelte/reactivity';\nimport {\n\tformatDate,\n\tformatDateTime,\n\tformatDateWithoutYear,\n\tformatDateWithWeekday,\n\tformatTime,\n\tformatTimeWithSeconds\n} from '$lib/helpers/DateHelper';\n\n// How often a visible, permanently-open app re-validates its session.\nconst SESSION_CHECK_INTERVAL_MS = 60 * 60 * 1000;\n\nexport class Auth {\n\tstatic readonly LS_AUTH_KEY: string = 'auth';\n\n\tloggedIn = $state<boolean>(false);\n\tauthToken = $state<AuthToken | null>(null);\n\tuser = $state<User | null>(null);\n\tapiService: ApiService;\n\tlocalStorage = new LocalStorageService();\n\tprofileCache = new SvelteMap<string, User>();\n\tprivate refreshInFlight: Promise<boolean> | null = null;\n\tprivate recoveryInFlight: Promise<boolean> | null = null;\n\tprivate sessionCheckInterval: ReturnType<typeof setInterval> | null = null;\n\tprivate visibilityHandler: (() => void) | null = null;\n\tprivate onlineHandler: (() => void) | null = null;\n\n\tconstructor() {\n\t\tthis.apiService = new ApiService(null);\n\t\t// ApiService asks back here when any request hits a 401; the handler\n\t\t// adopts another tab's token or refreshes this session, last resort logout.\n\t\tthis.apiService.setUnauthorizedHandler(() => this.recoverFromUnauthorized());\n\t\tthis.load().then();\n\t\tthis.startSessionMonitor();\n\t}\n\n\tprivate async load(): Promise<void> {\n\t\tconst savedAuth = this.localStorage.getJson(Auth.LS_AUTH_KEY);\n\n\t\tif (!savedAuth) return;\n\n\t\tconst { user, authToken } = savedAuth as { user: User; authToken: AuthToken }\n\n\t\tif (!authToken || !user) return;\n\n\t\tconst expiresAt = new SvelteDate(authToken.expires_at).getTime();\n\n\t\tif (expiresAt > Date.now()) {\n\t\t\tthis.user = user;\n\t\t\tthis.authToken = authToken;\n\t\t\tthis.apiService.updateAuthToken(this.getToken()!);\n\t\t\tthis.loggedIn = true;\n\n\t\t\tif (this.shouldRefresh(expiresAt)) {\n\t\t\t\tawait this.refresh();\n\t\t\t}\n\n\t\t\tawait this.loadAdditionalData();\n\n\t\t\tthis.save();\n\t\t} else {\n\t\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n\t\t}\n\t}\n\n\tpublic async loadAdditionalData(): Promise<void> {\n\t\tif (!this.user) return;\n\t\tconst res = await this.apiService.get(apiRoutes.users.get, null);\n\t\tif (res) this.user = res.data as User;\n\t\tthis.save();\n\t}\n\n\tpublic save(): void {\n\t\tthis.localStorage.setJson(Auth.LS_AUTH_KEY, {\n\t\t\tuser: this.user,\n\t\t\tauthToken: this.authToken\n\t\t});\n\t}\n\n\tprivate clear(): void {\n\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n\t\tthis.user = null;\n\t\tthis.authToken = null;\n\t\tthis.loggedIn = false;\n\t\t// Every store shares this ApiService instance, so clearing it here makes\n\t\t// sure no request keeps sending the revoked token.\n\t\tthis.apiService.updateAuthToken(null);\n\t}\n\n\tasync login(email: string, password: string): Promise<boolean> {\n\t\tconst request: LoginRequest = { email, password, platform: PLATFORM };\n\t\tconst res = await this.apiService.post(apiRoutes.auth.login, request);\n\n\t\tif (!res) return Promise.resolve(false);\n\t\tconst login = res.data as LoginResponse;\n\n\t\tthis.user = login.user;\n\t\tthis.authToken = {\n\t\t\ttoken: login.token,\n\t\t\ttoken_type: login.token_type,\n\t\t\texpires_at: login.token_expires_at\n\t\t};\n\t\tthis.loggedIn = true;\n\t\tthis.apiService.updateAuthToken(this.getToken()!);\n\n\t\tthis.save();\n\t\tawait this.loadAdditionalData();\n\n\t\treturn Promise.resolve(true);\n\t}\n\n\tprivate shouldRefresh(expiresAt: number): boolean {\n\t\tconst thresholdDays = IS_NATIVE ? 14 : 5;\n\t\treturn expiresAt < Date.now() + thresholdDays * 24 * 60 * 60 * 1000;\n\t}\n\n\tasync refresh(): Promise<boolean> {\n\t\t// Single-flight: concurrent 401 recoveries and the resume check share one\n\t\t// refresh request instead of racing each other with the same token.\n\t\tif (this.refreshInFlight) return this.refreshInFlight;\n\n\t\tthis.refreshInFlight = this.performRefresh().finally(()