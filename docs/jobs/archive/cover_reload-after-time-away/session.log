{"type":"tool_use","timestamp":1791393859781,"sessionID":"ses_ee89c2ab9ffergyxR5ZG3Tj4o0","part":{"type":"tool","tool":"read","callID":"call_00_wHBdymG5WLLQxsQZMJxC8663","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/QuickAdd.test.ts"},"output":"<path>/workspace/tests/unit/stores/QuickAdd.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { QuickAdd } from '$lib/state/QuickAdd.svelte';\n3: import { api, resetStoreMocks } from '../setup/storeMocks';\n4: \n5: // QuickAdd reads getTranslation() and getUiNotifications() at field\n6: // initialisation; the storeMocks setup does not cover those modules, so they\n7: // are stubbed per file.\n8: const notifications = { error: vi.fn(), success: vi.fn() };\n9: const ts = {\n10: \tget: {\n11: \t\tquick_add: {\n12: \t\t\tdetect_error: 'Failed to detect content type.',\n13: \t\t\tcommit_error: \"Couldn't add this. Try again.\",\n14: \t\t\tcommit_success: 'Added to %s.',\n15: \t\t\tdestinations: {\n16: \t\t\t\tmusic: 'your music library',\n17: \t\t\t\tbooks: 'your book library',\n18: \t\t\t\tmovies: 'your movie library',\n19: \t\t\t\tgames: 'your game library',\n20: \t\t\t\tlinks: 'your links',\n21: \t\t\t\trecipes: 'your recipe library',\n22: \t\t\t\tplants: 'your plant library',\n23: \t\t\t\tquotes: 'your quote library',\n24: \t\t\t\ttodo: 'your todos',\n25: \t\t\t\tnote: 'your notes',\n26: \t\t\t\tfeed: 'your feeds',\n27: \t\t\t\tclipboard: 'your clipboard'\n28: \t\t\t}\n29: \t\t}\n30: \t}\n31: };\n32: \n33: vi.mock('$lib/state/Translation.svelte', () => ({\n34: \tgetTranslation: () => ts\n35: }));\n36: \n37: vi.mock('$lib/state/UiNotifications.svelte', () => ({\n38: \tgetUiNotifications: () => notifications\n39: }));\n40: \n41: beforeEach(() => {\n42: \tresetStoreMocks();\n43: \tnotifications.error.mockClear();\n44: \tnotifications.success.mockClear();\n45: });\n46: \n47: afterEach(() => {\n48: \tvi.restoreAllMocks();\n49: });\n50: \n51: describe('QuickAdd store', () => {\n52: \tdescribe('isUrl', () => {\n53: \t\tit('detects valid urls', () => {\n54: \t\t\tconst s = new QuickAdd();\n55: \t\t\ts.content = 'https://example.com/article';\n56: \t\t\texpect(s.isUrl).toBe(true);\n57: \t\t});\n58: \n59: \t\tit('rejects plain text', () => {\n60: \t\t\tconst s = new QuickAdd();\n61: \t\t\ts.content = 'just some text';\n62: \t\t\texpect(s.isUrl).toBe(false);\n63: \t\t});\n64: \n65: \t\tit('rejects empty content', () => {\n66: \t\t\tconst s = new QuickAdd();\n67: \t\t\texpect(s.isUrl).toBe(false);\n68: \t\t});\n69: \t});\n70: \n71: \tdescribe('modal state', () => {\n72: \t\tit('openModal resets and opens', () => {\n73: \t\t\tconst s = new QuickAdd();\n74: \t\t\ts.content = 'leftover';\n75: \t\t\ts.error = 'boom';\n76: \t\t\ts.openModal();\n77: \t\t\texpect(s.open).toBe(true);\n78: \t\t\texpect(s.content).toBe('');\n79: \t\t\texpect(s.error).toBeNull();\n80: \t\t});\n81: \n82: \t\tit('closeModal closes and resets', () => {\n83: \t\t\tconst s = new QuickAdd();\n84: \t\t\ts.openModal();\n85: \t\t\ts.content = 'x';\n86: \t\t\ts.closeModal();\n87: \t\t\texpect(s.open).toBe(false);\n88: \t\t\texpect(s.content).toBe('');\n89: \t\t});\n90: \t});\n91: \n92: \tdescribe('detect', () => {\n93: \t\tit('ignores empty content', async () => {\n94: \t\t\tconst s = new QuickAdd();\n95: \t\t\tawait s.detect();\n96: \t\t\texpect(api.create).not.toHaveBeenCalled();\n97: \t\t});\n98: \n99: \t\tit('reports the error state and a notification on failure', async () => {\n100: \t\t\tapi.create.mockResolvedValue(null);\n101: \t\t\tconst s = new QuickAdd();\n102: \t\t\ts.content = 'https://example.com';\n103: \t\t\tawait s.detect();\n104: \t\t\texpect(s.error).toBe('Failed to detect content type.');\n105: \t\t\texpect(notifications.error).toHaveBeenCalledWith('Failed to detect content type.');\n106: \t\t});\n107: \n108: \t\tit('stores the detection and waits for confirmation when needed', async () => {\n109: \t\t\tapi.create.mockResolvedValue({\n110: \t\t\t\tdata: {\n111: \t\t\t\t\turl: 'https://example.com',\n112: \t\t\t\t\tcontent_type: 'links',\n113: \t\t\t\t\tconfidence: 0.9,\n114: \t\t\t\t\tneeds_confirmation: true,\n115: \t\t\t\t\tmetadata: { title: 'Example' }\n116: \t\t\t\t}\n117: \t\t\t});\n118: \t\t\tconst s = new QuickAdd();\n119: \t\t\ts.content = 'https://example.com';\n120: \t\t\tawait s.detect();\n121: \t\t\texpect(s.detectedType).toBe('links');\n122: \t\t\texpect(s.confidence).toBe(0.9);\n123: \t\t\texpect(s.metadata).toEqual({ title: 'Example' });\n124: \t\t\texpect(s.needsConfirmation).toBe(true);\n125: \t\t\texpect(s.loading).toBe(false);\n126: \t\t\t// no commit call while waiting for confirmation\n127: \t\t\texpect(api.create).toHaveBeenCalledTimes(1);\n128: \t\t});\n129: \n130: \t\tit('auto-commits when no confirmation is needed', async () => {\n131: \t\t\tapi.create\n132: \t\t\t\t.mockResolvedValueOnce({\n133: \t\t\t\t\tdata: {\n134: \t\t\t\t\t\turl: 'https://example.com',\n135: \t\t\t\t\t\tcontent_type: 'todo',\n136: \t\t\t\t\t\tconfidence: 0.8,\n137: \t\t\t\t\t\tneeds_confirmation: false,\n138: \t\t\t\t\t\tmetadata: null\n139: \t\t\t\t\t}\n140: \t\t\t\t})\n141: \t\t\t\t.mockResolvedValueOnce({ data: null });\n142: \n143: \t\t\tconst s = new QuickAdd();\n144: \t\t\ts.content = 'Buy milk';\n145: \t\t\tawait s.detect();\n146: \n147: \t\t\texpect(api.create).toHaveBeenCalledTimes(2);\n148: \t\t\texpect(s.open).toBe(false);\n149: \t\t\texpect(notifications.success).toHaveBeenCalledWith('Added to your todos.');\n150: \t\t});\n151: \t});\n152: \n153: \tdescribe('confirm', () => {\n154: \t\tit('commits with the given type and shows the success notification', async () => {\n155: \t\t\tapi.create.mockResolvedValue({ data: null });\n156: \t\t\tconst s = new QuickAdd();\n157: \t\t\ts.content = 'https://example.com/song';\n158: \t\t\ts.metadata = { artist: 'X' };\n159: \t\t\tawait s.confirm('music');\n160: \t\t\texpect(api.create).toHaveBeenCalledWith(\n161: \t