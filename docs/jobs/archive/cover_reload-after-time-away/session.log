ion_expired: 'Your session expired. Please sign in again.'\n\n  Line 381: \tcreate_error: 'Failed to create note.',\n\n  Line 382: \tcreate_folder_error: 'Failed to create folder.',\n\n  Line 448: \t\tcreate_error: 'Failed to create album.',\n\n  Line 473: \t\tcreate_error: 'Failed to create book.',\n\n  Line 494: \t\tcreate_error: 'Failed to create movie.',\n\n  Line 537: \t\tcreate_error: 'Failed to create link'\n\n  Line 546: \t\tcreate_error: 'Failed to create quote.',\n\n  Line 578: \t\tcreate_error: 'Failed to create recipe.',\n\n  Line 787: \tentry_create_error: 'Entry could not be created. Please check your input.',\n\n\n/workspace/src/lib/i18n/fr.ts:\n  Line 127: \tsession_expired: 'Votre session a expiré. Veuillez vous reconnecter.'\n\n  Line 380: \tcreate_error: 'Échec de la création de la note.',\n\n  Line 381: \tcreate_folder_error: 'Échec de la création du dossier.',\n\n  Line 447: \t\tcreate_error: 'Impossible de créer l\\'album.',\n\n  Line 472: \t\tcreate_error: 'Impossible de créer le livre.',\n\n  Line 493: \t\tcreate_error: 'Impossible de créer le film.',\n\n  Line 536: \t\tcreate_error: 'Impossible de créer le lien'\n\n  Line 545: \t\tcreate_error: 'Impossible de créer la citation.',\n\n  Line 577: \t\tcreate_error: 'Impossible de créer la recette.',\n\n  Line 786: \tentry_create_error: 'Impossible de créer l\\'événement. Vérifiez votre saisie.',\n\n\n/workspace/src/lib/i18n/de.ts:\n  Line 128: \tsession_expired: 'Deine Sitzung ist abgelaufen. Bitte melde dich erneut an.'\n\n  Line 382: \tcreate_error: 'Notiz konnte nicht erstellt werden.',\n\n  Line 383: \tcreate_folder_error: 'Ordner konnte nicht erstellt werden.',\n\n  Line 449: \t\tcreate_error: 'Album konnte nicht erstellt werden.',\n\n  Line 474: \t\tcreate_error: 'Buch konnte nicht erstellt werden.',\n\n  Line 495: \t\tcreate_error: 'Film konnte nicht erstellt werden.',\n\n  Line 538: \t\tcreate_error: 'Link konnte nicht erstellt werden'\n\n  Line 547: \t\tcreate_error: 'Zitat konnte nich