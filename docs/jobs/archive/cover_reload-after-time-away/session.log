cation/json' };\n\t\t}\n\n\t\treturn { Authorization: 'Bearer ' + this.authToken, Accept: 'application/json' };\n\t}\n\n\tprivate getApiHeaderWithBody(): HeadersInit {\n\t\tif (!this.authToken) {\n\t\t\treturn { 'Content-Type': 'application/json', Accept: 'application/json' };\n\t\t}\n\n\t\treturn {\n\t\t\tAuthorization: 'Bearer ' + this.authToken,\n\t\t\t'Content-Type': 'application/json',\n\t\t\tAccept: 'application/json'\n\t\t};\n\t}\n}","lineStart":1,"lineEnd":201,"totalLines":201,"truncated":false}},"title":"src/lib/services/ApiService.ts","time":{"start":1791402447518,"end":1791402447545}},"id":"prt_117e8128a001ydVvyevMv7mzSE","sessionID":"ses_ee8182b24ffeyiqdx3gF4WVL5T","messageID":"msg_117e7ff190019v4rJpiH7oT9K7"}}
