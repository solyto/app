leCollapseCategory(this.createParent);\n221: \t\t}\n222: \n223: \t\tthis.inputValue = '';\n224: \t\tthis.createParent = null;\n225: \t\tthis.rightClickMenuOpen = false;\n226: \n227: \t\tawait this.load();\n228: \t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n229: \t\tawait goto(resolve(urls.note, { id: note.id }));\n230: \n231: \t\treturn note;\n232: \t}\n233: \n234: \tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n235: \t\tif (this.inputValue === '') {\n236: \t\t\treturn null;\n237: \t\t}\n238: \n239: \t\tlet res;\n240: \n241: \t\tif (edit && this.rightClickId) {\n242: \t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n243: \t\t\tres = await this.apiService.update(\n244: \t\t\t\tapiRoutes.notes.updateCategory,\n245: \t\t\t\tthis.rightClickId,\n246: \t\t\t\trequest\n247: \t\t\t);\n248: \t\t} else {\n249: \t\t\tconst request: CreateNoteCategoryRequest =\n250: \t\t\t\tthis.createParent !== null\n251: \t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n252: \t\t\t\t\t: { title: this.inputValue };\n253: \t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n254: \t\t}\n255: \n256: \t\tif (res) await this.loadCategories();\n257: \n258: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n259: \t\t\tthis.toggleCollapseCategory(this.createParent);\n260: \t\t}\n261: \n262: \t\tthis.inputValue = '';\n263: \t\tthis.createParent = null;\n264: \t\tthis.rightClickMenuOpen = false;\n265: \n266: \t\treturn res && typeof res === 'object' ? (res.data as NoteCategory) : null;\n267: \t}\n268: \n269: \tasync saveContent(): Promise<boolean> {\n270: \t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n271: \t\tconst ok = await this.apiService.update(\n272: \t\t\tapiRoutes.notes.update,\n273: \t\t\tthis.activeNote!.id,\n274: \t\t\trequest\n275: \t\t);\n276: \t\tif (ok) await this.load();\n277: \t\tretur