{"type":"tool_use","timestamp":1791394278601,"sessionID":"ses_ee89c2ab9ffergyxR5ZG3Tj4o0","part":{"type":"tool","tool":"read","callID":"call_00_fq6PUCq3Pl0cbY7znopC7965","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/helpers/NavHelper.ts"},"output":"<path>/workspace/src/lib/helpers/NavHelper.ts</path>\n<type>file</type>\n<content>\n1: import { page } from '$app/state';\n2: import { navItems, type FeatureType } from '$lib/config/navigation';\n3: import { urls } from '$lib/config/urls';\n4: \n5: export function getPageSlug(): string {\n6: \treturn page.url.pathname.substring(1).split('/')[0] || 'home';\n7: }\n8: \n9: export function getPageFeature(): FeatureType | null {\n10: \treturn navItems[getPageSlug()]?.featureFlag ?? null;\n11: }\n12: \n13: export function showNavbar(): boolean {\n14: \treturn !isAuthRoute() && !isAdminRoute() && !isSetupRoute();\n15: }\n16: \n17: export function isDashboard(): boolean {\n18: \treturn page.url.pathname === urls.home;\n19: }\n20: \n21: export function isAdminRoute(): boolean {\n22: \treturn page.url.pathname.startsWith('/admin');\n23: }\n24: \n25: export function isAuthRoute(): boolean {\n26: \treturn page.url.pathname.startsWith('/auth');\n27: }\n28: \n29: export function isSetupRoute(): boolean {\n30: \treturn page.url.pathname.startsWith('/setup');\n31: }\n\n(End of file - total 31 lines)\n</content>","metadata":{"preview":"import { page } from '$app/state';\nimport { navItems, type FeatureType } from '$lib/config/navigation';\nimport { urls } from '$lib/config/urls';\n\nexport function getPageSlug(): string {\n\treturn page.url.pathname.substring(1).split('/')[0] || 'home';\n}\n\nexport function getPageFeature(): FeatureType | null {\n\treturn navItems[getPageSlug()]?.featureFlag ?? null;\n}\n\nexport function showNavbar(): boolean {\n\treturn !isAuthRoute() && !isAdminRoute() && !isSetupRoute();\n}\n\nexport function isDashboard(): boolean {\n\treturn page.url.pathname === urls.home;\n}\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/helpers/NavHelper.ts","text":"import { page } from '$app/state';\nimport { navItems, type FeatureType } from '$lib/config/navigation';\nimport { urls } from '$lib/config/urls';\n\nexport function getPageSlug(): string {\n\treturn page.url.pathname.substring(1).split('/')[0] || 'home';\n}\n\nexport function getPageFeature(): FeatureType | null {\n\treturn navItems[getPageSlug()]?.featureFlag ?? null;\n}\n\nexport function showNavbar(): boolean {\n\treturn !isAuthRoute() && !isAdminRoute() && !isSetupRoute();\n}\n\nexport function isDashboard(): boolean {\n\treturn page.url.pathname === urls.home;\n}\n\nexport function isAdminRoute(): boolean {\n\treturn page.url.pathname.startsWith('/admin');\n}\n\nexport function isAuthRoute(): boolean {\n\treturn page.url.pathname.startsWith('/auth');\n}\n\nexport function isSetupRoute(): boolean {\n\treturn page.url.pathname.startsWith('/setup');\n}","lineStart":1,"lineEnd":31,"totalLines":31,"truncated":false}},"title":"src/lib/helpers/NavHelper.ts","time":{"start":1791394278565,"end":1791394278597}},"id":"prt_1176b6c72001JWRV2NIPPSvFIn","sessionID":"ses_ee89c2ab9ffergyxR5ZG3Tj4o0","messageID":"msg_1176b5394001ghZFPOpDJnOidZ"}}
