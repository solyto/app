Id) {\n336: \t\t\t\tawait goto(resolve(urls.notes));\n337: \t\t\t}\n338: \n339: \t\t\tawait this.load();\n340: \t\t\tthis.closeRightClickMenu();\n341: \t\t}\n342: \t\treturn ok;\n343: \t}\n344: \n345: \tasync deleteActiveNote(): Promise<boolean> {\n346: \t\tif (!this.activeNote) return false;\n347: \n348: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n349: \t\tif (ok) {\n350: \t\t\tawait goto(resolve(urls.notes));\n351: \t\t\tawait this.load();\n352: \t\t}\n353: \t\treturn ok;\n354: \t}\n355: \n356: \tasync deleteCategory(): Promise<boolean> {\n357: \t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n358: \t\t\treturn false;\n359: \t\t}\n360: \n361: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n362: \t\tif (ok) await this.loadCategories();\n363: \t\tthis.closeRightClickMenu();\n364: \t\treturn ok;\n365: \t}\n366: \n367: \tasync importFile(file: File): Promise<boolean> {\n368: \t\tconst formData = new FormData();\n369: \t\tformData.append('file', file);\n370: \t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n371: \n372: \t\tif (ok) {\n373: \t\t\tawait this.load();\n374: \t\t\treturn true;\n375: \t\t}\n376: \n377: \t\treturn false;\n378: \t}\n379: }\n380: \n381: const NOTES_KEY = Symbol('SOLYTO_NOTES');\n382: \n383: export function setNotes(): NotesSvelte {\n384: \treturn setContext(NOTES_KEY, new NotesSvelte());\n385: }\n386: \n387: export function getNotes(): NotesSvelte {\n388: \treturn getContext<NotesSvelte>(NOTES_KEY);\n389: }\n\n(End of file - total 389 lines)\n</content>","metadata":{"preview":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { page } from '$app/state';\nimport