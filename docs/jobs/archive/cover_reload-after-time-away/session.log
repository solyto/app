etry. Retry once with a cache-buster, then fall back to the initial\n\t// letter instead of showing a broken image.\n\tlet attempts = $state(0);\n\tlet failed = $state(false);\n\n\tconst imagePath = $derived(auth.user?.profile?.profile_image_path ?? null);\n\tconst imageSrc = $derived(\n\t\timagePath\n\t\t\t? `${API_USER_STORAGE_URL}/${imagePath}${attempts ? `?retry=${attempts}` : ''}`\n\t\t\t: null\n\t);\n\n\t$effect(() => {\n\t\tif (imagePath !== null) {\n\t\t\tattempts = 0;\n\t\t\tfailed = false;\n\t\t}\n\t});\n\n\tfunction handleError() {\n\t\tif (attempts === 0) {\n\t\t\tattempts = 1;\n\t\t\treturn;\n\t\t}\n\t\tfailed = true;\n\t}\n</script>\n\n<NavEntry\n\tslug=\"profile\"\n\thref={urls.profile}\n\ttitle={ts.get.nav.profile}\n\t{active}\n\t{mobile}\n\t{onSelect}\n>\n\t<div class=\"flex size-10 items-center justify-center rounded-full bg-c-neutral-2 text-black\">\n\t\t{#if imageSrc && !failed}\n\t\t\t<img\n\t\t\t\tsrc={imageSrc}\n\t\t\t\talt=\"Profile\"\n\t\t\t\tclass=\"h-full w-full rounded-full object-cover\"\n\t\t\t\tonerror={handleError}\n\t\t\t/>\n\t\t{:else}\n\t\t\t{auth.user?.name?.[0]?.toUpperCase()}\n\t\t{/if}\n\t</div>\n</NavEntry>","lineStart":1,"lineEnd":71,"totalLines":71,"truncated":false}},"title":"src/lib/components/ui/NavProfileEntry.svelte","time":{"start":1791395353114,"end":1791395353141}},"id":"prt_1177bd1d4001ifWA4QZhRIe3jt","sessionID":"ses_ee88730eeffeRJKdaZ6r4Ci5uf","messageID":"msg_1177ba492001UMi7OeCfJflVxR"}}
