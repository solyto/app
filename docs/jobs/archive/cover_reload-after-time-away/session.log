((authEndpoint) => endpoint.startsWith(authEndpoint));\n40: \t}\n41: \n42: \t// Runs a request; on a 401 from a non-auth endpoint asks the session owner\n43: \t// to recover and, if it did, retries the same request exactly once with the\n44: \t// current token. Network errors (a rejected fetch) propagate untouched — they\n45: \t// are transient and must never trigger recovery/logout.\n46: \tprivate async fetchWithRecovery(endpoint: string, init: RequestInit): Promise<Response> {\n47: \t\tconst res = await fetch(endpoint, init);\n48: \n49: \t\tif (res.status !== 401 || !this.unauthorizedHandler || this.isAuthEndpoint(endpoint)) {\n50: \t\t\treturn res;\n51: \t\t}\n52: \n53: \t\tconst recovered = await this.unauthorizedHandler();\n54: \t\tif (!recovered) return res;\n55: \n56: \t\tconst headers = { ...(init.headers as Record<string, string>) };\n57: \t\tif (this.authToken) {\n58: \t\t\theaders['Authorization'] = 'Bearer ' + this.authToken;\n59: \t\t} else {\n60: \t\t\tdelete headers['Authorization'];\n61: \t\t}\n62: \n63: \t\treturn fetch(endpoint, { ...init, headers });\n64: \t}\n65: \n66: \tasync list(endpoint: string): Promise<ListResponse | null> {\n67: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n68: \t\treturn res.ok ? await res.json() : null;\n69: \t}\n70: \n71: \tasync get(endpoint: string, id: string | number | null): Promise<GetResponse | null> {\n72: \t\tif (typeof id === 'string') {\n73: \t\t\tendpoint = endpoint.replace('%s', id);\n74: \t\t} else if (typeof id === 'number') {\n75: \t\t\tendpoint = endpoint.replace('%d', id.toString());\n76: \t\t}\n77: \n78: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n79: \t\treturn res.ok ? await res.json() : null;\n80: \t}\n81: \n82: \tasync create(endpoint: string, body: object): Promise<CreateResponse | null> {\n83: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n84: \t\t\tmethod: 'POST',\n85: \t\t\theaders: this.getA