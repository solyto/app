{ profile_image_path: null },\n58: \t\tsettings: {\n59: \t\t\tlanguage: 'en',\n60: \t\t\ttimezone: 'UTC',\n61: \t\t\tdate_format: 'dd.mm.YYYY',\n62: \t\t\ttime_format: 'H:i',\n63: \t\t\twidgets: '',\n64: \t\t\tai_enabled: false,\n65: \t\t\tnavigation: '',\n66: \t\t\topenai_api_key: null,\n67: \t\t\tfirst_visit: true,\n68: \t\t\ttemperature_unit: 'c'\n69: \t\t},\n70: \t\tcreated_at: '2026-01-01T00:00:00',\n71: \t\tupdated_at: '2026-01-01T00:00:00',\n72: \t\tadditional_info_last_updated_at: '2026-01-01T00:00:00',\n73: \t\t...overrides\n74: \t};\n75: }\n76: \n77: function authToken(expiresAt: string, token = 'token-1'): AuthToken {\n78: \treturn { token, token_type: 'bearer', expires_at: expiresAt };\n79: }\n80: \n81: function loginResponse(overrides: Partial<LoginResponse> = {}): LoginResponse {\n82: \treturn {\n83: \t\ttoken: 'fresh-token',\n84: \t\ttoken_type: 'bearer',\n85: \t\ttoken_expires_at: new Date(Date.now() + 10 * 24 * 3600 * 1000).toISOString(),\n86: \t\tuser: user(),\n87: \t\t...overrides\n88: \t};\n89: }\n90: \n91: /** Flushes the fire-and-forget constructor load() chain (microtasks only). */\n92: async function flushAsync(): Promise<void> {\n93: \tfor (let i = 0; i < 10; i++) {\n94: \t\tawait Promise.resolve();\n95: \t}\n96: }\n97: \n98: beforeEach(() => {\n99: \tvi.clearAllMocks();\n100: \tstorage.getJson.mockReturnValue(null);\n101: \tstorage.destroy.mockReturnValue(undefined);\n102: \tapi.post.mockResolvedValue(null);\n103: \tapi.postRaw.mockResolvedValue(null);\n104: \tapi.get.mockResolvedValue(null);\n105: \tapi.put.mockResolvedValue(null);\n106: \tapi.update.mockResolvedValue(null);\n107: \tapi.delete.mockResolvedValue(null);\n108: });\n109: \n110: afterEach(() => {\n111: \tvi.restoreAllMocks();\n112: });\n113: \n114: describe('Auth store', () => {\n115: \tit('starts logged out when nothing is stored', async () => {\n116: \t\tconst auth = new Auth();\n117: \t\tawait flushAsync();\n118: \t\texpect(auth.loggedIn).toBe(false);\n119: \t\texpect(auth.user).toBeNull();\n120: \t\texpect(auth.getToken()).toBeNull();\n121: \t\texpect(storage.getJson).toHaveBeenCalledWith('auth');\n122: \t});\n123: \n124: \tit('constructs its ApiService without a token', () => {\n125: \t\tnew Auth();\n126: \t\texpect(api.updateAuthToken).not.toHaveBeenCalled();\n127: \t});\n128: \n129: \tdescribe('load from localStorage', () => {\n130: \t\tit('restores a valid session that does not need refreshing', async () => {\n131: \t\t\tconst expiresAt = new Date(Date.now() + 6 * 24 * 3600 * 1000).toISOString();\n132: \t\t\tstorage.getJson.mockReturnValue({ user: user(), authToken: authToken(expiresAt) });\n133: \t\t\tapi.get.mockResolvedValue({ data: user({ name: 'Refreshed Name' }) });\n134: \n135: \t\t\tconst auth = new Auth();\n136: \t\t\tawait flushAsync();\n137: \n138: \t\t\texpect(auth.loggedIn).toBe(true);\n139: \t\t\texpect(auth.getToken()).toBe('token-1');\n140: \t\t\texpect(auth.user?.name).toBe('Refreshed Name');\n141: \t\t\t// token was pushed into the ApiService\n142: \t\t\texpect(api.updateAuthToken).toHaveBeenCalledWith('token-1');\n143: \t\t\t// not within the 5-day refresh threshold\n144: \t\t\texpect(api.post).not.toHaveBeenCalled();\n145: \t\t\t// session was persisted again after the additional data load\n146: \t\t\texpect(storage.setJson).toHaveBeenCalledWith('auth', expect.objectContaining({}));\n147: \t\t});\n148: \n149: \t\tit('refreshes when the token expires within the 5-day threshold', async () => {\n150: \t\t\tconst expiresAt = new Date(Date.now() + 1 * 24 * 3600 * 1000).toISOString();\n151: \t\t\tstorage.getJson.mockReturnValue({ user: user(), authToken: authToken(expiresAt) });\n152: \t\t\tapi.post.mockResolvedValue({ data: loginResponse({ token: 'refreshed-token' }) });\n153: \n154: \t\t\tconst auth = new Auth();\n155: \t\t\tawait flushAsync();\n156: \n157: \t\t\texpect(api.post).toHaveBeenCalledWith(expect.stringContaining('/refresh'), {});\n158: \t\t\texpect(auth.getToken()).toBe('refreshed-token');\n159: \t\t\te