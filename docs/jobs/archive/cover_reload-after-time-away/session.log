e()}\n\t\t<CookieBanner />\n\t{/if}\n\t{#if showNavbar() && isDashboard()}\n\t\t<QuickAddFab />\n\t\t{#if quickAdd.open}\n\t\t\t<QuickAddModal />\n\t\t{/if}\n\t{/if}\n</div>\n\n<!-- italic text-orange-500 text-green-300 c-warning bg-gradient-to-r from-c-success via-c-btn via-c-danger-hover via-c-action to-c-warning text-c-success text-c-btn-hover text-c-danger -->\n\n<svelte:window\n\tbind:innerHeight\n\tonkeydown={(e) => keyManager.handleKeyDown(e)}\n\tonkeyup={(e) => keyManager.handleKeyUp(e)}\n/>","lineStart":1,"lineEnd":140,"totalLines":140,"truncated":false}},"title":"src/routes/+layout.svelte","time":{"start":1791377297027,"end":1791377297235}},"id":"prt_116684e3c001cxmML19G6N4Stq","sessionID":"ses_ee997eadcffer0klLXJV279zqa","messageID":"msg_116684526001xaNqvke3RTxDDx"}}
{"type":"tool_use","timestamp":1791377297346,"sessionID":"ses_ee997eadcffer0klLXJV279zqa","part":{"type":"tool","tool":"read","callID":"call_02_Sq8ftaynmzZobd6m0Fey6045","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Notes.svelte.ts"},"output":"<path>/workspace/src/lib/state/Notes.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tCreateNoteCategoryRequest,\n3: \tCreateNoteRequest,\n4: \tNote,\n5: \tNoteCategory,\n6: \tUpdateNoteCategoryRequest,\n7: \tUpdateNoteRequest\n8: } from '$lib/types/note';\n9: import { setContext, getContext, tick } from 'svelte';\n10: import { getAuth } from '$lib/state/Auth.svelte';\n11: import { page } from '$app/state';\n12: import { goto } from '$app/navigation';\n13: import { urls } from '$lib/config/urls';\n14: import { resolve } from '$app/paths';\n15: import ApiService from '$lib/services/ApiService';\n16: import LocalStorageService from '$lib/services/LocalStorageService';\n17: import { apiRoutes } from '$lib/config/apiRoutes';\n18: import { SvelteDate } from 'svelte/reactivity';\n19: \n20: export class NotesSvelte {\n21: \tstatic readonly LS_COLLAPSED_CATEGORIES_KEY: string = 'notes.collapsedCategories';\n22: \n23: \tloaded = $state<boolean>(false);\n24: \tnotes = $state<Note[]>([]);\n25: \tnewestNotes = $state<Note[]>([]);\n26: \tlastUpdatedNotes = $state<Note[]>([]);\n27: \tfavoriteNotes = $state<Note[]>([]);\n28: \tcategories = $state<NoteCategory[]>([]);\n29: \tcollapsedCategories = $state<number[]>([]);\n30: \tactiveNote = $state<Note | null>(null);\n31: \tmodalOpen = $state<boolean>(false);\n32: \tcreateType = $state<'note' | 'category'>('note');\n33: \tcreateParent = $state<number | null>(null);\n34: \trightClickMenuOpen = $state<boolean>(false);\n35: \trightClickMenuX = $state<number>(0);\n36: \trightClickMenuY = $state<number>(0);\n37: \trightClickType = $state<'note' | 'category'>('note');\n38: \trightClickId = $state<number | string | null>(null);\n39: \tdraggedNote = $state<Note | null>(null);\n40: \tdragTarget = $state<NoteCategory | null>(null);\n41: \tinput = $state<HTMLInputElement | null>(null);\n42: \tinputValue = $state<string>('');\n43: \tauth = getAuth();\n44: \tapiService: ApiService;\n45: \tlocalStorage = new LocalStorageService();\n46: \n47: \tconstructor() {\n48: \t\tthis.apiService = new ApiService(this.auth.getToken());\n49: \t\tthis.loadCollapsedCategories();\n50: \t}\n51: \n52: \tasync load(): Promise<void> {\n53: \t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n54: \t\tif (res) {\n55: \t\t\tthis.loaded = true;\n56: \t\t\tthis.notes = res.data as Note[];\n57: \t\t\tthis.newestNotes = this.getNewestNotes();\n58: \t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n59: \t\t\tthis.favoriteNotes = this.getFavorites();\n60: \t\t\tthis.checkUrlForActiveNote();\n61: \t\t}\n62: \t}\n63: \n64: \tloadCollapsedCategories(): void {\n65: \t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n66: \t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n67: \t}\n68: \n69: \tsaveCollapsedCategories(): void {\n70: \t\tthis.localStorage.setJson(\n71: \t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n72: \t\t\tthis.collapsedCategories\n73: \t\t);\n74: \t}\n75: \n76: \tcheckUrlForActiveNote(): void {\n77: \t\tif (page.params.id) {\n78: \t\t\tthis.selectNote(page.params.id);\n79: \t\t}\n80: \t}\n81: \n82: \tasync loadCategories(): Promise<void> {\n83: \t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n84: \t\tif (res) this.categories = res.data as NoteCategory[];\n85: \t}\n86: \n87: \ttoggleCollapseCategory(categoryId: number): void {\n88: \t\tif (this.collapsedCategories.includes(categoryId)) {\n89: \t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n90: \t\t} else {\n91: \t\t\tthis.collapsedCategories.push(categoryId);\n92: \t\t}\n93: \n94: \t\tthis.saveCollapsedCategories();\n95: \t}\n96: \n97: \tisCategoryCollapsed(categoryId: number): boolean {\n98: \t\treturn this.collapsedCategories.includes(categoryId);\n99: \t}\n100: \n101: \tgetNotesForCategory(categoryId: number | null): Note[] {\n102: \t\treturn this.notes.filter((n) => n.category_id === categoryId);\n103: \t}\n104: \n105: \tgetCategoryTitle(categoryId: number): string {\n106: \t\tfor (const cat of this.categories) {\n107: \t\t\tif (cat.id === categoryId) return cat.title;\n108: \t\t\tif (cat.children) {\n109: \t\t\t\tfor (const child of cat.children) {\n110: \t\t\t\t\tif (child.id === categoryId) return child.title;\n111: \t\t\t\t}\n112: \t\t\t}\n113: \t\t}\n114: \n115: \t\treturn '-';\n116: \t}\n117: \n118: \tgetLastUpdatedNotes(): Note[] {\n119: \t\treturn [...this.notes]\n120: \t\t\t.sort(\n121: \t\t\t\t(a, b) =>\n122: \t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n123: \t\t\t)\n124: \t\t\t.slice(0, 5);\n125: \t}\n126: \n127: \tgetNewestNotes(): Note[] {\n128: \t\treturn [...this.notes]\n129: \t\t\t.sort(\n130: \t\t\t\t(a, b) =>\n131: \t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n132: \t\t\t)\n133: \t\t\t.slice(0, 5);\n134: \t}\n135: \n136: \tgetFavorites(): Note[] {\n137: \t\treturn [...this.notes].filter((n) => n.is_favorite);\n138: \t}\n139: \n140: \tselectNote(noteId: string): void {\n141: \t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n142: \t}\n143: \n144: \tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n145: \t\tif (type === 'category' && edit && this.rightClickId) {\n146: \t\t\tthis.inputValue =\n147: \t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n148: \t\t} else {\n149: \t\t\tthis.inputValue = '';\n150: \t\t}\n151: \n152: \t\tthis.createType = type;\n153: \t\tthis.modalOpen = true;\n154: \n155: \t\tawait tick();\n156: \n157: \t\tsetTimeout(() => this.input?.focus(), 100);\n158: \t}\n159: \n160: \tcloseModal(): void {\n161: \t\tthis.modalOpen = false;\n162: \t}\n163: \n164: \tasync openCreateNoteModal(parent: number | null): Promise<void> {\n165: \t\tthis.createParent = parent;\n166: \t\tawait this.openModal('note');\n167: \t}\n168: \n169: \topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n170: \t\tevent.preventDefault();\n171: \n172: \t\tthis.rightClickType = type;\n173: \t\tthis.rightClickMenuX = event.clientX;\n174: \t\tthis.rightClickMenuY = event.clientY;\n175: \t\tthis.rightClickId = id;\n176: \t\tthis.createParent = type === 'category' ? id as number : null;\n177: \t\tthis.rightClickMenuOpen = true;\n178: \t}\n179: \n180: \tcloseRightClickMenu(): void {\n181: \t\tthis.rightClickMenuOpen = false;\n182: \t}\n183: \n184: \tasync dragToCategory(): Promise<void> {\n185: \t\tif (this.draggedNote === null) return;\n186: \n187: \t\tconst request: UpdateNoteRequest = {\n188: \t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n189: \t\t};\n190: \t\tconst ok = await this.apiService.update(\n191: \t\t\tapiRoutes.notes.update,\n192: \t\t\tthis.draggedNote.id,\n193: \t\t\trequest\n194: \t\t);\n195: \t\tif (ok) await this.load();\n196: \t\treturn Promise.resolve();\n197: \t}\n198: \n199: \tasync create(): Promise<Note | null> {\n200: \t\tif (this.inputValue === '') {\n201: \t\t\treturn null;\n202: \t\t}\n203: \n204: \t\tconst request: CreateNoteRequest =\n205: \t\t\tthis.createParent !== null\n206: \t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n207: \t\t\t\t: { title: this.inputValue };\n208: \t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n209: \n210: \t\tif (!res) {\n211: \t\t\tthis.inputValue = '';\n212: \t\t\tthis.createParent = null;\n213: \t\t\tthis.rightClickMenuOpen = false;\n214: \t\t\treturn null;\n215: \t\t}\n216: \n217: \t\tconst note = res.data as Note;\n218: \n219: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n220: \t\t\tthis.toggleCollapseCategory(this.createParent);\n221: \t\t}\n222: \n223: \t\tthis.inputValue = '';\n224: \t\tthis.createParent = null;\n225: \t\tthis.rightClickMenuOpen = false;\n226: \n227: \t\tawait this.load();\n228: \t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n229: \t\tawait goto(resolve(urls.note, { id: note.id }));\n230: \n231: \t\treturn note;\n232: \t}\n233: \n234: \tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n235: \t\tif (this.inputValue === '') {\n236: \t\t\treturn null;\n237: \t\t}\n238: \n239: \t\tlet res;\n240: \n241: \t\tif (edit && this.rightClickId) {\n242: \t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n243: \t\t\tres = await this.apiService.update(\n244: \t\t\t\tapiRoutes.notes.updateCategory,\n245: \t\t\t\tthis.rightClickId,\n246: \t\t\t\trequest\n247: \t\t\t);\n248: \t\t} else {\n249: \t\t\tconst request: CreateNoteCategoryRequest =\n250: \t\t\t\tthis.createParent !== null\n251: \t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n252: \t\t\t\t\t: { title: this.inputValue };\n253: \t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n254: \t\t}\n255: \n256: \t\tif (res) await this.loadCategories();\n257: \n258: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n259: \t\t\tthis.toggleCollapseCategory(this.createParent);\n260: \t\t}\n261: \n262: \t\tthis.inputValue = '';\n263: \t\tthis.createParent = null;\n264: \t\tthis.rightClickMenuOpen = false;\n265: \n266: \t\treturn res && typeof res === 'object' ? (res.data as NoteCategory) : null;\n267: \t}\n268: \n269: \tasync saveContent(): Promise<boolean> {\n270: \t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n271: \t\tconst ok = await this.apiService.update(\n272: \t\t\tapiRoutes.notes.update,\n273: \t\t\tthis.activeNote!.id,\n274: \t\t\trequest\n275: \t\t);\n276: \t\tif (ok) await this.load();\n277: \t\treturn ok;\n278: \t}\n279: \n280: \tasync changeTitle(title: string): Promise<boolean> {\n281: \t\tconst request: UpdateNoteRequest = { title: title };\n282: \t\tconst ok = await this.apiService.update(\n283: \t\t\tapiRoutes.notes.update,\n284: \t\t\tthis.activeNote!.id,\n285: \t\t\trequest\n286: \t\t);\n287: \t\tif (ok) await this.load();\n288: \t\treturn ok;\n289: \t}\n290: \n291: \tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n292: \t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n293: \t\tconst ok = await this.apiService.update(\n294: \t\t\tapiRoutes.notes.update,\n295: \t\t\tthis.activeNote!.id,\n296: \t\t\trequest\n297: \t\t);\n298: \t\tif (ok) await this.load();\n299: \t\treturn ok;\n300: \t}\n301: \n302: \tasync addTag(tagId: number): Promise<boolean> {\n303: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n304: \t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n305: \t\tconst ok = await this.apiService.update(\n306: \t\t\tapiRoutes.notes.update,\n307: \t\t\tthis.activeNote!.id,\n308: \t\t\trequest\n309: \t\t);\n310: \n311: \t\tif (ok) await this.load();\n312: \t\treturn ok;\n313: \t}\n314: \n315: \tasync removeTag(tagId: number): Promise<boolean> {\n316: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n317: \t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n318: \t\tconst ok = await this.apiService.update(\n319: \t\t\tapiRoutes.notes.update,\n320: \t\t\tthis.activeNote!.id,\n321: \t\t\trequest\n322: \t\t);\n323: \n324: \t\tif (ok) await this.load();\n325: \t\treturn ok;\n326: \t}\n327: \n328: \tasync delete(): Promise<boolean> {\n329: \t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n330: \t\t\treturn false;\n331: \t\t}\n332: \n333: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n334: \t\tif (ok) {\n335: \t\t\tif (this.activeNote?.id ===