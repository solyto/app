{"type":"tool_use","timestamp":1791377294364,"sessionID":"ses_ee997eadcffer0klLXJV279zqa","part":{"type":"tool","tool":"read","callID":"call_01_HJFj8GwzOfTctS8sWpxO4812","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Auth.svelte.ts"},"output":"<path>/workspace/src/lib/state/Auth.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tAuthToken,\n3: \tUser,\n4: \tLoginRequest,\n5: \tLoginResponse,\n6: \tRegisterRequest,\n7: \tVerifyRequest,\n8: \tAuthActionResponse,\n9: \tVerifyActionResponse,\n10: \tPasskeyActionResponse,\n11: \tPasskeyAuthenticationOptions,\n12: \tPasskeyRegistrationOptions,\n13: \tPasskey\n14: } from '$lib/types/auth';\n15: import { IS_NATIVE, PLATFORM } from '$lib/config/platform';\n16: import { setContext, getContext } from 'svelte';\n17: import { apiRoutes } from '$lib/config/apiRoutes';\n18: import ApiService from '$lib/services/ApiService';\n19: import LocalStorageService from '$lib/services/LocalStorageService';\n20: import { SvelteDate, SvelteMap } from 'svelte/reactivity';\n21: import {\n22: \tformatDate,\n23: \tformatDateTime,\n24: \tformatDateWithoutYear,\n25: \tformatDateWithWeekday,\n26: \tformatTime,\n27: \tformatTimeWithSeconds\n28: } from '$lib/helpers/DateHelper';\n29: \n30: export class Auth {\n31: \tstatic readonly LS_AUTH_KEY: string = 'auth';\n32: \n33: \tloggedIn = $state<boolean>(false);\n34: \tauthToken = $state<AuthToken | null>(null);\n35: \tuser = $state<User | null>(null);\n36: \tapiService: ApiService;\n37: \tlocalStorage = new LocalStorageService();\n38: \tprofileCache = new SvelteMap<string, User>();\n39: \n40: \tconstructor() {\n41: \t\tthis.apiService = new ApiService(null);\n42: \t\tthis.load().then();\n43: \t}\n44: \n45: \tprivate async load(): Promise<void> {\n46: \t\tconst savedAuth = this.localStorage.getJson(Auth.LS_AUTH_KEY);\n47: \n48: \t\tif (!savedAuth) return;\n49: \n50: \t\tconst { user, authToken } = savedAuth as { user: User; authToken: AuthToken }\n51: \n52: \t\tif (!authToken || !user) return;\n53: \n54: \t\tconst expiresAt = new SvelteDate(authToken.expires_at).getTime();\n55: \n56: \t\tif (expiresAt > Date.now()) {\n57: \t\t\tthis.user = user;\n58: \t\t\tthis.authToken = authToken;\n59: \t\t\tthis.apiService.updateAuthToken(this.getToken()!);\n60: \t\t\tthis.loggedIn = true;\n61: \n62: \t\t\tif (this.shouldRefresh(expiresAt)) {\n63: \t\t\t\tawait this.refresh();\n64: \t\t\t}\n65: \n66: \t\t\tawait this.loadAdditionalData();\n67: \n68: \t\t\tthis.save();\n69: \t\t} else {\n70: \t\t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n71: \t\t}\n72: \t}\n73: \n74: \tpublic async loadAdditionalData(): Promise<void> {\n75: \t\tif (!this.user) return;\n76: \t\tconst res = await this.apiService.get(apiRoutes.users.get, null);\n77: \t\tif (res) this.user = res.data as User;\n78: \t\tthis.save();\n79: \t}\n80: \n81: \tpublic save(): void {\n82: \t\tthis.localStorage.setJson(Auth.LS_AUTH_KEY, {\n83: \t\t\tuser: this.user,\n84: \t\t\tauthToken: this.authToken\n85: \t\t});\n86: \t}\n87: \n88: \tprivate clear(): void {\n89: \t\tthis.localStorage.destroy(Auth.LS_AUTH_KEY);\n90: \t\tthis.user = null;\n91: \t\tthis.authToken = null;\n92: \t\tthis.loggedIn = false;\n93: \t}\n94: \n95: \tasync login(email: string, password: string): Promise<boolean> {\n96: \t\tconst request: LoginRequest = { email, password, platform: PLATFORM };\n97: \t\tconst res = await this.apiService.post(apiRoutes.auth.login, request);\n98: \n99: \t\tif (!res) return Promise.resolve(false);\n100: \t\tconst login = res.data as LoginResponse;\n101: \n102: \t\tthis.user = login.user;\n103: \t\tthis.authToken = {\n104: \t\t\ttoken: login.token,\n105: \t\t\ttoken_type: login.token_type,\n106: \t\t\texpires_at: login.token_expires_at\n107: \t\t};\n108: \t\tthis.loggedIn = true;\n109: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n110: \n111: \t\tthis.save();\n112: \t\tawait this.loadAdditionalData();\n113: \n114: \t\treturn Promise.resolve(true);\n115: \t}\n116: \n117: \tprivate shouldRefresh(expiresAt: number): boolean {\n118: \t\tconst thresholdDays = IS_NATIVE ? 14 : 5;\n119: \t\treturn expiresAt < Date.now() + thresholdDays * 24 * 60 * 60 * 1000;\n120: \t}\n121: \n122: \tasync refresh(): Promise<boolean> {\n123: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n124: \t\tconst res = await this.apiService.post(apiRoutes.auth.refresh, {});\n125: \n126: \t\tif (!res) return Promise.resolve(false);\n127: \t\tconst refresh = res.data as LoginResponse;\n128: \n129: \t\tthis.user = refresh.user;\n130: \t\tthis.authToken = {\n131: \t\t\ttoken: refresh.token,\n132: \t\t\ttoken_type: refresh.token_type,\n133: \t\t\texpires_at: refresh.token_expires_at\n134: \t\t};\n135: \t\tthis.loggedIn = true;\n136: \n137: \t\tthis.save();\n138: \n139: \t\treturn Promise.resolve(true);\n140: \t}\n141: \n142: \tlogout(): void {\n143: \t\tthis.clear();\n144: \t}\n145: \n146: \tisAdmin(): boolean {\n147: \t\treturn this.user?.role === 'admin' || this.user?.role === 'super_admin';\n148: \t}\n149: \n150: \tasync register(request: RegisterRequest): Promise<AuthActionResponse> {\n151: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.register, request);\n152: \t}\n153: \n154: \tasync verify(request: VerifyRequest): Promise<VerifyActionResponse> {\n155: \t\treturn this.apiService.postRaw<VerifyActionResponse>(apiRoutes.auth.verify, request);\n156: \t}\n157: \n158: \tasync forgotPassword(email: string, platform: string): Promise<void> {\n159: \t\tawait this.apiService.post(apiRoutes.auth.forgotPassword, { email, platform });\n160: \t}\n161: \n162: \tasync resetPassword(token: string, email: string, password: string, passwordConfirmation: string): Promise<AuthActionResponse> {\n163: \t\treturn this.apiService.postRaw<AuthActionResponse>(apiRoutes.auth.resetPassword, {\n164: \t\t\ttoken,\n165: \t\t\temail,\n166: \t\t\tpassword,\n167: \t\t\tpassword_confirmation: passwordConfirmation\n168: \t\t});\n169: \t}\n170: \n171: \tasync passkeyAuthenticationOptions(): Promise<PasskeyAuthenticationOptions | null> {\n172: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.authenticateOptions, {});\n173: \t\treturn (res?.data ?? null) as PasskeyAuthenticationOptions | null;\n174: \t}\n175: \n176: \tasync passkeyAuthenticate(response: object): Promise<void> {\n177: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.authenticate, { response, platform: PLATFORM });\n178: \t\tif (!res.success) {\n179: \t\t\tthrow new Error(res.message ?? 'Passkey authentication failed');\n180: \t\t}\n181: \t\tconst data = res.data as LoginResponse;\n182: \t\tthis.user = data.user;\n183: \t\tthis.authToken = {\n184: \t\t\ttoken: data.token,\n185: \t\t\ttoken_type: data.token_type,\n186: \t\t\texpires_at: data.token_expires_at\n187: \t\t};\n188: \t\tthis.loggedIn = true;\n189: \t\tthis.apiService.updateAuthToken(this.getToken()!);\n190: \t\tthis.save();\n191: \t\tawait this.loadAdditionalData();\n192: \t}\n193: \n194: \tasync passkeyRegistrationOptions(): Promise<PasskeyRegistrationOptions | null> {\n195: \t\tconst res = await this.apiService.post(apiRoutes.auth.passkeys.registerOptions, {});\n196: \t\treturn (res?.data ?? null) as PasskeyRegistrationOptions | null;\n197: \t}\n198: \n199: \tasync passkeyRegister(response: object, name: string): Promise<void> {\n200: \t\tconst res = await this.apiService.postRaw<PasskeyActionResponse>(apiRoutes.auth.passkeys.register, { response, name });\n201: \t\tif (!res.success) {\n202: \t\t\tthrow new Error(res.message ?? 'Registration failed');\n203: \t\t}\n204: \t}\n205: \n206: \tasync getPasskeys(): Promise<Passkey[]> {\n207: \t\tconst res = await this.apiService.get(apiRoutes.auth.passkeys.list, null);\n208: \t\treturn (res?.data ?? []) as Passkey[];\n209: \t}\n210: \n211: \tasync deletePasskey(id: string): Promise<void> {\n212: \t\tawait this.apiService.delete(apiRoutes.auth.passkeys.delete, id);\n213: \t}\n214: \n215: \tasync 