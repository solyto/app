((authEndpoint) => endpoint.startsWith(authEndpoint));\n40: \t}\n41: \n42: \t// Runs a request; on a 401 from a non-auth endpoint asks the session owner\n43: \t// to recover and, if it did, retries the same request exactly once with the\n44: \t// current token. Network errors (a rejected fetch) propagate untouched — they\n45: \t// are transient and must never trigger recovery/logout.\n46: \tprivate async fetchWithRecovery(endpoint: string, init: RequestInit): Promise<Response> {\n47: \t\tconst res = await fetch(endpoint, init);\n48: \n49: \t\tif (res.status !== 401 || !this.unauthorizedHandler || this.isAuthEndpoint(endpoint)) {\n50: \t\t\treturn res;\n51: \t\t}\n52: \n53: \t\tconst recovered = await this.unauthorizedHandler();\n54: \t\tif (!recovered) return res;\n55: \n56: \t\tconst headers = { ...(init.headers as Record<string, string>) };\n57: \t\tif (this.authToken) {\n58: \t\t\theaders['Authorization'] = 'Bearer ' + this.authToken;\n59: \t\t} else {\n60: \t\t\tdelete headers['Authorization'];\n61: \t\t}\n62: \n63: \t\treturn fetch(endpoint, { ...init, headers });\n64: \t}\n65: \n66: \tasync list(endpoint: string): Promise<ListResponse | null> {\n67: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n68: \t\treturn res.ok ? await res.json() : null;\n69: \t}\n70: \n71: \tasync get(endpoint: string, id: string | number | null): Promise<GetResponse | null> {\n72: \t\tif (typeof id === 'string') {\n73: \t\t\tendpoint = endpoint.replace('%s', id);\n74: \t\t} else if (typeof id === 'number') {\n75: \t\t\tendpoint = endpoint.replace('%d', id.toString());\n76: \t\t}\n77: \n78: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n79: \t\treturn res.ok ? await res.json() : null;\n80: \t}\n81: \n82: \tasync create(endpoint: string, body: object): Promise<CreateResponse | null> {\n83: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n84: \t\t\tmethod: 'POST',\n85: \t\t\theaders: this.getApiHeaderWithBody(),\n86: \t\t\tbody: JSON.stringify(body)\n87: \t\t});\n88: \n89: \t\treturn res.ok ? await res.json() : null;\n90: \t}\n91: \n92: \tasync createWithStatus(endpoint: string, body: object): Promise<{ ok: boolean; status: number }> {\n93: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n94: \t\t\tmethod: 'POST',\n95: \t\t\theaders: this.getApiHeaderWithBody(),\n96: \t\t\tbody: JSON.stringify(body)\n97: \t\t});\n98: \n99: \t\treturn { ok: res.ok, status: res.status };\n100: \t}\n101: \n102: \tasync delete(endpoint: string, id: string | number): Promise<boolean> {\n103: \t\tconst res = await this.fetchWithRecovery(\n104: \t\t\ttypeof id === 'string'\n105: \t\t\t\t? endpoint.replace('%s', id)\n106: \t\t\t\t: endpoint.replace('%d', id.toString()),\n107: \t\t\t{ method: 'DELETE', headers: this.getApiHeader() }\n108: \t\t);\n109: \n110: \t\treturn Promise.resolve(res.ok);\n111: \t}\n112: \n113: \tasync update(endpoint: string, id: string | number, body: object): Promise<boolean> {\n114: \t\tconst res = await this.fetchWithRecovery(\n115: \t\t\ttypeof id === 'string'\n116: \t\t\t\t? endpoint.replace('%s', id)\n117: \t\t\t\t: endpoint.replace('%d', id.toString()),\n118: \t\t\t{ method: 'PUT', headers: this.getApiHeaderWithBody(), body: JSON.stringify(body) }\n119: \t\t);\n120: \n121: \t\treturn Promise.resolve(res.ok);\n122: \t}\n123: \n124: \tasync post(endpoint: string, body: FormData | object): Promise<PostResponse | null> {\n125: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n126: \t\t\tmethod: 'POST',\n127: \t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n128: \t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n129: \t\t});\n130: \n131: \t\treturn res.ok ? await res.json() : null;\n132: \t}\n133: \n134: \tasync postRaw<T = object>(endpoint: string, body: FormData | object): Promise<T> {\n135: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n136: \t\t\tmethod: 'POST',