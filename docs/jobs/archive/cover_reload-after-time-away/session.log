sion that expires while the app\n+// stays open (resume check / 401 recovery) flips loggedIn to false mid-session;\n+// react to that transition so the user is not left on a dead page.\n+let wasLoggedIn = false;\n+\n+$effect(() => {\n+\tif (!browser) return;\n+\n+\tif (auth.loggedIn) {\n+\t\twasLoggedIn = true;\n+\t\treturn;\n+\t}\n+\n+\tif (isAuthRoute() || isSetupRoute()) {\n+\t\twasLoggedIn = false;\n+\t\treturn;\n+\t}\n+\n+\tif (!wasLoggedIn) return;\n+\twasLoggedIn = false;\n+\n+\tnotifications.error(ts.get.auth.session_expired);\n+\n+\tif (featureConfig.firstStartupOptions) {\n+\t\tgoto(resolve(urls.setup));\n+\t} else {\n+\t\tgoto(resolve(urls.login));\n+\t}\n+});\n+\n onMount(async () => {\n \ttheme.load();\n \n \tif (!canAccessRoute) {\n","additions":31,"deletions":0},"truncated":false},"title":"src/routes/+layout.svelte","time":{"start":1791379045715,"end":1791379045822}},"id":"prt_11682f8c1001V5cXkk043n1qmj","sessionID":"ses_ee997eadcffer0klLXJV279zqa","messageID":"msg_11682d49f001gUnSkXl7IM63Oz"}}
