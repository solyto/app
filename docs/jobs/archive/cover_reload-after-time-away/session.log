cation/json' };\n\t\t}\n\n\t\treturn { Authorization: 'Bearer ' + this.authToken, Accept: 'application/json' };\n\t}\n\n\tprivate getApiHeaderWithBody(): HeadersInit {\n\t\tif (!this.authToken) {\n\t\t\treturn { 'Content-Type': 'application/json', Accept: 'application/json' };\n\t\t}\n\n\t\treturn {\n\t\t\tAuthorization: 'Bearer ' + this.authToken,\n\t\t\t'Content-Type': 'application/json',\n\t\t\tAccept: 'application/json'\n\t\t};\n\t}\n}","lineStart":1,"lineEnd":201,"totalLines":201,"truncated":false}},"title":"src/lib/services/ApiService.ts","time":{"start":1791395545921,"end":1791395545955}},"id":"prt_1177ec2fa001MBXsa6mWv6rwn1","sessionID":"ses_ee8818e60ffetGBXJ1ST4fwJTm","messageID":"msg_1177eb20d001Ks658inCLXX4c6"}}
