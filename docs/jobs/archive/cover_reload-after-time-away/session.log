((authEndpoint) => endpoint.startsWith(authEndpoint));\n40: \t}\n41: \n42: \t// Runs a request; on a 401 from a non-auth endpoint asks the session owner\n43: \t// to recover and, if it did, retries the same request exactly once with the\n44: \t// current token. Network errors (a rejected fetch) propagate untouched — they\n45: \t// are transient and must never trigger recovery/logout.\n46: \tprivate async fetchWithRecovery(endpoint: string, init: RequestInit): Promise<Response> {\n47: \t\tconst res = await fetch(endpoint, init);\n48: \n49: \t\tif (res.status !== 401 || !this.unauthorizedHandler || this.isAuthEndpoint(endpoint)) {\n50: \t\t\treturn res;\n51: \t\t}\n52: \n53: \t\tconst recovered = await this.unauthorizedHandler();\n54: \t\tif (!recovered) return res;\n55: \n56: \t\tconst headers = { ...(init.headers as Record<string, string>) };\n57: \t\tif (this.authToken) {\n58: \t\t\theaders['Authorization'] = 'Bearer ' + this.authToken;\n59: \t\t} else {\n60: \t\t\tdelete headers['Authorization'];\n61: \t\t}\n62: \n63: \t\treturn fetch(endpoint, { ...init, headers });\n64: \t}\n65: \n66: \tasync list(endpoint: string): Promise<ListResponse | null> {\n67: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n68: \t\treturn res.ok ? await res.json() : null;\n69: \t}\n70: \n71: \tasync get(endpoint: string, id: string | number | null): Promise<GetResponse | null> {\n72: \t\tif (typeof id === 'string') {\n73: \t\t\tendpoint = endpoint.replace('%s', id);\n74: \t\t} else if (typeof id === 'number') {\n75: \t\t\tendpoint = endpoint.replace('%d', id.toString());\n76: \t\t}\n77: \n78: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n79: \t\treturn res.ok ? await res.json() : null;\n80: \t}\n81: \n82: \tasync create(endpoint: string, body: object): Promise<CreateResponse | null> {\n83: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n84: \t\t\tmethod: 'POST',\n85: \t\t\theaders: this.getApiHeaderWithBody(),\n86: \t\t\tbody: JSON.stringify(body)\n87: \t\t});\n88: \n89: \t\treturn res.ok ? await res.json() : null;\n90: \t}\n91: \n92: \tasync createWithStatus(endpoint: string, body: object): Promise<{ ok: boolean; status: number }> {\n93: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n94: \t\t\tmethod: 'POST',\n95: \t\t\theaders: this.getApiHeaderWithBody(),\n96: \t\t\tbody: JSON.stringify(body)\n97: \t\t});\n98: \n99: \t\treturn { ok: res.ok, status: res.status };\n100: \t}\n101: \n102: \tasync delete(endpoint: string, id: string | number): Promise<boolean> {\n103: \t\tconst res = await this.fetchWithRecovery(\n104: \t\t\ttypeof id === 'string'\n105: \t\t\t\t? endpoint.replace('%s', id)\n106: \t\t\t\t: endpoint.replace('%d', id.toString()),\n107: \t\t\t{ method: 'DELETE', headers: this.getApiHeader() }\n108: \t\t);\n109: \n110: \t\treturn Promise.resolve(res.ok);\n111: \t}\n112: \n113: \tasync update(endpoint: string, id: string | number, body: object): Promise<boolean> {\n114: \t\tconst res = await this.fetchWithRecovery(\n115: \t\t\ttypeof id === 'string'\n116: \t\t\t\t? endpoint.replace('%s', id)\n117: \t\t\t\t: endpoint.replace('%d', id.toString()),\n118: \t\t\t{ method: 'PUT', headers: this.getApiHeaderWithBody(), body: JSON.stringify(body) }\n119: \t\t);\n120: \n121: \t\treturn Promise.resolve(res.ok);\n122: \t}\n123: \n124: \tasync post(endpoint: string, body: FormData | object): Promise<PostResponse | null> {\n125: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n126: \t\t\tmethod: 'POST',\n127: \t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n128: \t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n129: \t\t});\n130: \n131: \t\treturn res.ok ? await res.json() : null;\n132: \t}\n133: \n134: \tasync postRaw<T = object>(endpoint: string, body: FormData | object): Promise<T> {\n135: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n136: \t\t\tmethod: 'POST',\n137: \t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n138: \t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n139: \t\t});\n140: \n141: \t\treturn await res.json() as Promise<T>;\n142: \t}\n143: \n144: \tasync put(endpoint: string, body: FormData | object): Promise<boolean> {\n145: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n146: \t\t\tmethod: 'PUT',\n147: \t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n148: \t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n149: \t\t});\n150: \n151: \t\treturn res.ok;\n152: \t}\n153: \n154: \tasync postFormData(endpoint: string, body: FormData): Promise<boolean> {\n155: \t\tconst res = await this.fetchWithRecovery(endpoint, {\n156: \t\t\tmethod: 'POST',\n157: \t\t\theaders: this.getAuthHeaderOnly(),\n158: \t\t\tbody: body\n159: \t\t});\n160: \n161: \t\treturn res.ok ? await res.json() : false;\n162: \t}\n163: \n164: \tasync uploadFile(endpoint: string, id: string, body: FormData): Promise<CreateResponse | null> {\n165: \t\tconst res = await this.fetchWithRecovery(endpoint.replace('%s', id), {\n166: \t\t\tmethod: 'POST',\n167: \t\t\theaders: this.getAuthHeaderOnly(),\n168: \t\t\tbody\n169: \t\t});\n170: \t\treturn res.ok ? await res.json() : null;\n171: \t}\n172: \n173: \tasync image(endpoint: string): Promise<Blob | null> {\n174: \t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n175: \t\treturn res.ok ? await res.blob() : null;\n176: \t}\n177: \n178: \tprivate getAuthHeaderOnly(): HeadersInit {\n179: \t\treturn { Authorization: 'Bearer ' + this.authToken };\n180: \t}\n181: \n182: \tprivate getApiHeader(): HeadersInit {\n183: \t\tif (!this.authToken) {\n184: \t\t\treturn { Accept: 'application/json' };\n185: \t\t}\n186: \n187: \t\treturn { Authorization: 'Bearer ' + this.authToken, Accept: 'application/json' };\n188: \t}\n189: \n190: \tprivate getApiHeaderWithBody(): HeadersInit {\n191: \t\tif (!this.authToken) {\n192: \t\t\treturn { 'Content-Type': 'application/json', Accept: 'application/json' };\n193: \t\t}\n194: \n195: \t\treturn {\n196: \t\t\tAuthorization: 'Bearer ' + this.authToken,\n197: \t\t\t'Content-Type': 'application/json',\n198: \t\t\tAccept: 'application/json'\n199: \t\t};\n200: \t}\n201: }\n\n(End of file - total 201 lines)\n</content>","metadata":{"preview":"import type { CreateResponse, GetResponse, ListResponse, PostResponse } from '$lib/types/api';\nimport { apiRoutes } from '$lib/config/apiRoutes';\n\n// Endpoints where a 401 is a legitimate, expected auth failure (bad credentials,\n// expired refresh token, failed passkey authentication) rather than a stale\n// session. Recovery must never run for these, otherwise a failed login would\n// trigger a refresh/logout loop.\nconst AUTH_ENDPOINTS: string[] = [\n\tapiRoutes.auth.login,\n\tapiRoutes.auth.refresh,\n\tapiRoutes.auth.register,\n\tapiRoutes.auth.verify,\n\tapiRoutes.auth.forgotPassword,\n\tapiRoutes.auth.resetPassword,\n\tapiRoutes.auth.passkeys.authenticateOptions,\n\tapiRoutes.auth.passkeys.authenticate\n];\n\nexport default class ApiService {\n\tauthToken: string | null = null;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/services/ApiService.ts","text":"import type { CreateResponse, GetResponse, ListResponse, PostResponse } from '$lib/types/api';\nimport { apiRoutes } from '$lib/config/apiRoutes';\n\n// Endpoints where a 401 is a legitimate, expected auth failure (bad credentials,\n// expired refresh token, failed passkey authentication) rather than a stale\n// session. Recovery must never run for these, otherwise a failed login would\n// trigger a refresh/logout loop.\nconst AUTH_ENDPOINTS: string[] = [\n\tapiRoutes.auth.login,\n\tapiRoutes.auth.refresh,\n\tapiRoutes.auth.register,\n\tapiRoutes.auth.verify,\n\tapiRoutes.auth.forgotPassword,\n\tapiRoutes.auth.resetPassword,\n\tapiRoutes.auth.passkeys.authenticateOptions,\n\tapiRoutes.auth.passkeys.authenticate\n];\n\nexport default class ApiService {\n\tauthToken: string | null = null;\n\tprivate unauthorizedHandler: (() => Promise<boolean>) | null = null;\n\n\tconstructor(authToken: string | null = null) {\n\t\tthis.authToken = authToken;\n\t}\n\n\tupdateAuthToken(authToken: string | null): void {\n\t\tthis.authToken = authToken;\n\t}\n\n\t// The owner of the session (Auth) registers a single recovery routine here.\n\t// It is expected to adopt a token refreshed by another tab, or refresh this\n\t// session, and return true when a retry with a fresh token makes sense.\n\tsetUnauthorizedHandler(handler: () => Promise<boolean>): void {\n\t\tthis.unauthorizedHandler = handler;\n\t}\n\n\tprivate isAuthEndpoint(endpoint: string): boolean {\n\t\treturn AUTH_ENDPOINTS.some((authEndpoint) => endpoint.startsWith(authEndpoint));\n\t}\n\n\t// Runs a request; on a 401 from a non-auth endpoint asks the session owner\n\t// to recover and, if it did, retries the same request exactly once with the\n\t// current token. Network errors (a rejected fetch) propagate untouched — they\n\t// are transient and must never trigger recovery/logout.\n\tprivate async fetchWithRecovery(endpoint: string, init: RequestInit): Promise<Response> {\n\t\tconst res = await fetch(endpoint, init);\n\n\t\tif (res.status !== 401 || !this.unauthorizedHandler || this.isAuthEndpoint(endpoint)) {\n\t\t\treturn res;\n\t\t}\n\n\t\tconst recovered = await this.unauthorizedHandler();\n\t\tif (!recovered) return res;\n\n\t\tconst headers = { ...(init.headers as Record<string, string>) };\n\t\tif (this.authToken) {\n\t\t\theaders['Authorization'] = 'Bearer ' + this.authToken;\n\t\t} else {\n\t\t\tdelete headers['Authorization'];\n\t\t}\n\n\t\treturn fetch(endpoint, { ...init, headers });\n\t}\n\n\tasync list(endpoint: string): Promise<ListResponse | null> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n\t\treturn res.ok ? await res.json() : null;\n\t}\n\n\tasync get(endpoint: string, id: string | number | null): Promise<GetResponse | null> {\n\t\tif (typeof id === 'string') {\n\t\t\tendpoint = endpoint.replace('%s', id);\n\t\t} else if (typeof id === 'number') {\n\t\t\tendpoint = endpoint.replace('%d', id.toString());\n\t\t}\n\n\t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n\t\treturn res.ok ? await res.json() : null;\n\t}\n\n\tasync create(endpoint: string, body: object): Promise<CreateResponse | null> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'POST',\n\t\t\theaders: this.getApiHeaderWithBody(),\n\t\t\tbody: JSON.stringify(body)\n\t\t});\n\n\t\treturn res.ok ? await res.json() : null;\n\t}\n\n\tasync createWithStatus(endpoint: string, body: object): Promise<{ ok: boolean; status: number }> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'POST',\n\t\t\theaders: this.getApiHeaderWithBody(),\n\t\t\tbody: JSON.stringify(body)\n\t\t});\n\n\t\treturn { ok: res.ok, status: res.status };\n\t}\n\n\tasync delete(endpoint: string, id: string | number): Promise<boolean> {\n\t\tconst res = await this.fetchWithRecovery(\n\t\t\ttypeof id === 'string'\n\t\t\t\t? endpoint.replace('%s', id)\n\t\t\t\t: endpoint.replace('%d', id.toString()),\n\t\t\t{ method: 'DELETE', headers: this.getApiHeader() }\n\t\t);\n\n\t\treturn Promise.resolve(res.ok);\n\t}\n\n\tasync update(endpoint: string, id: string | number, body: object): Promise<boolean> {\n\t\tconst res = await this.fetchWithRecovery(\n\t\t\ttypeof id === 'string'\n\t\t\t\t? endpoint.replace('%s', id)\n\t\t\t\t: endpoint.replace('%d', id.toString()),\n\t\t\t{ method: 'PUT', headers: this.getApiHeaderWithBody(), body: JSON.stringify(body) }\n\t\t);\n\n\t\treturn Promise.resolve(res.ok);\n\t}\n\n\tasync post(endpoint: string, body: FormData | object): Promise<PostResponse | null> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'POST',\n\t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n\t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n\t\t});\n\n\t\treturn res.ok ? await res.json() : null;\n\t}\n\n\tasync postRaw<T = object>(endpoint: string, body: FormData | object): Promise<T> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'POST',\n\t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n\t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n\t\t});\n\n\t\treturn await res.json() as Promise<T>;\n\t}\n\n\tasync put(endpoint: string, body: FormData | object): Promise<boolean> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'PUT',\n\t\t\theaders: typeof body === 'object' ? this.getApiHeaderWithBody() : this.getApiHeader(),\n\t\t\tbody: typeof body === 'object' ? JSON.stringify(body) : body\n\t\t});\n\n\t\treturn res.ok;\n\t}\n\n\tasync postFormData(endpoint: string, body: FormData): Promise<boolean> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, {\n\t\t\tmethod: 'POST',\n\t\t\theaders: this.getAuthHeaderOnly(),\n\t\t\tbody: body\n\t\t});\n\n\t\treturn res.ok ? await res.json() : false;\n\t}\n\n\tasync uploadFile(endpoint: string, id: string, body: FormData): Promise<CreateResponse | null> {\n\t\tconst res = await this.fetchWithRecovery(endpoint.replace('%s', id), {\n\t\t\tmethod: 'POST',\n\t\t\theaders: this.getAuthHeaderOnly(),\n\t\t\tbody\n\t\t});\n\t\treturn res.ok ? await res.json() : null;\n\t}\n\n\tasync image(endpoint: string): Promise<Blob | null> {\n\t\tconst res = await this.fetchWithRecovery(endpoint, { headers: this.getApiHeader() });\n\t\treturn res.ok ? await res.blob() : null;\n\t}\n\n\tprivate getAuthHeaderOnly(): HeadersInit {\n\t\treturn { Authorization: 'Bearer ' + this.authToken };\n\t}\n\n\tprivate getApiHeader(): HeadersInit {\n\t\tif (!this.authToken) {\n\t\t\treturn { Accept: 'application/json' };\n\t\t}\n\n\t\treturn { Authorization: 'Bearer ' + this.authToken, Accept: 'application/json' };\n\t}\n\n\tprivate getApiHeaderWithBody(): HeadersInit {\n\t\tif (!this.authToken) {\n\t\t\treturn { 'Content-Type': 'application/json', Accept: 'application/json' };\n\t\t}\n\n\t\treturn {\n\t\t\tAuthorization: 'Bearer ' + this.authToken,\n\t\t\t'Content-Type': 'application/json',\n\t\t\tAccept: 'application/json'\n\t\t};\n\t}\n}","lineStart":1,"lineEnd":201,"totalLines":201,"truncated":false}},"title":"src/lib/services/ApiService.ts","time":{"start":1791403873099,"end":1791403873132}},"id":"prt_117fdd2ee001LVQitxRVILYx1H","sessionID":"ses_ee802475effeHVy4nw6OsS4MOK","messageID":"msg_117fdca8b001IBknKW1vE5d8Ik"}}
