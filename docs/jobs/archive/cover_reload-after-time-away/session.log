cation/json' };\n\t\t}\n\n\t\treturn { Authorization: 'Bearer ' + this.authToken, Accept: 'application/json' };\n\t}\n\n\tprivate getApiHeaderWithBody(): HeadersInit {\n\t\tif (!this.authToken) {\n\t\t\treturn { 'Content-Type': 'application/json', Accept: 'application/json' };\n\t\t}\n\n\t\treturn {\n\t\t\tAuthorization: 'Bearer ' + this.authToken,\n\t\t\t'Content-Type': 'application/json',\n\t\t\tAccept: 'application/json'\n\t\t};\n\t}\n}","lineStart":1,"lineEnd":201,"totalLines":201,"truncated":false}},"title":"src/lib/services/ApiService.ts","time":{"start":1791394360776,"end":1791394360844}},"id":"prt_1176cada40011ktQXKuNUXzHGL","sessionID":"ses_ee8936cdeffeU9hwZK5UQkXR8i","messageID":"msg_1176ca6330011RtvOATTwHoOfJ"}}
