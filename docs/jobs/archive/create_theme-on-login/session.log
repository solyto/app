 mb-2 text-sm font-bold dark:text-white\">\nsrc/routes/auth/logout/+page.svelte:27:\t<div class=\"mb-4 space-y-4 rounded bg-c-bg-surface px-8 pt-6 pb-8 shadow-md\">\nsrc/routes/auth/verify/[user_id]/[token]/+page.svelte:44:\t\t\tclass=\"mb-4 space-y-4 rounded bg-c-bg-surface px-8 pt-6 pb-8 shadow-md\"\n","metadata":{"output":"src/routes/auth/forgot-password/+page.svelte:72:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\nsrc/routes/auth/forgot-password/+page.svelte:76:\t\t\t\t<p class=\"text-base font-bold dark:text-white\">{ts.get.auth.forgot_password_sent_title}</p>\nsrc/routes/auth/forgot-password/+page.svelte:77:\t\t\t\t<p class=\"mt-1 text-sm dark:text-white/70\">\nsrc/routes/auth/forgot-password/+page.svelte:92:\t\t\t\tclass=\"cursor-pointer text-xs text-gray-400 hover:text-gray-600 dark:text-white/50 dark:hover:text-white/80\"\nsrc/routes/auth/forgot-password/+page.svelte:100:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\nsrc/routes/auth/forgot-password/+page.svelte:104:\t\t\t\t<p class=\"text-base font-bold dark:text-white\">{ts.get.auth.forgot_password}</p>\nsrc/routes/auth/forgot-password/+page.svelte:105:\t\t\t\t<p class=\"mt-1 text-sm dark:text-white/70\">{ts.get.auth.forgot_password_hint}</p>\nsrc/routes/auth/forgot-password/+page.svelte:108:\t\t\t\t<div class=\"label-text mb-2 text-sm font-bold dark:text-white\">{ts.get.auth.email}</div>\nsrc/routes/auth/forgot-password/+page.svelte:118:\t\t\t\t<a href={urls.login} class=\"cursor-pointer text-xs text-gray-400 hover:text-gray-600 dark:text-white/50 dark:hover:text-white/80\">\nsrc/routes/auth/login/+page.svelte:110:\t\tclass=\"mb-4 relative flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\nsrc/routes/auth/login/+page.svelte:114:\t\t\t<div class=\"label-text mb-2 text-sm font-bold da