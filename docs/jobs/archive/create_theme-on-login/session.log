igationMobile.svelte:115:\t\t\t\t\t\t\t\t\tclass=\"flex w-full cursor-pointer items-center border-b border-c-neutral-1 px-4 py-4 text-left hover:bg-c-neutral-1 dark:border-s-dark-3 dark:hover:bg-s-dark-3 {todos.isFilterActive({ type: 'workspace', value: workspace }) ? 'bg-c-neutral-1 dark:bg-s-dark-3' : ''}\"\nsrc/lib/components/todos/TodoNavigationMobile.svelte:141:\t\t\t\t\t\t\t\t\tclass=\"flex w-full cursor-pointer items-center border-b border-c-neutral-1 px-4 py-4 text-left hover:bg-c-neutral-1 dark:border-s-dark-3 dark:hover:bg-s-dark-3 {todos.isFilterActive({ type: 'category', value: category.id }) ? 'bg-c-neutral-1 dark:bg-s-dark-3' : ''}\"\nsrc/lib/components/todos/TodoNavigationMobile.svelte:175:\t\t\t\t\t\t\t\t\tclass=\"flex w-full cursor-pointer items-center border-b border-c-neutral-1 px-4 py-4 text-left hover:bg-c-neutral-1 dark:border-s-dark-3 dark:hover:bg-s-dark-3 {todos.isFilterActive({ type: 'tag', value: tag.id }) ? 'bg-c-neutral-1 dark:bg-s-dark-3' : ''}\"\nsrc/lib/components/todos/TodoNavigationMobile.svelte:203:\t\t\t\t\t\t\t\t\t\tclass=\"flex w-full cursor-pointer items-center border-b border-c-neutral-1 px-4 py-4 text-left hover:bg-c-neutral-1 dark:border-s-dark-3 dark:hover:bg-s-dark-3 {item.filter && todos.isFilterActive(item.filter) ? 'bg-c-neutral-1 dark:bg-s-dark-3' : ''}\"\n=== auth card classes ===\n--- login ---\n110:\t\tclass=\"mb-4 relative flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n--- register ---\n92:\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n--- forgot-password ---\n72:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n100:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n--- reset-password ---\n72:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n85:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n105:\t\t\tclass=\"mb-4 flex flex-col gap-4 rounded-lg border-2 border-white/5 bg-c-bg-surface px-8 pt-6 pb-8 shadow-sm md:min-w-80\"\n--- logout ---\n27:\t<div class=\"mb-4 space-y-4 rounded bg-c-bg-surface px-8 pt-6 pb-8 shadow-md\">\n--- verify/[user_id]/[token] ---\n44:\t\t\tclass=\"mb-4 space-y-4 rounded bg-c-bg-surface px-8 pt-6 pb-8 shadow-md\"\n","exit":0,"truncated":false},"title":"grep -rn \"bg-white\" src/ ; echo \"=== dark:bg-s-dark ===\"; grep -rn \"dark:bg-s-dark\" src/ ; echo \"=== auth card classes ===\"; for f in login register forgot-password reset-password logout 'verify/[user_id]/[token]'; do echo \"--- $f ---\"; grep -n \"bg-c-bg-surface\\|bg-white\\|dark:bg-s-dark\" \"src/routes/auth/$f/+page.svelte\"; done","time":{"start":1791395612285,"end":1791395612569}},"id":"prt_1177fc52a001pWPR7DRBILNbpk","sessionID":"ses_ee880a7b0ffeIqckXNvh7zeCm7","messageID":"msg_1177f89d0001JkS5YCBC1O4qw1"}}
