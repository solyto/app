g-modal: #3b4252;\n37: \t--color-c-nav-hover: #4c566a;\n38: \t--color-c-nav-active: #5e81ac;\n39: \t--color-c-nav-active-text: #eceff4;\n40: \n41: \t/* Override s-dark palette for dark: prefixed classes */\n42: \t--color-s-dark: #2e3440;\n43: \t--color-s-dark-2: #3b4252;\n44: \t--color-s-dark-3: #434c5e;\n45: \t--color-s-dark-shadow: rgb(46, 52, 64);\n46: \n47: \t/* White — Snow Storm (near-white, keeps text-white legible on buttons) */\n48: \t--color-white: #eceff4;\n49: \n50: \t/* Gray scale — cool blue-gray to match Polar Night / Snow Storm */\n51: \t--color-c-neutral: #323a49;\n52: \t--color-c-neutral-1: #4c566a;\n53: \t--color-c-neutral-2: #434c5e;\n54: \t--color-c-neutral-3: #4c566a;\n55: \t--color-c-neutral-4: #616e88;\n56: \t--color-c-neutral-5: #7b88a1;\n57: \t--color-c-neutral-6: #9aa5b8;\n58: \t--color-c-neutral-7: #b8c5d6;\n59: \t--color-c-neutral-8: #d8dee9;\n60: \t--color-c-neutral-9: #eceff4;\n61: \n62: \t/* Override light-blue utility colors used in borders and subtle backgrounds */\n63: \t--color-d-lightblue: #3b4252;\n64: \t--color-d-lighterblue: #323a49;\n65: \n66: \t/* Nav gradient — subtle Polar Night depth */\n67: \t--t-gradient-colors: #3b4252, #434c5e;\n68: }\n69: \n70: /* Single mode — enforce dark backgrounds regardless of light/dark toggle */\n71: html.dark {\n72: \t--color-c-bg: #2e3440;\n73: \t--color-c-bg-surface: #3b4252;\n74: \t--color-c-bg-elevated: #434c5e;\n75: \t--color-c-bg-modal: #3b4252;\n76: \t--color-c-nav-hover: #4c566a;\n77: \t--color-c-nav-active: #5e81ac;\n78: \t--color-c-nav-active-text: #eceff4;\n79: \t--color-c-neutral: #4c566a;\n80: }\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"/* Nord theme — single mode (always dark)                                    */\n/* Arctic, north-bluish color palette by Arctic Ice Studio.                  */\n/* Polar Night backgrounds, Frost accents, Aurora semantic colors.           */\n/* No font or border-radius changes — colors only.                           