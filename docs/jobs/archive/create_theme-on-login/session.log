lor-c-action: #d08770;\n\t--color-c-action-hover: #ebcb8b;\n\t--color-c-danger: #bf616a;\n\t--color-c-danger-hover: #b48ead;\n\t--color-c-success: #a3be8c;\n\t--color-c-warning: #ebcb8b;\n\n\t/* Background tokens — Polar Night */\n\t--color-c-bg: #2e3440;\n\t--color-c-bg-surface: #3b4252;\n\t--color-c-bg-elevated: #434c5e;\n\t--color-c-bg-modal: #3b4252;\n\t--color-c-nav-hover: #4c566a;\n\t--color-c-nav-active: #5e81ac;\n\t--color-c-nav-active-text: #eceff4;\n\n\t/* Override s-dark palette for dark: prefixed classes */\n\t--color-s-dark: #2e3440;\n\t--color-s-dark-2: #3b4252;\n\t--color-s-dark-3: #434c5e;\n\t--color-s-dark-shadow: rgb(46, 52, 64);\n\n\t/* White — Snow Storm (near-white, keeps text-white legible on buttons) */\n\t--color-white: #eceff4;\n\n\t/* Gray scale — cool blue-gray to match Polar Night / Snow Storm */\n\t--color-c-neutral: #323a49;\n\t--color-c-neutral-1: #4c566a;\n\t--color-c-neutral-2: #434c5e;\n\t--color-c-neutral-3: #4c566a;\n\t--color-c-neutral-4: #616e88;\n\t--color-c-neutral-5: #7b88a1;\n\t--color-c-neutral-6: #9aa5b8;\n\t--color-c-neutral-7: #b8c5d6;\n\t--color-c-neutral-8: #d8dee9;\n\t--color-c-neutral-9: #eceff4;\n\n\t/* Override light-blue utility colors used in borders and subtle backgrounds */\n\t--color-d-lightblue: #3b4252;\n\t--color-d-lighterblue: #323a49;\n\n\t/* Nav gradient — subtle Polar Night depth */\n\t--t-gradient-colors: #3b4252, #434c5e;\n}\n\n/* Single mode — enforce dark backgrounds regardless of light/dark toggle */\nhtml.dark {\n\t--color-c-bg: #2e3440;\n\t--color-c-bg-surface: #3b4252;\n\t--color-c-bg-elevated: #434c5e;\n\t--color-c-bg-modal: #3b4252;\n\t--color-c-nav-hover: #4c566a;\n\t--color-c-nav-active: #5e81ac;\n\t--color-c-nav-active-text: #eceff4;\n\t--color-c-neutral: #4c566a;\n}","lineStart":1,"lineEnd":80,"totalLines":80,"truncated":false}},"title":"static/themes/nord/nord.css","time":{"start":1791395257833,"end":1791395257868}},"id":"prt_1177a5d94001PQ67yjSXJqxx03","sessionID":"ses_ee885d62fffegfYx4e