{"type":"tool_use","timestamp":1791394622286,"sessionID":"ses_ee88fe25bffe2xhvlL8jpyAcF9","part":{"type":"tool","tool":"read","callID":"call_00_YjU74Pni8IlEx91WfZPQ3036","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Theme.svelte.ts"},"output":"<path>/workspace/src/lib/state/Theme.svelte.ts</path>\n<type>file</type>\n<content>\n1: import { getContext, setContext } from 'svelte';\n2: import { themes, type Theme } from '$lib/config/themes';\n3: import LocalStorageService from '$lib/services/LocalStorageService';\n4: \n5: export class ThemeState {\n6: \tstatic readonly LS_THEME_KEY: string = 'theme';\n7: \tstatic readonly LS_ANIMATIONS_KEY: string = 'animations';\n8: \n9: \ttheme = $state<Theme>(themes[0]);\n10: \tanimations = $state<boolean>(true);\n11: \tlink: HTMLLinkElement | null = null;\n12: \tmediaQuery: MediaQueryList | null = null;\n13: \tdarkListener: ((e: MediaQueryListEvent) => void) | null = null;\n14: \tlocalStorage = new LocalStorageService();\n15: \n16: \tload(): void {\n17: \t\tconst saved = this.localStorage.get(ThemeState.LS_THEME_KEY) ?? 'default';\n18: \t\tthis.apply(themes.find((t) => t.id === saved) ?? themes[0]);\n19: \n20: \t\tconst savedAnimations = this.localStorage.getBool(ThemeState.LS_ANIMATIONS_KEY);\n21: \t\tthis.applyAnimations(savedAnimations ?? true);\n22: \t}\n23: \n24: \tsetTheme(theme: Theme): void {\n25: \t\tthis.localStorage.set(ThemeState.LS_THEME_KEY, theme.id);\n26: \t\tthis.apply(theme);\n27: \t}\n28: \n29: \tsetAnimations(enabled: boolean): void {\n30: \t\tthis.localStorage.setBool(ThemeState.LS_ANIMATIONS_KEY, enabled);\n31: \t\tthis.applyAnimations(enabled);\n32: \t}\n33: \n34: \tapplyAnimations(enabled: boolean): void {\n35: \t\tthis.animations = enabled;\n36: \t\tdocument.documentElement.classList.toggle('no-animations', !enabled);\n37: \t\tif (!enabled) ThemeState.patchAnimate();\n38: \t}\n39: \n40: \tprivate static animatePatched = false;\n41: \n42: \tstatic patchAnimate(): void {\n43: \t\tif (ThemeState.animatePatched) return;\n44: \t\tThemeState.animatePatched = true;\n45: \n46: \t\tconst original = Element.prototype.animate;\n47: \t\tElement.prototype.animate = function (keyframes, options) {\n48: \t\t\tif (document.documentElement.classList.contains('no-animations')) {\n49: \t\t\t\tif (typeof options === 'object' && options !== null) {\n50: \t\t\t\t\toptions = { ...options, duration: 0, delay: 0 };\n51: \t\t\t\t} else {\n52: \t\t\t\t\toptions = 0;\n53: \t\t\t\t}\n54: \t\t\t}\n55: \t\t\treturn original.call(this, keyframes, options);\n56: \t\t};\n57: \t}\n58: \n59: \tapply(theme: Theme): void {\n60: \t\tthis.theme = theme;\n61: \n62: \t\tthis.link?.remove();\n63: \t\tif (theme.id !== 'default') {\n64: \t\t\tthis.link = document.createElement('link');\n65: \t\t\tthis.link.rel = 'stylesheet';\n66: \t\t\tthis.link.href = `/themes/${theme.id}/${theme.id}.css`;\n67: \t\t\tdocument.head.appendChild(this.link);\n68: \t\t}\n69: \n70: \t\tif (this.mediaQuery && this.darkListener) {\n71: \t\t\tthis.mediaQuery.removeEventListener('change', this.darkListener);\n72: \t\t\tthis.darkListener = null;\n73: \t\t}\n74: \n75: \t\tif (theme.supportsDarkMode) {\n76: \t\t\tthis.mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');\n77: \t\t\tthis.darkListener = (e) => this.applyDark(e.matches);\n78: \t\t\tthis.mediaQuery.addEventListener('change', this.darkListener);\n79: \t\t\tthis.applyDark(this.mediaQuery.matches);\n80: \t\t} else {\n81: \t\t\tdocument.documentElement.classList.remove('dark');\n82: \t\t}\n83: \t}\n84: \n85: \tapplyDark(dark: boolean): void {\n86: \t\tdocument.documentElement.classList.toggle('dark', dark);\n87: \t}\n88: }\n89: \n90: const THEME_KEY = Symbol('SOLYTO_THEME');\n91: \n92: export function setThemeState(): ThemeState {\n93: \treturn setContext(THEME_KEY, new ThemeState());\n94: }\n95: \n96: export function getThemeState(): ThemeState {\n97: \treturn getContext<ThemeState>(THEME_KEY);\n98: }\n\n(End of file - total 98 lines)\n</content>","metadata":{"preview":"import { getContext, setContext } from 'svelte';\nimport { themes, type Theme } from '$lib/config/themes';\nimport LocalStorageService from '$lib/services/LocalStorageService';\n\nexport class ThemeState {\n\tstatic readonly LS_THEME_KEY: string = 'theme';\n\tstatic readonly LS_ANIMATIONS_KEY: string = 'animations';\n\n\ttheme = $state<Theme>(themes[0]);\n\tanimations = $state<boolean>(true);\n\tlink: HTMLLinkElement | null = null;\n\tmediaQuery: MediaQueryList | null = null;\n\tdarkListener: ((e: MediaQueryListEvent) => void) | null = null;\n\tlocalStorage = new LocalStorageService();\n\n\tload(): void {\n\t\tconst saved = this.localStorage.get(ThemeState.LS_THEME_KEY) ?? 'default';\n\t\tthis.apply(themes.find((t) => t.id === saved) ?? themes[0]);\n\n\t\tconst savedAnimations = this.localStorage.getBool(ThemeState.LS_ANIMATIONS_KEY);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Theme.svelte.ts","text":"import { getContext, setContext } from 'svelte';\nimport { themes, type Theme } from '$lib/config/themes';\nimport LocalStorageService from '$lib/services/LocalStorageService';\n\nexport class ThemeState {\n\tstatic readonly LS_THEME_KEY: string = 'theme';\n\tstatic readonly LS_ANIMATIONS_KEY: string = 'animations';\n\n\ttheme = $state<Theme>(themes[0]);\n\tanimations = $state<boolean>(true);\n\tlink: HTMLLinkElement | null = null;\n\tmediaQuery: MediaQueryList | null = null;\n\tdarkListener: ((e: MediaQueryListEvent) => void) | null = null;\n\tlocalStorage = new LocalStorageService();\n\n\tload(): void {\n\t\tconst saved = this.localStorage.get(ThemeState.LS_THEME_KEY) ?? 'default';\n\t\tthis.apply(themes.find((t) => t.id === saved) ?? themes[0]);\n\n\t\tconst savedAnimations = this.localStorage.getBool(ThemeState.LS_ANIMATIONS_KEY);\n\t\tthis.applyAnimations(savedAnimations ?? true);\n\t}\n\n\tsetTheme(theme: Theme): void {\n\t\tthis.localStorage.set(ThemeState.LS_THEME_KEY, theme.id);\n\t\tthis.apply(theme);\n\t}\n\n\tsetAnimations(enabled: boolean): void {\n\t\tthis.localStorage.setBool(ThemeState.LS_ANIMATIONS_KEY, enabled);\n\t\tthis.applyAnimations(enabled);\n\t}\n\n\tapplyAnimations(enabled: boolean): void {\n\t\tthis.animations = enabled;\n\t\tdocument.documentElement.classList.toggle('no-animations', !enabled);\n\t\tif (!enabled) ThemeState.patchAnimate();\n\t}\n\n\tprivate static animatePatched = false;\n\n\tstatic patchAnimate(): void {\n\t\tif (ThemeState.animatePatched) return;\n\t\tThemeState.animatePatched = true;\n\n\t\tconst original = Element.prototype.animate;\n\t\tElement.prototype.animate = function (keyframes, options) {\n\t\t\tif (document.documentElement.classList.contains('no-animations')) {\n\t\t\t\tif (typeof options === 'object' && options !== null) {\n\t\t\t\t\toptions = { ...options, duration: 0, delay: 0 };\n\t\t\t\t} else {\n\t\t\t\t\toptions = 0;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn original.call(this, keyframes, options);\n\t\t};\n\t}\n\n\tapply(theme: Theme): void {\n\t\tthis.theme = theme;\n\n\t\tthis.link?.remove();\n\t\tif (theme.id !== 'default') {\n\t\t\tthis.link = document.createElement('link');\n\t\t\tthis.link.rel = 'stylesheet';\n\t\t\tthis.link.href = `/themes/${theme.id}/${theme.id}.css`;\n\t\t\tdocument.head.appendChild(this.link);\n\t\t}\n\n\t\tif (this.mediaQuery && this.darkListener) {\n\t\t\tthis.mediaQuery.removeEventListener('change', this.darkListener);\n\t\t\tthis.darkListener = null;\n\t\t}\n\n\t\tif (theme.supportsDarkMode) {\n\t\t\tthis.mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');\n\t\t\tthis.darkListener = (e) => this.applyDark(e.matches);\n\t\t\tthis.mediaQuery.addEventListener('change', this.darkListener);\n\t\t\tthis.applyDark(this.mediaQuery.matches);\n\t\t} else {\n\t\t\tdocument.documentElement.classList.remove('dark');\n\t\t}\n\t}\n\n\tapplyDark(dark: boolean): void {\n\t\tdocument.documentElement.classList.toggle('dark', dark);\n\t}\n}\n\nconst THEME_KEY = Symbol('SOLYTO_THEME');\n\nexport function setThemeState(): ThemeState {\n\treturn setContext(THEME_KEY, new ThemeState());\n}\n\nexport function getThemeState(): ThemeState {\n\treturn getContext<ThemeState>(THEME_KEY);\n}","lineStart":1,"lineEnd":98,"totalLines":98,"truncated":false}},"title":"src/lib/state/Theme.svelte.ts","time":{"start":1791394622202,"end":1791394622282}},"id":"prt_11770aaa9001yqLDqlc1R2s55T","sessionID":"ses_ee88fe25bffe2xhvlL8jpyAcF9","messageID":"msg_117709275001zPPRa6nSgYWzL8"}}
