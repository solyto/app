*/\n\n:root {\n\t/* Fonts — overrides the base html font-family per theme */\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t/* Shadows — deep polar night tint */\n\t--shadow-xs: 0 1px 2px 0 rgb(46 52 64 / 0.8);\n\t--shadow-sm: 0 1px 3px 0 rgb(46 52 64 / 0.7), 0 1px 2px -1px rgb(46 52 64 / 0.5);\n\t--shadow-md: 0 4px 6px -1px rgb(46 52 64 / 0.7), 0 2px 4px -2px rgb(46 52 64 / 0.5);\n\t--shadow-lg: 0 10px 15px -3px rgb(46 52 64 / 0.7), 0 4px 6px -4px rgb(46 52 64 / 0.5);\n\t--drop-shadow-sm: 0 1px 2px rgb(46 52 64 / 0.8);\n\t--drop-shadow-md: 0 3px 3px rgb(46 52 64 / 0.6);\n\n\t/* Semantic color tokens — Frost for UI, Aurora for states */\n\t--color-c-primary: #88c0d0;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/static/themes/nord/nord.css","text":"/* Nord theme — single mode (always dark)                                    */\n/* Arctic, north-bluish color palette by Arctic Ice Studio.                  */\n/* Polar Night backgrounds, Frost accents, Aurora semantic colors.           */\n/* No font or border-radius changes — colors only.                           */\n\n:root {\n\t/* Fonts — overrides the base html font-family per theme */\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t/* Shadows — deep polar night tint */\n\t--shadow-xs: 0 1px 2px 0 rgb(46 52 64 / 0.8);\n\t--shadow-sm: 0 1px 3px 0 rgb(46 52 64 / 0.7), 0 1px 2px -1px rgb(46 52 64 / 0.5);\n\t--shadow-md: 0 4px 6px -1px rgb(46 52 64 / 0.7), 0 2px 4px -2px rgb(46 52 64 / 0.5);\n\t--shadow-lg: 0 10px 15px -3px rgb(46 52 64 / 0.7), 0 4px 6px -4px rgb(46 52 64 / 0.5);\n\t--drop-shadow-sm: 0 1px 2px rgb(46 52 64 / 0.8);\n\t--drop-shadow-md: 0 3px 3px rgb(46 52 64 / 0.6);\n\n\t/* Semantic color tokens — Frost for UI, Aurora for states */\n\t--color-c-primary: #88c0d0;\n\t--color-c-heading: #81a1c1;\n\t--color-c-heading-base: #eceff4;\n\t--color-c-btn: #4c566a;\n\t--color-c-btn-hover: #5e81ac;\n\t--co