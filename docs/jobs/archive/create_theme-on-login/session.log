out[y]\n    for x in range(w):\n        o=x*bpp\n        r,g,b=line[o],line[o+1],line[o+2]\n        if r>235 and g>235 and b>235:\n            if x<minx:minx=x\n            if x>maxx:maxx=x\n            if y<miny:miny=y\n            if y>maxy:maxy=y\nprint('white bbox', minx,miny,maxx,maxy, 'size', (maxx-minx+1),(maxy-miny+1))\n# sample center\nfor (sx,sy) in [(486,494),(486,100),(100,494),(486,900),(200,300),(700,300)]:\n    o=(sy*w+sx)*bpp; print((sx,sy), tuple(out[sy][o:o+3]))\nEOF"},"output":"top colors:\n(53, 61, 74) 96423\n(235, 238, 244) 6442\n(69, 77, 94) 2068\n(77, 87, 106) 1044\n(52, 60, 73) 196\n(61, 68, 83) 93\n(234, 237, 243) 84\n(227, 229, 235) 78\n(238, 250, 251) 10\n(55, 61, 74) 10\n(97, 110, 135) 8\n(53, 61, 77) 8\n(53, 63, 88) 8\n(231, 234, 240) 7\n(234, 238, 244) 5\nnear-white fraction 0.00013986013986013986\nwhite bbox 512 560 555 573 size 44 14\n(486, 494) ()\n(486, 100) ()\n(100, 494) ()\n(486, 900) ()\n(200, 300) ()\n(700, 300) ()\n","metadata":{"output":"top colors:\n(53, 61, 74) 96423\n(235, 238, 244) 6442\n(69, 77, 94) 2068\n(77, 87, 106) 1044\n(52, 60, 73) 196\n(61, 68, 83) 93\n(234, 237, 243) 84\n(227, 229, 235) 78\n(238, 250, 251) 10\n(55, 61, 74) 10\n(97, 110, 135) 8\n(53, 61, 77) 8\n(53, 63, 88) 8\n(231, 234, 240) 7\n(234, 238, 244) 5\nnear-white fraction 0.00013986013986013986\nwhite bbox 512 560 555 573 size 44 14\n(486, 494) ()\n(486, 100) ()\n(100, 494) ()\n(486, 900) ()\n(200, 300) ()\n(700, 300) ()\n","exit":0,"truncated":false},"title":"cd /tmp && python3 - <<'EOF'\nimport struct, zlib\nfrom collections import Counter\ndata = open('brief-screenshot.png','rb').read()\npos=8; idat=b''\nwhile pos < len(data):\n    ln = struct.unpack('>I', data[pos:pos+4])[0]\n    typ = data[pos+4:pos+8]\n    chunk = data[pos+8:pos+8+ln]\n    if typ==b'IHDR':\n        w,h,bd,ct,comp,filt,inter = struct.unpack('>IIBBBBB', chunk)\n    if typ==b'IDAT': idat+=chunk\n    pos += 12+ln\nraw = zlib.decompress(idat)\nbpp=4; stride=w*bpp\nprev=bytearray(strid