r = $state<boolean>(false);\n38: \tlet password = $state<string>('');\n39: \tlet passwordError = $state<boolean>(false);\n40: \tlet error = $state<boolean>(false);\n41: \tlet passkeySupported = $state(false);\n42: \n43: \tonMount(() => {\n44: \t\tif (auth.loggedIn) goto(resolve(urls.home));\n45: \t\tpasskeySupported = typeof window !== 'undefined' && !!window.PublicKeyCredential;\n46: \t});\n47: \n48: \tasync function onsubmit(e: SubmitEvent): Promise<void> {\n49: \t\te.preventDefault();\n50: \n51: \t\tif (!validateInput()) return;\n52: \n53: \t\tloadingIndicator.start();\n54: \t\tlet success = await auth.login(email, password);\n55: \t\tloadingIndicator.stop();\n56: \n57: \t\tif (success) {\n58: \t\t\tts.loadLanguage();\n59: \t\t\tnotifications.success(ts.get.auth.login_success);\n60: \t\t\tawait goto(resolve(urls.home));\n61: \t\t} else {\n62: \t\t\tnotifications.error(ts.get.auth.login_error);\n63: \t\t\terror = true;\n64: \t\t}\n65: \t}\n66: \n67: \tasync function signInWithPasskey(): Promise<void> {\n68: \t\tloadingIndicator.start();\n69: \t\ttry {\n70: \t\t\tconst options = await auth.passkeyAuthenticationOptions();\n71: \t\t\tif (!options) throw new Error('No options');\n72: \t\t\tconst response = await startAuthentication({ optionsJSON: options });\n73: \t\t\tawait auth.passkeyAuthenticate(response);\n74: \t\t\tts.loadLanguage();\n75: \t\t\tnotifications.success(ts.get.auth.login_success);\n76: \t\t\tawait goto(resolve(urls.home));\n77: \t\t} catch (e) {\n78: \t\t\tnotifications.error(ts.get.auth.passkey_error);\n79: \t\t} finally {\n80: \t\t\tloadingIndicator.stop();\n81: \t\t}\n82: \t}\n83: \n84: \tfunction validateInput(): boolean {\n85: \t\temailError = false;\n86: \t\tpasswordError = false;\n87: \t\temailError = email === '';\n88: \t\tpasswordError = password === '';\n89: \t\terror = passwordError || emailError;\n90: \n91: \t\treturn !(emailError || passwordError);\n92: \t}\n93: </script>\n94: \n95: {#if PLATFORM !== 'web'}\n96: \t<a\n97: \t\thref={urls