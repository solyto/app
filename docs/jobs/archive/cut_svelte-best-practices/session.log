formatTime(input: string | Date, timeFormat: string | null = null): string {\n89:export function formatDateWithWeekday(\n100:export function formatTimeWithSeconds(\n135:export function getUrlFormat(date: Date): string {\n","exit":0,"truncated":false},"title":"cd /workspace && echo \"=== server files ===\" && find src/routes -name '*server*' -o -name '+page.ts' -o -name '+layout.ts' | head && echo \"=== load functions ===\" && grep -rn 'export const load' src/routes | head && echo \"=== helpers defaults ===\" && grep -c 'export default\\|export function\\|export const' src/lib/helpers/*.ts 2>/dev/null | head -5 && echo \"=== sample helper funcs ===\" && grep -nE 'export function' src/lib/helpers/DateHelper.ts | head -8","time":{"start":1791639870000,"end":1791639870048}},"id":"prt_1260ed516001bZbU3G2sM5rJZ3","sessionID":"ses_ed9f4bacaffe2fU0aQS8EF17gR","messageID":"msg_1260ea71a001MXEzqMACaNs7qj"}}
