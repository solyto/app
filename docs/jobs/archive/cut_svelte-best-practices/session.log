{"type":"tool_use","timestamp":1791639533224,"sessionID":"ses_ed9f6a1a9ffeKSNlfjObVylAL2","part":{"type":"tool","tool":"read","callID":"call_00_jGXQtDj1CwKnNdO3wu3L9873","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Todos.svelte.ts"},"output":"<path>/workspace/src/lib/state/Todos.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tTodo,\n3: \tTodoCategory,\n4: \tTodoFilter,\n5: \tTodoPriority,\n6: \tCreateTodoRequest,\n7: \tTodoEffort,\n8: \tTodoRecurrenceFrequency,\n9: \tTodoStatus,\n10: \tGroupedTodos,\n11: \tTodoFilterType,\n12: \tTodoWorkspace,\n13: \tCreateTodoCategoryRequest,\n14: \tUpdateTodoCategoryRequest,\n15: \tCreateTodoWorkspaceRequest,\n16: \tUpdateTodoWorkspaceRequest,\n17: \tUpdateTodoRequest,\n18: \tCreateTodoSubtaskRequest,\n19: \tTodoSubtask,\n20: \tUpdateTodoSubtaskRequest\n21: } from '$lib/types/todo';\n22: import type { Tag } from '$lib/types/tag';\n23: import type { Auth } from '$lib/state/Auth.svelte';\n24: import { setContext, getContext } from 'svelte';\n25: import { getAuth } from '$lib/state/Auth.svelte';\n26: import { page } from '$app/state';\n27: import TodoFilterService from '$lib/services/TodoFilterService';\n28: import TodoGroupingService from '$lib/services/TodoGroupingService';\n29: import TodoSortingService from '$lib/services/TodoSortingService';\n30: import ApiService from '$lib/services/ApiService';\n31: import { apiRoutes } from '$lib/config/apiRoutes';\n32: import TodoRelevanceService from '$lib/services/TodoRelevanceService';\n33: import LocalStorageService from '$lib/services/LocalStorageService';\n34: import { SvelteDate } from 'svelte/reactivity';\n35: \n36: export class Todos {\n37: \tstatic readonly LS_HIDE_IT_KEY: string = 'todos_hideit';\n38: \n39: \tloaded = $state<boolean>(false);\n40: \ttodos = $state<Todo[]>([]);\n41: \tfilteredTodos = $state<Todo[]>([]);\n42: \tgroupedTodos = $state<GroupedTodos[]>([]);\n43: \tcategories = $state<TodoCategory[]>([]);\n44: \tfilteredCategories = $state<TodoCategory[]>([]);\n45: \tworkspaces = $state<TodoWorkspace[]>([]);\n46: \tactiveWorkspace = $state<TodoWorkspace | null>(null);\n47: \tactiveFilters = $state<TodoFilter[]>([]);\n48: \tview = $state<'list' | 'kanban' | 'overview' | 'card'>('list');\n49: \tsortByScore = $state<boolean>(false);\n50: \ttodosScored = $state<boolean>(false);\n51: \thideItActive = $state<boolean>(false);\n52: \trecentlyCreated = $state<string | null>(null);\n53: \tquickCreateOpen = $state<boolean>(false);\n54: \tauth: Auth;\n55: \tapiService: ApiService;\n56: \tlocalStorage: LocalStorageService;\n57: \tfilterService = new TodoFilterService();\n58: \tsortingService = new TodoSortingService();\n59: \tgroupingService = new TodoGroupingService();\n60: \trelevanceService = new TodoRelevanceService();\n61: \n62: \tconstructor(\n63: \t\tauth: Auth = getAuth(),\n64: \t\tapiService: ApiService = auth.apiService,\n65: \t\tlocalStorage: LocalStorageService = new LocalStorageService()\n66: \t) {\n67: \t\tthis.auth = auth;\n68: \t\tthis.apiService = apiService;\n69: \t\tthis.localStorage = localStorage;\n70: \n71: \t\t// Restore synchronously so every filter pass (including the ones run by\n72: \t\t// load() before the workspaces request resolves) already sees the\n73: \t\t// persisted value instead of the default false.\n74: \t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n75: \t}\n76: \n77: \tasync load(): Promise<void> {\n78: \t\tconst res = await this.apiService.list(apiRoutes.todos.list);\n79: \n80: \t\tif (res) {\n81: \t\t\tthis.loaded = true;\n82: \t\t\tthis.todos = res.data as Todo[];\n83: \t\t\tthis.filteredTodos = this.todos;\n84: \t\t\tthis.checkUrlForFilter();\n85: \t\t}\n86: \n87: \t\tif (this.sortByScore) {\n88: \t\t\tthis.loadScores();\n89: \t\t} else {\n90: \t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n91: \t\t}\n92: \n93: \t\tthis.groupByStatus();\n94: \n95: \t\ttry {\n96: \t\t\tawait Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n97: \t\t} finally {\n98: \t\t\t// Always re-apply hide-it once the parallel loads settled: a failed\n99: \t\t\t// or rejected workspaces/categories request must not skip this.\n100: \t\t\tthis.loadHideIt();\n101: \t\t}\n102: \t}\n103: \n104: \tasync loadCategories(): Promise<void> {\n105: \t\tconst res = await this.apiService.list(apiRoutes.todos.listCategories);\n106: \n107: \t\tif (res) this.categories = res.data as TodoCategory[];\n108: \t\tthis.categories = this.sortingService.sortCategories(this.categories);\n109: \t\tthis.filteredCategories = this.categories;\n110: \t}\n111: \n112: \tasync loadWorkspaces(retries: number = 1): Promise<void> {\n113: \t\t// Treated like a failed request (null) so a network error gets the same\n114: \t\t// single retry as a non-ok response. An empty workspaces list would\n115: \t\t// silently disable hide-it filtering for the whole page lifetime.\n116: \t\tconst res = await this.apiService.list(apiRoutes.todos.listWorkspaces).catch(() => null);\n117: \n118: \t\tif (res) {\n119: \t\t\tthis.workspaces = res.data as TodoWorkspace[];\n120: \t\t\treturn;\n121: \t\t}\n122: \n123: \t\tif (retries > 0) {\n124: \t\t\tawait this.loadWorkspaces(retries - 1);\n125: \t\t}\n126: \t}\n127: \n128: \tchangeView(view: 'list' | 'kanban' | 'overview' | 'card'): void {\n129: \t\tthis.view = view;\n130: \t}\n131: \n132: \ttoggleSortByScore(): void {\n133: \t\tif (!this.sortByScore) {\n134: \t\t\tthis.loadScores();\n135: \t\t} else {\n136: \t\t\tthis.useFilters(this.activeFilters);\n137: \t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n138: \t\t}\n139: \n140: \t\tthis.groupByStatus();\n141: \n142: \t\tthis.sortByScore = !this.sortByScore;\n143: \t}\n144: \n145: \tloadScores(): void {\n146: \t\tthis.todos = this.relevanceService.getScoredTodos(this.todos);\n147: \t\tthis.todosScored = true;\n148: \t\tthis.useFilters(this.activeFilters);\n149: \t\tthis.filteredTodos = this.sortingService.sortByScore(this.filteredTodos);\n150: \t}\n151: \n152: \tgroupByStatus(): void {\n153: \t\tthis.groupedTodos = this.groupingService.groupByStatus(this.filteredTodos);\n154: \t}\n155: \n156: \tcheckUrlForFilter(): void {\n157: \t\tconst type = page.url.searchParams.get('filterType'),\n158: \t\t\tvalue: string | number | null = page.url.searchParams.get('filterValue');\n159: \n160: \t\tif (type && value) {\n161: \t\t\tif (type !== 'workspace') {\n162: \t\t\t\tthis.addFilter({ type: type as TodoFilterType, value });\n163: \t\t\t}\n164: \t\t}\n165: \n166: \t\tthis.useFilters(this.activeFilters);\n167: \t}\n168: \n169: \tuseFilters(filters: TodoFilter[]): void {\n170: \t\t// Set before the hide-it guard below (which reads it via\n171: \t\t// isCategoryFilterActive()/isTagFilterActive()) so that guard reflects\n172: \t\t// the filters being applied, not the previous selection.\n173: \t\tthis.activeFilters = filters;\n174: \t\tthis.filteredTodos = this.todos;\n175: \n176: \t\tconst visibilityThreshold = new SvelteDate();\n177: \t\tvisibilityThreshold.setDate(visibilityThreshold.getDate() + 3);\n178: \t\tthis.filteredTodos = this.filteredTodos.filter(\n179: \t\t\t(t) =>\n180: \t\t\t\t!t.auto_generated ||\n181: \t\t\t\tt.due_at === null ||\n182: \t\t\t\tnew SvelteDate(t.due_at) <= visibilityThreshold\n183: \t\t);\n184: \n185: \t\tif (!filters.some((f) => f.type === 'status' && f.value === 'backlog')) {\n186: \t\t\tthis.filteredTodos = this.filterService.filterOutBacklog(this.filteredTodos);\n187: \t\t}\n188: \n189: \t\tif (\n190: \t\t\tthis.hideItActive &&\n191: \t\t\tthis.activeWorkspace === null &&\n192: \t\t\t!this.isCategoryFilterActive() &&\n193: \t\t\t!this.isTagFilterActive()\n194: \t\t) {\n195: \t\t\tthis.filteredTodos = this.filterService.filterByHideIt(\n196: \t\t\t\tthis.filteredTodos,\n197: \t\t\t\tthis.workspaces\n198: \t\t\t);\n199: \t\t}\n200: \n201: \t\tfor (const filter of filters) {\n202: \t\t\tthis.filteredTodos = this.filterService.filter(filter, this.filteredTodos);\n203: \t\t}\n204: \n205: \t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n206: \t\tthis.groupByStatus();\n207: \t}\n208: \n209: \tfilterCategories(): void {\n210: \t\tif (this.hideItActive) {\n211: \t\t\tthis.filteredCategories = this.filterService.filterCategoriesByHideIt(\n212: \t\t\t\tthis.categories,\n213: \t\t\t\tthis.workspaces\n214: \t\t\t);\n215: \t\t} else {\n216: \t\t\tthis.filteredCategories = this.categories;\n217: \t\t}\n218: \t}\n219: \n220: \taddFilter(filter: TodoFilter): void {\n221: \t\tthis.activeFilters.push(filter);\n222: \t}\n223: \n224: \tremoveFilter(filter: TodoFilter): void {\n225: \t\tthis.activeFilters = this.activeFilters.filter((f) => f !== filter);\n226: \t}\n227: \n228: \tclearFilters(): void {\n229: \t\tthis.activeFilters = [];\n230: \t}\n231: \n232: \tisFilterActive(filter: TodoFilter): boolean {\n233: \t\treturn this.activeFilters.some((f) => f.type === filter.type && f.value === filter.value);\n234: \t}\n235: \n236: \tisCategoryFilterActive(): boolean {\n237: \t\treturn this.activeFilters.some((f) => f.type === 'category');\n238: \t}\n239: \n240: \tisTagFilterActive(): boolean {\n241: \t\treturn this.activeFilters.some((f) => f.type === 'tag');\n242: \t}\n243: \n244: \ttoggleHideIt(): void {\n245: \t\tthis.hideItActive = !this.hideItActive;\n246: \t\tthis.useFilters(this.activeFilters);\n247: \t\tthis.filterCategories();\n248: \n249: \t\tthis.localStorage.setBool(Todos.LS_HIDE_IT_KEY, this.hideItActive);\n250: \t}\n251: \n252: \tloadHideIt(): void {\n253: \t\t// Re-reads storage so a toggle issued while load() was still in flight\n254: \t\t// wins over the constructor restore, then re-applies the filters now\n255: \t\t// that workspaces (which decide what hide-it removes) are loaded.\n256: \t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n257: \t\tif (this.hideItActive) {\n258: \t\t\tthis.filterCategories();\n259: \t\t\tthis.useFilters(this.activeFilters);\n260: \t\t}\n261: \t}\n262: \n263: \tasync quickCreate(input: string): Promise<{ ok: boolean; recurrenceIgnored: boolean }> {\n264: \t\tconst recurrenceIgnored = /repeat:/i.test(input) && !/due:/i.test(input);\n265: \n266: \t\tconst request: CreateTodoRequest = { title: input };\n267: \n268: \t\tif (this.activeFilters.some((f) => f.type === 'tag')) {\n269: \t\t\trequest.tags = [this.activeFilters.find((f) => f.type === 'tag')?.value as number];\n270: \t\t}\n271: \n272: \t\tif (this.activeFilters.some((f) => f.type === 'category')) {\n273: \t\t\trequest.category_id = this.activeFilters.find((f) => f.type === 'category')\n274: \t\t\t\t?.value as number;\n275: \t\t}\n276: \n277: \t\tconst res = await this.apiService.create(apiRoutes.todos.create, request);\n278: \n279: \t\tif (res) {\n280: \t\t\tconst todo = res.data as Todo;\n281: \t\t\tthis.recentlyCreated = todo.id;\n282: \t\t\tawait this.load();\n283: \n284: \t\t\tsetTimeout(() => {\n285: \t\t\t\tthis.recentlyCreated = null;\n286: \t\t\t}, 10000);\n287: \n288: \t\t\treturn Promise.resolve({ ok: true, recurrenceIgnored });\n289: \t\t}\n290: \n291: \t\treturn Promise.resolve({ ok: false, recurrenceIgnored: false });\n292: \t}\n293: \n294: \tasync delete(todo: Todo): Promise<boolean> {\n295: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.delete, todo.id);\n296: \t\tif (ok) await this.load();\n297: \t\treturn ok;\n298: \t}\n299: \n300: \tasync createCategory(title: string): Promise<TodoCategory | null> {\n301: \t\tconst request: CreateTodoCategoryRequest = { title };\n302: \t\tconst res = await this.apiService.create(apiRoutes.todos.createCategory, request);\n303: \t\tif (res) await this.loadCategories();\n304: \t\treturn res ? (res.data as TodoCategory) : null;\n305: \t}\n306: \n307: \tasync updateCategory(\n308: \t\tcategory: TodoCategory,\n309: \t\trequest: UpdateTodoCategoryRequest\n310: \t): Promise<boolean> {\n311: \t\tconst res = await this.apiService.update(\n312: \t\t\tapiRoutes.todos.updateCategory,\n313: \t\t\tcategory.id,\n314: \t\t\trequest\n315: \t\t);\n316: \t\tif (res) await Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n317: \t\treturn res;\n318: \t}\n319: \n320: \tasync deleteCategory(category: TodoCategory): Promise<boolean> {\n321: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteCategory, category.id);\n322: \t\tif (ok) await this.loadCategories();\n323: \t\treturn ok;\n324: \t}\n325: \n326: \tasync createWorkspace(title: string): Promise<boolean> {\n327: \t\tconst request: CreateTodoWorkspaceRequest = { title };\n328: \t\tconst res = await this.apiService.create(apiRoutes.todos.createWorkspace, request);\n329: \t\tif (res) await this.loadWorkspaces();\n330: \t\treturn Promise.resolve(res !== null);\n331: \t}\n332: \n333: \tasync deleteWorkspace(workspace: TodoWorkspace): Promise<boolean> {\n334: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteWorkspace, workspace.id);\n335: \t\tif (ok) await this.loadWorkspaces();\n336: \t\treturn ok;\n337: \t}\n338: \n339: \tasync attachCategoryToWorkspace(\n340: \t\tworkspace: TodoWorkspace,\n341: \t\tcategoryId: number\n342: \t): Promise<boolean> {\n343: \t\tconst res = await this.apiService.post(\n344: \t\t\tapiRoutes.todos.attachWorkspaceCategory.replace('%d', workspace.id.toString()),\n345: \t\t\t{ categories: [categoryId] }\n346: \t\t);\n347: \t\tif (res) await this.loadWorkspaces();\n348: \t\treturn Promise.resolve(res !== null);\n349: \t}\n350: \n351: \tasync detachCategoryFromWorkspace(\n352: \t\tworkspace: TodoWorkspace,\n353: \t\tcategoryId: number\n354: \t): Promise<boolean> {\n355: \t\tconst res = await this.apiService.post(\n356: \t\t\tapiRoutes.todos.detachWorkspaceCategory.replace('%d', workspace.id.toString()),\n357: \t\t\t{ categories: [categoryId] }\n358: \t\t);\n359: \t\tif (res) await this.loadWorkspaces();\n360: \t\treturn Promise.resolve(res !== null);\n361: \t}\n362: \n363: \tasync updateWorkspace(\n364: \t\tworkspace: TodoWorkspace,\n365: \t\trequest: UpdateTodoWorkspaceRequest\n366: \t): Promise<boolean> {\n367: \t\tconst res = await this.apiService.update(\n368: \t\t\tapiRoutes.todos.updateWorkspace,\n369: \t\t\tworkspace.id,\n370: \t\t\trequest\n371: \t\t);\n372: \t\tif (res) await this.loadWorkspaces();\n373: \t\treturn Promise.resolve(res !== null);\n374: \t}\n375: \n376: \tasync changePriority(todo: Todo, priority: TodoPriority): Promise<boolean> {\n377: \t\tconst request: UpdateTodoRequest = { priority };\n378: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n379: \t\tif (res) await this.load();\n380: \t\treturn res;\n381: \t}\n382: \n383: \tasync addTag(todo: Todo, tagId: number): Promise<boolean> {\n384: \t\tconst tagIds = todo.tags.map((t) => t.id);\n385: \t\tconst request: UpdateTodoRequest = {\n386: \t\t\ttags: tagIds.concat([tagId])\n387: \t\t};\n388: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n389: \t\tif (res) await this.load();\n390: \t\treturn res;\n391: \t}\n392: \n393: \tasync removeTag(todo: Todo, tag: Tag): Promise<boolean> {\n394: \t\tconst tagIds = todo.tags.map((t) => t.id);\n395: \t\tconst request: UpdateTodoRequest = {\n396: \t\t\ttags: tagIds.filter((id) => id != tag.id)\n397: \t\t};\n398: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n399: \t\tif (res) await this.load();\n400: \t\treturn res;\n401: \t}\n402: \n403: \tasync addCategory(todo: Todo, categoryId: number): Promise<boolean> {\n404: \t\tconst request: UpdateTodoRequest = { category_id: categoryId };\n405: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n406: \t\tif (res) await this.load();\n407: \t\treturn res;\n408: \t}\n409: \n410: \tasync removeCategory(todo: Todo): Promise<boolean> {\n411: \t\tconst request: UpdateTodoRequest = { category_id: null };\n412: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n413: \t\tif (res) await this.load();\n414: \t\treturn res;\n415: \t}\n416: \n417: \tasync changeCompleted(todo: Todo, checked: boolean): Promise<boolean> {\n418: \t\tconst request: UpdateTodoRequest = { is_completed: checked };\n419: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n420: \t\tif (res) await this.load();\n421: \t\treturn res;\n422: \t}\n423: \n424: \tasync changeEffort(todo: Todo, effort: TodoEffort): Promise<boolean> {\n425: \t\tconst request: UpdateTodoRequest = { effort };\n426: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n427: \t\tif (res) await this.load();\n428: \t\treturn res;\n429: \t}\n430: \n431: \tasync changeStatus(todoId: string, status: TodoStatus): Promise<boolean> {\n432: \t\tconst request: UpdateTodoRequest = { status };\n433: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todoId, request);\n434: \t\tif (res) await this.load();\n435: \t\treturn res;\n436: \t}\n437: \n438: \tasync changeProgress(todo: Todo, progress: number): Promise<boolean> {\n439: \t\tconst request: UpdateTodoRequest = { progress };\n440: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n441: \t\tif (res) await this.load();\n442: \t\treturn res;\n443: \t}\n444: \n445: \tasync changeDue(todo: Todo, due_at: string | null): Promise<boolean> {\n446: \t\tconst request: UpdateTodoRequest = { due_at };\n447: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n448: \t\tif (res) await this.load();\n449: \t\treturn res;\n450: \t}\n451: \n452: \tasync changeRecurrence(\n453: \t\ttodo: Todo,\n454: \t\tfrequency: TodoRecurrenceFrequency | null,\n455: \t\tinterval: number = 1,\n456: \t\tendsAt: string | null = null\n457: \t): Promise<boolean> {\n458: \t\tconst request: UpdateTodoRequest = {\n459: \t\t\trecurrence_frequency: frequency,\n460: \t\t\trecurrence_interval: interval,\n461: \t\t\trecurrence_ends_at: endsAt\n462: \t\t};\n463: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n464: \t\tif (res) await this.load();\n465: \t\treturn res;\n466: \t}\n467: \n468: \tasync changeTitle(todo: Todo, title: string): Promise<boolean> {\n469: \t\tconst request: UpdateTodoRequest = { title };\n470: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n471: \t\tif (res) await this.load();\n472: \t\treturn res;\n473: \t}\n474: \n475: \tasync changeDescription(todo: Todo, description: string): Promise<boolean> {\n476: \t\tconst request: UpdateTodoRequest = { description };\n477: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n478: \t\tif (res) await this.load();\n479: \t\treturn res;\n480: \t}\n481: \n482: \tasync changeLink(todo: Todo, link: string | null): Promise<boolean> {\n483: \t\tconst request: UpdateTodoRequest = { link };\n484: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n485: \t\tif (res) await this.load();\n486: \t\treturn res;\n487: \t}\n488: \n489: \tasync addSubtask(todo: Todo, title: string): Promise<boolean> {\n490: \t\tconst request: CreateTodoSubtaskRequest = { title };\n491: \t\tconst res = await this.apiService.post(\n492: \t\t\tapiRoutes.todos.addSubtask.replace('%s', todo.id),\n493: \t\t\trequest\n494: \t\t);\n495: \t\tif (res) await this.load();\n496: \t\treturn Promise.resolve(res !== null);\n497: \t}\n498: \n499: \tasync changeSubtaskTitle(todo: Todo, subtask: TodoSubtask, title: string): Promise<boolean> {\n500: \t\tconst request: UpdateTodoSubtaskRequest = { title };\n501: \t\tconst res = await this.apiService.put(\n502: \t\t\tapiRoutes.todos.markSubtask.replace('%s', todo.id).replace('%d', subtask.id.toString()),\n503: \t\t\trequest\n504: \t\t);\n505: \t\tif (res) await this.load();\n506: \t\treturn res;\n507: \t}\n508: \n509: \tasync markSubtask(todo: Todo, subtask: TodoSubtask, is_completed: boolean): Promise<boolean> {\n510: \t\tconst request: UpdateTodoSubtaskRequest = { is_completed };\n511: \t\tconst res = await this.apiService.put(\n512: \t\t\tapiRoutes.todos.markSubtask.replace('%s', todo.id).replace('%d', subtask.id.toString()),\n513: \t\t\trequest\n514: \t\t);\n515: \t\tif (res) await this.load();\n516: \t\treturn res;\n517: \t}\n518: \n519: \tasync deleteSubtask(todo: Todo, subtask: TodoSubtask): Promise<boolean> {\n520: \t\tconst res = await this.apiService.delete(\n521: \t\t\tapiRoutes.todos.deleteSubtask.replace('%d', subtask.id.toString()),\n522: \t\t\ttodo.id\n523: \t\t);\n524: \t\tif (res) await this.load();\n525: \t\treturn res;\n526: \t}\n527: }\n528: \n529: const TODOS_KEY = Symbol('SOLYTO_TODOS');\n530: \n531: export function setTodos(): Todos {\n532: \treturn setContext(TODOS_KEY, new Todos());\n533: }\n534: \n535: export function getTodos(): Todos {\n536: \treturn getContext<Todos>(TODOS_KEY);\n537: }\n\n(End of file - total 537 lines)\n</content>","metadata":{"preview":"import type {\n\tTodo,\n\tTodoCategory,\n\tTodoFilter,\n\tTodoPriority,\n\tCreateTodoRequest,\n\tTodoEffort,\n\tTodoRecurrenceFrequency,\n\tTodoStatus,\n\tGroupedTodos,\n\tTodoFilterType,\n\tTodoWorkspace,\n\tCreateTodoCategoryRequest,\n\tUpdateTodoCategoryRequest,\n\tCreateTodoWorkspaceRequest,\n\tUpdateTodoWorkspaceRequest,\n\tUpdateTodoRequest,\n\tCreateTodoSubtaskRequest,\n\tTodoSubtask,\n\tUpdateTodoSubtaskRequest","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Todos.svelte.ts","text":"import type {\n\tTodo,\n\tTodoCategory,\n\tTodoFilter,\n\tTodoPriority,\n\tCreateTodoRequest,\n\tTodoEffort,\n\tTodoRecurrenceFrequency,\n\tTodoStatus,\n\tGroupedTodos,\n\tTodoFilterType,\n\tTodoWorkspace,\n\tCreateTodoCategoryRequest,\n\tUpdateTodoCategoryRequest,\n\tCreateTodoWorkspaceRequest,\n\tUpdateTodoWorkspaceRequest,\n\tUpdateTodoRequest,\n\tCreateTodoSubtaskRequest,\n\tTodoSubtask,\n\tUpdateTodoSubtaskRequest\n} from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\nimport type { Auth } from '$lib/state/Auth.svelte';\nimport { setContext, getContext } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { page } from '$app/state';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport TodoGroupingService from '$lib/services/TodoGroupingService';\nimport TodoSortingService from '$lib/services/TodoSortingService';\nimport ApiService from '$lib/services/ApiService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport TodoRelevanceService from '$lib/services/TodoRelevanceService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { SvelteDate } from 'svelte/reactivity';\n\nexport class Todos {\n\tstatic readonly LS_HIDE_IT_KEY: string = 'todos_hideit';\n\n\tloaded = $state<boolean>(false);\n\ttodos = $state<Todo[]>([]);\n\tfilteredTodos = $state<Todo[]>([]);\n\tgroupedTodos = $state<GroupedTodos[]>([]);\n\tcategories = $state<TodoCategory[]>([]);\n\tfilteredCategories = $state<TodoCategory[]>([]);\n\tworkspaces = $state<TodoWorkspace[]>([]);\n\tactiveWorkspace = $state<TodoWorkspace | null>(null);\n\tactiveFilters = $state<TodoFilter[]>([]);\n\tview = $state<'list' | 'kanban' | 'overview' | 'card'>('list');\n\tsortByScore = $state<boolean>(false);\n\ttodosScored = $state<boolean>(false);\n\thideItActive = $state<boolean>(false);\n\trecentlyCreated = $state<string | null>(null);\n\tquickCreateOpen = $state<boolean>(false);\n\tauth: Auth;\n\tapiService: ApiService;\n\tlocalStorage: LocalStorageService;\n\tfilterService = new TodoFilterService();\n\tsortingService = new TodoSortingService();\n\tgroupingService = new TodoGroupingService();\n\trelevanceService = new TodoRelevanceService();\n\n\tconstructor(\n\t\tauth: Auth = getAuth(),\n\t\tapiService: ApiService = auth.apiService,\n\t\tlocalStorage: LocalStorageService = new LocalStorageService()\n\t) {\n\t\tthis.auth = auth;\n\t\tthis.apiService = apiService;\n\t\tthis.localStorage = localStorage;\n\n\t\t// Restore synchronously so every filter pass (including the ones run by\n\t\t// load() before the workspaces request resolves) already sees the\n\t\t// persisted value instead of the default false.\n\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n\t}\n\n\tasync load(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.todos.list);\n\n\t\tif (res) {\n\t\t\tthis.loaded = true;\n\t\t\tthis.todos = res.data as Todo[];\n\t\t\tthis.filteredTodos = this.todos;\n\t\t\tthis.checkUrlForFilter();\n\t\t}\n\n\t\tif (this.sortByScore) {\n\t\t\tthis.loadScores();\n\t\t} else {\n\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\t}\n\n\t\tthis.groupByStatus();\n\n\t\ttry {\n\t\t\tawait Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n\t\t} finally {\n\t\t\t// Always re-apply hide-it once the parallel loads settled: a failed\n\t\t\t// or rejected workspaces/categories request must not skip this.\n\t\t\tthis.loadHideIt();\n\t\t}\n\t}\n\n\tasync loadCategories(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.todos.listCategories);\n\n\t\tif (res) this.categories = res.data as TodoCategory[];\n\t\tthis.categories = this.sortingService.sortCategories(this.categories);\n\t\tthis.filteredCategories = this.categories;\n\t}\n\n\tasync loadWorkspaces(retries: number = 1): Promise<void> {\n\t\t// Treated like a failed request (null) so a network error gets the same\n\t\t// single retry as a non-ok response. An empty workspaces list would\n\t\t// silently disable hide-it filtering for the whole page lifetime.\n\t\tconst res = await this.apiService.list(apiRoutes.todos.listWorkspaces).catch(() => null);\n\n\t\tif (res) {\n\t\t\tthis.workspaces = res.data as TodoWorkspace[];\n\t\t\treturn;\n\t\t}\n\n\t\tif (retries > 0) {\n\t\t\tawait this.loadWorkspaces(retries - 1);\n\t\t}\n\t}\n\n\tchangeView(view: 'list' | 'kanban' | 'overview' | 'card'): void {\n\t\tthis.view = view;\n\t}\n\n\ttoggleSortByScore(): void {\n\t\tif (!this.sortByScore) {\n\t\t\tthis.loadScores();\n\t\t} else {\n\t\t\tthis.useFilters(this.activeFilters);\n\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\t}\n\n\t\tthis.groupByStatus();\n\n\t\tthis.sortByScore = !this.sortByScore;\n\t}\n\n\tloadScores(): void {\n\t\tthis.todos = this.relevanceService.getScoredTodos(this.todos);\n\t\tthis.todosScored = true;\n\t\tthis.useFilters(this.activeFilters);\n\t\tthis.filteredTodos = this.sortingService.sortByScore(this.filteredTodos);\n\t}\n\n\tgroupByStatus(): void {\n\t\tthis.groupedTodos = this.groupingService.groupByStatus(this.filteredTodos);\n\t}\n\n\tcheckUrlForFilter(): void {\n\t\tconst type = page.url.searchParams.get('filterType'),\n\t\t\tvalue: string | number | null = page.url.searchParams.get('filterValue');\n\n\t\tif (type && value) {\n\t\t\tif (type !== 'workspace') {\n\t\t\t\tthis.addFilter({ type: type as TodoFilterType, value });\n\t\t\t}\n\t\t}\n\n\t\tthis.useFilters(this.activeFilters);\n\t}\n\n\tuseFilters(filters: TodoFilter[]): void {\n\t\t// Set before the hide-it guard below (which reads it via\n\t\t// isCategoryFilterActive()/isTagFilterActive()) so that guard reflects\n\t\t// the filters being applied, not the previous selection.\n\t\tthis.activeFilters = filters;\n\t\tthis.filteredTodos = this.todos;\n\n\t\tconst visibilityThreshold = new SvelteDate();\n\t\tvisibilityThreshold.setDate(visibilityThreshold.getDate() + 3);\n\t\tthis.filteredTodos = this.filteredTodos.filter(\n\t\t\t(t) =>\n\t\t\t\t!t.auto_generated ||\n\t\t\t\tt.due_at === null ||\n\t\t\t\tnew SvelteDate(t.due_at) <= visibilityThreshold\n\t\t);\n\n\t\tif (!filters.some((f) => f.type === 'status' && f.value === 'backlog')) {\n\t\t\tthis.filteredTodos = this.filterService.filterOutBacklog(this.filteredTodos);\n\t\t}\n\n\t\tif (\n\t\t\tthis.hideItActive &&\n\t\t\tthis.activeWorkspace === null &&\n\t\t\t!this.isCategoryFilterActive() &&\n\t\t\t!this.isTagFilterActive()\n\t\t) {\n\t\t\tthis.filteredTodos = this.filterService.filterByHideIt(\n\t\t\t\tthis.filteredTodos,\n\t\t\t\tthis.workspaces\n\t\t\t);\n\t\t}\n\n\t\tfor (const filter of filters) {\n\t\t\tthis.filteredTodos = this.filterService.filter(filter, this.filteredTodos);\n\t\t}\n\n\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\tthis.groupByStatus();\n\t}\n\n\tfilterCategories(): void {\n\t\tif (this.hideItActive) {\n\t\t\tthis.filteredCategories = this.filterService.filterCategoriesByHideIt(\n\t\t\t\tthis.categories,\n\t\t\t\tthis.workspaces\n\t\t\t);\n\t\t} else {\n\t\t\tthis.filteredCategories = this.categories;\n\t\t}\n\t}\n\n\taddFilter(filter: TodoFilter): void {\n\t\tthis.activeFilters.push(filter);\n\t}\n\n\tremoveFilter(filter: TodoFilter): void {\n\t\tthis.activeFilters = this.activeFilters.filter((f) => f !== filter);\n\t}\n\n\tclearFilters(): void {\n\t\tthis.activeFilters = [];\n\t}\n\n\tisFilterActive(filter: TodoFilter): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === filter.type && f.value === filter.value);\n\t}\n\n\tisCategoryFilterActive(): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === 'category');\n\t}\n\n\tisTagFilterActive(): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === 'tag');\n\t}\n\n\ttoggleHideIt(): void {\n\t\tthis.hideItActive = !this.hideItActive;\n\t\tthis.useFilters(this.activeFilters);\n\t\tthis.filterCategories();\n\n\t\tthis.localStorage.setBool(Todos.LS_HIDE_IT_KEY, this.hideItActive);\n\t}\n\n\tloadHideIt(): void {\n\t\t// Re-reads storage so a toggle issued while load() was still in flight\n\t\t// wins over the constructor restore, then re-applies the filters now\n\t\t// that workspaces (which decide what hide-it removes) are loaded.\n\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n\t\tif (this.hideItActive) {\n\t\t\tthis.filterCategories();\n\t\t\tthis.useFilters(this.activeFilters);\n\t\t}\n\t}\n\n\tasync quickCreate(input: string): Promise<{ ok: boolean; recurrenceIgnored: boolean }> {\n\t\tconst recurrenceIgnored = /repeat:/i.test(input) && !/due:/i.test(input);\n\n\t\tconst request: CreateTodoRequest = { title: input };\n\n\t\tif (this.activeFilters.some((f) => f.type === 'tag')) {\n\t\t\trequest.tags = [this.activeFilters.find((f) => f.type === 'tag')?.value as number];\n\t\t}\n\n\t\tif (this.activeFilters.some((f) => f.type === 'category')) {\n\t\t\trequest.category_id = this.activeFilters.find((f) => f.type === 'category')\n\t\t\t\t?.value as number;\n\t\t}\n\n\t\tconst res = await this.apiService.create(apiRoutes.todos.create, request);\n\n\t\tif (res) {\n\t\t\tconst todo = res.data as Todo;\n\t\t\tthis.recentlyCreated = todo.id;\n\t\t\tawait this.load();\n\n\t\t\tsetTimeout(() => {\n\t\t\t\tthis.recentlyCreated = null;\n\t\t\t}, 10000);\n\n\t\t\treturn Promise.resolve({ ok: true, recurrenceIgnored });\n\t\t}\n\n\t\treturn Promise.resolve({ ok: false, recurrenceIgnored: false });\n\t}\n\n\tasync delete(todo: Todo): Promise<boolean> {\n\t\tconst ok = await this.apiService.delete(apiRoutes.todos.delete, todo.id);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync createCategory(title: string): Promise<TodoCategory | null> {\n\t\tconst request: CreateTodoCategoryRequest = { title };\n\t\tconst res = await this.apiService.create(apiRoutes.todos.createCategory, request);\n\t\tif (res) await this.loadCategories();\n\t\treturn res ? (res.data as TodoCategory) : null;\n\t}\n\n\tasync updateCategory(\n\t\tcategory: TodoCategory,\n\t\trequest: UpdateTodoCategoryRequest\n\t): Promise<boolean> {\n\t\tconst res = await this.apiService.update(\n\t\t\tapiRoutes.todos.updateCategory,\n\t\t\tcategory.id,\n\t\t\trequest\n\t\t);\n\t\tif (res) await Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n\t\treturn res;\n\t}\n\n\tasync deleteCategory(category: TodoCategory): Promise<boolean> {\n\t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteCategory, category.id);\n\t\tif (ok) await this.loadCategories();\n\t\treturn ok;\n\t}\n\n\tasync createWorkspace(title: string): Promise<boolean> {\n\t\tconst request: CreateTodoWorkspaceRequest = { title };\n\t\tconst res = await this.apiService.create(apiRoutes.todos.createWorkspace, request);\n\t\tif (res) await this.loadWorkspaces();\n\t\treturn Promise.resolve(res !== null);\n\t}\n\n\tasync deleteWorkspace(workspace: TodoWorkspace): Promise<boolean> {\n\t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteWorkspace, workspace.id);\n\t\tif (ok) await this.loadWorkspaces();\n\t\treturn ok;\n\t}\n\n\tasync attachCategoryToWorkspace(\n\t\tworkspace: TodoWorkspace,\n\t\tcategoryId: number\n\t): Promise<boolean> {\n\t\tconst res = await this.apiService.post(\n\t\t\tapiRoutes.todos.attachWorkspaceCategory.replace('%d', workspace.id.toString()),\n\t\t\t{ categories: [categoryId] }\n\t\t);\n\t\tif (res) await this.loadWorkspaces();\n\t\treturn Promise.resolve(res !== null);\n\t}\n\n\tasync detachCategoryFromWorkspace(\n\t\tworkspace: TodoWorkspace,\n\t\tcategoryId: number\n\t): Promise<boolean> {\n\t\tconst res = await this.apiService.post(\n\t\t\tapiRoutes.todos.detachWorkspaceCategory.replace('%d', workspace.id.toString()),\n\t\t\t{ categories: [categoryId] }\n\t\t);\n\t\tif (res) await this.loadWorkspaces();\n\t\treturn Promise.resolve(res !== null);\n\t}\n\n\tasync updateWorkspace(\n\t\tworkspace: TodoWorkspace,\n\t\trequest: UpdateTodoWorkspaceRequest\n\t): Promise<boolean> {\n\t\tconst res = await this.apiService.update(\n\t\t\tapiRoutes.todos.updateWorkspace,\n\t\t\tworkspace.id,\n\t\t\trequest\n\t\t);\n\t\tif (res) await this.loadWorkspaces();\n\t\treturn Promise.resolve(res !== null);\n\t}\n\n\tasync changePriority(todo: Todo, priority: TodoPriority): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { priority };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync addTag(todo: Todo, tagId: number): Promise<boolean> {\n\t\tconst tagIds = todo.tags.map((t) => t.id);\n\t\tconst request: UpdateTodoRequest = {\n\t\t\ttags: tagIds.concat([tagId])\n\t\t};\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync removeTag(todo: Todo, tag: Tag): Promise<boolean> {\n\t\tconst tagIds = todo.tags.map((t) => t.id);\n\t\tconst request: UpdateTodoRequest = {\n\t\t\ttags: tagIds.filter((id) => id != tag.id)\n\t\t};\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync addCategory(todo: Todo, categoryId: number): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { category_id: categoryId };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync removeCategory(todo: Todo): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { category_id: null };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeCompleted(todo: Todo, checked: boolean): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { is_completed: checked };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeEffort(todo: Todo, effort: TodoEffort): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { effort };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeStatus(todoId: string, status: TodoStatus): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { status };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todoId, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeProgress(todo: Todo, progress: number): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { progress };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeDue(todo: Todo, due_at: string | null): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { due_at };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeRecurrence(\n\t\ttodo: Todo,\n\t\tfrequency: TodoRecurrenceFrequency | null,\n\t\tinterval: number = 1,\n\t\tendsAt: string | null = null\n\t): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = {\n\t\t\trecurrence_frequency: frequency,\n\t\t\trecurrence_interval: interval,\n\t\t\trecurrence_ends_at: endsAt\n\t\t};\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeTitle(todo: Todo, title: string): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { title };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeDescription(todo: Todo, description: string): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { description };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync changeLink(todo: Todo, link: string | null): Promise<boolean> {\n\t\tconst request: UpdateTodoRequest = { link };\n\t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n\t\tif (res) await this.load();\n\t\treturn res;\n\t}\n\n\tasync addS