ect(): Promise<void> {\n50: \t\tif (!this.content.trim()) return;\n51: \n52: \t\tthis.loading = true;\n53: \t\tthis.error = null;\n54: \t\tthis.detectedType = null;\n55: \t\tthis.needsConfirmation = false;\n56: \t\tthis.showTypeSelector = false;\n57: \n58: \t\tconst res = await this.apiService.create(apiRoutes.dashboard.quickAddDetect, { content: this.content });\n59: \n60: \t\tthis.loading = false;\n61: \n62: \t\tif (!res) {\n63: \t\t\tthis.error = this.ts.get.quick_add.detect_error;\n64: \t\t\tthis.notifications.error(this.ts.get.quick_add.detect_error);\n65: \t\t\treturn;\n66: \t\t}\n67: \n68: \t\tconst data = res.data as DetectionResult;\n69: \n70: \t\tthis.detectedType = data.content_type;\n71: \t\tthis.confidence = data.confidence;\n72: \t\tthis.metadata = data.metadata ?? null;\n73: \n74: \t\tif (data.needs_confirmation) {\n75: \t\t\tthis.needsConfirmation = true;\n76: \t\t} else {\n77: \t\t\tawait this.confirm(this.detectedType!);\n78: \t\t}\n79: \t}\n80: \n81: \trejectDetection(): void {\n82: \t\tthis.needsConfirmation = false;\n83: \t\tthis.showTypeSelector = true;\n84: \t}\n85: \n86: \tbackToConfirmation(): void {\n87: \t\tif (!this.detectedType) return;\n88: \t\tthis.showTypeSelector = false;\n89: \t\tthis.needsConfirmation = true;\n90: \t}\n91: \n92: \tasync confirm(type: QuickAddContentType): Promise<void> {\n93: \t\tthis.loading = true;\n94: \t\tthis.error = null;\n95: \n96: \t\tconst res = await this.apiService.create(apiRoutes.dashboard.quickAddCommit, {\n97: \t\t\tcontent: this.content,\n98: \t\t\tcontent_type: type,\n99: \t\t\tmetadata: this.metadata\n100: \t\t});\n101: \n102: \t\tthis.loading = false;\n103: \n104: \t\tif (!res) {\n105: \t\t\tthis.error = this.ts.get.quick_add.commit_error;\n106: \t\t\tthis.notifications.error(this.ts.get.quick_add.commit_error);\n107: \t\t\treturn;\n108: \t\t}\n109: \n110: \t\tconst destination = this.ts.get.quick_add.destinations[type];\n111: \t\tthis.notifications.success(\n112: \t\t\tthis.ts.get.quick_add.comm