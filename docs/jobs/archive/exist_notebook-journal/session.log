: \t});\n200: \n201: \tdescribe('openCreateNoteModal', () => {\n202: \t\tit('sets the create parent and opens the note modal', async () => {\n203: \t\t\tconst n = new NotesSvelte();\n204: \t\t\tawait n.openCreateNoteModal(5);\n205: \n206: \t\t\texpect(n.createParent).toBe(5);\n207: \t\t\texpect(n.createType).toBe('note');\n208: \t\t\texpect(n.modalOpen).toBe(true);\n209: \t\t});\n210: \n211: \t\tit('clears a stale create parent when given null', async () => {\n212: \t\t\tconst n = new NotesSvelte();\n213: \t\t\tn.createParent = 5;\n214: \t\t\tawait n.openCreateNoteModal(null);\n215: \n216: \t\t\texpect(n.createParent).toBeNull();\n217: \t\t\texpect(n.createType).toBe('note');\n218: \t\t\texpect(n.modalOpen).toBe(true);\n219: \t\t});\n220: \t});\n221: \n222: \tdescribe('create', () => {\n223: \t\tit('does nothing when the input is empty', async () => {\n224: \t\t\tconst n = new NotesSvelte();\n225: \t\t\tn.inputValue = '';\n226: \t\t\tawait expect(n.create()).resolves.toBeNull();\n227: \t\t\texpect(api.create).not.toHaveBeenCalled();\n228: \t\t});\n229: \n230: \t\tit('creates a note, reloads and navigates to it', async () => {\n231: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n9', title: 'Draft' }) });\n232: \t\t\tapi.list.mockResolvedValue({ data: [note({ id: 'n9' })] });\n233: \n234: \t\t\tconst n = new NotesSvelte();\n235: \t\t\tn.inputValue = 'Draft';\n236: \t\t\tconst result = await n.create();\n237: \n238: \t\t\texpect(result?.id).toBe('n9');\n239: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n240: \t\t\t\ttitle: 'Draft'\n241: \t\t\t});\n242: \t\t\texpect(n.activeNote?.id).toBe('n9');\n243: \t\t\texpect(n.inputValue).toBe('');\n244: \t\t\texpect(navigation.goto).toHaveBeenCalledWith('/notes/n9');\n245: \t\t});\n246: \n247: \t\tit('passes the parent category id when creating inside a category', async () => {\n248: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n10', category_id: 5 }) });\n249: \n250: \t\t\