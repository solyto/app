{"type":"tool_use","timestamp":1791638229393,"sessionID":"ses_eda0a7d94ffePtOp5YHUfGtuLZ","part":{"type":"tool","tool":"read","callID":"call_02_uCNVBqtnJYrIvYuz7mQQ2958","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/Notes.test.ts"},"output":"<path>/workspace/tests/unit/stores/Notes.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { NotesSvelte } from '$lib/state/Notes.svelte';\n3: import { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\n4: import type { Note, NoteCategory } from '$lib/types/note';\n5: \n6: const { navigation } = vi.hoisted(() => ({\n7: \tnavigation: {\n8: \t\tgoto: vi.fn(),\n9: \t\tresolve: (path: string, params: Record<string, string>) => path.replace('[id]', params.id)\n10: \t}\n11: }));\n12: \n13: vi.mock('$app/navigation', () => ({ goto: navigation.goto }));\n14: vi.mock('$app/paths', () => ({ resolve: navigation.resolve }));\n15: \n16: // The Notes store reads getTranslation() / getUiNotifications() at field\n17: // initialisation; storeMocks does not cover those modules, so stub them here.\n18: const notifications = { error: vi.fn() };\n19: const ts = {\n20: \tget: {\n21: \t\tnotes: {\n22: \t\t\tcreate_error: 'Failed to create note.',\n23: \t\t\tcreate_folder_error: 'Failed to create folder.'\n24: \t\t}\n25: \t}\n26: };\n27: \n28: vi.mock('$lib/state/Translation.svelte', () => ({\n29: \tgetTranslation: () => ts\n30: }));\n31: \n32: vi.mock('$lib/state/UiNotifications.svelte', () => ({\n33: \tgetUiNotifications: () => notifications\n34: }));\n35: \n36: function note(overrides: Partial<Note> = {}): Note {\n37: \treturn {\n38: \t\tid: 'n1',\n39: \t\ttitle: 'Note',\n40: \t\tcontent: '',\n41: \t\tcategory_id: null,\n42: \t\ttags: [],\n43: \t\tis_favorite: false,\n44: \t\tcreated_at: '2026-01-01T00:00:00',\n45: \t\tupdated_at: '2026-01-01T00:00:00',\n46: \t\t...overrides\n47: \t};\n48: }\n49: \n50: function category(id: number, title: string, overrides: Partial<NoteCategory> = {}): NoteCategory {\n51: \treturn {\n52: \t\tid,\n53: \t\ttitle,\n54: \t\tparent_id: null,\n55: \t\tsort_order: 0,\n56: \t\tcreated_at: '',\n57: \t\tupdated_at: '',\n58: \t\tchildren: [],\n59: \t\t...overrides\n60: \t};\n61: }\n62: \n63: beforeEach(() => {\n64: \tresetStoreMocks();\n65: \tpageState.pathname = '/notes';\n66: \tpageState.params = {};\n67: \tnavigation.goto.mockReset();\n68: \tnavigation.goto.mockResolvedValue(undefined);\n69: \tnotifications.error.mockReset();\n70: });\n71: \n72: afterEach(() => {\n73: \tvi.useRealTimers();\n74: });\n75: \n76: describe('Notes store', () => {\n77: \tdescribe('newest / last updated / favorites', () => {\n78: \t\tit('getNewestNotes returns the five most recently created notes', () => {\n79: \t\t\tconst n = new NotesSvelte();\n80: \t\t\tn.notes = [\n81: \t\t\t\tnote({ id: '1', created_at: '2026-01-01T00:00:00' }),\n82: \t\t\t\tnote({ id: '2', created_at: '2026-03-01T00:00:00' }),\n83: \t\t\t\tnote({ id: '3', created_at: '2026-02-01T00:00:00' }),\n84: \t\t\t\tnote({ id: '4', created_at: '2026-05-01T00:00:00' }),\n85: \t\t\t\tnote({ id: '5', created_at: '2026-04-01T00:00:00' }),\n86: \t\t\t\tnote({ id: '6', created_at: '2026-06-01T00:00:00' })\n87: \t\t\t];\n88: \t\t\texpect(n.getNewestNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n89: \t\t});\n90: \n91: \t\tit('getLastUpdatedNotes returns the five most recently updated notes', () => {\n92: \t\t\tconst n = new NotesSvelte();\n93: \t\t\tn.notes = [\n94: \t\t\t\tnote({ id: '1', updated_at: '2026-01-01T00:00:00' }),\n95: \t\t\t\tnote({ id: '2', updated_at: '2026-03-01T00:00:00' }),\n96: \t\t\t\tnote({ id: '3', updated_at: '2026-02-01T00:00:00' }),\n97: \t\t\t\tnote({ id: '4', updated_at: '2026-05-01T00:00:00' }),\n98: \t\t\t\tnote({ id: '5', updated_at: '2026-04-01T00:00:00' }),\n99: \t\t\t\tnote({ id: '6', updated_at: '2026-06-01T00:00:00' })\n100: \t\t\t];\n101: \t\t\texpect(n.getLastUpdatedNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n102: \t\t});\n103: \n104: \t\tit('getFavorites returns only favourite notes', () => {\n105: \t\t\tconst n = new NotesSvelte();\n106: \t\t\tn.notes = [\n107: \t\t\t\tnote({ id: '1', is_favorite: true }),\n108: \t\t\t\tnote({ id: '2', is_favorite: false }),\n109: \t\t\t\tnote({ id: '3', is_favorite: true })\n110: \t\t\t];\n111: \t\t\texpect(n.getFavorites().map((x) => x.id)).toEqual(['1', '3']);\n112: \t\t});\n113: \t});\n114: \n115: \tdescribe('categories', () => {\n116: \t\tit('getNotesForCategory filters by category id', () => {\n117: \t\t\tconst n = new NotesSvelte();\n118: \t\t\tn.notes = [\n119: \t\t\t\tnote({ id: '1', category_id: 1 }),\n120: \t\t\t\tnote({ id: '2', category_id: null }),\n121: \t\t\t\tnote({ id: '3', category_id: 1 })\n122: \t\t\t];\n123: \t\t\texpect(n.getNotesForCategory(1).map((x) => x.id)).toEqual(['1', '3']);\n124: \t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['2']);\n125: \t\t});\n126: \n127: \t\tit('getCategoryTitle resolves top-level categories', () => {\n128: \t\t\tconst n = new NotesSvelte();\n129: \t\t\tn.categories = [category(1, 'Work'), category(2, 'Private')];\n130: \t\t\texpect(n.getCategoryTitle(1)).toBe('Work');\n131: \t\t});\n132: \n133: \t\tit('getCategoryTitle resolves child categories', () => {\n134: \t\t\tconst n = new NotesSvelte();\n135: \t\t\tn.categories = [category(1, 'Work', { children: [category(5, 'Projects')] })];\n136: \t\t\texpect(n.getCategoryTitle(5)).toBe('Projects');\n137: \t\t});\n138: \n139: \t\tit('getCategoryTitle returns a dash for unknown categories', () => {\n140: \t\t\tconst n = new NotesSvelte();\n141: \t\t\tn.categories = [category(1, 'Work')];\n142: \t\t\texpect(n.getCategoryTitle(99)).toBe('-');\n143: \t\t});\n144: \t});\n145: \n146: \tdescribe('collapsed categories', () => {\n147: \t\tit('loads persisted collapsed categories from storage', () => {\n148: \t\t\tstorage.getJson.mockReturnValue([1, 2]);\n149: \t\t