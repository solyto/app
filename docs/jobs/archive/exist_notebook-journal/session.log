tegory(1), category(2)])).toBeNull();\n50: \t});\n51: \n52: \tit('returns null for an empty list', () => {\n53: \t\texpect(service.findJournalCategory([])).toBeNull();\n54: \t});\n55: });\n56: \n57: describe('getEntryTitle', () => {\n58: \tit('formats a date as YYYY-MM-DD', () => {\n59: \t\texpect(service.getEntryTitle(new Date(2026, 7, 4))).toBe('2026-08-04');\n60: \t});\n61: \n62: \tit('pads single-digit months and days', () => {\n63: \t\texpect(service.getEntryTitle(new Date(2026, 0, 9))).toBe('2026-01-09');\n64: \t});\n65: });\n66: \n67: describe('isEntryTitle', () => {\n68: \tit('accepts date titles', () => {\n69: \t\texpect(service.isEntryTitle('2026-08-04')).toBe(true);\n70: \t});\n71: \n72: \tit('rejects non-date titles', () => {\n73: \t\texpect(service.isEntryTitle('My day')).toBe(false);\n74: \t\texpect(service.isEntryTitle('2026-8-4')).toBe(false);\n75: \t\texpect(service.isEntryTitle('')).toBe(false);\n76: \t});\n77: });\n78: \n79: describe('findEntry', () => {\n80: \tit('finds the entry in the journal folder for the date', () => {\n81: \t\tconst notes = [\n82: \t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n83: \t\t\tnote({ id: 'b', title: '2026-08-03', category_id: 7 })\n84: \t\t];\n85: \t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))?.id).toBe('a');\n86: \t});\n87: \n88: \tit('ignores a matching title in an ordinary folder', () => {\n89: \t\tconst notes = [note({ id: 'a', title: '2026-08-04', category_id: 2 })];\n90: \t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))).toBeNull();\n91: \t});\n92: \n93: \tit('returns null when no entry exists for the day', () => {\n94: \t\texpect(service.findEntry([], 7, new Date(2026, 7, 4))).toBeNull();\n95: \t});\n96: });\n97: \n98: describe('getEntryDates', () => {\n99: \tit('returns the date titles of entries in the journal folder', () => {\n100: \t\tconst notes = [\n101: \t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n102: \t\t\tnote({ id: 'b', title: '2026-08-02', category_id: 7 }),\n103: \t\t\tnote({ id: 'c', title: 'Not a date', category_id: 7 }),\n104: \t\t\tnote({ id: 'd', title: '2026-08-01', category_id: 2 })\n105: \t\t];\n106: \t\texpect(service.getEntryDates(notes, 7)).toEqual(['2026-08-04', '2026-08-02']);\n107: \t});\n108: \n109: \tit('returns an empty list when the folder has no entries', () => {\n110: \t\texpect(service.getEntryDates([], 7)).toEqual([]);\n111: \t});\n112: });\n113: \n114: describe('isReachable', () => {\n115: \tconst today = new Date(2026, 7, 4);\n116: \n117: \tit('allows today', () => {\n118: \t\texpect(service.isReachable(new Date(2026, 7, 4), today)).toBe(true);\n119: \t});\n120: \n121: \tit('allows earlier days', () => {\n122: \t\texpect(service.isReachable(new Date(2026, 7, 1), today)).toBe(true);\n123: \t});\n124: \n125: \tit('rejects future days', () => {\n126: \t\texpect(service.isReachable(new Date(2026, 7, 5), today)).toBe(false);\n127: \t});\n128: \n129: \tit('compares by day, ignoring the time of day', () => {\n130: \t\tconst lateToday = new Date(2026, 7, 4, 23, 59);\n131: \t\texpect(service.isReachable(lateToday, new Date(2026, 7, 4, 0, 1))).toBe(true);\n132: \t});\n133: });\n\n(End of file - total 133 lines)\n</content>","metadata":{"preview":"import { describe, it, expect } from 'vitest';\nimport JournalService from '$lib/services/JournalService';\nimport type { Note, NoteCategory } from '$lib/types/note';\n\nfunction category(id: number, overrides: Partial<NoteCategory> = {}): NoteCategory {\n\treturn {\n\t\tid,\n\t\ttitle: 'Category',\n\t\tparent_id: null,\n\t\tsort_order: 0,\n\t\tis_system: false,\n\t\tis_hidden: false,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\tchildren: [],\n\t\t...overrides\n\t};\n}\n\nfunction note(overrides: Partial<Note> = {}): Note {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/services/JournalService.test.ts","text":"import { describe, it, expect } from 'vitest';\nimport JournalService from '$lib/services/JournalService';\nimport type { Note, NoteCategory } from '$lib/types/note';\n\nfunction category(id: number, overrides: Partial<NoteCategory> = {}): NoteCategory {\n\treturn {\n\t\tid,\n\t\ttitle: 'Category',\n\t\tparent_id: null,\n\t\tsort_order: 0,\n\t\tis_system: false,\n\t\tis_hidden: false,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\tchildren: [],\n\t\t...overrides\n\t};\n}\n\nfunction note(overrides: Partial<Note> = {}): Note {\n\treturn {\n\t\tid: 'n1',\n\t\ttitle: 'Note',\n\t\tcontent: '',\n\t\tcategory_id: null,\n\t\ttags: [],\n\t\tis_favorite: false,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\t...overrides\n\t};\n}\n\nconst service = new JournalService();\n\ndescribe('findJournalCategory', () => {\n\tit('finds a root-level system category', () => {\n\t\tconst journal = category(3, { title: '.journal', is_system: true, is_hidden: true });\n\t\texpect(service.findJournalCategory([category(1), journal, category(2)])).toBe(journal);\n\t});\n\n\tit('finds a system category nested as a child', () => {\n\t\tconst journal = category(9, { is_system: true });\n\t\tconst parent = category(1, { children: [category(2), journal] });\n\t\texpect(service.findJournalCategory([parent])).toBe(journal);\n\t});\n\n\tit('returns null when no category is a system folder', () => {\n\t\texpect(service.findJournalCategory([category(1), category(2)])).toBeNull();\n\t});\n\n\tit('returns null for an empty list', () => {\n\t\texpect(service.findJournalCategory([])).toBeNull();\n\t});\n});\n\ndescribe('getEntryTitle', () => {\n\tit('formats a date as YYYY-MM-DD', () => {\n\t\texpect(service.getEntryTitle(new Date(2026, 7, 4))).toBe('2026-08-04');\n\t});\n\n\tit('pads single-digit months and days', () => {\n\t\texpect(service.getEntryTitle(new Date(2026, 0, 9))).toBe('2026-01-09');\n\t});\n});\n\ndescribe('isEntryTitle', () => {\n\tit('accepts date titles', () => {\n\t\texpect(service.isEntryTitle('2026-08-04')).toBe(true);\n\t});\n\n\tit('rejects non-date titles', () => {\n\t\texpect(service.isEntryTitle('My day')).toBe(false);\n\t\texpect(service.isEntryTitle('2026-8-4')).toBe(false);\n\t\texpect(service.isEntryTitle('')).toBe(false);\n\t});\n});\n\ndescribe('findEntry', () => {\n\tit('finds the entry in the journal folder for the date', () => {\n\t\tconst notes = [\n\t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n\t\t\tnote({ id: 'b', title: '2026-08-03', category_id: 7 })\n\t\t];\n\t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))?.id).toBe('a');\n\t});\n\n\tit('ignores a matching title in an ordinary folder', () => {\n\t\tconst notes = [note({ id: 'a', title: '2026-08-04', category_id: 2 })];\n\t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))).toBeNull();\n\t});\n\n\tit('returns null when no entry exists for the day', () => {\n\t\texpect(service.findEntry([], 7, new Date(2026, 7, 4))).toBeNull();\n\t});\n});\n\ndescribe('getEntryDates', () => {\n\tit('returns the date titles of entries in the journal folder', () => {\n\t\tconst notes = [\n\t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n\t\t\tnote({ id: 'b', title: '2026-08-02', category_id: 7 }),\n\t\t\tnote({ id: 'c', title: 'Not a date', category_id: 7 }),\n\t\t\tnote({ id: 'd', title: '2026-08-01', category_id: 2 })\n\t\t];\n\t\texpect(service.getEntryDates(notes, 7)).toEqual(['2026-08-04', '2026-08-02']);\n\t});\n\n\tit('returns an empty list when the folder has no entries', () => {\n\t\texpect(service.getEntryDates([], 7)).toEqual([]);\n\t});\n});\n\ndescribe('isReachable', () => {\n\tconst today = new Date(2026, 7, 4);\n\n\tit('allows today', () => {\n\t\texpect(service.isReachable(new Date(2026, 7, 4), today)).toBe(true);\n\t});\n\n\tit('allows earlier days', () => {\n\t\texpect(service.isReachable(new Date(2026, 7, 1), today)).toBe(true);\n\t});\n\n\tit('rejects future days', () => {\n\t\texpect(service.isReachable(new Date(2026, 7, 5), today)).toBe(false);\n\t});\n\n\tit('compares by day, ignoring the time of day', () => {\n\t\tconst lateToday = new Date(2026, 7, 4, 23, 59);\n\t\texpect(service.isReachable(lateToday, new Date(2026, 7, 4, 0, 1))).toBe(true);\n\t});\n});","lineStart":1,"lineEnd":133,"totalLines":133,"truncated":false}},"title":"tests/unit/services/JournalService.test.ts","time":{"start":1791639671628,"end":1791639671687}},"id":"prt_1260bd307001zdISR5MmEM33H1","sessionID":"ses_ed9f4e243ffefIDWX0046IKymc","messageID":"msg_1260bc2fd001oNRCxeaMQ5kzuP"}}
{"type":"tool_use","timestamp":1791639671708,"sessionID":"ses_ed9f4e243ffefIDWX0046IKymc","part":{"type":"tool","tool":"read","callID":"call_01_4L2XUlKVVHHxSs20fyLf3203","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/Notes.test.ts"},"output":"<path>/workspace/tests/unit/stores/Notes.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { NotesSvelte } from '$lib/state/Notes.svelte';\n3: import { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\n4: import type { Note, NoteCategory } from '$lib/types/note';\n5: \n6: const { navigation } = vi.hoisted(() => ({\n7: \tnavigation: {\n8: \t\tgoto: vi.fn(),\n9: \t\tresolve: (path: string, params: Record<string, string>) => path.replace('[id]', params.id)\n10: \t}\n11: }));\n12: \n13: vi.mock('$app/navigation', () => ({ goto: navigation.goto }));\n14: vi.mock('$app/paths', () => ({ resolve: navigation.resolve }));\n15: \n16: // The Notes store reads getTranslation() / getUiNotifications() at field\n17: // initialisation; storeMocks does not cover those modules, so stub them here.\n18: const notifications = { error: vi.fn() };\n19: const ts = {\n20: \tget: {\n21: \t\tnotes: {\n22: \t\t\tcreate_error: 'Failed to create note.',\n23: \t\t\tcreate_folder_error: 'Failed to create folder.',\n24: \t\t\tjournal_create_error: 'Failed to open journal entry.'\n25: \t\t}\n26: \t}\n27: };\n28: \n29: vi.mock('$lib/state/Translation.svelte', () => ({\n30: \tgetTranslation: () => ts\n31: }));\n32: \n33: vi.mock('$lib/state/UiNotifications.svelte', () => ({\n34: \tgetUiNotifications: () => notifications\n35: }));\n36: \n37: function note(overrides: Partial<Note> = {}): Note {\n38: \treturn {\n39: \t\tid: 'n1',\n40: \t\ttitle: 'Note',\n41: \t\tcontent: '',\n42: \t\tcategory_id: null,\n43: \t\ttags: [],\n44: \t\tis_favorite: false,\n45: \t\tcreated_at: '2026-01-01T00:00:00',\n46: \t\tupdated_at: '2026-01-01T00:00:00',\n47: \t\t...overrides\n48: \t};\n49: }\n50: \n51: function category(id: number, title: string, overrides: Partial<NoteCategory> = {}): NoteCategory {\n52: \treturn {\n53: \t\tid,\n54: \t\ttitle,\n55: \t\tparent_id: null,\n56: \t\tsort_order: 0,\n57: \t\tis_system: false,\n58: \t\tis_hidden: false,\n59: \t\tcreated_at: '',\n60: \t\tupdated_at: '',\n61: \t\tchildren: [],\n62: \t\t...overrides\n63: \t};\n64: }\n65: \n66: beforeEach(() => {\n67: \tresetStoreMocks();\n68: \tpageState.pathname = '/notes';\n69: \tpageState.params = {};\n70: \tnavigation.goto.mockReset();\n71: \tnavigation.goto.mockResolvedValue(undefined);\n72: \tnotifications.error.mockReset();\n73: });\n74: \n75: afterEach(() => {\n76: \tvi.useRealTimers();\n77: });\n78: \n79: describe('Notes store', () => {\n80: \tdescribe('newest / last updated / favorites', () => {\n81: \t\tit('getNewestNotes returns the five most recently created notes', () => {\n82: \t\t\tconst n = new NotesSvelte();\n83: \t\t\tn.notes = [\n84: \t\t\t\tnote({ id: '1', created_at: '2026-01-01T00:00:00' }),\n85: \t\t\t\tnote({ id: '2', created_at: '2026-03-01T00:00:00' }),\n86: \t\t\t\tnote({ id: '3', created_at: '2026-02-01T00:00:00' }),\n87: \t\t\t\tnote({ id: '4', created_at: '2026-05-01T00:00:00' }),\n88: \t\t\t\tnote({ id: '5', created_at: '2026-04-01T00:00:00' }),\n89: \t\t\t\tnote({ id: '6', created_at: '2026-06-01T00:00:00' })\n90: \t\t\t];\n91: \t\t\texpect(n.getNewestNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n92: \t\t});\n93: \n94: \t\tit('getLastUpdatedNotes returns the five most recently updated notes', () => {\n95: \t\t\tconst n = new NotesSvelte();\n96: \t\t\tn.notes = [\n97: \t\t\t\tnote({ id: '1', updated_at: '2026-01-01T00:00:00' }),\n98: \t\t\t\tnote({ id: '2', updated_at: '2026-03-01T00:00:00' }),\n99: \t\t\t\tnote({ id: '3', updated_at: '2026-02-01T00:00:00' }),\n100: \t\t\t\tnote({ id: '4', updated_at: '2026-05-01T00:00:00' }),\n101: \t\t\t\tnote({ id: '5', updated_at: '2026-04-01T00:00:00' }),\n102: \t\t\t\tnote({ id: '6', updated_at: '2026-06-01T00:00:00' })\n103: \t\t\t];\n104: \t\t\texpect(n.getLastUpdatedNotes().map((x) => x.id)).toEqual(['6', '4', '5', '2', '3']);\n105: \t\t});\n106: \n107: \t\tit('getFavorites returns only favourite notes', () => {\n108: \t\t\tconst n = new NotesSvelte();\n109: \t\t\tn.notes = [\n110: \t\t\t\tnote({ id: '1', is_favorite: true }),\n111: \t\t\t\tnote({ id: '2', is_favorite: false }),\n112: \t\t\t\tnote({ id: '3', is_favorite: true })\n113: \t\t\t];\n114: \t\t\texpect(n.getFavorites().map((x) => x.id)).toEqual(['1', '3']);\n115: \t\t});\n116: \t});\n117: \n118: \tdescribe('categories', () => {\n119: \t\tit('getNotesForCategory filters by category id', () => {\n120: \t\t\tconst n = new NotesSvelte();\n121: \t\t\tn.notes = [\n122: \t\t\t\tnote({ id: '1', category_id: 1 }),\n123: \t\t\t\tnote({ id: '2', category_id: null }),\n124: \t\t\t\tnote({ id: '3', category_id: 1 })\n125: \t\t\t];\n126: \t\t\texpect(n.getNotesForCategory(1).map((x) => x.id)).toEqual(['1', '3']);\n127: \t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['2']);\n128: \t\t});\n129: \n130: \t\tit('getCategoryTitle resolves top-level categories', () => {\n131: \t\t\tconst n = new NotesSvelte();\n132: \t\t\tn.categories = [category(1, 'Work'), category(2, 'Private')];\n133: \t\t\texpect(n.getCategoryTitle(1)).toBe('Work');\n134: \t\t});\n135: \n136: \t\tit('getCategoryTitle resolves child categories', () => {\n137: \t\t\tconst n = new NotesSvelte();\n138: \t\t\tn.categories = [category(1, 'Work', { children: [category(5, 'Projects')] })];\n139: \t\t\texpect(n.getCategoryTitle(5)).toBe('Projects');\n140: \t\t});\n141: \n142: \t\tit('getCategoryTitle returns a dash for unknown categories', () => {\n143: \t\t\tconst n = new NotesSvelte();\n144: \t\t\tn.categories = [category(1, 'Work')];\n145: \t\t\texpect(n.getCategoryTitle(99)).toBe('-');\n146: \t\t});\n147: \t});\n148: \n149: \tdescribe('collapsed categories', () => {\n150: \t\tit('loads persisted collapsed categories from storage', () => {\n151: \t\t\tstorage.getJson.mockReturnValue([1, 2]);\n152: \t\t\tconst n = new NotesSvelte();\n153: \t\t\texpect(n.collapsedCategories).toEqual([1, 2]);\n154: \t\t\texpect(storage.getJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n155: \t\t});\n156: \n157: \t\tit('defaults to an empty list when nothing is stored', () => {\n158: \t\t\tstorage.getJson.mockReturnValue(null);\n159: \t\t\tconst n = new NotesSvelte();\n160: \t\t\texpect(n.collapsedCategories).toEqual([]);\n161: \t\t});\n162: \n163: \t\tit('toggleCollapseCategory adds and removes ids and persists', () => {\n164: \t\t\tconst n = new NotesSvelte();\n165: \t\t\tn.toggleCollapseCategory(3);\n166: \t\t\texpect(n.isCategoryCollapsed(3)).toBe(true);\n167: \t\t\texpect(storage.setJson).toHaveBeenCalledWith(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY, [\n168: \t\t\t\t3\n169: \t\t\t]);\n170: \n171: \t\t\tn.toggleCollapseCategory(3);\n172: \t\t\texpect(n.isCategoryCollapsed(3)).toBe(false);\n173: \t\t\texpect(storage.setJson).toHaveBeenCalledWith(\n174: \t\t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n175: \t\t\t\t[]\n176: \t\t\t);\n177: \t\t});\n178: \t});\n179: \n180: \tdescribe('active note', () => {\n181: \t\tit('selectNote sets the active note by id', () => {\n182: \t\t\tconst n = new NotesSvelte();\n183: \t\t\tn.notes = [note({ id: '1' }), note({ id: '2' })];\n184: \t\t\tn.selectNote('2');\n185: \t\t\texpect(n.activeNote?.id).toBe('2');\n186: \t\t});\n187: \n188: \t\tit('selectNote clears the active note when the id is unknown', () => {\n189: \t\t\tconst n = new NotesSvelte();\n190: \t\t\tn.notes = [note({ id: '1' })];\n191: \t\t\tn.selectNote('missing');\n192: \t\t\texpect(n.activeNote).toBeNull();\n193: \t\t});\n194: \n195: \t\tit('checkUrlForActiveNote selects the note from the page params', () => {\n196: \t\t\tpageState.params = { id: 'n7' };\n197: \t\t\tconst n = new NotesSvelte();\n198: \t\t\tn.notes = [note({ id: 'n7' }), note({ id: 'n8' })];\n199: \t\t\tn.checkUrlForActiveNote();\n200: \t\t\texpect(n.activeNote?.id).toBe('n7');\n201: \t\t});\n202: \t});\n203: \n204: \tdescribe('openCreateNoteModal', () => {\n205: \t\tit('sets the create parent and opens the note modal', async () => {\n206: \t\t\tconst n = new NotesSvelte();\n207: \t\t\tawait n.openCreateNoteModal(5);\n208: \n209: \t\t\texpect(n.createParent).toBe(5);\n210: \t\t\texpect(n.createType).toBe('note');\n211: \t\t\texpect(n.modalOpen).toBe(true);\n212: \t\t});\n213: \n214: \t\tit('clears a stale create parent when given null', async () => {\n215: \t\t\tconst n = new NotesSvelte();\n216: \t\t\tn.createParent = 5;\n217: \t\t\tawait n.openCreateNoteModal(null);\n218: \n219: \t\t\texpect(n.createParent).toBeNull();\n220: \t\t\texpect(n.createType).toBe('note');\n221: \t\t\texpect(n.modalOpen).toBe(true);\n222: \t\t});\n223: \t});\n224: \n225: \tdescribe('create', () => {\n226: \t\tit('does nothing when the input is empty', async () => {\n227: \t\t\tconst n = new NotesSvelte();\n228: \t\t\tn.inputValue = '';\n229: \t\t\tawait expect(n.create()).resolves.toBeNull();\n230: \t\t\texpect(api.create).not.toHaveBeenCalled();\n231: \t\t});\n232: \n233: \t\tit('creates a note, reloads and navigates to it', async () => {\n234: \t\t\tapi.create.mockResolvedValue({ data: note({ id: 'n9', title: 'Draft' }) });\n235: \t\t\tapi.list.mockResolvedValue({ data: [note({ id: 'n9' })] });\n236: \n237: \t\t\tconst n = new NotesSvelte();\n238: \t\t\tn.inputValue = 'Draft';\n239: \t\t\tconst result = await n.create();\n240: \n241: \t\t\texpect(result?.id).toBe('n9');\n242: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n243: \t\t\t\ttitle: 'Draft'\n244: \t\t\t});\n245: \t\t\texpect(n.activeNote?.id).toBe('n9');\n246: \t\t\texpect(n.inputValue).toBe('');\n247: \t\t\texpect(navigation.goto).toHaveBeenCalledWith('/notes/n9');\n248: \t\t});\n249: \n250: \t\tit('passes the parent category id when creating inside a category'