 \t\t\tapiRoutes.notes.update,\n377: \t\t\tthis.activeNote!.id,\n378: \t\t\trequest\n379: \t\t);\n380: \n381: \t\tif (ok) await this.load();\n382: \t\treturn ok;\n383: \t}\n384: \n385: \tasync removeTag(tagId: number): Promise<boolean> {\n386: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n387: \t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n388: \t\tconst ok = await this.apiService.update(\n389: \t\t\tapiRoutes.notes.update,\n390: \t\t\tthis.activeNote!.id,\n391: \t\t\trequest\n392: \t\t);\n393: \n394: \t\tif (ok) await this.load();\n395: \t\treturn ok;\n396: \t}\n397: \n398: \tasync delete(): Promise<boolean> {\n399: \t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n400: \t\t\treturn false;\n401: \t\t}\n402: \n403: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n404: \t\tif (ok) {\n405: \t\t\tif (this.activeNote?.id === this.rightClickId) {\n406: \t\t\t\tawait goto(resolve(urls.notes));\n407: \t\t\t}\n408: \n409: \t\t\tawait this.load();\n410: \t\t\tthis.closeRightClickMenu();\n411: \t\t}\n412: \t\treturn ok;\n413: \t}\n414: \n415: \tasync deleteActiveNote(): Promise<boolean> {\n416: \t\tif (!this.activeNote) return false;\n417: \n418: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n419: \t\tif (ok) {\n420: \t\t\tawait goto(resolve(urls.notes));\n421: \t\t\tawait this.load();\n422: \t\t}\n423: \t\treturn ok;\n424: \t}\n425: \n426: \tasync deleteCategory(): Promise<boolean> {\n427: \t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n428: \t\t\treturn false;\n429: \t\t}\n430: \n431: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n432: \t\tif (ok) await this.loadCategories();\n433: \t\tthis.closeRightClickMenu();\n434: \t\treturn ok;\n435: \t}\n436: \n437: \tasync importFile(file: File): Promise<boolean> {\n438: \t\tco