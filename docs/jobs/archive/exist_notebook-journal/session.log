{"type":"tool_use","timestamp":1791639466296,"sessionID":"ses_ed9f7786fffeTGZhqVpS150df1","part":{"type":"tool","tool":"read","callID":"call_01_Z6zqhIyRbOwFKRpW1MjH3242","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Notes.svelte.ts"},"output":"<path>/workspace/src/lib/state/Notes.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tCreateNoteCategoryRequest,\n3: \tCreateNoteRequest,\n4: \tNote,\n5: \tNoteCategory,\n6: \tUpdateNoteCategoryRequest,\n7: \tUpdateNoteRequest\n8: } from '$lib/types/note';\n9: import { setContext, getContext, tick } from 'svelte';\n10: import { getAuth } from '$lib/state/Auth.svelte';\n11: import { getTranslation } from '$lib/state/Translation.svelte';\n12: import { getUiNotifications } from '$lib/state/UiNotifications.svelte';\n13: import { page } from '$app/state';\n14: import { goto } from '$app/navigation';\n15: import { urls } from '$lib/config/urls';\n16: import { resolve } from '$app/paths';\n17: import ApiService from '$lib/services/ApiService';\n18: import JournalService from '$lib/services/JournalService';\n19: import LocalStorageService from '$lib/services/LocalStorageService';\n20: import { apiRoutes } from '$lib/config/apiRoutes';\n21: import { SvelteDate } from 'svelte/reactivity';\n22: \n23: export class NotesSvelte {\n24: \tstatic readonly LS_COLLAPSED_CATEGORIES_KEY: string = 'notes.collapsedCategories';\n25: \n26: \tloaded = $state<boolean>(false);\n27: \tnotes = $state<Note[]>([]);\n28: \tnewestNotes = $state<Note[]>([]);\n29: \tlastUpdatedNotes = $state<Note[]>([]);\n30: \tfavoriteNotes = $state<Note[]>([]);\n31: \tcategories = $state<NoteCategory[]>([]);\n32: \tjournalCategory = $state<NoteCategory | null>(null);\n33: \tcollapsedCategories = $state<number[]>([]);\n34: \tactiveNote = $state<Note | null>(null);\n35: \tmodalOpen = $state<boolean>(false);\n36: \tcreateType = $state<'note' | 'category'>('note');\n37: \tcreateParent = $state<number | null>(null);\n38: \trightClickMenuOpen = $state<boolean>(false);\n39: \trightClickMenuX = $state<number>(0);\n40: \trightClickMenuY = $state<number>(0);\n41: \trightClickType = $state<'note' | 'category'>('note');\n42: \trightClickId = $state<number | string | null>(null);\n43: \tdraggedNote = $state<Note | null>(null);\n44: \tdragTarget = $state<NoteCategory | null>(null);\n45: \tinput = $state<HTMLInputElement | null>(null);\n46: \tinputValue = $state<string>('');\n47: \tauth = getAuth();\n48: \tts = getTranslation();\n49: \tnotifications = getUiNotifications();\n50: \tapiService: ApiService;\n51: \tlocalStorage = new LocalStorageService();\n52: \tjournalService = new JournalService();\n53: \n54: \tconstructor() {\n55: \t\tthis.apiService = this.auth.apiService;\n56: \t\tthis.loadCollapsedCategories();\n57: \t}\n58: \n59: \tasync load(): Promise<void> {\n60: \t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n61: \t\tif (res) {\n62: \t\t\tthis.loaded = true;\n63: \t\t\tthis.notes = res.data as Note[];\n64: \t\t\tthis.newestNotes = this.getNewestNotes();\n65: \t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n66: \t\t\tthis.favoriteNotes = this.getFavorites();\n67: \t\t\tthis.checkUrlForActiveNote();\n68: \t\t}\n69: \t}\n70: \n71: \tloadCollapsedCategories(): void {\n72: \t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n73: \t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n74: \t}\n75: \n76: \tsaveCollapsedCategories(): void {\n77: \t\tthis.localStorage.setJson(\n78: \t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n79: \t\t\tthis.collapsedCategories\n80: \t\t);\n81: \t}\n82: \n83: \tcheckUrlForActiveNote(): void {\n84: \t\tif (page.params.id) {\n85: \t\t\tthis.selectNote(page.params.id);\n86: \t\t}\n87: \t}\n88: \n89: \tasync loadCategories(): Promise<void> {\n90: \t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n91: \t\tif (res) {\n92: \t\t\tconst all = res.data as NoteCategory[];\n93: \t\t\t// The system journal folder is resolved separately and kept out of the\n94: \t\t\t// rendered category tree.\n95: \t\t\tthis.journalCategory = this.journalService.findJournalCategory(all);\n96: \t\t\tthis.categories = all.filter((c) => !c.is_system);\n97: \t\t}\n98: \t}\n99: \n100: \tisJournalNote(note: Note): boolean {\n101: \t\treturn this.journalCategory !== null && note.category_id === this.journalCategory.id;\n102: \t}\n103: \n104: \tgetJournalEntry(date: Date): Note | null {\n105: \t\tif (this.journalCategory === null) return null;\n106: \t\treturn this.journalService.findEntry(this.notes, this.journalCategory.id, date);\n107: \t}\n108: \n109: \tgetJournalEntryDates(): string[] {\n110: \t\tif (this.journalCategory === null) return [];\n111: \t\treturn this.journalService.getEntryDates(this.notes, this.journalCategory.id);\n112: \t}\n113: \n114: \t// Resolves the day's entry in the journal folder, creating it on first open,\n115: \t// and makes it the active note so the editor can render it.\n116: \tasync openJournalEntry(date: Date): Promise<Note | null> {\n117: \t\tif (this.journalCategory === null) return null;\n118: \n119: \t\tconst existing = this.getJournalEntry(date);\n120: \t\tif (existing) {\n121: \t\t\tthis.activeNote = existing;\n122: \t\t\treturn existing;\n123: \t\t}\n124: \n125: \t\tconst request: CreateNoteRequest = {\n126: \t\t\ttitle: this.journalService.getEntryTitle(date),\n127: \t\t\tcategory_id: this.journalCategory.id\n128: \t\t};\n129: \t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n130: \n131: \t\tif (!res) {\n132: \t\t\tthis.notifications.error(this.ts.get.notes.journal_create_error);\n133: \t\t\treturn null;\n134: \t\t}\n135: \n136: \t\tconst created = res.data as Note;\n137: \t\tawait this.load();\n138: \t\tthis.activeNote = this.notes.find((n) => n.id === created.id) ?? created;\n139: \n140: \t\treturn this.activeNote;\n141: \t}\n142: \n143: \ttoggleCollapseCategory(categoryId: number): void {\n144: \t\tif (this.collapsedCategories.includes(categoryId)) {\n145: \t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n146: \t\t} else {\n147: \t\t\tthis.collapsedCategories.push(categoryId);\n148: \t\t}\n149: \n150: \t\tthis.saveCollapsedCategories();\n151: \t}\n152: \n153: \tisCategoryCollapsed(categoryId: number): boolean {\n154: \t\treturn this.collapsedCategories.includes(categoryId);\n155: \t}\n156: \n157: \tgetNotesForCategory(categoryId: number | null): Note[] {\n158: \t\treturn this.notes.filter((n) => n.category_id === categoryId && !this.isJournalNote(n));\n159: \t}\n160: \n161: \tgetVisibleNotes(): Note[] {\n162: \t\treturn this.notes.filter((n) => !this.isJournalNote(n));\n163: \t}\n164: \n165: \tgetCategoryTitle(categoryId: number): string {\n166: \t\tfor (const cat of this.categories) {\n167: \t\t\tif (cat.id === categoryId) return cat.title;\n168: \t\t\tif (cat.children) {\n169: \t\t\t\tfor (const child of cat.children) {\n170: \t\t\t\t\tif (child.id === categoryId) return child.title;\n171: \t\t\t\t}\n172: \t\t\t}\n173: \t\t}\n174: \n175: \t\treturn '-';\n176: \t}\n177: \n178: \tgetLastUpdatedNotes(): Note[] {\n179: \t\treturn this.getVisibleNotes()\n180: \t\t\t.sort(\n181: \t\t\t\t(a, b) =>\n182: \t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n183: \t\t\t)\n184: \t\t\t.slice(0, 5);\n185: \t}\n186: \n187: \tgetNewestNotes(): Note[] {\n188: \t\treturn this.getVisibleNotes()\n189: \t\t\t.sort(\n190: \t\t\t\t(a, b) =>\n191: \t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n192: \t\t\t)\n193: \t\t\t.slice(0, 5);\n194: \t}\n195: \n196: \tgetFavorites(): Note[] {\n197: \t\treturn this.getVisibleNotes().filter((n) => n.is_favorite);\n198: \t}\n199: \n200: \tselectNote(noteId: string): void {\n201: \t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n202: \t}\n203: \n204: \tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n205: \t\tif (type === 'category' && edit && this.rightClickId) {\n206: \t\t\tthis.inputValue =\n207: \t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n208: \t\t} else {\n209: \t\t\tthis.inputValue = '';\n210: \t\t}\n211: \n212: \t\tthis.createType = type;\n213: \t\tthis.modalOpen = true;\n214: \n215: \t\tawait tick();\n216: \n217: \t\tsetTimeout(() => this.input?.focus(), 100);\n218: \t}\n219: \n220: \tcloseModal(): void {\n221: \t\tthis.modalOpen = false;\n222: \t}\n223: \n224: \tasync openCreateNoteModal(parent: number | null): Promise<void> {\n225: \t\tthis.createParent = parent;\n226: \t\tawait this.openModal('note');\n227: \t}\n228: \n229: \topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n230: \t\tevent.preventDefault();\n231: \n232: \t\tthis.rightClickType = type;\n233: \t\tthis.rightClickMenuX = event.clientX;\n234: \t\tthis.rightClickMenuY = event.clientY;\n235: \t\tthis.rightClickId = id;\n236: \t\tthis.createParent = type === 'category' ? id as number : null;\n237: \t\tthis.rightClickMenuOpen = true;\n238: \t}\n239: \n240: \tcloseRightClickMenu(): void {\n241: \t\tthis.rightClickMenuOpen = false;\n242: \t}\n243: \n244: \tasync dragToCategory(): Promise<void> {\n245: \t\tif (this.draggedNote === null) return;\n246: \n247: \t\tconst request: UpdateNoteRequest = {\n248: \t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n249: \t\t};\n250: \t\tconst ok = await this.apiService.update(\n251: \t\t\tapiRoutes.notes.update,\n252: \t\t\tthis.draggedNote.id,\n253: \t\t\trequest\n254: \t\t);\n255: \t\tif (ok) await this.load();\n256: \t\treturn Promise.resolve();\n257: \t}\n258: \n259: \tasync create(): Promise<Note | null> {\n260: \t\tif (this.inputValue === '') {\n261: \t\t\treturn null;\n262: \t\t}\n263: \n264: \t\tconst request: CreateNoteRequest =\n265: \t\t\tthis.createParent !== null\n266: \t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n267: \t\t\t\t: { title: this.inputValue };\n268: \t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n269: \n270: \t\tif (!res) {\n271: \t\t\t// Keep the modal and the user's input intact so the note (and the\n272: \t\t\t// failure) is not silently swallowed; a 401 is recovered upstream.\n273: \t\t\tthis.notifications.error(this.ts.get.notes.create_error);\n274: \t\t\tthis.rightClickMenuOpen = false;\n275: \t\t\treturn null;\n276: \t\t}\n277: \n278: \t\tconst note = res.data as Note;\n279: \n280: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n281: \t\t\tthis.toggleCollapseCategory(this.createParent);\n282: \t\t}\n283: \n284: \t\tthis.inputValue = '';\n285: \t\tthis.createParent = null;\n286: \t\tthis.rightClickMenuOpen = false;\n287: \t\tthis.modalOpen = false;\n288: \n289: \t\tawait this.load();\n290: \t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n291: \t\tawait goto(resolve(urls.note, { id: note.id }));\n292: \n293: \t\treturn note;\n294: \t}\n295: \n296: \tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n297: \t\tif (this.inputValue === '') {\n298: \t\t\treturn null;\n299: \t\t}\n300: \n301: \t\tlet res;\n302: \n303: \t\tif (edit && this.rightClickId) {\n304: \t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n305: \t\t\tres = await this.apiService.update(\n306: \t\t\t\tapiRoutes.notes.updateCategory,\n307: \t\t\t\tthis.rightClickId,\n308: \t\t\t\trequest\n309: \t\t\t);\n310: \t\t} else {\n311: \t\t\tconst request: CreateNoteCategoryRequest =\n312: \t\t\t\tthis.createParent !== null\n313: \t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n314: \t\t\t\t\t: { title: this.inputValue };\n315: \t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n316: \t\t}\n317: \n318: \t\tif (!res) {\n319: \t\t\t// Keep the modal and the user's input intact (see create()).\n320: \t\t\tthis.notifications.error(this.ts.get.notes.create_folder_error);\n321: \t\t\tthis.rightClickMenuOpen = false;\n322: \t\t\treturn null;\n323: \t\t}\n324: \n325: \t\tawait this.loadCategories();\n326: \n327: \t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n328: \t\t\tthis.toggleCollapseCategory(this.createParent);\n329: \t\t}\n330: \n331: \t\tthis.inputValue = '';\n332: \t\tthis.createParent = null;\n333: \t\tthis.rightClickMenuOpen = false;\n334: \t\tthis.modalOpen = false;\n335: \n336: \t\treturn typeof res === 'object' ? (res.data as NoteCategory) : null;\n337: \t}\n338: \n339: \tasync saveContent(): Promise<boolean> {\n340: \t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n341: \t\tconst ok = await this.apiService.update(\n342: \t\t\tapiRoutes.notes.update,\n343: \t\t\tthis.activeNote!.id,\n344: \t\t\trequest\n345: \t\t);\n346: \t\tif (ok) await this.load();\n347: \t\treturn ok;\n348: \t}\n349: \n350: \tasync changeTitle(title: string): Promise<boolean> {\n351: \t\tconst request: UpdateNoteRequest = { title: title };\n352: \t\tconst ok = await this.apiService.update(\n353: \t\t\tapiRoutes.notes.update,\n354: \t\t\tthis.activeNote!.id,\n355: \t\t\trequest\n356: \t\t);\n357: \t\tif (ok) await this.load();\n358: \t\treturn ok;\n359: \t}\n360: \n361: \tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n362: \t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n363: \t\tconst ok = await this.apiService.update(\n364: \t\t\tapiRoutes.notes.update,\n365: \t\t\tthis.activeNote!.id,\n366: \t\t\trequest\n367: \t\t);\n368: \t\tif (ok) await this.load();\n369: \t\treturn ok;\n370: \t}\n371: \n372: \tasync addTag(tagId: number): Promise<boolean> {\n373: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n374: \t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n375: \t\tconst ok = await this.apiService.update(\n376: \t\t\tapiRoutes.notes.update,\n377: \t\t\tthis.activeNote!.id,\n378: \t\t\trequest\n379: \t\t);\n380: \n381: \t\tif (ok) await this.load();\n382: \t\treturn ok;\n383: \t}\n384: \n385: \tasync removeTag(tagId: number): Promise<boolean> {\n386: \t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n387: \t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n388: \t\tconst ok = await this.apiService.update(\n389: \t\t\tapiRoutes.notes.update,\n390: \t\t\tthis.activeNote!.id,\n391: \t\t\trequest\n392: \t\t);\n393: \n394: \t\tif (ok) await this.load();\n395: \t\treturn ok;\n396: \t}\n397: \n398: \tasync delete(): Promise<boolean> {\n399: \t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n400: \t\t\treturn false;\n401: \t\t}\n402: \n403: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n404: \t\tif (ok) {\n405: \t\t\tif (this.activeNote?.id === this.rightClickId) {\n406: \t\t\t\tawait goto(resolve(urls.notes));\n407: \t\t\t}\n408: \n409: \t\t\tawait this.load();\n410: \t\t\tthis.closeRightClickMenu();\n411: \t\t}\n412: \t\treturn ok;\n413: \t}\n414: \n415: \tasync deleteActiveNote(): Promise<boolean> {\n416: \t\tif (!this.activeNote) return false;\n417: \n418: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n419: \t\tif (ok) {\n420: \t\t\tawait goto(resolve(urls.notes));\n421: \t\t\tawait this.load();\n422: \t\t}\n423: \t\treturn ok;\n424: \t}\n425: \n426: \tasync deleteCategory(): Promise<boolean> {\n427: \t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n428: \t\t\treturn false;\n429: \t\t}\n430: \n431: \t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n432: \t\tif (ok) await this.loadCategories();\n433: \t\tthis.closeRightClickMenu();\n434: \t\treturn ok;\n435: \t}\n436: \n437: \tasync importFile(file: File): Promise<boolean> {\n438: \t\tconst formData = new FormData();\n439: \t\tformData.append('file', file);\n440: \t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n441: \n442: \t\tif (ok) {\n443: \t\t\tawait this.load();\n444: \t\t\treturn true;\n445: \t\t}\n446: \n447: \t\treturn false;\n448: \t}\n449: }\n450: \n451: const NOTES_KEY = Symbol('SOLYTO_NOTES');\n452: \n453: export function setNotes(): NotesSvelte {\n454: \treturn setContext(NOTES_KEY, new NotesSvelte());\n455: }\n456: \n457: export function getNotes(): NotesSvelte {\n458: \treturn getContext<NotesSvelte>(NOTES_KEY);\n459: }\n\n(End of file - total 459 lines)\n</content>","metadata":{"preview":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { getTranslation } from '$lib/state/Translation.svelte';\nimport { getUiNotifications } from '$lib/state/UiNotifications.svelte';\nimport { page } from '$app/state';\nimport { goto } from '$app/navigation';\nimport { urls } from '$lib/config/urls';\nimport { resolve } from '$app/paths';\nimport ApiService from '$lib/services/ApiService';\nimport JournalService from '$lib/services/JournalService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { apiRoutes } from '$lib/config/apiRoutes';","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Notes.svelte.ts","text":"import type {\n\tCreateNoteCategoryRequest,\n\tCreateNoteRequest,\n\tNote,\n\tNoteCategory,\n\tUpdateNoteCategoryRequest,\n\tUpdateNoteRequest\n} from '$lib/types/note';\nimport { setContext, getContext, tick } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { getTranslation } from '$lib/state/Translation.svelte';\nimport { getUiNotifications } from '$lib/state/UiNotifications.svelte';\nimport { page } from '$app/state';\nimport { goto } from '$app/navigation';\nimport { urls } from '$lib/config/urls';\nimport { resolve } from '$app/paths';\nimport ApiService from '$lib/services/ApiService';\nimport JournalService from '$lib/services/JournalService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport { SvelteDate } from 'svelte/reactivity';\n\nexport class NotesSvelte {\n\tstatic readonly LS_COLLAPSED_CATEGORIES_KEY: string = 'notes.collapsedCategories';\n\n\tloaded = $state<boolean>(false);\n\tnotes = $state<Note[]>([]);\n\tnewestNotes = $state<Note[]>([]);\n\tlastUpdatedNotes = $state<Note[]>([]);\n\tfavoriteNotes = $state<Note[]>([]);\n\tcategories = $state<NoteCategory[]>([]);\n\tjournalCategory = $state<NoteCategory | null>(null);\n\tcollapsedCategories = $state<number[]>([]);\n\tactiveNote = $state<Note | null>(null);\n\tmodalOpen = $state<boolean>(false);\n\tcreateType = $state<'note' | 'category'>('note');\n\tcreateParent = $state<number | null>(null);\n\trightClickMenuOpen = $state<boolean>(false);\n\trightClickMenuX = $state<number>(0);\n\trightClickMenuY = $state<number>(0);\n\trightClickType = $state<'note' | 'category'>('note');\n\trightClickId = $state<number | string | null>(null);\n\tdraggedNote = $state<Note | null>(null);\n\tdragTarget = $state<NoteCategory | null>(null);\n\tinput = $state<HTMLInputElement | null>(null);\n\tinputValue = $state<string>('');\n\tauth = getAuth();\n\tts = getTranslation();\n\tnotifications = getUiNotifications();\n\tapiService: ApiService;\n\tlocalStorage = new LocalStorageService();\n\tjournalService = new JournalService();\n\n\tconstructor() {\n\t\tthis.apiService = this.auth.apiService;\n\t\tthis.loadCollapsedCategories();\n\t}\n\n\tasync load(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.notes.list);\n\t\tif (res) {\n\t\t\tthis.loaded = true;\n\t\t\tthis.notes = res.data as Note[];\n\t\t\tthis.newestNotes = this.getNewestNotes();\n\t\t\tthis.lastUpdatedNotes = this.getLastUpdatedNotes();\n\t\t\tthis.favoriteNotes = this.getFavorites();\n\t\t\tthis.checkUrlForActiveNote();\n\t\t}\n\t}\n\n\tloadCollapsedCategories(): void {\n\t\tconst stored = this.localStorage.getJson(NotesSvelte.LS_COLLAPSED_CATEGORIES_KEY);\n\t\tthis.collapsedCategories = (stored as number[] | null) ?? [];\n\t}\n\n\tsaveCollapsedCategories(): void {\n\t\tthis.localStorage.setJson(\n\t\t\tNotesSvelte.LS_COLLAPSED_CATEGORIES_KEY,\n\t\t\tthis.collapsedCategories\n\t\t);\n\t}\n\n\tcheckUrlForActiveNote(): void {\n\t\tif (page.params.id) {\n\t\t\tthis.selectNote(page.params.id);\n\t\t}\n\t}\n\n\tasync loadCategories(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.notes.listCategories);\n\t\tif (res) {\n\t\t\tconst all = res.data as NoteCategory[];\n\t\t\t// The system journal folder is resolved separately and kept out of the\n\t\t\t// rendered category tree.\n\t\t\tthis.journalCategory = this.journalService.findJournalCategory(all);\n\t\t\tthis.categories = all.filter((c) => !c.is_system);\n\t\t}\n\t}\n\n\tisJournalNote(note: Note): boolean {\n\t\treturn this.journalCategory !== null && note.category_id === this.journalCategory.id;\n\t}\n\n\tgetJournalEntry(date: Date): Note | null {\n\t\tif (this.journalCategory === null) return null;\n\t\treturn this.journalService.findEntry(this.notes, this.journalCategory.id, date);\n\t}\n\n\tgetJournalEntryDates(): string[] {\n\t\tif (this.journalCategory === null) return [];\n\t\treturn this.journalService.getEntryDates(this.notes, this.journalCategory.id);\n\t}\n\n\t// Resolves the day's entry in the journal folder, creating it on first open,\n\t// and makes it the active note so the editor can render it.\n\tasync openJournalEntry(date: Date): Promise<Note | null> {\n\t\tif (this.journalCategory === null) return null;\n\n\t\tconst existing = this.getJournalEntry(date);\n\t\tif (existing) {\n\t\t\tthis.activeNote = existing;\n\t\t\treturn existing;\n\t\t}\n\n\t\tconst request: CreateNoteRequest = {\n\t\t\ttitle: this.journalService.getEntryTitle(date),\n\t\t\tcategory_id: this.journalCategory.id\n\t\t};\n\t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n\n\t\tif (!res) {\n\t\t\tthis.notifications.error(this.ts.get.notes.journal_create_error);\n\t\t\treturn null;\n\t\t}\n\n\t\tconst created = res.data as Note;\n\t\tawait this.load();\n\t\tthis.activeNote = this.notes.find((n) => n.id === created.id) ?? created;\n\n\t\treturn this.activeNote;\n\t}\n\n\ttoggleCollapseCategory(categoryId: number): void {\n\t\tif (this.collapsedCategories.includes(categoryId)) {\n\t\t\tthis.collapsedCategories = this.collapsedCategories.filter((c) => c !== categoryId);\n\t\t} else {\n\t\t\tthis.collapsedCategories.push(categoryId);\n\t\t}\n\n\t\tthis.saveCollapsedCategories();\n\t}\n\n\tisCategoryCollapsed(categoryId: number): boolean {\n\t\treturn this.collapsedCategories.includes(categoryId);\n\t}\n\n\tgetNotesForCategory(categoryId: number | null): Note[] {\n\t\treturn this.notes.filter((n) => n.category_id === categoryId && !this.isJournalNote(n));\n\t}\n\n\tgetVisibleNotes(): Note[] {\n\t\treturn this.notes.filter((n) => !this.isJournalNote(n));\n\t}\n\n\tgetCategoryTitle(categoryId: number): string {\n\t\tfor (const cat of this.categories) {\n\t\t\tif (cat.id === categoryId) return cat.title;\n\t\t\tif (cat.children) {\n\t\t\t\tfor (const child of cat.children) {\n\t\t\t\t\tif (child.id === categoryId) return child.title;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\treturn '-';\n\t}\n\n\tgetLastUpdatedNotes(): Note[] {\n\t\treturn this.getVisibleNotes()\n\t\t\t.sort(\n\t\t\t\t(a, b) =>\n\t\t\t\t\tnew SvelteDate(b.updated_at).getTime() - new SvelteDate(a.updated_at).getTime()\n\t\t\t)\n\t\t\t.slice(0, 5);\n\t}\n\n\tgetNewestNotes(): Note[] {\n\t\treturn this.getVisibleNotes()\n\t\t\t.sort(\n\t\t\t\t(a, b) =>\n\t\t\t\t\tnew SvelteDate(b.created_at).getTime() - new SvelteDate(a.created_at).getTime()\n\t\t\t)\n\t\t\t.slice(0, 5);\n\t}\n\n\tgetFavorites(): Note[] {\n\t\treturn this.getVisibleNotes().filter((n) => n.is_favorite);\n\t}\n\n\tselectNote(noteId: string): void {\n\t\tthis.activeNote = this.notes.find((n) => n.id === noteId) ?? null;\n\t}\n\n\tasync openModal(type: 'note' | 'category', edit: boolean = false): Promise<void> {\n\t\tif (type === 'category' && edit && this.rightClickId) {\n\t\t\tthis.inputValue =\n\t\t\t\tthis.categories.filter((c) => c.id === this.rightClickId)[0]?.title ?? '';\n\t\t} else {\n\t\t\tthis.inputValue = '';\n\t\t}\n\n\t\tthis.createType = type;\n\t\tthis.modalOpen = true;\n\n\t\tawait tick();\n\n\t\tsetTimeout(() => this.input?.focus(), 100);\n\t}\n\n\tcloseModal(): void {\n\t\tthis.modalOpen = false;\n\t}\n\n\tasync openCreateNoteModal(parent: number | null): Promise<void> {\n\t\tthis.createParent = parent;\n\t\tawait this.openModal('note');\n\t}\n\n\topenRightClickMenu(event: MouseEvent, type: 'note' | 'category', id: number | string): void {\n\t\tevent.preventDefault();\n\n\t\tthis.rightClickType = type;\n\t\tthis.rightClickMenuX = event.clientX;\n\t\tthis.rightClickMenuY = event.clientY;\n\t\tthis.rightClickId = id;\n\t\tthis.createParent = type === 'category' ? id as number : null;\n\t\tthis.rightClickMenuOpen = true;\n\t}\n\n\tcloseRightClickMenu(): void {\n\t\tthis.rightClickMenuOpen = false;\n\t}\n\n\tasync dragToCategory(): Promise<void> {\n\t\tif (this.draggedNote === null) return;\n\n\t\tconst request: UpdateNoteRequest = {\n\t\t\tcategory_id: this.dragTarget ? this.dragTarget.id : null\n\t\t};\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.draggedNote.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn Promise.resolve();\n\t}\n\n\tasync create(): Promise<Note | null> {\n\t\tif (this.inputValue === '') {\n\t\t\treturn null;\n\t\t}\n\n\t\tconst request: CreateNoteRequest =\n\t\t\tthis.createParent !== null\n\t\t\t\t? { title: this.inputValue, category_id: this.createParent }\n\t\t\t\t: { title: this.inputValue };\n\t\tconst res = await this.apiService.create(apiRoutes.notes.create, request);\n\n\t\tif (!res) {\n\t\t\t// Keep the modal and the user's input intact so the note (and the\n\t\t\t// failure) is not silently swallowed; a 401 is recovered upstream.\n\t\t\tthis.notifications.error(this.ts.get.notes.create_error);\n\t\t\tthis.rightClickMenuOpen = false;\n\t\t\treturn null;\n\t\t}\n\n\t\tconst note = res.data as Note;\n\n\t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n\t\t\tthis.toggleCollapseCategory(this.createParent);\n\t\t}\n\n\t\tthis.inputValue = '';\n\t\tthis.createParent = null;\n\t\tthis.rightClickMenuOpen = false;\n\t\tthis.modalOpen = false;\n\n\t\tawait this.load();\n\t\tthis.activeNote = this.notes.find((n) => n.id === note.id) ?? note;\n\t\tawait goto(resolve(urls.note, { id: note.id }));\n\n\t\treturn note;\n\t}\n\n\tasync createCategory(edit: boolean = false): Promise<NoteCategory | null> {\n\t\tif (this.inputValue === '') {\n\t\t\treturn null;\n\t\t}\n\n\t\tlet res;\n\n\t\tif (edit && this.rightClickId) {\n\t\t\tconst request: UpdateNoteCategoryRequest = { title: this.inputValue };\n\t\t\tres = await this.apiService.update(\n\t\t\t\tapiRoutes.notes.updateCategory,\n\t\t\t\tthis.rightClickId,\n\t\t\t\trequest\n\t\t\t);\n\t\t} else {\n\t\t\tconst request: CreateNoteCategoryRequest =\n\t\t\t\tthis.createParent !== null\n\t\t\t\t\t? { title: this.inputValue, parent_id: this.createParent }\n\t\t\t\t\t: { title: this.inputValue };\n\t\t\tres = await this.apiService.create(apiRoutes.notes.createCategory, request);\n\t\t}\n\n\t\tif (!res) {\n\t\t\t// Keep the modal and the user's input intact (see create()).\n\t\t\tthis.notifications.error(this.ts.get.notes.create_folder_error);\n\t\t\tthis.rightClickMenuOpen = false;\n\t\t\treturn null;\n\t\t}\n\n\t\tawait this.loadCategories();\n\n\t\tif (this.createParent && !this.collapsedCategories.includes(this.createParent)) {\n\t\t\tthis.toggleCollapseCategory(this.createParent);\n\t\t}\n\n\t\tthis.inputValue = '';\n\t\tthis.createParent = null;\n\t\tthis.rightClickMenuOpen = false;\n\t\tthis.modalOpen = false;\n\n\t\treturn typeof res === 'object' ? (res.data as NoteCategory) : null;\n\t}\n\n\tasync saveContent(): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { content: this.activeNote!.content };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync changeTitle(title: string): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { title: title };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync updateFavoriteStatus(note: Note, isFavorite: boolean): Promise<boolean> {\n\t\tconst request: UpdateNoteRequest = { is_favorite: isFavorite };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync addTag(tagId: number): Promise<boolean> {\n\t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n\t\tconst request: UpdateNoteRequest = { tags: tagIds.concat([tagId]) };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync removeTag(tagId: number): Promise<boolean> {\n\t\tconst tagIds = this.activeNote!.tags.map((t) => t.id);\n\t\tconst request: UpdateNoteRequest = { tags: tagIds.filter((id) => id != tagId) };\n\t\tconst ok = await this.apiService.update(\n\t\t\tapiRoutes.notes.update,\n\t\t\tthis.activeNote!.id,\n\t\t\trequest\n\t\t);\n\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync delete(): Promise<boolean> {\n\t\tif (this.rightClickType === 'category' || typeof this.rightClickId !== 'string') {\n\t\t\treturn false;\n\t\t}\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.rightClickId);\n\t\tif (ok) {\n\t\t\tif (this.activeNote?.id === this.rightClickId) {\n\t\t\t\tawait goto(resolve(urls.notes));\n\t\t\t}\n\n\t\t\tawait this.load();\n\t\t\tthis.closeRightClickMenu();\n\t\t}\n\t\treturn ok;\n\t}\n\n\tasync deleteActiveNote(): Promise<boolean> {\n\t\tif (!this.activeNote) return false;\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.delete, this.activeNote.id);\n\t\tif (ok) {\n\t\t\tawait goto(resolve(urls.notes));\n\t\t\tawait this.load();\n\t\t}\n\t\treturn ok;\n\t}\n\n\tasync deleteCategory(): Promise<boolean> {\n\t\tif (this.rightClickType === 'note' || typeof this.rightClickId !== 'number') {\n\t\t\treturn false;\n\t\t}\n\n\t\tconst ok = await this.apiService.delete(apiRoutes.notes.deleteCategory, this.rightClickId);\n\t\tif (ok) await this.loadCategories();\n\t\tthis.closeRightClickMenu();\n\t\treturn ok;\n\t}\n\n\tasync importFile(file: File): Promise<boolean> {\n\t\tconst formData = new FormData();\n\t\tformData.append('file', file);\n\t\tconst ok = await this.apiService.post(apiRoutes.notes.import, formData);\n\n\t\tif (ok) {\n\t\t\tawait this.load();\n\t\t\treturn true;\n\t\t}\n\n\t\treturn false;\n\t}\n}\n\nconst NOTES_KEY = Symbol('SOLYTO_NOTES');\n\nexport function setNotes(): NotesSvelte {\n\treturn setContext(NOTES_KEY, new NotesSvelte());\n}\n\nexport function getNotes(): NotesSvelte {\n\treturn getContext<NotesSvelte>(NOTES_KEY);\n}","lineStart":1,"lineEnd":459,"totalLines":459,"truncated":false}},"title":"src/lib/state/Notes.svelte.ts","time":{"start":1791639466143,"end":1791639466287}},"id":"prt_12608b06c001CLFTcNFaSZTBX9","sessionID":"ses_ed9f7786fffeTGZhqVpS150df1","messageID":"msg_12608a80d001oMddmADPSiJNE7"}}
