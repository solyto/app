s.\\n12: \\tfindJournalCategory(categories: NoteCategory[]): NoteCategory | null {\\n13: \\t\\tfor (const category of categories) {\\n14: \\t\\t\\tif (category.is_system) return category;\\n15: \\t\\t\\tif (category.children) {\\n16: \\t\\t\\t\\tconst child = category.children.find((c) => c.is_system);\\n17: \\t\\t\\t\\tif (child) return child;\\n18: \\t\\t\\t}\\n19: \\t\\t}\\n20: \\n21: \\t\\treturn null;\\n22: \\t}\\n23: \\n24: \\tgetEntryTitle(date: Date): string {\\n25: \\t\\treturn getUrlFormat(date);\\n26: \\t}\\n27: \\n28: \\tisEntryTitle(title: string): boolean {\\n29: \\t\\treturn ENTRY_TITLE_PATTERN.test(title);\\n30: \\t}\\n31: \\n32: \\tfindEntry(notes: Note[], categoryId: number, date: Date): Note | null {\\n33: \\t\\tconst title = this.getEntryTitle(date);\\n34: \\t\\treturn (\\n35: \\t\\t\\tnotes.find((note) => note.category_id === categoryId && note.title === title) ?? null\\n36: \\t\\t);\\n37: \\t}\\n38: \\n39: \\t// Dates (YYYY-MM-DD) that already have an entry, for archive marking.\\n40: \\tgetEntryDates(notes: Note[], categoryId: number): string[] {\\n41: \\t\\treturn notes\\n42: \\t\\t\\t.filter((note) => note.category_id === categoryId && this.isEntryTitle(note.title))\\n43: \\t\\t\\t.map((note) => note.title);\\n44: \\t}\\n45: \\n46: \\t// Only today and earlier are reachable from the notebook; future days are not.\\n47: \\tisReachable(date: Date, today: Date = new Date()): boolean {\\n48: \\t\\treturn getUrlFormat(date) <= getUrlFormat(today);\\n49: \\t}\\n50: }\\n\\n(End of file - total 50 lines)\\n</content>\",\"metadata\":{\"preview\":\"import type { Note, NoteCategory } from '$lib/types/note';\\nimport { getUrlFormat } from '$lib/helpers/DateHelper';\\n\\n// Journal entries are ordinary notes addressed by a date title (YYYY-MM-DD)\\n// inside the single system-owned journal folder.\\nconst ENTRY_TITLE_PATTERN = /^\\\\d{4}-\\\\d{2}-\\\\d{2}$/;\\n\\nexport default class JournalService {\\n\\t// The journal folder is identified by its system