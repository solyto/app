{"type":"tool_use","timestamp":1791639675664,"sessionID":"ses_ed9f4e243ffefIDWX0046IKymc","part":{"type":"tool","tool":"read","callID":"call_00_cUJlZPZph06nM99CAEN16582","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/components/notes/editor/TipTapEditor.svelte"},"output":"<path>/workspace/src/lib/components/notes/editor/TipTapEditor.svelte</path>\n<type>file</type>\n<content>\n1: <script lang=\"ts\">\n2: \timport { Editor } from '@tiptap/core'\n3: \timport StarterKit from '@tiptap/starter-kit'\n4: \timport Placeholder from '@tiptap/extension-placeholder'\n5: \timport Typography from '@tiptap/extension-typography'\n6: \timport Link from '@tiptap/extension-link'\n7: \timport Image from '@tiptap/extension-image'\n8: \timport { Table } from '@tiptap/extension-table'\n9: \timport { TableRow } from '@tiptap/extension-table-row'\n10: \timport { TableCell } from '@tiptap/extension-table-cell'\n11: \timport { TableHeader } from '@tiptap/extension-table-header'\n12: \timport BubbleMenu from '@tiptap/extension-bubble-menu'\n13: \timport { marked } from 'marked'\n14: \timport { onDestroy, onMount } from 'svelte'\n15: \timport { getNotes } from '$lib/state/Notes.svelte'\n16: \timport { getViewPoint } from '$lib/state/Viewpoint.svelte'\n17: \timport EditorToolbar from './EditorToolbar.svelte'\n18: \timport TableBubbleMenu from './TableBubbleMenu.svelte'\n19: \timport type { ActiveStates } from './EditorToolbar.svelte'\n20: \n21: \tconst notes = getNotes()\n22: \tconst viewPoint = getViewPoint()\n23: \n24: \tlet { autofocus = false } = $props<{ autofocus?: boolean }>();\n25: \n26: \tlet editorDiv = $state<HTMLDivElement | null>(null)\n27: \tlet tableBubbleRoot = $state<HTMLDivElement | null>(null)\n28: \tlet editor = $state<Editor | null>(null)\n29: \tlet activeStates = $state<ActiveStates>({\n30: \t\tbold: false,\n31: \t\titalic: false,\n32: \t\tstrike: false,\n33: \t\tcode: false,\n34: \t\tcodeBlock: false,\n35: \t\th1: false,\n36: \t\th2: false,\n37: \t\th3: false,\n38: \t\tbulletList: false,\n39: \t\torderedList: false,\n40: \t\tblockquote: false,\n41: \t\tlink: false\n42: \t})\n43: \n44: \t// Keyboard-aware bottom padding: on mobile, when the on-screen keyboard opens it\n45: \t// otherwise clips the scrollable editor pane so the caret can't be scrolled into\n46: \t// view. Padding the scroll container by the keyboard height gives it room to do so.\n47: \tlet keyboardPadding = $state<string>('')\n48: \tlet removeViewportListeners: (() => void) | null = null\n49: \n50: \tfunction syncActiveStates() {\n51: \t\tif (!editor) return\n52: \t\tactiveStates = {\n53: \t\t\tbold: editor.isActive('bold'),\n54: \t\t\titalic: editor.isActive('italic'),\n55: \t\t\tstrike: editor.isActive('strike'),\n56: \t\t\tcode: editor.isActive('code'),\n57: \t\t\tcodeBlock: editor.isActive('codeBlock'),\n58: \t\t\th1: editor.isActive('heading', { level: 1 }),\n59: \t\t\th2: editor.isActive('heading', { level: 2 }),\n60: \t\t\th3: editor.isActive('heading', { level: 3 }),\n61: \t\t\tbulletList: editor.isActive('bulletList'),\n62: \t\t\torderedList: editor.isActive('orderedList'),\n63: \t\t\tblockquote: editor.isActive('blockquote'),\n64: \t\t\tlink: editor.isActive('link')\n65: \t\t}\n66: \t}\n67: \n68: \tfunction handlePaste(event: ClipboardEvent) {\n69: \t\tconst items = event.clipboardData?.items\n70: \t\tif (!items || !editor) return\n71: \t\tconst instance = editor\n72: \t\tfor (const item of items) {\n73: \t\t\tif (item.type.startsWith('image/')) {\n74: \t\t\t\tevent.preventDefault()\n75: \t\t\t\tconst file = item.getAsFile()\n76: \t\t\t\tif (!file) return\n77: \t\t\t\tconst reader = new FileReader()\n78: \t\t\t\treader.onload = (e) => {\n79: \t\t\t\t\tconst base64 = e.target?.result as string\n80: \t\t\t\t\tif (base64) instance.chain().focus().setImage({ src: base64 }).run()\n81: \t\t\t\t}\n82: \t\t\t\treader.readAsDataURL(file)\n83: \t\t\t\treturn\n84: \t\t\t}\n85: \t\t}\n86: \t}\n87: \n88: \tonMount(async () => {\n89: \t\tif (!editorDiv || !tableBubbleRoot) return\n90: \n91: \t\tconst raw = notes.activeNote?.content ?? ''\n92: \t\tconst content = raw.trimStart().startsWith('<') ? raw : await marked(raw)\n93: \n94: \t\tconst instance = new Editor({\n95: \t\t\telement: editorDiv,\n96: \t\t\textensions: [\n97: \t\t\t\tStarterKit,\n98: \t\t\t\tTypography,\n99: \t\t\t\tPlaceholder.configure({ placeholder: '...' }),\n100: \t\t\t\tLink.configure({ openOnClick: false }),\n101: \t\t\t\tImage,\n102: \t\t\t\tTable.configure({ resizable: true }),\n103: \t\t\t\tTableRow,\n104: \t\t\t\tTableHeader,\n105: \t\t\t\tTableCell,\n106: \t\t\t\tBubbleMenu.configure({\n107: \t\t\t\t\telement: tableBubbleRoot,\n108: \t\t\t\t\tshouldShow: ({ editor: e }) => e.isActive('table')\n109: \t\t\t\t})\n110: \t\t\t],\n111: \t\t\tcontent,\n112: \t\t\tonUpdate({ editor: e }) {\n113: \t\t\t\tsyncActiveStates()\n114: \t\t\t\tif (notes.activeNote) {\n115: \t\t\t\t\tnotes.activeNote.content = e.getHTML()\n116: \t\t\t\t}\n117: \t\t\t},\n118: \t\t\tonSelectionUpdate() {\n119: \t\t\t\tsyncActiveStates()\n120: \t\t\t},\n121: \t\t\teditorProps: {\n122: \t\t\t\tattributes: { class: 'tiptap-editor' }\n123: \t\t\t}\n124: \t\t})\n125: \n126: \t\teditor = instance\n127: \n128: \t\tif (autofocus) instance.commands.focus()\n129: \n130: \t\tconst vv = window.visualViewport\n131: \t\tif (vv && viewPoint.isMobile) {\n132: \t\t\tconst updateKeyboardPadding = () => {\n133: \t\t\t\tconst diff = window.innerHeight - vv.height\n134: \t\t\t\tkeyboardPadding = diff > 60 ? `${diff}px` : ''\n135: \t\t\t}\n136: \n137: \t\t\tvv.addEventListener('resize', updateKeyboardPadding)\n138: \t\t\tvv.addEventListener('scroll', updateKeyboardPadding)\n139: \t\t\tupdateKeyboardPadding()\n140: \n141: \t\t\tremoveViewportListeners = () => {\n142: \t\t\t\tvv.removeEventListener('resize', updateKeyboardPadding)\n143: \t\t\t\tvv.removeEventListener('scroll', updateKeyboardPadding)\n144: \t\t\t}\n145: \t\t}\n146: \t})\n147: \n148: \tonDestroy(() => {\n149: \t\teditor?.destroy()\n150: \t\teditor = null\n151: \t\tremoveViewportListeners?.()\n152: \t})\n153: </script>\n154: \n155: <TableBubbleMenu {editor} bind:root={tableBubbleRoot} />\n156: \n157: <div class=\"flex flex-1 flex-col overflow-y-auto\" style:padding-bottom={keyboardPadding}>\n158: \t{#if editor}\n159: \t\t<EditorToolbar {editor} {activeStates} />\n160: \t{/if}\n161: \t<div bind:this={editorDiv} onpaste={handlePaste} class=\"tiptap-wrapper max-md:pr-8\"></div>\n162: </div>\n163: \n164: <style>\n165: \t:global(.tiptap-wrapper) {\n166: \t\tpadding: 0.2rem;\n167: \t\tbackground-color: var(--color-c-bg);\n168: \t}\n169: \n170: \n171: \t:global(.tiptap-editor) {\n172: \t\tbackground-color: var(--color-c-bg);\n173: \t\tcolor: var(--color-c-text);\n174: \t\tfont-family: var(--t-font-body);\n175: \t\tfont-size: 1.0625rem;\n176: \t\tline-height: 1.8;\n177: \t\toutline: none;\n178: \t\tmin-height: 400px;\n179: \t}\n180: \n181: \t:global(.tiptap-editor p.is-editor-empty:first-child::before) {\n182: \t\tcolor: var(--color-c-neutral-4, #9ca3af);\n183: \t\tcontent: attr(data-placeholder);\n184: \t\tfloat: left;\n185: \t\theight: 0;\n186: \t\tpointer-events: none;\n187: \t}\n188: \n189: \t:global(.tiptap-editor h1) {\n190: \t\tfont-size: 2.25rem;\n191: \t\tfont-weight: 700;\n192: \t\tline-height: 1.2;\n193: \t\tmargin: 1.5rem 0 0.75rem;\n194: \t\tcolor: var(--color-c-heading);\n195: \t}\n196: \n197: \t:global(.tiptap-editor h2) {\n198: \t\tfont-size: 1.625rem;\n199: \t\tfont-weight: 600;\n200: \t\tline-height: 1.3;\n201: \t\tmargin: 1.25rem 0 0.5rem;\n202: \t\tcolor: var(--color-c-heading);\n203: \t}\n204: \n205: \t:global(.tiptap-editor h3) {\n206: \t\tfont-size: 1.25rem;\n207: \t\tfont-weight: 600;\n208: \t\tline-height: 1.4;\n209: \t\tmargin: 1rem 0 0.375rem;\n210: \t\tcolor: var(--color-c-heading);\n211: \t}\n212: \n213: \t:global(.tiptap-editor p) {\n214: \t\tmargin: 0 0 0.875rem;\n215: \t\tline-height: 1.8;\n216: \t}\n217: \n218: \t:global(.tiptap-editor li p) {\n219: \t\tmargin-botto