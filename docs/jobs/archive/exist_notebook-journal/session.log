pi.list.mockResolvedValue({\n303: \t\t\t\tdata: [category(1, 'Work'), journal, category(2, 'Private')]\n304: \t\t\t});\n305: \n306: \t\t\tconst n = new NotesSvelte();\n307: \t\t\tawait n.loadCategories();\n308: \n309: \t\t\texpect(n.journalCategory?.id).toBe(9);\n310: \t\t\texpect(n.categories.map((c) => c.id)).toEqual([1, 2]);\n311: \t\t});\n312: \n313: \t\tit('getJournalEntry finds the day entry in the journal folder', () => {\n314: \t\t\tconst n = withJournal();\n315: \t\t\tn.notes = [\n316: \t\t\t\tnote({ id: 'j1', title: '2026-08-04', category_id: 9 }),\n317: \t\t\t\tnote({ id: 'j2', title: '2026-08-04', category_id: 1 })\n318: \t\t\t];\n319: \t\t\texpect(n.getJournalEntry(new Date(2026, 7, 4))?.id).toBe('j1');\n320: \t\t});\n321: \n322: \t\tit('getJournalEntryDates lists the dates with entries', () => {\n323: \t\t\tconst n = withJournal();\n324: \t\t\tn.notes = [\n325: \t\t\t\tnote({ id: 'j1', title: '2026-08-04', category_id: 9 }),\n326: \t\t\t\tnote({ id: 'x', title: 'Scribble', category_id: 9 }),\n327: \t\t\t\tnote({ id: 'o', title: '2026-08-01', category_id: 1 })\n328: \t\t\t];\n329: \t\t\texpect(n.getJournalEntryDates()).toEqual(['2026-08-04']);\n330: \t\t});\n331: \n332: \t\tit('openJournalEntry reuses an existing entry without creating', async () => {\n333: \t\t\tconst n = withJournal();\n334: \t\t\tn.notes = [note({ id: 'j1', title: '2026-08-04', category_id: 9 })];\n335: \n336: \t\t\tconst result = await n.openJournalEntry(new Date(2026, 7, 4));\n337: \n338: \t\t\texpect(result?.id).toBe('j1');\n339: \t\t\texpect(n.activeNote?.id).toBe('j1');\n340: \t\t\texpect(api.create).not.toHaveBeenCalled();\n341: \t\t});\n342: \n343: \t\tit('openJournalEntry creates the day entry on first open', async () => {\n344: \t\t\tapi.create.mockResolvedValue({\n345: \t\t\t\tdata: note({ id: 'j5', title: '2026-08-04', category_id: 9 })\n346: \t\t\t});\n347: \t\t\tapi.list.mockResolvedValue({\n348: \t\t\t\tdata: [note({ id: 'j5', title: '2026-08-04', category_id: 9 })]\n34