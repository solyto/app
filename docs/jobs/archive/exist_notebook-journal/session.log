e from '$lib/services/JournalService';\n+import type { Note, NoteCategory } from '$lib/types/note';\n+\n+function category(id: number, overrides: Partial<NoteCategory> = {}): NoteCategory {\n+\treturn {\n+\t\tid,\n+\t\ttitle: 'Category',\n+\t\tparent_id: null,\n+\t\tsort_order: 0,\n+\t\tis_system: false,\n+\t\tis_hidden: false,\n+\t\tcreated_at: '',\n+\t\tupdated_at: '',\n+\t\tchildren: [],\n+\t\t...overrides\n+\t};\n+}\n+\n+function note(overrides: Partial<Note> = {}): Note {\n+\treturn {\n+\t\tid: 'n1',\n+\t\ttitle: 'Note',\n+\t\tcontent: '',\n+\t\tcategory_id: null,\n+\t\ttags: [],\n+\t\tis_favorite: false,\n+\t\tcreated_at: '',\n+\t\tupdated_at: '',\n+\t\t...overrides\n+\t};\n+}\n+\n+const service = new JournalService();\n+\n+describe('findJournalCategory', () => {\n+\tit('finds a root-level system category', () => {\n+\t\tconst journal = category(3, { title: '.journal', is_system: true, is_hidden: true });\n+\t\texpect(service.findJournalCategory([category(1), journal, category(2)])).toBe(journal);\n+\t});\n+\n+\tit('finds a system category nested as a child', () => {\n+\t\tconst journal = category(9, { is_system: true });\n+\t\tconst parent = category(1, { children: [category(2), journal] });\n+\t\texpect(service.findJournalCategory([parent])).toBe(journal);\n+\t});\n+\n+\tit('returns null when no category is a system folder', () => {\n+\t\texpect(service.findJournalCategory([category(1), category(2)])).toBeNull();\n+\t});\n+\n+\tit('returns null for an empty list', () => {\n+\t\texpect(service.findJournalCategory([])).toBeNull();\n+\t});\n+});\n+\n+describe('getEntryTitle', () => {\n+\tit('formats a date as YYYY-MM-DD', () => {\n+\t\texpect(service.getEntryTitle(new Date(2026, 7, 4))).toBe('2026-08-04');\n+\t});\n+\n+\tit('pads single-digit months and days', () => {\n+\t\texpect(service.getEntryTitle(new Date(2026, 0, 9))).toBe('2026-01-09');\n+\t});\n+});\n+\n+describe('isEntryTitle', () => {\n+\tit('accepts date titles', () => {\n+\t\texpect(service.isEntryTitle('2026-08-04')).toBe(true);\n+\t});\n+\n+\tit('rejects non-date titles', () => {\n+\t\texpect(service.isEntryTitle('My day')).toBe(false);\n+\t\texpect(service.isEntryTitle('2026-8-4')).toBe(false);\n+\t\texpect(service.isEntryTitle('')).toBe(false);\n+\t});\n+});\n+\n+describe('findEntry', () => {\n+\tit('finds the entry in the journal folder for the date', () => {\n+\t\tconst notes = [\n+\t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n+\t\t\tnote({ id: 'b', title: '2026-08-03', category_id: 7 })\n+\t\t];\n+\t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))?.id).toBe('a');\n+\t});\n+\n+\tit('ignores a matching title in an ordinary folder', () => {\n+\t\tconst notes = [note({ id: 'a', title: '2026-08-04', category_id: 2 })];\n+\t\texpect(service.findEntry(notes, 7, new Date(2026, 7, 4))).toBeNull();\n+\t});\n+\n+\tit('returns null when no entry exists for the day', () => {\n+\t\texpect(service.findEntry([], 7, new Date(2026, 7, 4))).toBeNull();\n+\t});\n+});\n+\n+describe('getEntryDates', () => {\n+\tit('returns the date titles of entries in the journal folder', () => {\n+\t\tconst notes = [\n+\t\t\tnote({ id: 'a', title: '2026-08-04', category_id: 7 }),\n+\t\t\tnote({ id: 'b', title: '2026-08-02', category_id: 7 }),\n+\t\t\tnote({ id: 'c', title: 'Not a date', category_id: 7 }),\n+\t\t\tnote({ id: 'd', title: '2026-08-01', category_id: 2 })\n+\t\t];\n+\t\texpect(service.getEntryDates(notes, 7)).toEqual(['2026-08-04', '2026-08-02']);\n+\t});\n+\n+\tit('returns an empty list when the folder has no entries', () => {\n+\t\texpect(service.getEntryDates([], 7)).toEqual([]);\n+\t});\n+});\n+\n+describe('isReachable', () => {\n+\tconst today = new Date(2026, 7, 4);\n+\n+\tit('allows today', () => {\n+\t\texpect(service.isReachable(new Date(2026, 7, 4), today)).toBe(true);\n+\t});\n+\n+\tit('allows earlier days', () => {\n+\t\texpect(service.isReachable(new Date(2026, 7, 1), today)).toBe(true);\n+\t});\n+\n+\tit('rejects future days', () => {\n+\t\texpect(service.isReachable(new Date(2026, 7, 5), today)).toBe(false);\n+\t});\n+\n+\tit('compares by day, ignoring the time of day', () => {\n+\t\tconst lateToday = new Date(2026, 7, 4, 23, 59);\n+\t\texpect(service.isReachable(lateToday, new Date(2026, 7, 4, 0, 1))).toBe(true);\n+\t});\n+});\ndiff --git a/tests/unit/stores/Notes.test.ts b/tests/unit/stores/Notes.test.ts\nindex 5228a58..b682737 100644\n--- a/tests/unit/stores/Notes.test.ts\n+++ b/tests/unit/stores/Notes.test.ts\n@@ -20,7 +20,8 @@ const ts = {\n \tget: {\n \t\tnotes: {\n \t\t\tcreate_error: 'Failed to create note.',\n-\t\t\tcreate_folder_error: 'Failed to create folder.'\n+\t\t\tcreate_folder_error: 'Failed to create folder.',\n+\t\t\tjournal_create_error: 'Failed to open journal entry.'\n \t\t}\n \t}\n };\n@@ -53,6 +54,8 @@ function category(id: number, title: string, overrides: Partial<NoteCategory> =\n \t\ttitle,\n \t\tparent_id: null,\n \t\tsort_order: 0,\n+\t\tis_system: false,\n+\t\tis_hidden: false,\n \t\tcreated_at: '',\n \t\tupdated_at: '',\n \t\tchildren: [],\n@@ -286,6 +289,119 @@ describe('Notes store', () => {\n \t\t});\n \t});\n \n+\tdescribe('journal', () => {\n+\t\tconst journal = category(9, '.journal', { is_system: true, is_hidden: true });\n+\n+\t\tfunction withJournal(): NotesSvelte {\n+\t\t\tconst n = new NotesSvelte();\n+\t\t\tn.journalCategory = journal;\n+\t\t\treturn n;\n+\t\t}\n+\n+\t\tit('loadCategories resolves the journal folder and keeps it out of the tree', async () => {\n+\t\t\tapi.list.mockResolvedValue({\n+\t\t\t\tdata: [category(1, 'Work'), journal, category(2, 'Private')]\n+\t\t\t});\n+\n+\t\t\tconst n = new NotesSvelte();\n+\t\t\tawait n.loadCategories();\n+\n+\t\t\texpect(n.journalCategory?.id).toBe(9);\n+\t\t\texpect(n.categories.map((c) => c.id)).toEqual([1, 2]);\n+\t\t});\n+\n+\t\tit('getJournalEntry finds the day entry in the journal folder', () => {\n+\t\t\tconst n = withJournal();\n+\t\t\tn.notes = [\n+\t\t\t\tnote({ id: 'j1', title: '2026-08-04', category_id: 9 }),\n+\t\t\t\tnote({ id: 'j2', title: '2026-08-04', category_id: 1 })\n+\t\t\t];\n+\t\t\texpect(n.getJournalEntry(new Date(2026, 7, 4))?.id).toBe('j1');\n+\t\t});\n+\n+\t\tit('getJournalEntryDates lists the dates with entries', () => {\n+\t\t\tconst n = withJournal();\n+\t\t\tn.notes = [\n+\t\t\t\tnote({ id: 'j1', title: '2026-08-04', category_id: 9 }),\n+\t\t\t\tnote({ id: 'x', title: 'Scribble', category_id: 9 }),\n+\t\t\t\tnote({ id: 'o', title: '2026-08-01', category_id: 1 })\n+\t\t\t];\n+\t\t\texpect(n.getJournalEntryDates()).toEqual(['2026-08-04']);\n+\t\t});\n+\n+\t\tit('openJournalEntry reuses an existing entry without creating', async () => {\n+\t\t\tconst n = withJournal();\n+\t\t\tn.notes = [note({ id: 'j1', title: '2026-08-04', category_id: 9 })];\n+\n+\t\t\tconst result = await n.openJournalEntry(new Date(2026, 7, 4));\n+\n+\t\t\texpect(result?.id).toBe('j1');\n+\t\t\texpect(n.activeNote?.id).toBe('j1');\n+\t\t\texpect(api.create).not.toHaveBeenCalled();\n+\t\t});\n+\n+\t\tit('openJournalEntry creates the day entry on first open', async () => {\n+\t\t\tapi.create.mockResolvedValue({\n+\t\t\t\tdata: note({ id: 'j5', title: '2026-08-04', category_id: 9 })\n+\t\t\t});\n+\t\t\tapi.list.mockResolvedValue({\n+\t\t\t\tdata: [note({ id: 'j5', title: '2026-08-04', category_id: 9 })]\n+\t\t\t});\n+\n+\t\t\tconst n = withJournal();\n+\t\t\tconst result = await n.openJournalEntry(new Date(2026, 7, 4));\n+\n+\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('/notes'), {\n+\t\t\t\ttitle: '2026-08-04',\n+\t\t\t\tcategory_id: 9\n+\t\t\t});\n+\t\t\texpect(result?.id).toBe('j5');\n+\t\t\texpect(n.activeNote?.id).toBe('j5');\n+\t\t});\n+\n+\t\tit('openJournalEntry reports an error when creation fails', async () => {\n+\t\t\tapi.create.mockResolvedValue(null);\n+\n+\t\t\tconst n = withJournal();\n+\t\t\tawait expect(n.openJournalEntry(new Date(2026, 7, 4))).resolves.toBeNull();\n+\t\t\texpect(notifications.error).toHaveBeenCalledWith('Failed to open journal entry.');\n+\t\t});\n+\n+\t\tit('openJournalEntry does nothing when no journal folder is known', async () => {\n+\t\t\tconst n = new NotesSvelte();\n+\t\t\tawait expect(n.openJournalEntry(new Date(2026, 7, 4))).resolves.toBeNull();\n+\t\t\texpect(api.create).not.toHaveBeenCalled();\n+\t\t});\n+\n+\t\tit('excludes journal entries from the ordinary note surfaces', () => {\n+\t\t\tconst n = withJournal();\n+\t\t\tn.notes = [\n+\t\t\t\tnote({\n+\t\t\t\t\tid: 'j1',\n+\t\t\t\t\ttitle: '2026-08-04',\n+\t\t\t\t\tcategory_id: 9,\n+\t\t\t\t\tis_favorite: true,\n+\t\t\t\t\tcreated_at: '2026-09-01T00:00:00',\n+\t\t\t\t\tupdated_at: '2026-09-01T00:00:00'\n+\t\t\t\t}),\n+\t\t\t\tnote({\n+\t\t\t\t\tid: 'o1',\n+\t\t\t\t\ttitle: 'Ordinary',\n+\t\t\t\t\tcategory_id: null,\n+\t\t\t\t\tcreated_at: '2026-01-01T00:00:00',\n+\t\t\t\t\tupdated_at: '2026-01-01T00:00:00'\n+\t\t\t\t})\n+\t\t\t];\n+\n+\t\t\texpect(n.getVisibleNotes().map((x) => x.id)).toEqual(['o1']);\n+\t\t\texpect(n.getNewestNotes().map((x) => x.id)).toEqual(['o1']);\n+\t\t\texpect(n.getLastUpdatedNotes().map((x) => x.id)).toEqual(['o1']);\n+\t\t\texpect(n.getFavorites()).toEqual([]);\n+\t\t\texpect(n.getNotesForCategory(null).map((x) => x.id)).toEqual(['o1']);\n+\t\t\texpect(n.getNotesForCategory(9)).toEqual([]);\n+\t\t});\n+\t});\n+\n \tdescribe('createCategory', () => {\n \t\tit('does nothing when the input is empty', async () => {\n \t\t\tconst n = new NotesSvelte();\n","exit":0,"truncated":false},"title":"git diff main...HEAD -- src/ tests/","time":{"start":1791639351273,"end":1791639351341}},"id":"prt_12606ef79001563MCWvNCZcIsK","sessionID":"ses_ed9f94635ffee3zYlqCKAoMoF3","messageID":"msg_12606e8570010ao36cZos0TyXH"}}
