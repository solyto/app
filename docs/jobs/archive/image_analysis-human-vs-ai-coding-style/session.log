urrence_frequency);\n33: \t\treturn option?.label ?? todo.recurrence_frequency;\n34: \t}\n35: \n36: \tasync function save(): Promise<void> {\n37: \t\tisOpen = false;\n38: \t\tloadingIndicator.start();\n39: \t\tawait todos.changeRecurrence(\n40: \t\t\ttodo,\n41: \t\t\tselectedFrequency,\n42: \t\t\tselectedInterval,\n43: \t\t\tselectedEndsAt || null\n44: \t\t);\n45: \t\tloadingIndicator.stop();\n46: \t}\n47: \n48: \tasync function remove(): Promise<void> {\n49: \t\tselectedFrequency = null;\n50: \t\tselectedInterval = 1;\n51: \t\tselectedEndsAt = '';\n52: \t\tloadingIndicator.start();\n53: \t\tawait todos.changeRecurrence(todo, null);\n54: \t\tloadingIndicator.stop();\n55: \t}\n56: \n57: \tfunction open(): void {\n58: \t\tif (!hasDueDate) return;\n59: \t\tselectedFrequency = todo.recurrence_frequency;\n60: \t\tselectedInterval = todo.recurrence_interval ?? 1;\n61: \t\tselectedEndsAt = todo.recurrence_ends_at ?? '';\n62: \t\tisOpen = true;\n63: \t}\n64: </script>\n65: \n66: <div class=\"group relative flex items-center gap-1\">\n67: \t{#if !hasDueDate}\n68: \t\t<span class=\"cursor-not-allowed text-xs text-c-neutral-3 dark:text-c-neutral-6\" title={ts.get.todos.recurrence_requires_due}>\n69: \t\t\t<IconRepeat class=\"size-4\" />\n70: \t\t</span>\n71: \t{:else if todo.recurrence_frequency}\n72: \t\t<button\n73: \t\t\tclass=\"flex cursor-pointer items-center gap-1 text-xs text-c-primary hover:text-c-primary/80\"\n74: \t\t\tonclick={open}\n75: \t\t>\n76: \t\t\t<IconRepeat class=\"size-4\" />\n77: \t\t\t<span>{recurrenceLabel()}</span>\n78: \t\t</button>\n79: \t\t<button\n80: \t\t\tclass=\"hidden size-4 cursor-pointer items-center justify-center rounded-full bg-c-danger text-white group-hover:flex\"\n81: \t\t\tonclick={remove}\n82: \t\t>\n83: \t\t\t<IconX class=\"size-3\" />\n84: \t\t</button>\n85: \t{:else}\n86: \t\t<button\n87: \t\t\tclass=\"cursor-pointer text-xs text-c-neutral-4 transition-all hover:text-c-neutral-7 dark:hover:text-white\"\n88: \t\t\tonclick={open}\n89