{"type":"tool_use","timestamp":1791728777836,"sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","part":{"type":"tool","tool":"read","callID":"call_00_FlsD6aiQl15XDIX4brZx6031","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/Todos.test.ts"},"output":"<path>/workspace/tests/unit/stores/Todos.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { Todos } from '$lib/state/Todos.svelte';\n3: import { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\n4: import { todo, category } from '../helpers/factories';\n5: \n6: beforeEach(() => {\n7: \tresetStoreMocks();\n8: \tpageState.pathname = '/todos';\n9: });\n10: \n11: afterEach(() => {\n12: \tvi.useRealTimers();\n13: });\n14: \n15: describe('Todos store', () => {\n16: \tit('constructs with the mocked defaults', () => {\n17: \t\tconst t = new Todos();\n18: \t\texpect(t.auth.getToken()).toBe('test-token');\n19: \t\texpect(t.apiService).toBeDefined();\n20: \t});\n21: \n22: \tit('loads todos, categories and workspaces', async () => {\n23: \t\tapi.list.mockImplementation(async (endpoint: string) => {\n24: \t\t\tif (endpoint.includes('categories')) return { data: [category(1, 'Work')] };\n25: \t\t\tif (endpoint.includes('workspaces')) return { data: [] };\n26: \t\t\treturn { data: [todo({ id: '1', status: 'pending' })] };\n27: \t\t});\n28: \n29: \t\tconst t = new Todos();\n30: \t\tawait t.load();\n31: \n32: \t\texpect(t.loaded).toBe(true);\n33: \t\texpect(t.todos).toHaveLength(1);\n34: \t\texpect(t.categories.map((c) => c.id)).toEqual([1]);\n35: \t\texpect(t.groupedTodos.find((g) => g.status === 'pending')?.todos).toHaveLength(1);\n36: \t});\n37: \n38: \tdescribe('useFilters', () => {\n39: \t\tit('removes backlog todos unless a backlog filter is active', () => {\n40: \t\t\tconst t = new Todos();\n41: \t\t\tt.todos = [todo({ id: '1', status: 'backlog' }), todo({ id: '2', status: 'pending' })];\n42: \n43: \t\t\tt.useFilters([]);\n44: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n45: \n46: \t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n47: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n48: \t\t});\n49: \n50: \t\tit('applies category and tag filters', () => {\n51: \t\t\tconst cat = category(1, 'Work');\n52: \t\t\tconst t = new Todos();\n53: \t\t\tt.todos = [\n54: \t\t\t\ttodo({ id: '1', category: cat }),\n55: \t\t\t\ttodo({ id: '2', category: null }),\n56: \t\t\t\ttodo({\n57: \t\t\t\t\tid: '3',\n58: \t\t\t\t\ttags: [{ id: 5, name: 'x', color: '#fff', created_at: '', updated_at: '' }]\n59: \t\t\t\t})\n60: \t\t\t];\n61: \n62: \t\t\tt.useFilters([{ type: 'category', value: 1 }]);\n63: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n64: \n65: \t\t\tt.useFilters([{ type: 'tag', value: 5 }]);\n66: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['3']);\n67: \t\t});\n68: \n69: \t\tit('hides todos from hideable workspaces when hide-it is active', () => {\n70: \t\t\tconst cat1 = category(1);\n71: \t\t\tconst hideable = {\n72: \t\t\t\tid: 1,\n73: \t\t\t\ttitle: 'Hidden',\n74: \t\t\t\tis_hideable: true,\n75: \t\t\t\tcategories: [cat1],\n76: \t\t\t\tcreated_at: '',\n77: \t\t\t\tupdated_at: ''\n78: \t\t\t};\n79: \t\t\tconst t = new Todos();\n80: \t\t\tt.workspaces = [hideable];\n81: \t\t\tt.hideItActive = true;\n82: \t\t\tt.todos = [todo({ id: '1', category: cat1 }), todo({ id: '2', category: null })];\n83: \n84: \t\t\tt.useFilters([]);\n85: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n86: \t\t});\n87: \n88: \t\tit('hides backlog todos from hideable workspaces when hide-it is active and the backlog filter is selected', () => {\n89: \t\t\tconst cat1 = category(1);\n90: \t\t\tconst cat2 = category(2);\n91: \t\t\tconst hideable = {\n92: \t\t\t\tid: 1,\n93: \t\t\t\ttitle: 'Hidden',\n94: \t\t\t\tis_hideable: true,\n95: \t\t\t\tcategories: [cat1],\n96: \t\t\t\tcreated_at: '',\n97: \t\t\t\tupdated_at: ''\n98: \t\t\t};\n99: \t\t\tconst t = new Todos();\n100: \t\t\tt.workspaces = [hideable];\n101: \t\t\tt.hideItActive = true;\n102: \t\t\tt.todos = [\n103: \t\t\t\ttodo({ id: '1', status: 'backlog', category: cat1 }),\n104: \t\t\t\ttodo({ id: '2', status: 'backlog', category: cat2 })\n105: \t\t\t];\n106: \n107: \t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n108: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n109: \t\t});\n110: \n111: \t\tit('re-evaluates hide-it against the filters being applied, not the previous selection', () => {\n112: \t\t\t// Regression test: selecting a category filter and then switching to\n113: \t\t\t// the backlog status filter used to leak hidden-workspace backlog\n114: \t\t\t// items through, because the hide-it guard read the stale\n115: \t\t\t// this.activeFilters from before the switch.\n116: \t\t\tconst cat1 = category(1);\n117: \t\t\tconst cat2 = category(2);\n118: \t\t\tconst hideable = {\n119: \t\t\t\tid: 1,\n120: \t\t\t\ttitle: 'Hidden',\n121: \t\t\t\tis_hideable: true,\n122: \t\t\t\tcategories: [cat1],\n123: \t\t\t\tcreated_at: '',\n124: \t\t\t\tupdated_at: ''\n125: \t\t\t};\n126: \t\t\tconst t = new Todos();\n127: \t\t\tt.workspaces = [hideable];\n128: \t\t\tt.hideItActive = true;\n129: \t\t\tt.todos = [\n130: \t\t\t\ttodo({ id: '1', status: 'backlog', category: cat1 }),\n131: \t\t\t\ttodo({ id: '2', status: 'backlog', category: cat2 })\n132: \t\t\t];\n133: \n134: \t\t\tt.useFilters([{ type: 'category', value: 2 }]);\n135: \t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n136: \n137: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n138: \t\t});\n139: \n140: \t\tit('keeps only auto-generated todos due within the visibility window', () => {\n141: \t\t\tconst far = new Date();\n142: \t\t\tfar.setDate(far.getDate() + 10);\n143: \t\t\tconst near = new Date();\n144: \t\t\tnear.setDate(near.getDate() + 1);\n145: \n146: \t\t\tconst t = new Todos();\n147: \t\t\tt.todos = [\n148: \t\t\t\ttodo({ id: '1', auto_generated: true, due_at: far.toISOString().split('T')[0] }),\n149: \t\t\t\ttodo({ id: '2', auto_generated: true, due_at: near.toISOString().split('T')[0] }),\n150: \t\t\t\ttodo({ id: '3', auto_generated: false, due_at: far.toISOString().split('T')[0] })\n151: \t\t\t];\n152: \n153: \t\t\tt.useFilters([]);\n154: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2', '3']);\n155: \t\t});\n156: \t});\n157: \n158: \tdescribe('filter management', () => {\n159: \t\tit('adds, removes and clears filters', () => {\n160: \t\t\tconst t = new Todos();\n161: \t\t\tconst filter = { type: 'priority' as const, value: 'high' as const };\n162: \n163: \t\t\tt.addFilter(filter);\n164: \t\t\texpect(t.isFilterActive(filter)).toBe(true);\n165: \n166: \t\t\tt.removeFilter(filter);\n167: \t\t\texpect(t.isFilterActive(filter)).toBe(false);\n168: \n169: \t\t\tt.addFilter(filter);\n170: \t\t\tt.clearFilters();\n171: \t\t\texpect(t.activeFilters).toEqual([]);\n172: \t\t});\n173: \n174: \t\tit('applies a filter coming from the URL', () => {\n175: \t\t\tpageState.searchParams.set('filterType', 'priority');\n176: \t\t\tpageState.searchParams.set('filterValue', 'high');\n177: \n178: \t\t\tconst t = new Todos();\n179: \t\t\tt.todos = [todo({ id: '1', priority: 'high' }), todo({ id: '2', priority: 'low' })];\n180: \n181: \t\t\tt.checkUrlForFilter();\n182: \t\t\texpect(t.activeFilters).toEqual([{ type: 'priority', value: 'high' }]);\n183: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n184: \t\t});\n185: \n186: \t\tit('ignores workspace filters from the URL', () => {\n187: \t\t\tpageState.searchParams.set('filterType', 'workspace');\n188: \t\t\tpageState.searchParams.set('filterValue', '1');\n189: \n190: \t\t\tconst t = new Todos();\n191: \t\t\tt.todos = [todo()];\n192: \t\t\tt.checkUrlForFilter();\n193: \t\t\texpect(t.activeFilters).toEqual([]);\n194: \t\t});\n195: \t});\n196: \n197: \tdescribe('quickCreate', () => {\n198: \t\tit('creates a todo and reports ignored recurrence', async () => {\n199: \t\t\tvi.useFakeTimers();\n200: \t\t\tapi.create.mockResolvedValue({ data: todo({ id: '99' }) });\n201: \n202: \t\t\tconst t = new Todos();\n203: \t\t\tconst res = await t.quickCreate('Buy milk repeat:weekly');\n204: \n205: \t\t\texpect(res).toEqual({ ok: true, recurrenceIgnored: true });\n206: \t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('todos'), {\n207: \t\t\t\ttitle: 'Buy milk repeat:weekly'\n208: \t\t\t});\n209: \t\t\texpect(t.recentlyCreated).toBe('99');\n210: \n211: \t\t\tvi.runAllTimers();\n212: \t\t\texpect(t.recentlyCreated).toBeNull();\n213: \t\t});\n214: \n215: \t\tit('reports failure when creation fails', async () => {\n216: \t\t\tapi.create.mockResolvedValue(null);\n217: \t\t\tconst t = new Todos();\n218: \t\t\tconst res = await t.quickCreate('Buy milk');\n219: \t\t\texpect(res).toEqual({ ok: false, recurrenceIgnored: false });\n220: \t\t});\n221: \t});\n222: \n223: \tdescribe('sort by score', () => {\n224: \t\tit('enables score sorting and orders by relevance', () => {\n225: \t\t\tconst t = new Todos();\n226: \t\t\tt.todos = [\n227: \t\t\t\ttodo({ id: 'low', priority: 'low', created_at: '2020-01-01' }),\n228: \t\t\t\ttodo({ id: 'high', priority: 'high', created_at: '2020-01-01' })\n229: \t\t\t];\n230: \n231: \t\t\tt.toggleSortByScore();\n232: \n233: \t\t\texpect(t.sortByScore).toBe(true);\n234: \t\t\texpect(t.todosScored).toBe(true);\n235: \t\t\texpect(t.filteredTodos[0].id).toBe('high');\n236: \t\t});\n237: \t});\n238: \n239: \tdescribe('hide-it flag', () => {\n240: \t\tit('reads the persisted flag from storage', () => {\n241: \t\t\tstorage.getBool.mockReturnValue(true);\n242: \t\t\tconst t = new Todos();\n243: \t\t\tt.todos = [todo()];\n244: \t\t\tt.loadHideIt();\n245: \t\t\texpect(t.hideItActive).toBe(true);\n246: \t\t});\n247: \n248: \t\tit('defaults to inactive when storage returns null', () => {\n249: \t\t\tstorage.getBool.mockReturnValue(null);\n250: \t\t\tconst t = new Todos();\n251: \t\t\tt.loadHideIt();\n252: \t\t\texpect(t.hideItActive).toBe(false);\n253: \t\t});\n254: \n255: \t\tit('persists the flag when toggled', () => {\n256: \t\t\tconst t = new Todos();\n257: \t\t\tt.todos = [todo()];\n258: \t\t\tt.toggleHideIt();\n259: \t\t\texpect(storage.setBool).toHaveBeenCalledWith(Todos.LS_HIDE_IT_KEY, true);\n260: \t\t});\n261: \t});\n262: \n263: \tdescribe('hide-it restore on load', () => {\n264: \t\tconst hideableWorkspace = (cat: ReturnType<typeof category>) => ({\n265: \t\t\tid: 1,\n266: \t\t\ttitle: 'Hidden',\n267: \t\t\tis_hideable: true,\n268: \t\t\tcategories: [cat],\n269: \t\t\tcreated_at: '',\n270: \t\t\tupdated_at: ''\n271: \t\t});\n272: \n273: \t\tit('restores the flag at construction and hides after load()', async () => {\n274: \t\t\tstorage.getBool.mockReturnValue(true);\n275: \t\t\tconst cat = category(1, 'Chores');\n276: \t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n277: \t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n278: \t\t\t\tif (endpoint.includes('workspaces')) return { data: [hideableWorkspace(cat)] };\n279: \t\t\t\treturn { data: [todo({ id: '1', category: cat }), todo({ id: '2' })] };\n280: \t\t\t});\n281: \n282: \t\t\tconst t = new Todos();\n283: \t\t\t// flag already restored before any request resolved\n284: \t\t\texpect(t.hideItActive).toBe(true);\n285: \n286: \t\t\tawait t.load();\n287: \n288: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n289: \t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n290: \t\t});\n291: \n292: \t\tit('retries a failed workspaces fetch and still hides', async () => {\n293: \t\t\tstorage.getBool.mockReturnValue(true);\n294: \t\t\tconst cat = category(1);\n295: \t\t\tlet workspaceCalls = 0;\n296: \t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n297: \t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n298: \t\t\t\tif (endpoint.includes('workspaces')) {\n299: \t\t\t\t\tworkspaceCalls++;\n300: \t\t\t\t\treturn workspaceCalls === 1 ? null : { data: [hideableWorkspace(cat)] };\n301: \t\t\t\t}\n302: \t\t\t\treturn { data: [todo({ id: '1', category: cat })] };\n303: \t\t\t});\n304: \n305: \t\t\tconst t = new Todos();\n306: \t\t\tawait t.load();\n307: \n308: \t\t\texpect(workspaceCalls).toBe(2);\n309: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual([]);\n310: \t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n311: \t\t});\n312: \n313: \t\tit('still completes load() when the workspaces fetch fails for good', async () => {\n314: \t\t\tstorage.getBool.mockReturnValue(true);\n315: \t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n316: \t\t\t\tif (endpoint.includes('workspaces')) return null;\n317: \t\t\t\tif (endpoint.includes('categories')) return { data: [category(1)] };\n318: \t\t\t\treturn { data: [todo({ id: '1' })] };\n319: \t\t\t});\n320: \n321: \t\t\tconst t = new Todos();\n322: \t\t\tawait t.load();\n323: \n324: \t\t\t// graceful degradation: the flag is still restored (toggle shows the\n325: \t\t\t// correct state) even though hiding cannot apply without workspaces\n326: \t\t\texpect(t.loaded).toBe(true);\n327: \t\t\texpect(t.hideItActive).toBe(true);\n328: \t\t});\n329: \n330: \t\tit('respects a toggle issued while load() is in flight', async () => {\n331: \t\t\tlet stored = true;\n332: \t\t\tstorage.getBool.mockImplementation(() => stored);\n333: \t\t\tstorage.setBool.mockImplementation((_key: string, value: boolean) => {\n334: \t\t\t\tstored = value;\n335: \t\t\t});\n336: \n337: \t\t\tconst cat = category(1);\n338: \t\t\tlet resolveTodos: (value: { data: unknown[] }) => void = () => {};\n339: \t\t\tconst todosResponse = new Promise<{ data: unknown[] }>((resolve) => {\n340: \t\t\t\tresolveTodos = resolve;\n341: \t\t\t});\n342: \t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n343: \t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n344: \t\t\t\tif (endpoint.includes('workspaces')) return { data: [hideableWorkspace(cat)] };\n345: \t\t\t\treturn todosResponse;\n346: \t\t\t});\n347: \n348: \t\t\tconst t = new Todos();\n349: \t\t\texpect(t.hideItActive).toBe(true);\n350: \n351: \t\t\tconst loading = t.load();\n352: \t\t\tt.toggleHideIt(); // user turns it off before any data arrived\n353: \t\t\tresolveTodos({ data: [todo({ id: '1', category: cat }), todo({ id: '2' })] });\n354: \t\t\tawait loading;\n355: \n356: \t\t\t// the toggle wins over the constructor restore, nothing is hidden\n357: \t\t\texpect(t.hideItActive).toBe(false);\n358: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1', '2']);\n359: \t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([1]);\n360: \n361: \t\t\t// one toggle is enough to re-hide now that workspaces are loaded\n362: \t\t\tt.toggleHideIt();\n363: \t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n364: \t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n365: \t\t});\n366: \t});\n367: });\n\n(End of file - total 367 lines)\n</content>","metadata":{"preview":"import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { Todos } from '$lib/state/Todos.svelte';\nimport { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\nimport { todo, category } from '../helpers/factories';\n\nbeforeEach(() => {\n\tresetStoreMocks();\n\tpageState.pathname = '/todos';\n});\n\nafterEach(() => {\n\tvi.useRealTimers();\n});\n\ndescribe('Todos store', () => {\n\tit('constructs with the mocked defaults', () => {\n\t\tconst t = new Todos();\n\t\texpect(t.auth.getToken()).toBe('test-token');\n\t\texpect(t.apiService).toBeDefined();\n\t});","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/stores/Todos.test.ts","text":"import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\nimport { Todos } from '$lib/state/Todos.svelte';\nimport { api, storage, pageState, resetStoreMocks } from '../setup/storeMocks';\nimport { todo, category } from '../helpers/factories';\n\nbeforeEach(() => {\n\tresetStoreMocks();\n\tpageState.pathname = '/todos';\n});\n\nafterEach(() => {\n\tvi.useRealTimers();\n});\n\ndescribe('Todos store', () => {\n\tit('constructs with the mocked defaults', () => {\n\t\tconst t = new Todos();\n\t\texpect(t.auth.getToken()).toBe('test-token');\n\t\texpect(t.apiService).toBeDefined();\n\t});\n\n\tit('loads todos, categories and workspaces', async () => {\n\t\tapi.list.mockImplementation(async (endpoint: string) => {\n\t\t\tif (endpoint.includes('categories')) return { data: [category(1, 'Work')] };\n\t\t\tif (endpoint.includes('workspaces')) return { data: [] };\n\t\t\treturn { data: [todo({ id: '1', status: 'pending' })] };\n\t\t});\n\n\t\tconst t = new Todos();\n\t\tawait t.load();\n\n\t\texpect(t.loaded).toBe(true);\n\t\texpect(t.todos).toHaveLength(1);\n\t\texpect(t.categories.map((c) => c.id)).toEqual([1]);\n\t\texpect(t.groupedTodos.find((g) => g.status === 'pending')?.todos).toHaveLength(1);\n\t});\n\n\tdescribe('useFilters', () => {\n\t\tit('removes backlog todos unless a backlog filter is active', () => {\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [todo({ id: '1', status: 'backlog' }), todo({ id: '2', status: 'pending' })];\n\n\t\t\tt.useFilters([]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\n\t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n\t\t});\n\n\t\tit('applies category and tag filters', () => {\n\t\t\tconst cat = category(1, 'Work');\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [\n\t\t\t\ttodo({ id: '1', category: cat }),\n\t\t\t\ttodo({ id: '2', category: null }),\n\t\t\t\ttodo({\n\t\t\t\t\tid: '3',\n\t\t\t\t\ttags: [{ id: 5, name: 'x', color: '#fff', created_at: '', updated_at: '' }]\n\t\t\t\t})\n\t\t\t];\n\n\t\t\tt.useFilters([{ type: 'category', value: 1 }]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n\n\t\t\tt.useFilters([{ type: 'tag', value: 5 }]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['3']);\n\t\t});\n\n\t\tit('hides todos from hideable workspaces when hide-it is active', () => {\n\t\t\tconst cat1 = category(1);\n\t\t\tconst hideable = {\n\t\t\t\tid: 1,\n\t\t\t\ttitle: 'Hidden',\n\t\t\t\tis_hideable: true,\n\t\t\t\tcategories: [cat1],\n\t\t\t\tcreated_at: '',\n\t\t\t\tupdated_at: ''\n\t\t\t};\n\t\t\tconst t = new Todos();\n\t\t\tt.workspaces = [hideable];\n\t\t\tt.hideItActive = true;\n\t\t\tt.todos = [todo({ id: '1', category: cat1 }), todo({ id: '2', category: null })];\n\n\t\t\tt.useFilters([]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\t\t});\n\n\t\tit('hides backlog todos from hideable workspaces when hide-it is active and the backlog filter is selected', () => {\n\t\t\tconst cat1 = category(1);\n\t\t\tconst cat2 = category(2);\n\t\t\tconst hideable = {\n\t\t\t\tid: 1,\n\t\t\t\ttitle: 'Hidden',\n\t\t\t\tis_hideable: true,\n\t\t\t\tcategories: [cat1],\n\t\t\t\tcreated_at: '',\n\t\t\t\tupdated_at: ''\n\t\t\t};\n\t\t\tconst t = new Todos();\n\t\t\tt.workspaces = [hideable];\n\t\t\tt.hideItActive = true;\n\t\t\tt.todos = [\n\t\t\t\ttodo({ id: '1', status: 'backlog', category: cat1 }),\n\t\t\t\ttodo({ id: '2', status: 'backlog', category: cat2 })\n\t\t\t];\n\n\t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\t\t});\n\n\t\tit('re-evaluates hide-it against the filters being applied, not the previous selection', () => {\n\t\t\t// Regression test: selecting a category filter and then switching to\n\t\t\t// the backlog status filter used to leak hidden-workspace backlog\n\t\t\t// items through, because the hide-it guard read the stale\n\t\t\t// this.activeFilters from before the switch.\n\t\t\tconst cat1 = category(1);\n\t\t\tconst cat2 = category(2);\n\t\t\tconst hideable = {\n\t\t\t\tid: 1,\n\t\t\t\ttitle: 'Hidden',\n\t\t\t\tis_hideable: true,\n\t\t\t\tcategories: [cat1],\n\t\t\t\tcreated_at: '',\n\t\t\t\tupdated_at: ''\n\t\t\t};\n\t\t\tconst t = new Todos();\n\t\t\tt.workspaces = [hideable];\n\t\t\tt.hideItActive = true;\n\t\t\tt.todos = [\n\t\t\t\ttodo({ id: '1', status: 'backlog', category: cat1 }),\n\t\t\t\ttodo({ id: '2', status: 'backlog', category: cat2 })\n\t\t\t];\n\n\t\t\tt.useFilters([{ type: 'category', value: 2 }]);\n\t\t\tt.useFilters([{ type: 'status', value: 'backlog' }]);\n\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\t\t});\n\n\t\tit('keeps only auto-generated todos due within the visibility window', () => {\n\t\t\tconst far = new Date();\n\t\t\tfar.setDate(far.getDate() + 10);\n\t\t\tconst near = new Date();\n\t\t\tnear.setDate(near.getDate() + 1);\n\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [\n\t\t\t\ttodo({ id: '1', auto_generated: true, due_at: far.toISOString().split('T')[0] }),\n\t\t\t\ttodo({ id: '2', auto_generated: true, due_at: near.toISOString().split('T')[0] }),\n\t\t\t\ttodo({ id: '3', auto_generated: false, due_at: far.toISOString().split('T')[0] })\n\t\t\t];\n\n\t\t\tt.useFilters([]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2', '3']);\n\t\t});\n\t});\n\n\tdescribe('filter management', () => {\n\t\tit('adds, removes and clears filters', () => {\n\t\t\tconst t = new Todos();\n\t\t\tconst filter = { type: 'priority' as const, value: 'high' as const };\n\n\t\t\tt.addFilter(filter);\n\t\t\texpect(t.isFilterActive(filter)).toBe(true);\n\n\t\t\tt.removeFilter(filter);\n\t\t\texpect(t.isFilterActive(filter)).toBe(false);\n\n\t\t\tt.addFilter(filter);\n\t\t\tt.clearFilters();\n\t\t\texpect(t.activeFilters).toEqual([]);\n\t\t});\n\n\t\tit('applies a filter coming from the URL', () => {\n\t\t\tpageState.searchParams.set('filterType', 'priority');\n\t\t\tpageState.searchParams.set('filterValue', 'high');\n\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [todo({ id: '1', priority: 'high' }), todo({ id: '2', priority: 'low' })];\n\n\t\t\tt.checkUrlForFilter();\n\t\t\texpect(t.activeFilters).toEqual([{ type: 'priority', value: 'high' }]);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1']);\n\t\t});\n\n\t\tit('ignores workspace filters from the URL', () => {\n\t\t\tpageState.searchParams.set('filterType', 'workspace');\n\t\t\tpageState.searchParams.set('filterValue', '1');\n\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [todo()];\n\t\t\tt.checkUrlForFilter();\n\t\t\texpect(t.activeFilters).toEqual([]);\n\t\t});\n\t});\n\n\tdescribe('quickCreate', () => {\n\t\tit('creates a todo and reports ignored recurrence', async () => {\n\t\t\tvi.useFakeTimers();\n\t\t\tapi.create.mockResolvedValue({ data: todo({ id: '99' }) });\n\n\t\t\tconst t = new Todos();\n\t\t\tconst res = await t.quickCreate('Buy milk repeat:weekly');\n\n\t\t\texpect(res).toEqual({ ok: true, recurrenceIgnored: true });\n\t\t\texpect(api.create).toHaveBeenCalledWith(expect.stringContaining('todos'), {\n\t\t\t\ttitle: 'Buy milk repeat:weekly'\n\t\t\t});\n\t\t\texpect(t.recentlyCreated).toBe('99');\n\n\t\t\tvi.runAllTimers();\n\t\t\texpect(t.recentlyCreated).toBeNull();\n\t\t});\n\n\t\tit('reports failure when creation fails', async () => {\n\t\t\tapi.create.mockResolvedValue(null);\n\t\t\tconst t = new Todos();\n\t\t\tconst res = await t.quickCreate('Buy milk');\n\t\t\texpect(res).toEqual({ ok: false, recurrenceIgnored: false });\n\t\t});\n\t});\n\n\tdescribe('sort by score', () => {\n\t\tit('enables score sorting and orders by relevance', () => {\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [\n\t\t\t\ttodo({ id: 'low', priority: 'low', created_at: '2020-01-01' }),\n\t\t\t\ttodo({ id: 'high', priority: 'high', created_at: '2020-01-01' })\n\t\t\t];\n\n\t\t\tt.toggleSortByScore();\n\n\t\t\texpect(t.sortByScore).toBe(true);\n\t\t\texpect(t.todosScored).toBe(true);\n\t\t\texpect(t.filteredTodos[0].id).toBe('high');\n\t\t});\n\t});\n\n\tdescribe('hide-it flag', () => {\n\t\tit('reads the persisted flag from storage', () => {\n\t\t\tstorage.getBool.mockReturnValue(true);\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [todo()];\n\t\t\tt.loadHideIt();\n\t\t\texpect(t.hideItActive).toBe(true);\n\t\t});\n\n\t\tit('defaults to inactive when storage returns null', () => {\n\t\t\tstorage.getBool.mockReturnValue(null);\n\t\t\tconst t = new Todos();\n\t\t\tt.loadHideIt();\n\t\t\texpect(t.hideItActive).toBe(false);\n\t\t});\n\n\t\tit('persists the flag when toggled', () => {\n\t\t\tconst t = new Todos();\n\t\t\tt.todos = [todo()];\n\t\t\tt.toggleHideIt();\n\t\t\texpect(storage.setBool).toHaveBeenCalledWith(Todos.LS_HIDE_IT_KEY, true);\n\t\t});\n\t});\n\n\tdescribe('hide-it restore on load', () => {\n\t\tconst hideableWorkspace = (cat: ReturnType<typeof category>) => ({\n\t\t\tid: 1,\n\t\t\ttitle: 'Hidden',\n\t\t\tis_hideable: true,\n\t\t\tcategories: [cat],\n\t\t\tcreated_at: '',\n\t\t\tupdated_at: ''\n\t\t});\n\n\t\tit('restores the flag at construction and hides after load()', async () => {\n\t\t\tstorage.getBool.mockReturnValue(true);\n\t\t\tconst cat = category(1, 'Chores');\n\t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n\t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n\t\t\t\tif (endpoint.includes('workspaces')) return { data: [hideableWorkspace(cat)] };\n\t\t\t\treturn { data: [todo({ id: '1', category: cat }), todo({ id: '2' })] };\n\t\t\t});\n\n\t\t\tconst t = new Todos();\n\t\t\t// flag already restored before any request resolved\n\t\t\texpect(t.hideItActive).toBe(true);\n\n\t\t\tawait t.load();\n\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n\t\t});\n\n\t\tit('retries a failed workspaces fetch and still hides', async () => {\n\t\t\tstorage.getBool.mockReturnValue(true);\n\t\t\tconst cat = category(1);\n\t\t\tlet workspaceCalls = 0;\n\t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n\t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n\t\t\t\tif (endpoint.includes('workspaces')) {\n\t\t\t\t\tworkspaceCalls++;\n\t\t\t\t\treturn workspaceCalls === 1 ? null : { data: [hideableWorkspace(cat)] };\n\t\t\t\t}\n\t\t\t\treturn { data: [todo({ id: '1', category: cat })] };\n\t\t\t});\n\n\t\t\tconst t = new Todos();\n\t\t\tawait t.load();\n\n\t\t\texpect(workspaceCalls).toBe(2);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual([]);\n\t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n\t\t});\n\n\t\tit('still completes load() when the workspaces fetch fails for good', async () => {\n\t\t\tstorage.getBool.mockReturnValue(true);\n\t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n\t\t\t\tif (endpoint.includes('workspaces')) return null;\n\t\t\t\tif (endpoint.includes('categories')) return { data: [category(1)] };\n\t\t\t\treturn { data: [todo({ id: '1' })] };\n\t\t\t});\n\n\t\t\tconst t = new Todos();\n\t\t\tawait t.load();\n\n\t\t\t// graceful degradation: the flag is still restored (toggle shows the\n\t\t\t// correct state) even though hiding cannot apply without workspaces\n\t\t\texpect(t.loaded).toBe(true);\n\t\t\texpect(t.hideItActive).toBe(true);\n\t\t});\n\n\t\tit('respects a toggle issued while load() is in flight', async () => {\n\t\t\tlet stored = true;\n\t\t\tstorage.getBool.mockImplementation(() => stored);\n\t\t\tstorage.setBool.mockImplementation((_key: string, value: boolean) => {\n\t\t\t\tstored = value;\n\t\t\t});\n\n\t\t\tconst cat = category(1);\n\t\t\tlet resolveTodos: (value: { data: unknown[] }) => void = () => {};\n\t\t\tconst todosResponse = new Promise<{ data: unknown[] }>((resolve) => {\n\t\t\t\tresolveTodos = resolve;\n\t\t\t});\n\t\t\tapi.list.mockImplementation(async (endpoint: string) => {\n\t\t\t\tif (endpoint.includes('categories')) return { data: [cat] };\n\t\t\t\tif (endpoint.includes('workspaces')) return { data: [hideableWorkspace(cat)] };\n\t\t\t\treturn todosResponse;\n\t\t\t});\n\n\t\t\tconst t = new Todos();\n\t\t\texpect(t.hideItActive).toBe(true);\n\n\t\t\tconst loading = t.load();\n\t\t\tt.toggleHideIt(); // user turns it off before any data arrived\n\t\t\tresolveTodos({ data: [todo({ id: '1', category: cat }), todo({ id: '2' })] });\n\t\t\tawait loading;\n\n\t\t\t// the toggle wins over the constructor restore, nothing is hidden\n\t\t\texpect(t.hideItActive).toBe(false);\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['1', '2']);\n\t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([1]);\n\n\t\t\t// one toggle is enough to re-hide now that workspaces are loaded\n\t\t\tt.toggleHideIt();\n\t\t\texpect(t.filteredTodos.map((x) => x.id)).toEqual(['2']);\n\t\t\texpect(t.filteredCategories.map((c) => c.id)).toEqual([]);\n\t\t});\n\t});\n});","lineStart":1,"lineEnd":367,"totalLines":367,"truncated":false}},"title":"tests/unit/stores/Todos.test.ts","time":{"start":1791728777693,"end":1791728777830}},"id":"prt_12b5b798b001iNKv2pAZhbOXWY","sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","messageID":"msg_12b5b67a8001O4KW4Y4KKNrEnC"}}
{"type":"tool_use","timestamp":1791728777912,"sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","part":{"type":"tool","tool":"read","callID":"call_01_3UeAJIwZ95VTbXbRxsJQ6221","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/services/TodoFilterService.test.ts"},"output":"<path>/workspace/tests/unit/services/TodoFilterService.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect } from 'vitest';\n2: import TodoFilterService from '$lib/services/TodoFilterService';\n3: import type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\n4: import type { Tag } from '$lib/types/tag';\n5: \n6: function todo(overrides: Partial<Todo> = {}): Todo {\n7: \treturn {\n8: \t\tid: '1',\n9: \t\ttitle: 'Test todo',\n10: \t\tdescription: '',\n11: \t\tlink: null,\n12: \t\tpriority: 'medium',\n13: \t\tstatus: 'pending',\n14: \t\teffort: null,\n15: \t\tprogress: null,\n16: \t\tis_completed: false,\n17: \t\tdue_at: '',\n18: \t\tcategory: null,\n19: \t\ttags: [],\n20: \t\tsubtasks: [],\n21: \t\trelevance: null,\n22: \t\trecurrence_frequency: null,\n23: \t\trecurrence_interval: 1,\n24: \t\trecurrence_ends_at: null,\n25: \t\tparent_task_id: null,\n26: \t\tauto_generated: false,\n27: \t\tcreated_at: '',\n28: \t\tupdated_at: '',\n29: \t\tcompleted_at: '',\n30: \t\t...overrides\n31: \t};\n32: }\n33: \n34: function category(id: number, title = 'Category'): TodoCategory {\n35: \treturn { id, title, created_at: '', updated_at: '' };\n36: }\n37: \n38: function tag(id: number, name = 'tag'): Tag {\n39: \treturn { id, name, color: '#000000', created_at: '', updated_at: '' };\n40: }\n41: \n42: function workspace(id: number, categories: TodoCategory[], hideable = false): TodoWorkspace {\n43: \treturn { id, title: 'WS', is_hideable: hideable, categories, created_at: '', updated_at: '' };\n44: }\n45: \n46: const service = new TodoFilterService();\n47: \n48: describe('filterByPriority', () => {\n49: \tit('keeps only todos with the matching priority', () => {\n50: \t\tconst todos = [\n51: \t\t\ttodo({ priority: 'high' }),\n52: \t\t\ttodo({ priority: 'low' }),\n53: \t\t\ttodo({ priority: 'high' })\n54: \t\t];\n55: \t\texpect(service.filterByPriority('high', todos)).toHaveLength(2);\n56: \t\texpect(service.filterByPriority('low', todos)).toHaveLength(1);\n57: \t\texpect(service.filterByPriority('medium', todos)).toHaveLength(0);\n58: \t});\n59: });\n60: \n61: describe('filterByStatus', () => {\n62: \tit('keeps only todos with the matching status', () => {\n63: \t\tconst todos = [\n64: \t\t\ttodo({ status: 'pending' }),\n65: \t\t\ttodo({ status: 'in-progress' }),\n66: \t\t\ttodo({ status: 'backlog' })\n67: \t\t];\n68: \t\texpect(service.filterByStatus('pending', todos)).toHaveLength(1);\n69: \t\texpect(service.filterByStatus('in-progress', todos)).toHaveLength(1);\n70: \t\texpect(service.filterByStatus('backlog', todos)).toHaveLength(1);\n71: \t});\n72: });\n73: \n74: describe('filterByEffort', () => {\n75: \tit('matches todos with the given effort', () => {\n76: \t\tconst todos = [todo({ effort: 'low' }), todo({ effort: 'high' }), todo({ effort: null })];\n77: \t\texpect(service.filterByEffort('low', todos)).toHaveLength(1);\n78: \t\texpect(service.filterByEffort('high', todos)).toHaveLength(1);\n79: \t});\n80: \n81: \tit('treats null effort as medium', () => {\n82: \t\tconst todos = [todo({ effort: null }), todo({ effort: 'medium' }), todo({ effort: 'low' })];\n83: \t\texpect(service.filterByEffort('medium', todos)).toHaveLength(2);\n84: \t});\n85: });\n86: \n87: describe('filterOutBacklog', () => {\n88: \tit('removes backlog todos and keeps the rest', () => {\n89: \t\tconst todos = [\n90: \t\t\ttodo({ status: 'backlog' }),\n91: \t\t\ttodo({ status: 'pending' }),\n92: \t\t\ttodo({ status: 'backlog' })\n93: \t\t];\n94: \t\texpect(service.filterOutBacklog(todos)).toHaveLength(1);\n95: \t\texpect(service.filterOutBacklog(todos)[0].status).toBe('pending');\n96: \t});\n97: });\n98: \n99: describe('filterByDueDate', () => {\n100: \t// TZ=UTC (set in vitest.config.ts) so YYYY-MM-DD strings parse as midnight local\n101: \tconst todayStr = new Date().toISOString().split('T')[0];\n102: \tconst tomorrowStr = (() => {\n103: \t\tconst d = new Date();\n104: \t\td.setDate(d.getDate() + 1);\n105: \t\treturn d.toISOString().split('T')[0];\n106: \t})();\n107: \n108: \tit('filters by today', () => {\n109: \t\tconst todos = [\n110: \t\t\ttodo({ due_at: todayStr }),\n111: \t\t\ttodo({ due_at: '2099-01-01' }),\n112: \t\t\ttodo({ due_at: '' })\n113: \t\t];\n114: \t\tconst result = service.filterByDueDate('today', todos);\n115: \t\texpect(result).toHaveLength(1);\n116: \t\texpect(result[0].due_at).toBe(todayStr);\n117: \t});\n118: \n119: \tit('filters by tomorrow', () => {\n120: \t\tconst todos = [todo({ due_at: tomorrowStr }), todo({ due_at: todayStr })];\n121: \t\texpect(service.filterByDueDate('tomorrow', todos)).toHaveLength(1);\n122: \t});\n123: \n124: \tit('filters overdue (past dates only)', () => {\n125: \t\tconst todos = [todo({ due_at: '2000-01-01' }), todo({ due_at: '2099-01-01' })];\n126: \t\texpect(service.filterByDueDate('overdue', todos)).toHaveLength(1);\n127: \t});\n128: \n129: \tit('filters today-overdue (today and past combined)', () => {\n130: \t\tconst todos = [\n131: \t\t\ttodo({ due_at: todayStr }),\n132: \t\t\ttodo({ due_at: '2000-01-01' }),\n133: \t\t\ttodo({ due_at: '2099-01-01' })\n134: \t\t];\n135: \t\texpect(service.filterByDueDate('today-overdue', todos)).toHaveLength(2);\n136: \t});\n137: \n138: \tit('excludes todos with an empty due date', () => {\n139: \t\texpect(service.filterByDueDate('today', [todo({ due_at: '' })])).toHaveLength(0);\n140: \t});\n141: });\n142: \n143: describe('filterByCategory', () => {\n144: \tit('keeps only todos in the given category', () => {\n145: \t\tconst cat1 = category(1);\n146: \t\tconst cat2 = category(2);\n147: \t\tconst todos = [\n148: \t\t\ttodo({ category: cat1 }),\n149: \t\t\ttodo({ category: cat2 }),\n150: \t\t\ttodo({ category: null })\n151: \t\t];\n152: \t\texpect(service.filterByCategory(1, todos)).toHaveLength(1);\n153: \t\texpect(service.filterByCategory(99, todos)).toHaveLength(0);\n154: \t});\n155: });\n156: \n157: describe('filterByTag', () => {\n158: \tit('keeps todos that have the given tag', () => {\n159: \t\tconst t1 = tag(10);\n160: \t\tconst t2 = tag(20);\n161: \t\tconst todos = [todo({ tags: [t1, t2] }), todo({ tags: [t2] }), todo({ tags: [] })];\n162: \t\texpect(service.filterByTag(10, todos)).toHaveLength(1);\n163: \t\texpect(service.filterByTag(20, todos)).toHaveLength(2);\n164: \t\texpect(service.filterByTag(99, todos)).toHaveLength(0);\n165: \t});\n166: });\n167: \n168: describe('filterByWorkspace', () => {\n169: \tit('keeps todos whose category belongs to the workspace', () => {\n170: \t\tconst cat1 = category(1);\n171: \t\tconst cat2 = category(2);\n172: \t\tconst ws = workspace(1, [cat1]);\n173: \t\tconst todos = [\n174: \t\t\ttodo({ category: cat1 }),\n175: \t\t\ttodo({ category: cat2 }),\n176: \t\t\ttodo({ category: null })\n177: \t\t];\n178: \t\texpect(service.filterByWorkspace(ws, todos)).toHaveLength(1);\n179: \t});\n180: });\n181: \n182: describe('filterByHideIt', () => {\n183: \tit('hides todos whose category is in a hideable workspace', () => {\n184: \t\tconst cat = category(1);\n185: \t\tconst hideable = workspace(1, [cat], true);\n186: \t\tconst todos = [\n187: \t\t\ttodo({ category: cat }),\n188: \t\t\ttodo({ category: category(2) }),\n189: \t\t\ttodo({ category: null })\n190: \t\t];\n191: \t\tconst result = service.filterByHideIt(todos, [hideable]);\n192: \t\texpect(result).toHaveLength(2);\n193: \t\texpect(result.every((t) => t.category?.id !== 1)).toBe(true);\n194: \t});\n195: \n196: \tit('keeps todos with no category regardless of workspaces', () => {\n197: \t\tconst hideable = workspace(1, [category(1)], true);\n198: \t\texpect(service.filterByHideIt([todo({ category: null })], [hideable])).toHaveLength(1);\n199: \t});\n200: \n201: \tit('does not hide todos from non-hideable workspaces', () => {\n202: \t\tconst cat = category(1);\n203: \t\tconst visible = workspace(1, [cat], false);\n204: \t\texpect(service.filterByHideIt([todo({ category: cat })], [visible])).toHaveLength(1);\n205: \t});\n206: });\n207: \n208: describe('filter (dispatch)', () => {\n209: \tit('routes priority filter correctly', () => {\n210: \t\tconst todos = [todo({ priority: 'high' }), todo({ priority: 'low' })];\n211: \t\texpect(service.filter({ type: 'priority', value: 'high' }, todos)).toHaveLength(1);\n212: \t});\n213: \n214: \tit('routes status filter correctly', () => {\n215: \t\tconst todos = [todo({ status: 'pending' }), todo({ status: 'backlog' })];\n216: \t\texpect(service.filter({ type: 'status', value: 'pending' }, todos)).toHaveLength(1);\n217: \t});\n218: \n219: \tit('returns all todos for unknown filter type', () => {\n220: \t\t// @ts-expect-error testing fallback path\n221: \t\texpect(service.filter({ type: 'unknown', value: '' }, [todo(), todo()])).toHaveLength(2);\n222: \t});\n223: });\n224: \n225: describe('filterByDueDate (week)', () => {\n226: \tit('keeps only todos due within the current week', () => {\n227: \t\t// isDateThisWeek uses a Sunday-start week: today - getDay() to +6 days\n228: \t\tconst now = new Date();\n229: \t\tconst startOfWeek = new Date(now);\n230: \t\tstartOfWeek.setDate(now.getDate() - now.getDay());\n231: \t\tconst endOfWeek = new Date(now);\n232: \t\tendOfWeek.setDate(startOfWeek.getDate() + 6);\n233: \n234: \t\tconst todos = [\n235: \t\t\ttodo({ due_at: startOfWeek.toISOString().split('T')[0] }),\n236: \t\t\ttodo({ due_at: endOfWeek.toISOString().split('T')[0] }),\n237: \t\t\ttodo({ due_at: '2099-01-01' }),\n238: \t\t\ttodo({ due_at: '' })\n239: \t\t];\n240: \n241: \t\texpect(service.filterByDueDate('week', todos)).toHaveLength(2);\n242: \t});\n243: \n244: \tit('routes the week filter through the dispatch method', () => {\n245: \t\tconst now = new Date();\n246: \t\tconst todos = [\n247: \t\t\ttodo({ due_at: now.toISOString().split('T')[0] }),\n248: \t\t\ttodo({ due_at: '2099-01-01' })\n249: \t\t];\n250: \t\texpect(service.filter({ type: 'due', value: 'week' }, todos)).toHaveLength(1);\n251: \t});\n252: });\n253: \n254: describe('filterCategoriesByHideIt', () => {\n255: \tit('removes categories that belong to a hideable workspace', () => {\n256: \t\tconst cat1 = category(1);\n257: \t\tconst cat2 = category(2);\n258: \t\tconst hideable = workspace(1, [cat1], true);\n259: \t\tconst visible = workspace(2, [cat2], false);\n260: \n261: \t\tconst result = service.filterCategoriesByHideIt(\n262: \t\t\t[cat1, cat2, category(3)],\n263: \t\t\t[hideable, visible]\n264: \t\t);\n265: \t\texpect(result.map((c) => c.id)).toEqual([2, 3]);\n266: \t});\n267: \n268: \tit('keeps all categories when no workspace is hideable', () => {\n269: \t\tconst cats = [category(1), category(2)];\n270: \t\texpect(\n271: \t\t\tservice.filterCategoriesByHideIt(cats, [workspace(1, [cats[0]], false)])\n272: \t\t).toHaveLength(2);\n273: \t});\n274: \n275: \tit('keeps categories not assigned to any hideable workspace', () => {\n276: \t\tconst cat = category(1);\n277: \t\tconst result = service.filterCategoriesByHideIt([cat], [workspace(1, [category(9)], true)]);\n278: \t\texpect(result.map((c) => c.id)).toEqual([1]);\n279: \t});\n280: });\n\n(End of file - total 280 lines)\n</content>","metadata":{"preview":"import { describe, it, expect } from 'vitest';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\n\nfunction todo(overrides: Partial<Todo> = {}): Todo {\n\treturn {\n\t\tid: '1',\n\t\ttitle: 'Test todo',\n\t\tdescription: '',\n\t\tlink: null,\n\t\tpriority: 'medium',\n\t\tstatus: 'pending',\n\t\teffort: null,\n\t\tprogress: null,\n\t\tis_completed: false,\n\t\tdue_at: '',\n\t\tcategory: null,\n\t\ttags: [],\n\t\tsubtasks: [],","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/services/TodoFilterService.test.ts","text":"import { describe, it, expect } from 'vitest';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport type { Todo, TodoCategory, TodoWorkspace } from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\n\nfunction todo(overrides: Partial<Todo> = {}): Todo {\n\treturn {\n\t\tid: '1',\n\t\ttitle: 'Test todo',\n\t\tdescription: '',\n\t\tlink: null,\n\t\tpriority: 'medium',\n\t\tstatus: 'pending',\n\t\teffort: null,\n\t\tprogress: null,\n\t\tis_completed: false,\n\t\tdue_at: '',\n\t\tcategory: null,\n\t\ttags: [],\n\t\tsubtasks: [],\n\t\trelevance: null,\n\t\trecurrence_frequency: null,\n\t\trecurrence_interval: 1,\n\t\trecurrence_ends_at: null,\n\t\tparent_task_id: null,\n\t\tauto_generated: false,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\tcompleted_at: '',\n\t\t...overrides\n\t};\n}\n\nfunction category(id: number, title = 'Category'): TodoCategory {\n\treturn { id, title, created_at: '', updated_at: '' };\n}\n\nfunction tag(id: number, name = 'tag'): Tag {\n\treturn { id, name, color: '#000000', created_at: '', updated_at: '' };\n}\n\nfunction workspace(id: number, categories: TodoCategory[], hideable = false): TodoWorkspace {\n\treturn { id, title: 'WS', is_hideable: hideable, categories, created_at: '', updated_at: '' };\n}\n\nconst service = new TodoFilterService();\n\ndescribe('filterByPriority', () => {\n\tit('keeps only todos with the matching priority', () => {\n\t\tconst todos = [\n\t\t\ttodo({ priority: 'high' }),\n\t\t\ttodo({ priority: 'low' }),\n\t\t\ttodo({ priority: 'high' })\n\t\t];\n\t\texpect(service.filterByPriority('high', todos)).toHaveLength(2);\n\t\texpect(service.filterByPriority('low', todos)).toHaveLength(1);\n\t\texpect(service.filterByPriority('medium', todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByStatus', () => {\n\tit('keeps only todos with the matching status', () => {\n\t\tconst todos = [\n\t\t\ttodo({ status: 'pending' }),\n\t\t\ttodo({ status: 'in-progress' }),\n\t\t\ttodo({ status: 'backlog' })\n\t\t];\n\t\texpect(service.filterByStatus('pending', todos)).toHaveLength(1);\n\t\texpect(service.filterByStatus('in-progress', todos)).toHaveLength(1);\n\t\texpect(service.filterByStatus('backlog', todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterByEffort', () => {\n\tit('matches todos with the given effort', () => {\n\t\tconst todos = [todo({ effort: 'low' }), todo({ effort: 'high' }), todo({ effort: null })];\n\t\texpect(service.filterByEffort('low', todos)).toHaveLength(1);\n\t\texpect(service.filterByEffort('high', todos)).toHaveLength(1);\n\t});\n\n\tit('treats null effort as medium', () => {\n\t\tconst todos = [todo({ effort: null }), todo({ effort: 'medium' }), todo({ effort: 'low' })];\n\t\texpect(service.filterByEffort('medium', todos)).toHaveLength(2);\n\t});\n});\n\ndescribe('filterOutBacklog', () => {\n\tit('removes backlog todos and keeps the rest', () => {\n\t\tconst todos = [\n\t\t\ttodo({ status: 'backlog' }),\n\t\t\ttodo({ status: 'pending' }),\n\t\t\ttodo({ status: 'backlog' })\n\t\t];\n\t\texpect(service.filterOutBacklog(todos)).toHaveLength(1);\n\t\texpect(service.filterOutBacklog(todos)[0].status).toBe('pending');\n\t});\n});\n\ndescribe('filterByDueDate', () => {\n\t// TZ=UTC (set in vitest.config.ts) so YYYY-MM-DD strings parse as midnight local\n\tconst todayStr = new Date().toISOString().split('T')[0];\n\tconst tomorrowStr = (() => {\n\t\tconst d = new Date();\n\t\td.setDate(d.getDate() + 1);\n\t\treturn d.toISOString().split('T')[0];\n\t})();\n\n\tit('filters by today', () => {\n\t\tconst todos = [\n\t\t\ttodo({ due_at: todayStr }),\n\t\t\ttodo({ due_at: '2099-01-01' }),\n\t\t\ttodo({ due_at: '' })\n\t\t];\n\t\tconst result = service.filterByDueDate('today', todos);\n\t\texpect(result).toHaveLength(1);\n\t\texpect(result[0].due_at).toBe(todayStr);\n\t});\n\n\tit('filters by tomorrow', () => {\n\t\tconst todos = [todo({ due_at: tomorrowStr }), todo({ due_at: todayStr })];\n\t\texpect(service.filterByDueDate('tomorrow', todos)).toHaveLength(1);\n\t});\n\n\tit('filters overdue (past dates only)', () => {\n\t\tconst todos = [todo({ due_at: '2000-01-01' }), todo({ due_at: '2099-01-01' })];\n\t\texpect(service.filterByDueDate('overdue', todos)).toHaveLength(1);\n\t});\n\n\tit('filters today-overdue (today and past combined)', () => {\n\t\tconst todos = [\n\t\t\ttodo({ due_at: todayStr }),\n\t\t\ttodo({ due_at: '2000-01-01' }),\n\t\t\ttodo({ due_at: '2099-01-01' })\n\t\t];\n\t\texpect(service.filterByDueDate('today-overdue', todos)).toHaveLength(2);\n\t});\n\n\tit('excludes todos with an empty due date', () => {\n\t\texpect(service.filterByDueDate('today', [todo({ due_at: '' })])).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByCategory', () => {\n\tit('keeps only todos in the given category', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat1 }),\n\t\t\ttodo({ category: cat2 }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\texpect(service.filterByCategory(1, todos)).toHaveLength(1);\n\t\texpect(service.filterByCategory(99, todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByTag', () => {\n\tit('keeps todos that have the given tag', () => {\n\t\tconst t1 = tag(10);\n\t\tconst t2 = tag(20);\n\t\tconst todos = [todo({ tags: [t1, t2] }), todo({ tags: [t2] }), todo({ tags: [] })];\n\t\texpect(service.filterByTag(10, todos)).toHaveLength(1);\n\t\texpect(service.filterByTag(20, todos)).toHaveLength(2);\n\t\texpect(service.filterByTag(99, todos)).toHaveLength(0);\n\t});\n});\n\ndescribe('filterByWorkspace', () => {\n\tit('keeps todos whose category belongs to the workspace', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst ws = workspace(1, [cat1]);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat1 }),\n\t\t\ttodo({ category: cat2 }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\texpect(service.filterByWorkspace(ws, todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterByHideIt', () => {\n\tit('hides todos whose category is in a hideable workspace', () => {\n\t\tconst cat = category(1);\n\t\tconst hideable = workspace(1, [cat], true);\n\t\tconst todos = [\n\t\t\ttodo({ category: cat }),\n\t\t\ttodo({ category: category(2) }),\n\t\t\ttodo({ category: null })\n\t\t];\n\t\tconst result = service.filterByHideIt(todos, [hideable]);\n\t\texpect(result).toHaveLength(2);\n\t\texpect(result.every((t) => t.category?.id !== 1)).toBe(true);\n\t});\n\n\tit('keeps todos with no category regardless of workspaces', () => {\n\t\tconst hideable = workspace(1, [category(1)], true);\n\t\texpect(service.filterByHideIt([todo({ category: null })], [hideable])).toHaveLength(1);\n\t});\n\n\tit('does not hide todos from non-hideable workspaces', () => {\n\t\tconst cat = category(1);\n\t\tconst visible = workspace(1, [cat], false);\n\t\texpect(service.filterByHideIt([todo({ category: cat })], [visible])).toHaveLength(1);\n\t});\n});\n\ndescribe('filter (dispatch)', () => {\n\tit('routes priority filter correctly', () => {\n\t\tconst todos = [todo({ priority: 'high' }), todo({ priority: 'low' })];\n\t\texpect(service.filter({ type: 'priority', value: 'high' }, todos)).toHaveLength(1);\n\t});\n\n\tit('routes status filter correctly', () => {\n\t\tconst todos = [todo({ status: 'pending' }), todo({ status: 'backlog' })];\n\t\texpect(service.filter({ type: 'status', value: 'pending' }, todos)).toHaveLength(1);\n\t});\n\n\tit('returns all todos for unknown filter type', () => {\n\t\t// @ts-expect-error testing fallback path\n\t\texpect(service.filter({ type: 'unknown', value: '' }, [todo(), todo()])).toHaveLength(2);\n\t});\n});\n\ndescribe('filterByDueDate (week)', () => {\n\tit('keeps only todos due within the current week', () => {\n\t\t// isDateThisWeek uses a Sunday-start week: today - getDay() to +6 days\n\t\tconst now = new Date();\n\t\tconst startOfWeek = new Date(now);\n\t\tstartOfWeek.setDate(now.getDate() - now.getDay());\n\t\tconst endOfWeek = new Date(now);\n\t\tendOfWeek.setDate(startOfWeek.getDate() + 6);\n\n\t\tconst todos = [\n\t\t\ttodo({ due_at: startOfWeek.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: endOfWeek.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: '2099-01-01' }),\n\t\t\ttodo({ due_at: '' })\n\t\t];\n\n\t\texpect(service.filterByDueDate('week', todos)).toHaveLength(2);\n\t});\n\n\tit('routes the week filter through the dispatch method', () => {\n\t\tconst now = new Date();\n\t\tconst todos = [\n\t\t\ttodo({ due_at: now.toISOString().split('T')[0] }),\n\t\t\ttodo({ due_at: '2099-01-01' })\n\t\t];\n\t\texpect(service.filter({ type: 'due', value: 'week' }, todos)).toHaveLength(1);\n\t});\n});\n\ndescribe('filterCategoriesByHideIt', () => {\n\tit('removes categories that belong to a hideable workspace', () => {\n\t\tconst cat1 = category(1);\n\t\tconst cat2 = category(2);\n\t\tconst hideable = workspace(1, [cat1], true);\n\t\tconst visible = workspace(2, [cat2], false);\n\n\t\tconst result = service.filterCategoriesByHideIt(\n\t\t\t[cat1, cat2, category(3)],\n\t\t\t[hideable, visible]\n\t\t);\n\t\texpect(result.map((c) => c.id)).toEqual([2, 3]);\n\t});\n\n\tit('keeps all categories when no workspace is hideable', () => {\n\t\tconst cats = [category(1), category(2)];\n\t\texpect(\n\t\t\tservice.filterCategoriesByHideIt(cats, [workspace(1, [cats[0]], false)])\n\t\t).toHaveLength(2);\n\t});\n\n\tit('keeps categories not assigned to any hideable workspace', () => {\n\t\tconst cat = category(1);\n\t\tconst result = service.filterCategoriesByHideIt([cat], [workspace(1, [category(9)], true)]);\n\t\texpect(result.map((c) => c.id)).toEqual([1]);\n\t});\n});","lineStart":1,"lineEnd":280,"totalLines":280,"truncated":false}},"title":"tests/unit/services/TodoFilterService.test.ts","time":{"start":1791728777796,"end":1791728777902}},"id":"prt_12b5b79e5001BtpVNqeoxEiTrL","sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","messageID":"msg_12b5b67a8001O4KW4Y4KKNrEnC"}}
{"type":"tool_use","timestamp":1791728778043,"sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","part":{"type":"tool","tool":"read","callID":"call_02_F32teGSfv19C8BuGZuD31131","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/services/TimeTrackingGroupingService.test.ts"},"output":"<path>/workspace/tests/unit/services/TimeTrackingGroupingService.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect } from 'vitest';\n2: import TimeTrackingGroupingService, {\n3: \tFALLBACK_PROJECT_COLOR\n4: } from '$lib/services/TimeTrackingGroupingService';\n5: import type { TimeTrackingEntry, TimeTrackingProject } from '$lib/types/time_tracking';\n6: \n7: const service = new TimeTrackingGroupingService();\n8: \n9: function project(overrides: Partial<TimeTrackingProject> = {}): TimeTrackingProject {\n10: \treturn {\n11: \t\tid: 'p1',\n12: \t\ttitle: 'Project',\n13: \t\tdescription: null,\n14: \t\tcolor: null,\n15: \t\tcategories: [],\n16: \t\ttotal_duration: 0,\n17: \t\tcreated_at: '',\n18: \t\tupdated_at: '',\n19: \t\t...overrides\n20: \t};\n21: }\n22: \n23: function entry(\n24: \tprojectId: string | null,\n25: \tdurationMinutes: number,\n26: \toverrides: Partial<TimeTrackingEntry> = {}\n27: ): TimeTrackingEntry {\n28: \treturn {\n29: \t\tid: `e-${Math.random()}`,\n30: \t\tdescription: null,\n31: \t\tstarted_at: '2026-10-01T09:00:00.000Z',\n32: \t\tstopped_at: '2026-10-01T10:00:00.000Z',\n33: \t\tduration_minutes: durationMinutes,\n34: \t\thas_exact_times: false,\n35: \t\tproject: projectId ? project({ id: projectId, title: projectId }) : null,\n36: \t\tcreated_at: '',\n37: \t\tupdated_at: '',\n38: \t\t...overrides\n39: \t};\n40: }\n41: \n42: describe('groupByProject', () => {\n43: \tit('sums minutes per project and sorts descending', () => {\n44: \t\tconst projects = [project({ id: 'p1', title: 'One' }), project({ id: 'p2', title: 'Two' })];\n45: \t\tconst result = service.groupByProject(\n46: \t\t\t[entry('p1', 30), entry('p2', 10), entry('p1', 20)],\n47: \t\t\tprojects\n48: \t\t);\n49: \n50: \t\texpect(result).toHaveLength(2);\n51: \t\texpect(result[0]).toMatchObject({ projectId: 'p1', title: 'One', minutes: 50 });\n52: \t\texpect(result[1]).toMatchObject({ projectId: 'p2', title: 'Two', minutes: 10 });\n53: \t});\n54: \n55: \tit(\"uses the project's own colour, not its first category\", () => {\n56: \t\tconst projects = [\n57: \t\t\tproject({\n58: \t\t\t\tid: 'p1',\n59: \t\t\t\ttitle: 'One',\n60: \t\t\t\tcolor: '#ff0000',\n61: \t\t\t\tcategories: [\n62: \t\t\t\t\t{\n63: \t\t\t\t\t\tid: 1,\n64: \t\t\t\t\t\ttitle: 'Cat',\n65: \t\t\t\t\t\tcolor: '#00ff00',\n66: \t\t\t\t\t\tcreated_at: '',\n67: \t\t\t\t\t\tupdated_at: ''\n68: \t\t\t\t\t}\n69: \t\t\t\t]\n70: \t\t\t})\n71: \t\t];\n72: \t\tconst result = service.groupByProject([entry('p1', 30)], projects);\n73: \n74: \t\texpect(result[0].color).toBe('#ff0000');\n75: \t});\n76: \n77: \tit('falls back to the theme variable when a project has no colour', () => {\n78: \t\tconst projects = [project({ id: 'p1', title: 'One', color: null })];\n79: \t\tconst result = service.groupByProject([entry('p1', 30)], projects);\n80: \n81: \t\texpect(result[0].color).toBe(FALLBACK_PROJECT_COLOR);\n82: \t});\n83: \n84: \tit('ignores entries with no project', () => {\n85: \t\tconst result = service.groupByProject([entry(null, 30)], []);\n86: \t\texpect(result).toHaveLength(0);\n87: \t});\n88: \n89: \tit('does not mutate the input entries', () => {\n90: \t\tconst projects = [project({ id: 'p1', title: 'One' })];\n91: \t\tconst entries = [entry('p1', 30), entry('p1', 15)];\n92: \t\tconst original = entries.map((e) => e.duration_minutes);\n93: \t\tservice.groupByProject(entries, projects);\n94: \t\texpect(entries.map((e) => e.duration_minutes)).toEqual(original);\n95: \t});\n96: });\n\n(End of file - total 96 lines)\n</content>","metadata":{"preview":"import { describe, it, expect } from 'vitest';\nimport TimeTrackingGroupingService, {\n\tFALLBACK_PROJECT_COLOR\n} from '$lib/services/TimeTrackingGroupingService';\nimport type { TimeTrackingEntry, TimeTrackingProject } from '$lib/types/time_tracking';\n\nconst service = new TimeTrackingGroupingService();\n\nfunction project(overrides: Partial<TimeTrackingProject> = {}): TimeTrackingProject {\n\treturn {\n\t\tid: 'p1',\n\t\ttitle: 'Project',\n\t\tdescription: null,\n\t\tcolor: null,\n\t\tcategories: [],\n\t\ttotal_duration: 0,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\t...overrides\n\t};","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/unit/services/TimeTrackingGroupingService.test.ts","text":"import { describe, it, expect } from 'vitest';\nimport TimeTrackingGroupingService, {\n\tFALLBACK_PROJECT_COLOR\n} from '$lib/services/TimeTrackingGroupingService';\nimport type { TimeTrackingEntry, TimeTrackingProject } from '$lib/types/time_tracking';\n\nconst service = new TimeTrackingGroupingService();\n\nfunction project(overrides: Partial<TimeTrackingProject> = {}): TimeTrackingProject {\n\treturn {\n\t\tid: 'p1',\n\t\ttitle: 'Project',\n\t\tdescription: null,\n\t\tcolor: null,\n\t\tcategories: [],\n\t\ttotal_duration: 0,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\t...overrides\n\t};\n}\n\nfunction entry(\n\tprojectId: string | null,\n\tdurationMinutes: number,\n\toverrides: Partial<TimeTrackingEntry> = {}\n): TimeTrackingEntry {\n\treturn {\n\t\tid: `e-${Math.random()}`,\n\t\tdescription: null,\n\t\tstarted_at: '2026-10-01T09:00:00.000Z',\n\t\tstopped_at: '2026-10-01T10:00:00.000Z',\n\t\tduration_minutes: durationMinutes,\n\t\thas_exact_times: false,\n\t\tproject: projectId ? project({ id: projectId, title: projectId }) : null,\n\t\tcreated_at: '',\n\t\tupdated_at: '',\n\t\t...overrides\n\t};\n}\n\ndescribe('groupByProject', () => {\n\tit('sums minutes per project and sorts descending', () => {\n\t\tconst projects = [project({ id: 'p1', title: 'One' }), project({ id: 'p2', title: 'Two' })];\n\t\tconst result = service.groupByProject(\n\t\t\t[entry('p1', 30), entry('p2', 10), entry('p1', 20)],\n\t\t\tprojects\n\t\t);\n\n\t\texpect(result).toHaveLength(2);\n\t\texpect(result[0]).toMatchObject({ projectId: 'p1', title: 'One', minutes: 50 });\n\t\texpect(result[1]).toMatchObject({ projectId: 'p2', title: 'Two', minutes: 10 });\n\t});\n\n\tit(\"uses the project's own colour, not its first category\", () => {\n\t\tconst projects = [\n\t\t\tproject({\n\t\t\t\tid: 'p1',\n\t\t\t\ttitle: 'One',\n\t\t\t\tcolor: '#ff0000',\n\t\t\t\tcategories: [\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 1,\n\t\t\t\t\t\ttitle: 'Cat',\n\t\t\t\t\t\tcolor: '#00ff00',\n\t\t\t\t\t\tcreated_at: '',\n\t\t\t\t\t\tupdated_at: ''\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t})\n\t\t];\n\t\tconst result = service.groupByProject([entry('p1', 30)], projects);\n\n\t\texpect(result[0].color).toBe('#ff0000');\n\t});\n\n\tit('falls back to the theme variable when a project has no colour', () => {\n\t\tconst projects = [project({ id: 'p1', title: 'One', color: null })];\n\t\tconst result = service.groupByProject([entry('p1', 30)], projects);\n\n\t\texpect(result[0].color).toBe(FALLBACK_PROJECT_COLOR);\n\t});\n\n\tit('ignores entries with no project', () => {\n\t\tconst result = service.groupByProject([entry(null, 30)], []);\n\t\texpect(result).toHaveLength(0);\n\t});\n\n\tit('does not mutate the input entries', () => {\n\t\tconst projects = [project({ id: 'p1', title: 'One' })];\n\t\tconst entries = [entry('p1', 30), entry('p1', 15)];\n\t\tconst original = entries.map((e) => e.duration_minutes);\n\t\tservice.groupByProject(entries, projects);\n\t\texpect(entries.map((e) => e.duration_minutes)).toEqual(original);\n\t});\n});","lineStart":1,"lineEnd":96,"totalLines":96,"truncated":false}},"title":"tests/unit/services/TimeTrackingGroupingService.test.ts","time":{"start":1791728777908,"end":1791728778040}},"id":"prt_12b5b7a5d001472hTBkh71ahKt","sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","messageID":"msg_12b5b67a8001O4KW4Y4KKNrEnC"}}
