Total = $derived(() => weekBreakdown().reduce((s, c) => s + c.minutes, 0));\n36: \n37: \tlet todayBreakdown = $derived(() => {\n38: \t\tconst now = new Date();\n39: \t\tconst startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n40: \t\tconst filtered = tt.entries.filter(\n41: \t\t\t(e) => e.stopped_at !== null && new Date(e.started_at) >= startOfToday\n42: \t\t);\n43: \t\treturn groupingService.groupByProject(filtered, tt.projects);\n44: \t});\n45: \n46: \tlet todayTotal = $derived(() => todayBreakdown().reduce((s, c) => s + c.minutes, 0));\n47: </script>\n48: \n49: <div class=\"flex flex-col gap-8\">\n50: \t<Heading title={ts.get.timeTracking.dashboard} my={0} />\n51: \n52: \t<div class=\"grid grid-cols-1 items-start gap-4 md:grid-cols-2 lg:grid-cols-4\">\n53: \t\t<div class=\"lg:col-span-1\">\n54: \t\t\t<TimerWidget />\n55: \t\t</div>\n56: \t\t<TimeBreakdownWidget\n57: \t\t\ttitle={ts.get.timeTracking.today}\n58: \t\t\tbreakdown={todayBreakdown()}\n59: \t\t\ttotal={todayTotal()}\n60: \t\t/>\n61: \t\t<TimeBreakdownWidget\n62: \t\t\ttitle={ts.get.timeTracking.this_week}\n63: \t\t\tbreakdown={weekBreakdown()}\n64: \t\t\ttotal={weekTotal()}\n65: \t\t/>\n66: \t</div>\n67: \n68: \t{#if recentEntries.length > 0}\n69: \t\t<div class=\"flex flex-col gap-2\">\n70: \t\t\t<Heading title={ts.get.timeTracking.recent_entries} my={0} />\n71: \t\t\t{#each recentEntries as entry (entry.id)}\n72: \t\t\t\t<Entry {entry} showProject showDate showEdit onEdit={(e) => (editingEntry = e)} />\n73: \t\t\t{/each}\n74: \t\t</div>\n75: \t{/if}\n76: </div>\n77: \n78: {#if editingEntry}\n79: \t<EntryCreate entry={editingEntry} onClose={() => (editingEntry = null)} />\n80: {/if}\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"<script lang=\"ts\">\n\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n\timport { getTranslation } from '$lib/state/Translation.svelte';\n\timport Entry from '$lib/components/time-tracking/Entry.svelte';\n\timp