dicator = getLoadingIndicator();\n29: \tconst keyManager = getKeyManager();\n30: \n31: \tlet activeTab = $derived.by(() => {\n32: \t\tconst tab = page.url.searchParams.get('tab');\n33: \t\tif (tab === 'entries' || tab === 'statistics') return tab;\n34: \t\treturn 'dashboard';\n35: \t});\n36: \n37: \tlet {\n38: \t\tonCreateProject,\n39: \t\tonEditProject,\n40: \t\tactiveProjectId = null\n41: \t} = $props<{\n42: \t\tonCreateProject: () => void;\n43: \t\tonEditProject: (id: string) => void;\n44: \t\tactiveProjectId?: string | null;\n45: \t}>();\n46: \n47: \tlet open = $state<boolean>(false);\n48: \tlet confirmDeleteProjectId = $state<string | null>(null);\n49: \tlet confirmDeleteCategoryId = $state<number | null>(null);\n50: \tlet addingCategory = $state<boolean>(false);\n51: \n52: \t// Concrete hex default for the colour picker swatch (the picker needs a\n53: \t// hex value); styling fallbacks use theme variables instead.\n54: \tconst DEFAULT_CATEGORY_COLOR = '#1dbda5';\n55: \tlet newCategoryTitle = $state<string>('');\n56: \tlet addCategoryInput = $state<HTMLInputElement | null>(null);\n57: \tlet editingCategoryId = $state<number | null>(null);\n58: \tlet editingCategoryTitle = $state<string>('');\n59: \tlet editingInput = $state<HTMLInputElement | null>(null);\n60: \tlet addKeyHandlers = $state<Record<string, string | null>>({ Enter: null, Escape: null });\n61: \tlet editKeyHandlers = $state<Record<string, string | null>>({ Enter: null, Escape: null });\n62: \tlet categoryColors = $state<Record<number, string>>({});\n63: \n64: \tfunction getCategoryHex(id: number, fallback: string | null): string {\n65: \t\treturn categoryColors[id] ?? fallback ?? DEFAULT_CATEGORY_COLOR;\n66: \t}\n67: \n68: \tfunction setCategoryHex(id: number, hex: string): void {\n69: \t\tcategoryColors[id] = hex;\n70: \t}\n71: \n72: \tfunction handleNavigation(): void {\n73: \t\topen = false;\n74: \t}\n75: \n76: \tasync function addCategory(): Promise<void> {\n77: \t\tif (!newCategoryTitle.trim()) return;\n78: \t\tkeyManager.unregisterAll(addKeyHandlers);\n79: \t\tloadingIndicator.start();\n80: \t\tawait tt.createCategory({ title: newCategoryTitle.trim() });\n81: \t\tnewCategoryTitle = '';\n82: \t\taddingCategory = false;\n83: \t\tloadingIndicator.stop();\n84: \t}\n85: \n86: \tfunction startAddCategory(): void {\n87: \t\tif (addingCategory) return;\n88: \t\taddingCategory = true;\n89: \t\taddKeyHandlers.Enter = keyManager.registerKeyDown('Enter', () => addCategory(), { priority: 2 });\n90: \t\taddKeyHandlers.Escape = keyManager.registerKeyDown('Escape', () => {\n91: \t\t\tkeyManager.unregisterAll(addKeyHandlers);\n92: \t\t\taddingCategory = false;\n93: \t\t\tnewCategoryTitle = '';\n94: \t\t});\n95: \t}\n96: \n97: \tasync function startEditCategory(id: number, title: string): Promise<void> {\n98: \t\tkeyManager.unregisterAll(editKeyHandlers);\n99: \t\teditingCategoryId = id;\n100: \t\teditingCategoryTitle = title;\n101: \t\teditKeyHandlers.Enter = keyManager.registerKeyDown('Enter', () => saveEditCategory(), { priority: 2 });\n102: \t\teditKeyHandlers.Escape = keyManager.registerKeyDown('Escape', () => cancelEditCategory());\n103: \t\tawait tick();\n104: \t\teditingInput?.focus();\n105: \t}\n106: \n107: \tasync function saveEditCategory(): Promise<void> {\n108: \t\tif (editingCategoryId === null || !editingCategoryTitle.trim()) return;\n109: \t\tkeyManager.unregisterAll(editKeyHandlers);\n110: \t\tloadingIndicator.start();\n111: \t\tawait tt.updateCategory(editingCategoryId, { title: editingCategoryTitle.trim() });\n112: \t\teditingCategoryId = null;\n113: \t\teditingCategoryTitle = '';\n114: \t\tloadingIndicator.stop();\n115: \t}\n116: \n117: \tfunction cancelEditCategory(): void {\n118: \t\tkeyManager.unregisterAll(editKeyHandlers);\n119: \t\teditingCategoryId = null;\n120: \t\teditingCategoryTitle = '';\n121: \t}\n122: \n123: \tasync function handleColorChange(id: number): Promise<void> {\n124: \t\tconst category = tt.categories.find((c) => c.id === id);\n125: \t\tconst newColor = categoryColors[id];\n126: \t\tif (!newColor || !category || newColor === (category.color ?? DEFAULT_CATEGORY_COLOR)) return;\n127: \t\tawait tt.updateCategory(id, { color: newColor });\n128: \t}\n129: \n130: \tonDestroy(() => {\n131: \t\tkeyManager.unregisterAll(addKeyHandlers);\n132: \t\tkeyManager.unregisterAll(editKeyHandlers);\n133: \t});\n134: </script>\n135: \n136: {#snippet sidebar()}\n137: \t<div class=\"flex items-center justify-between border-b border-c-neutral-2 p-4 mb-4 lg:hidden dark:border-s-dark-3\">\n138: \t\t<span class=\"text-2xl font-bold 2xl:font-normal\">\n139: \t\t\t{ts.get.timeTracking.time_tracking}\n140: \t\t</span>\n141: \t\t<CloseButton onClick={handleNavigation} inModal={false} />\n142: \t</div>\n143: \n144: \t<div class=\"p-4 lg:p-0\">\n145: \t\t<div class=\"flex flex-col gap-0.5\">\n146: \t\t\t<a\n147: \t\t\t\thref={resolve(urls.timeTracking)}\n148: \t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n149: \t\t\t\tclass:bg-c-neutral-1={!activeProjectId && activeTab === 'dashboard'}\n150: \t\t\t\tclass:dark:bg-s-dark-3={!activeProjectId && activeTab === 'dashboard'}\n151: \t\t\t\tonclick={handleNavigation}\n152: \t\t\t>\n153: \t\t\t\t<IconLayoutDashboard class=\"size-4\" />\n154: \t\t\t\t{ts.get.timeTracking.dashboard}\n155: \t\t\t</a>\n156: \t\t\t<a\n157: \t\t\t\thref=\"{resolve(urls.timeTracking)}?tab=entries\"\n158: \t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n159: \t\t\t\tclass:bg-c-neutral-1={!activeProjectId && activeTab === 'entries'}\n160: \t\t\t\tclass:dark:bg-s-dark-3={!activeProjectId && activeTab === 'entries'}\n161: \t\t\t\tonclick={handleNavigation}\n162: \t\t\t>\n163: \t\t\t\t<IconList class=\"size-4\" />\n164: \t\t\t\t{ts.get.timeTracking.entries}\n165: \t\t\t</a>\n166: \t\t\t<a\n167: \t\t\t\thref=\"{resolve(urls.timeTracking)}?tab=statistics\"\n168: \t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n169: \t\t\t\tclass:bg-c-neutral-1={!activeProjectId && activeTab === 'statistics'}\n170: \t\t\t\tclass:dark:bg-s-dark-3={!activeProjectId && activeTab === 'statistics'}\n171: \t\t\t\tonclick={handleNavigation}\n172: \t\t\t>\n173: \t\t\t\t<IconChartPie class=\"size-4\" />\n174: \t\t\t\t{ts.get.timeTracking.statistics}\n175: \t\t\t</a>\n176: \t\t</div>\n177: \n178: \t\t<div class=\"flex flex-col gap-1\">\n179: \t\t\t<div class=\"flex flex-row items-center justify-between\">\n180: \t\t\t\t<span class=\"mb-1 mt-2 text-base font-bold 2xl:text-2xl 2xl:font-normal\">\n181: \t\t\t\t\t{ts.get.timeTracking.projects}\n182: \t\t\t\t</span>\n183: \t\t\t\t<button\n184: \t\t\t\t\taria-label={ts.get.timeTracking.add_project}\n185: \t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-1 hover:text-c-primary dark:hover:bg-s-dark-3\"\n186: \t\t\t\t\tonclick={() => {\n187: \t\t\t\t\t\tonCreateProject();\n188: \t\t\t\t\t\thandleNavigation();\n189: \t\t\t\t\t}}\n190: \t\t\t\t>\n191: \t\t\t\t\t<IconPlus class=\"size-4\" />\n192: \t\t\t\t</button>\n193: \t\t\t</div>\n194: \t\t\t{#each tt.projects as project (project.id)}\n195: \t\t\t\t<div\n196: \t\t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center justify-between rounded-md px-2 py-1.5 transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n197: \t\t\t\t\tclass:bg-c-neutral-1={activeProjectId === project.id}\n198: \t\t\t\t\tclass:dark:bg-s-dark-3={activeProjectId === project.id}\n199: \t\t\t\t>\n200: \t\t\t\t\t<a\n201: \t\t\t\t\t\thref={resolve(urls.timeTrackingProject, { id: project.id })}\n202: \t\t\t\t\t\tclass=\"flex min-w-0 flex-1 flex-col text-left text-sm\"\n203: \t\t\t\t\t\tonclick={() => handleNavigation()}\n204: \t\t\t\t\t>\n205: \t\t\t\t\t\t<span class=\"truncate font-medium\">{project.title}</span>\n206: \t\t\t\t\t\t<span class=\"text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n207: \t\t\t\t\t\t\t{tt.formatDuration(project.total_duration ?? 0)}\n208: \t\t\t\t\t\t</span>\n209: \t\t\t\t\t</a>\n210: \t\t\t\t\t<div class=\"flex flex-row items-center gap-0.5\">\n211: \t\t\t\t\t\t<button\n212: \t\t\t\t\t\t\taria-label={ts.get.timeTracking.edit_project}\n213: \t\t\t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-2 hover:text-c-primary dark:hover:bg-s-dark-2\"\n214: \t\t\t\t\t\t\tonclick={(e) => {\n215: \t\t\t\t\t\t\t\te.preventDefault();\n216: \t\t\t\t\t\t\t\te.stopPropagation();\n217: \t\t\t\t\t\t\t\tonEditProject(project.id);\n218: \t\t\t\t\t\t\t\thandleNavigation();\n219: \t\t\t\t\t\t\t}}\n220: \t\t\t\t\t\t>\n221: \t\t\t\t\t\t\t<IconPen class=\"size-3.5\" />\n222: \t\t\t\t\t\t</button>\n223: \t\t\t\t\t\t<button\n224: \t\t\t\t\t\t\taria-label={ts.get.timeTracking.deletion_title}\n225: \t\t\t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-2 hover:text-c-danger dark:hover:bg-s-dark-2\"\n226: \t\t\t\t\t\t\tonclick={(e) => {\n227: \t\t\t\t\t\t\t\te.preventDefault();\n228: \t\t\t\t\t\t\t\te.stopPropagation();\n229: \t\t\t\t\t\t\t\tconfirmDeleteProjectId = project.id;\n230: \t\t\t\t\t\t\t}}\n231: \t\t\t\t\t\t>\n232: \t\t\t\t\t\t\t<IconTrash class=\"size-3.5\" />\n233: \t\t\t\t\t\t</button>\n234: \t\t\t\t\t</div>\n235: \t\t\t\t</div>\n236: \t\t\t{/each}\n237: \t\t</div>\n238: \n239: \t\t<div class=\"flex flex-col gap-1\">\n240: \t\t\t<div class=\"flex flex-row items-center justify-between\">\n241: \t\t\t\t<span class=\"mb-1 mt-2 text-base font-bold 2xl:text-2xl 2xl:font-normal\">\n242: \t\t\t\t\t{ts.get.timeTracking.categories}\n243: \t\t\t\t</span>\n244: \t\t\t\t<button\n245: \t\t\t\t\taria-label={ts.get.timeTracking.add_category}\n246: \t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-1 hover:text-c-primary dark:hover:bg-s-dark-3\"\n247: \t\t\t\t\tonclick={async () => {\n248: \t\t\t\t\t\tstartAddCategory();\n249: \t\t\t\t\t\tawait tick();\n250: \t\t\t\t\t\taddCategoryInput?.focus();\n251: \t\t\t\t\t}}\n252: \t\t\t\t>\n253: \t\t\t\t\t<IconPlus class=\"size-4\" />\n254: \t\t\t\t</button>\n255: \t\t\t</div>\n256: \t\t\t{#if addingCategory}\n257: \t\t\t\t<div class=\"flex flex-row items-center space-x-2\">\n258: \t\t\t\t\t<TextInput\n259: \t\t\t\t\t\tbind:input={addCategoryInput}\n260: \t\t\t\t\t\tbind:value={newCategoryTitle}\n261: \t\t\t\t\t\tonblur={() => {\n262: \t\t\t\t\t\t\tkeyManager.unregisterAll(addKeyHandlers);\n263: \t\t\t\t\t\t\taddingCategory = false;\n264: \t\t\t\t\t\t\tnewCategoryTitle = '';\n265: \t\t\t\t\t\t}}\n266: \t\t\t\t\t\tplaceholder={ts.get.timeTracking.title}\n267: \t\t\t\t\t/>\n268: \t\t\t\t\t<SaveButton onClick={addCategory} />\n269: \t\t\t\t</div>\n270: \t\t\t{/if}\n271: \t\t\t{#each tt.categories as category (category.id)}\n272: \t\t\t\t<div class=\"flex flex-row items-center justify-between py-1\">\n273: \t\t\t\t\t<div class=\"flex flex-row items-center gap-2\">\n274: \t\t\t\t\t\t<div use:clickOutside={() => handleColorChange(category.id)}>\n275: \t\t\t\t\t\t\t<ColorPicker\n276: \t\t\t\t\t\t\t\thex={getCategoryHex(category.id, category.color)}\n277: \t\t\t\t\t\t\t\tonInput={(e) => { if (e.hex) setCategoryHex(category.id, e.hex); }}\n278: \t\t\t\t\t\t\t\tposition=\"responsive\"\n279: \t\t\t\t\t\t\t\tnullable={false}\n280: \t\t\t\t\t\t\t\tlabel=\"\"\n281: \t\t\t\t\t\t\t\tisTextInput={false}\n282: \t\t\t\t\t\t\t\t--cp-border-color=\"var(--color-c-neutral-2)\"\n283: \t\t\t\t\t\t\t/>\n284: \t\t\t\t\t\t</div>\n285: \t\t\t\t\t\t{#if editingCategoryId === category.id}\n286: \t\t\t\t\t\t\t<input\n287: \t\t\t\t\t\t\t\ttype=\"text\"\n288: \t\t\t\t\t\t\t\tbind:this={editingInput}\n289: \t\t\t\t\t\t\t\tbind:value={editingCategoryTitle}\n290: \t\t\t\t\t\t\t\tonblur={saveEditCategory}\n291: \t\t\t\t\t\t\t\tclass=\"w-full rounded-md border-1 border-c-neutral-2 px-2 py-0.5 text-sm shadow-xs focus:ring-2 focus:ring-c-primary focus:outline-none dark:border-s-dark-3 dark:bg-inherit dark:text-white\"\n292: \t\t\t\t\t\t\t/>\n293: \t\t\t\t\t\t{:else}\n294: \t\t\t\t\t\t\t<span class=\"text-sm\">{category.title}</span>\n295: \t\t\t\t\t\t{/if}\n296: \t\t\t\t\t</div>\n297: \t\t\t\t\t<div class=\"flex flex-row items-center gap-0.5\">\n298: \t\t\t\t\t\t{#if editingCategoryId !== category.id}\n299: \t\t\t\t\t\t\t<button\n300: \t\t\t\t\t\t\t\taria-label={ts.get.timeTracking.edit_category}\n301: \t\t\t\t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-2 hover:text-c-primary dark:hover:bg-s-dark-2\"\n302: \t\t\t\t\t\t\t\tonclick={() => startEditCategory(category.id, category.title)}\n303: \t\t\t\t\t\t\t>\n304: \t\t\t\t\t\t\t\t<IconPen class=\"size-3.5\" />\n305: \t\t\t\t\t\t\t</button>\n306: \t\t\t\t\t\t{/if}\n307: \t\t\t\t\t\t<button\n308: \t\t\t\t\t\t\taria-label={ts.get.timeTracking.category_deletion_title}\n309: \t\t\t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-2 hover:text-c-danger dark:hover:bg-s-dark-2\"\n310: \t\t\t\t\t\t\tonclick={() => (confirmDeleteCategoryId = category.id)}\n311: \t\t\t\t\t\t>\n312: \t\t\t\t\t\t\t<IconTrash class=\"size-3.5\" />\n313: \t\t\t\t\t\t</button>\n314: \t\t\t\t\t</div>\n315: \t\t\t\t</div>\n316: \t\t\t{/each}\n317: \t\t</div>\n318: \t</div>\n319: {/snippet}\n320: \n321: <HamburgerButton onclick={() => (open = true)} top={6} />\n322: \n323: <div\n324: \tclass=\"secondary-nav-mobile-container relative hidden h-full max-h-screen w-64 shrink-0 flex-col gap-4 overflow-y-auto bg-c-bg p-4 lg:flex dark:border-r-1 dark:border-s-dark-2 dark:drop-shadow-sm dark:drop-shadow-s-dark-shadow\"\n325: \tin:fade\n326: >\n327: \t{@render sidebar()}\n328: </div>\n32