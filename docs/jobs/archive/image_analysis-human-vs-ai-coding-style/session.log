ubmit(): Promise<void> {\n78: \t\tif (autocompleteOpen) return;\n79: \t\tif (!formOpen) {\n80: \t\t\tawait toggleForm();\n81: \t\t\treturn;\n82: \t\t}\n83: \n84: \t\tloadingIndicator.start();\n85: \n86: \t\tif (userInput.trim() !== '') {\n87: \t\t\tconst res = await todos.quickCreate(userInput);\n88: \t\t\tif (res.ok) {\n89: \t\t\t\tif (res.recurrenceIgnored) {\n90: \t\t\t\t\tnotifications.warning(ts.get.todos.recurrence_requires_due);\n91: \t\t\t\t\tloadingIndicator.stop();\n92: \t\t\t\t\treturn;\n93: \t\t\t\t}\n94: \t\t\t\tuserInput = '';\n95: \t\t\t\tnotifications.success(ts.get.todos.create_success);\n96: \t\t\t}\n97: \t\t}\n98: \n99: \t\tawait toggleForm();\n100: \t\tloadingIndicator.stop();\n101: \t}\n102: \n103: \tfunction handleEscape(event: KeyboardEvent): void {\n104: \t\tonblur();\n105: \t}\n106: \n107: \tasync function handleEnter(event: KeyboardEvent): Promise<void> {\n108: \t\tawait onSubmit();\n109: \t}\n110: </script>\n111: \n112: <div\n113: \tclass=\"relative mb-4 flex h-14 w-full flex-row justify-end p-2 pl-20 sm:pl-30 lg:pl-2 2xl:pl-14 pr-0\"\n114: >\n115: \t{#if formOpen}\n116: \t\t{#if viewPoint.isDesktop}\n117: \t\t\t<InlineAutocomplete\n118: \t\t\t\tbind:input\n119: \t\t\t\tbind:value={userInput}\n120: \t\t\t\t{onblur}\n121: \t\t\t\tplaceholder=\"Enter todo\"\n122: \t\t\t\ttriggers={autocompleteTriggers}\n123: \t\t\t\tbind:open={autocompleteOpen}\n124: \t\t\t/>\n125: \t\t\t<div\n126: \t\t\t\tclass=\"absolute top-[-24px] right-8 flex items-center gap-8 text-xs max-md:hidden\"\n127: \t\t\t\tin:fade\n128: \t\t\t>\n129: \t\t\t\t<div class=\"flex items-center gap-1\">\n130: \t\t\t\t\t<div class=\"bg-c-neutral-1 px-2 py-1 dark:bg-s-dark-2\">/</div>\n131: \t\t\t\t\t<span>Category</span>\n132: \t\t\t\t</div>\n133: \t\t\t\t<div class=\"flex items-center gap-1\">\n134: \t\t\t\t\t<div class=\"bg-c-neutral-1 px-2 py-1 dark:bg-s-dark-2\">#</div>\n135: \t\t\t\t\t<span>Tag</span>\n136: \t\t\t\t</div>\n137: \t\t\t\t<div class=\"flex items-center gap-1\">\n138