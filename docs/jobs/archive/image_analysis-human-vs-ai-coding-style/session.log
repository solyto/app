0: \t\treturn LONG_BREAK_SECONDS;\n41: \t}\n42: \n43: \tfunction nextPhase(): Phase {\n44: \t\tif (phase === 'work') {\n45: \t\t\tconst completed = sessionsCompleted + 1;\n46: \t\t\tsessionsCompleted = completed;\n47: \t\t\tif (completed % SESSIONS_PER_CYCLE === 0) return 'longBreak';\n48: \t\t\treturn 'shortBreak';\n49: \t\t}\n50: \t\treturn 'work';\n51: \t}\n52: \n53: \tfunction advancePhase(): void {\n54: \t\tconst next = nextPhase();\n55: \t\tphase = next;\n56: \t\tsecondsRemaining = getDurationForPhase(next);\n57: \t\trunning = false;\n58: \t\tstopInterval();\n59: \t}\n60: \n61: \tfunction playBeep(): void {\n62: \t\ttry {\n63: \t\t\tconst ctx = new AudioContext();\n64: \t\t\tconst oscillator = ctx.createOscillator();\n65: \t\t\tconst gain = ctx.createGain();\n66: \t\t\toscillator.connect(gain);\n67: \t\t\tgain.connect(ctx.destination);\n68: \t\t\toscillator.frequency.value = 880;\n69: \t\t\toscillator.type = 'sine';\n70: \t\t\tgain.gain.value = 0.3;\n71: \t\t\toscillator.start();\n72: \t\t\toscillator.stop(ctx.currentTime + 0.2);\n73: \t\t} catch {\n74: \t\t\t// audio not available\n75: \t\t}\n76: \t}\n77: \n78: \tfunction tick(): void {\n79: \t\tif (secondsRemaining <= 1) {\n80: \t\t\tsecondsRemaining = 0;\n81: \t\t\tplayBeep();\n82: \t\t\tadvancePhase();\n83: \t\t\treturn;\n84: \t\t}\n85: \t\tsecondsRemaining--;\n86: \t}\n87: \n88: \tfunction startInterval(): void {\n89: \t\tif (interval) return;\n90: \t\tinterval = setInterval(tick, 1000);\n91: \t}\n92: \n93: \tfunction stopInterval(): void {\n94: \t\tif (interval) {\n95: \t\t\tclearInterval(interval);\n96: \t\t\tinterval = null;\n97: \t\t}\n98: \t}\n99: \n100: \tfunction toggleRunning(): void {\n101: \t\trunning = !running;\n102: \t\tif (running) {\n103: \t\t\tstarted = true;\n104: \t\t\tstartInterval();\n105: \t\t} else {\n106: \t\t\tstopInterval();\n107: \t\t}\n108: \t}\n109: \n110: \tfunction skip(): void {\n111: \t\tadvancePhase();\n112: \t}\n113: \n114: \tfunction reset(): void {\n115: \t\tstopInterva