projectId,\n\t\t\t\ttitle: project?.title ?? '',\n\t\t\t\tcolor: project?.color ?? FALLBACK_PROJECT_COLOR,\n\t\t\t\tminutes: entry.duration_minutes\n\t\t\t});\n\t\t}\n\n\t\treturn [...groups.values()].sort((a, b) => b.minutes - a.minutes);\n\t}\n}","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/lib/services/TimeTrackingGroupingService.ts","time":{"start":1791728799335,"end":1791728799368}},"id":"prt_12b5bcd9e0017zfL0Gze6sRWCK","sessionID":"ses_ed4a56c6fffevAGmwB1j5o7wcj","messageID":"msg_12b5bbdfa001KfY4xC3OIfhGWU"}}
