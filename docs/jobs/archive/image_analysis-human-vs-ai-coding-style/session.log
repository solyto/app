enceIgnored });\n275: \t\t}\n276: \n277: \t\treturn Promise.resolve({ ok: false, recurrenceIgnored: false });\n278: \t}\n279: \n280: \tasync delete(todo: Todo): Promise<boolean> {\n281: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.delete, todo.id);\n282: \t\tif (ok) await this.load();\n283: \t\treturn ok;\n284: \t}\n285: \n286: \tasync createCategory(title: string): Promise<TodoCategory | null> {\n287: \t\tconst request: CreateTodoCategoryRequest = { title };\n288: \t\tconst res = await this.apiService.create(apiRoutes.todos.createCategory, request);\n289: \t\tif (res) await this.loadCategories();\n290: \t\treturn res ? (res.data as TodoCategory) : null;\n291: \t}\n292: \n293: \tasync updateCategory(\n294: \t\tcategory: TodoCategory,\n295: \t\trequest: UpdateTodoCategoryRequest\n296: \t): Promise<boolean> {\n297: \t\tconst res = await this.apiService.update(\n298: \t\t\tapiRoutes.todos.updateCategory,\n299: \t\t\tcategory.id,\n300: \t\t\trequest\n301: \t\t);\n302: \t\tif (res) await Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n303: \t\treturn res;\n304: \t}\n305: \n306: \tasync deleteCategory(category: TodoCategory): Promise<boolean> {\n307: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteCategory, category.id);\n308: \t\tif (ok) await this.loadCategories();\n309: \t\treturn ok;\n310: \t}\n311: \n312: \tasync createWorkspace(title: string): Promise<boolean> {\n313: \t\tconst request: CreateTodoWorkspaceRequest = { title };\n314: \t\tconst res = await this.apiService.create(apiRoutes.todos.createWorkspace, request);\n315: \t\tif (res) await this.loadWorkspaces();\n316: \t\treturn Promise.resolve(res !== null);\n317: \t}\n318: \n319: \tasync deleteWorkspace(workspace: TodoWorkspace): Promise<boolean> {\n320: \t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteWorkspace, workspace.id);\n321: \t\tif (ok) await this.loadWorkspaces();\n322: \t\treturn ok;\n323: \t}\n324: \n325: \tasync attachCategoryToWorkspace(\n326: \t\tworkspace: TodoWorkspace,\n327: \t\tcategoryId: number\n328: \t): Promise<boolean> {\n329: \t\tconst res = await this.apiService.post(\n330: \t\t\tapiRoutes.todos.attachWorkspaceCategory.replace('%d', workspace.id.toString()),\n331: \t\t\t{ categories: [categoryId] }\n332: \t\t);\n333: \t\tif (res) await this.loadWorkspaces();\n334: \t\treturn Promise.resolve(res !== null);\n335: \t}\n336: \n337: \tasync detachCategoryFromWorkspace(\n338: \t\tworkspace: TodoWorkspace,\n339: \t\tcategoryId: number\n340: \t): Promise<boolean> {\n341: \t\tconst res = await this.apiService.post(\n342: \t\t\tapiRoutes.todos.detachWorkspaceCategory.replace('%d', workspace.id.toString()),\n343: \t\t\t{ categories: [categoryId] }\n344: \t\t);\n345: \t\tif (res) await this.loadWorkspaces();\n346: \t\treturn Promise.resolve(res !== null);\n347: \t}\n348: \n349: \tasync updateWorkspace(\n350: \t\tworkspace: TodoWorkspace,\n351: \t\trequest: UpdateTodoWorkspaceRequest\n352: \t): Promise<boolean> {\n353: \t\tconst res = await this.apiService.update(\n354: \t\t\tapiRoutes.todos.updateWorkspace,\n355: \t\t\tworkspace.id,\n356: \t\t\trequest\n357: \t\t);\n358: \t\tif (res) await this.loadWorkspaces();\n359: \t\treturn Promise.resolve(res !== null);\n360: \t}\n361: \n362: \tasync changePriority(todo: Todo, priority: TodoPriority): Promise<boolean> {\n363: \t\tconst request: UpdateTodoRequest = { priority };\n364: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n365: \t\tif (res) await this.load();\n366: \t\treturn res;\n367: \t}\n368: \n369: \tasync addTag(todo: Todo, tagId: number): Promise<boolean> {\n370: \t\tconst tagIds = todo.tags.map((t) => t.id);\n371: \t\tconst request: UpdateTodoRequest = {\n372: \t\t\ttags: tagIds.concat([tagId])\n373: \t\t};\n374: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n375: \t\tif (res) await this.load();\n376: \t\treturn res;\n377: \t}\n378: \n379: \tasync removeTag(todo: Todo, tag: Tag): Promise<boolean> {\n380: \t\tconst tagIds = todo.tags.map((t) => t.id);\n381: \t\tconst request: UpdateTodoRequest = {\n382: \t\t\ttags: tagIds.filter((id) => id != tag.id)\n383: \t\t};\n384: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n385: \t\tif (res) await this.load();\n386: \t\treturn res;\n387: \t}\n388: \n389: \tasync addCategory(todo: Todo, categoryId: number): Promise<boolean> {\n390: \t\tconst request: UpdateTodoRequest = { category_id: categoryId };\n391: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n392: \t\tif (res) await this.load();\n393: \t\treturn res;\n394: \t}\n395: \n396: \tasync removeCategory(todo: Todo): Promise<boolean> {\n397: \t\tconst request: UpdateTodoRequest = { category_id: null };\n398: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n399: \t\tif (res) await this.load();\n400: \t\treturn res;\n401: \t}\n402: \n403: \tasync changeCompleted(todo: Todo, checked: boolean): Promise<boolean> {\n404: \t\tconst request: UpdateTodoRequest = { is_completed: checked };\n405: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n406: \t\tif (res) await this.load();\n407: \t\treturn res;\n408: \t}\n409: \n410: \tasync changeEffort(todo: Todo, effort: TodoEffort): Promise<boolean> {\n411: \t\tconst request: UpdateTodoRequest = { effort };\n412: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n413: \t\tif (res) await this.load();\n414: \t\treturn res;\n415: \t}\n416: \n417: \tasync changeStatus(todoId: string, status: TodoStatus): Promise<boolean> {\n418: \t\tconst request: UpdateTodoRequest = { status };\n419: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todoId, request);\n420: \t\tif (res) await this.load();\n421: \t\treturn res;\n422: \t}\n423: \n424: \tasync changeProgress(todo: Todo, progress: number): Promise<boolean> {\n425: \t\tconst request: UpdateTodoRequest = { progress };\n426: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n427: \t\tif (res) await this.load();\n428: \t\treturn res;\n429: \t}\n430: \n431: \tasync changeDue(todo: Todo, due_at: string | null): Promise<boolean> {\n432: \t\tconst request: UpdateTodoRequest = { due_at };\n433: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n434: \t\tif (res) await this.load();\n435: \t\treturn res;\n436: \t}\n437: \n438: \tasync changeRecurrence(\n439: \t\ttodo: Todo,\n440: \t\tfrequency: TodoRecurrenceFrequency | null,\n441: \t\tinterval: number = 1,\n442: \t\tendsAt: string | null = null\n443: \t): Promise<boolean> {\n444: \t\tconst request: UpdateTodoRequest = {\n445: \t\t\trecurrence_frequency: frequency,\n446: \t\t\trecurrence_interval: interval,\n447: \t\t\trecurrence_ends_at: endsAt\n448: \t\t};\n449: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n450: \t\tif (res) await this.load();\n451: \t\treturn res;\n452: \t}\n453: \n454: \tasync changeTitle(todo: Todo, title: string): Promise<boolean> {\n455: \t\tconst request: UpdateTodoRequest = { title };\n456: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n457: \t\tif (res) await this.load();\n458: \t\treturn res;\n459: \t}\n460: \n461: \tasync changeDescription(todo: Todo, description: string): Promise<boolean> {\n462: \t\tconst request: UpdateTodoRequest = { description };\n463: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n464: \t\tif (res) await this.load();\n465: \t\treturn res;\n466: \t}\n467: \n468: \tasync changeLink(todo: Todo, link: string | null): Promise<boolean> {\n469: \t\tconst request: UpdateTodoRequest = { link };\n470: \t\tconst res = await this.apiService.update(apiRoutes.todos.update, todo.id, request);\n471: \t\tif (res) await this.load();\n472: \t\treturn res;\n473: \t}\n474: \n475: \tasync addSubtask(todo: Todo, title: string): Promise<boolean> {\n476: \t\tconst request: CreateTodoSubtaskRequest = { title };\n477: \t\tconst res = await this.apiService.post(\n478: \t\t\tapiRoutes.todos.addSubtask.replace('%s', todo.id),\n479: \t\t\trequest\n480: \t\t);\n481: \t\tif (res) await this.load();\n482: \t\treturn Promise.resolve(res !== null);\n483: \t}\n484: \n485: \tasync changeSubtaskTitle(todo: Todo, subtask: TodoSubtask, title: string): Promise<boolean> {\n486: \t\tconst request: UpdateTodoSubtaskRequest = { title };\n487: \t\tconst res = await this.apiService.put(\n488: \t\t\tapiRoutes.todos.markSubtask.replace('%s', todo.id).replace('%d', subtask.id.toString()),\n489: \t\t\trequest\n490: \t\t);\n491: \t\tif (res) await this.load();\n492: \t\treturn res;\n493: \t}\n494: \n495: \tasync markSubtask(todo: Todo, subtask: TodoSubtask, is_completed: boolean): Promise<boolean> {\n496: \t\tconst request: UpdateTodoSubtaskRequest = { is_completed };\n497: \t\tconst res = await this.apiService.put(\n498: \t\t\tapiRoutes.todos.markSubtask.replace('%s', todo.id).replace('%d', subtask.id.toString()),\n499: \t\t\trequest\n500: \t\t);\n501: \t\tif (res) await this.load();\n502: \t\treturn res;\n503: \t}\n504: \n505: \tasync deleteSubtask(todo: Todo, subtask: TodoSubtask): Promise<boolean> {\n506: \t\tconst res = await this.apiService.delete(\n507: \t\t\tapiRoutes.todos.deleteSubtask.replace('%d', subtask.id.toString()),\n508: \t\t\ttodo.id\n509: \t\t);\n510: \t\tif (res) await this.load();\n511: \t\treturn res;\n512: \t}\n513: }\n514: \n515: const TODOS_KEY = Symbol('SOLYTO_TODOS');\n516: \n517: export function setTodos(): Todos {\n518: \treturn setContext(TODOS_KEY, new Todos());\n519: }\n520: \n521: export function getTodos(): Todos {\n522: \treturn getContext<Todos>(TODOS_KEY);\n523: }\n\n(End of file - total 523 lines)\n</content>","metadata":{"preview":"import type {\n\tTodo,\n\tTodoCategory,\n\tTodoFilter,\n\tTodoPriority,\n\tCreateTodoRequest,\n\tTodoEffort,\n\tTodoRecurrenceFrequency,\n\tTodoStatus,\n\tGroupedTodos,\n\tTodoFilterType,\n\tTodoWorkspace,\n\tCreateTodoCategoryRequest,\n\tUpdateTodoCategoryRequest,\n\tCreateTodoWorkspaceRequest,\n\tUpdateTodoWorkspaceRequest,\n\tUpdateTodoRequest,\n\tCreateTodoSubtaskRequest,\n\tTodoSubtask,\n\tUpdateTodoSubtaskRequest","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Todos.svelte.ts","text":"import type {\n\tTodo,\n\tTodoCategory,\n\tTodoFilter,\n\tTodoPriority,\n\tCreateTodoRequest,\n\tTodoEffort,\n\tTodoRecurrenceFrequency,\n\tTodoStatus,\n\tGroupedTodos,\n\tTodoFilterType,\n\tTodoWorkspace,\n\tCreateTodoCategoryRequest,\n\tUpdateTodoCategoryRequest,\n\tCreateTodoWorkspaceRequest,\n\tUpdateTodoWorkspaceRequest,\n\tUpdateTodoRequest,\n\tCreateTodoSubtaskRequest,\n\tTodoSubtask,\n\tUpdateTodoSubtaskRequest\n} from '$lib/types/todo';\nimport type { Tag } from '$lib/types/tag';\nimport type { Auth } from '$lib/state/Auth.svelte';\nimport { setContext, getContext } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport { page } from '$app/state';\nimport TodoFilterService from '$lib/services/TodoFilterService';\nimport TodoGroupingService from '$lib/services/TodoGroupingService';\nimport TodoSortingService from '$lib/services/TodoSortingService';\nimport ApiService from '$lib/services/ApiService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport TodoRelevanceService from '$lib/services/TodoRelevanceService';\nimport LocalStorageService from '$lib/services/LocalStorageService';\nimport { SvelteDate } from 'svelte/reactivity';\n\nexport class Todos {\n\tstatic readonly LS_HIDE_IT_KEY: string = 'todos_hideit';\n\n\tloaded = $state<boolean>(false);\n\ttodos = $state<Todo[]>([]);\n\tfilteredTodos = $state<Todo[]>([]);\n\tgroupedTodos = $state<GroupedTodos[]>([]);\n\tcategories = $state<TodoCategory[]>([]);\n\tfilteredCategories = $state<TodoCategory[]>([]);\n\tworkspaces = $state<TodoWorkspace[]>([]);\n\tactiveWorkspace = $state<TodoWorkspace | null>(null);\n\tactiveFilters = $state<TodoFilter[]>([]);\n\tview = $state<'list' | 'kanban' | 'overview' | 'card'>('list');\n\tsortByScore = $state<boolean>(false);\n\ttodosScored = $state<boolean>(false);\n\thideItActive = $state<boolean>(false);\n\trecentlyCreated = $state<string | null>(null);\n\tquickCreateOpen = $state<boolean>(false);\n\tauth: Auth;\n\tapiService: ApiService;\n\tlocalStorage: LocalStorageService;\n\tfilterService = new TodoFilterService();\n\tsortingService = new TodoSortingService();\n\tgroupingService = new TodoGroupingService();\n\trelevanceService = new TodoRelevanceService();\n\n\tconstructor(\n\t\tauth: Auth = getAuth(),\n\t\tapiService: ApiService = auth.apiService,\n\t\tlocalStorage: LocalStorageService = new LocalStorageService()\n\t) {\n\t\tthis.auth = auth;\n\t\tthis.apiService = apiService;\n\t\tthis.localStorage = localStorage;\n\n\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n\t}\n\n\tasync load(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.todos.list);\n\n\t\tif (res) {\n\t\t\tthis.loaded = true;\n\t\t\tthis.todos = res.data as Todo[];\n\t\t\tthis.filteredTodos = this.todos;\n\t\t\tthis.checkUrlForFilter();\n\t\t}\n\n\t\tif (this.sortByScore) {\n\t\t\tthis.loadScores();\n\t\t} else {\n\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\t}\n\n\t\tthis.groupByStatus();\n\n\t\ttry {\n\t\t\tawait Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n\t\t} finally {\n\t\t\tthis.loadHideIt();\n\t\t}\n\t}\n\n\tasync loadCategories(): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.todos.listCategories);\n\n\t\tif (res) this.categories = res.data as TodoCategory[];\n\t\tthis.categories = this.sortingService.sortCategories(this.categories);\n\t\tthis.filteredCategories = this.categories;\n\t}\n\n\tasync loadWorkspaces(retries: number = 1): Promise<void> {\n\t\tconst res = await this.apiService.list(apiRoutes.todos.listWorkspaces).catch(() => null);\n\n\t\tif (res) {\n\t\t\tthis.workspaces = res.data as TodoWorkspace[];\n\t\t\treturn;\n\t\t}\n\n\t\tif (retries > 0) {\n\t\t\tawait this.loadWorkspaces(retries - 1);\n\t\t}\n\t}\n\n\tchangeView(view: 'list' | 'kanban' | 'overview' | 'card'): void {\n\t\tthis.view = view;\n\t}\n\n\ttoggleSortByScore(): void {\n\t\tif (!this.sortByScore) {\n\t\t\tthis.loadScores();\n\t\t} else {\n\t\t\tthis.useFilters(this.activeFilters);\n\t\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\t}\n\n\t\tthis.groupByStatus();\n\n\t\tthis.sortByScore = !this.sortByScore;\n\t}\n\n\tloadScores(): void {\n\t\tthis.todos = this.relevanceService.getScoredTodos(this.todos);\n\t\tthis.todosScored = true;\n\t\tthis.useFilters(this.activeFilters);\n\t\tthis.filteredTodos = this.sortingService.sortByScore(this.filteredTodos);\n\t}\n\n\tgroupByStatus(): void {\n\t\tthis.groupedTodos = this.groupingService.groupByStatus(this.filteredTodos);\n\t}\n\n\tcheckUrlForFilter(): void {\n\t\tconst type = page.url.searchParams.get('filterType'),\n\t\t\tvalue: string | number | null = page.url.searchParams.get('filterValue');\n\n\t\tif (type && value) {\n\t\t\tif (type !== 'workspace') {\n\t\t\t\tthis.addFilter({ type: type as TodoFilterType, value });\n\t\t\t}\n\t\t}\n\n\t\tthis.useFilters(this.activeFilters);\n\t}\n\n\tuseFilters(filters: TodoFilter[]): void {\n\t\tthis.activeFilters = filters;\n\t\tthis.filteredTodos = this.todos;\n\n\t\tconst visibilityThreshold = new SvelteDate();\n\t\tvisibilityThreshold.setDate(visibilityThreshold.getDate() + 3);\n\t\tthis.filteredTodos = this.filteredTodos.filter(\n\t\t\t(t) =>\n\t\t\t\t!t.auto_generated ||\n\t\t\t\tt.due_at === null ||\n\t\t\t\tnew SvelteDate(t.due_at) <= visibilityThreshold\n\t\t);\n\n\t\tif (!filters.some((f) => f.type === 'status' && f.value === 'backlog')) {\n\t\t\tthis.filteredTodos = this.filterService.filterOutBacklog(this.filteredTodos);\n\t\t}\n\n\t\tif (\n\t\t\tthis.hideItActive &&\n\t\t\tthis.activeWorkspace === null &&\n\t\t\t!this.isCategoryFilterActive() &&\n\t\t\t!this.isTagFilterActive()\n\t\t) {\n\t\t\tthis.filteredTodos = this.filterService.filterByHideIt(\n\t\t\t\tthis.filteredTodos,\n\t\t\t\tthis.workspaces\n\t\t\t);\n\t\t}\n\n\t\tfor (const filter of filters) {\n\t\t\tthis.filteredTodos = this.filterService.filter(filter, this.filteredTodos);\n\t\t}\n\n\t\tthis.filteredTodos = this.sortingService.sort(this.filteredTodos);\n\t\tthis.groupByStatus();\n\t}\n\n\tfilterCategories(): void {\n\t\tif (this.hideItActive) {\n\t\t\tthis.filteredCategories = this.filterService.filterCategoriesByHideIt(\n\t\t\t\tthis.categories,\n\t\t\t\tthis.workspaces\n\t\t\t);\n\t\t} else {\n\t\t\tthis.filteredCategories = this.categories;\n\t\t}\n\t}\n\n\taddFilter(filter: TodoFilter): void {\n\t\tthis.activeFilters.push(filter);\n\t}\n\n\tremoveFilter(filter: TodoFilter): void {\n\t\tthis.activeFilters = this.activeFilters.filter((f) => f !== filter);\n\t}\n\n\tclearFilters(): void {\n\t\tthis.activeFilters = [];\n\t}\n\n\tisFilterActive(filter: TodoFilter): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === filter.type && f.value === filter.value);\n\t}\n\n\tisCategoryFilterActive(): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === 'category');\n\t}\n\n\tisTagFilterActive(): boolean {\n\t\treturn this.activeFilters.some((f) => f.type === 'tag');\n\t}\n\n\ttoggleHideIt(): void {\n\t\tthis.hideItActive = !this.hideItActive;\n\t\tthis.useFilters(this.activeFilters);\n\t\tthis.filterCategories();\n\n\t\tthis.localStorage.setBool(Todos.LS_HIDE_IT_KEY, this.hideItActive);\n\t}\n\n\tloadHideIt(): void {\n\t\tthis.hideItActive = this.localStorage.getBool(Todos.LS_HIDE_IT_KEY) ?? false;\n\t\tif (this.hideItActive) {\n\t\t\tthis.filterCategories();\n\t\t\tthis.useFilters(this.activeFilters);\n\t\t}\n\t}\n\n\tasync quickCreate(input: string): Promise<{ ok: boolean; recurrenceIgnored: boolean }> {\n\t\tconst recurrenceIgnored = /repeat:/i.test(input) && !/due:/i.test(input);\n\n\t\tconst request: CreateTodoRequest = { title: input };\n\n\t\tif (this.activeFilters.some((f) => f.type === 'tag')) {\n\t\t\trequest.tags = [this.activeFilters.find((f) => f.type === 'tag')?.value as number];\n\t\t}\n\n\t\tif (this.activeFilters.some((f) => f.type === 'category')) {\n\t\t\trequest.category_id = this.activeFilters.find((f) => f.type === 'category')\n\t\t\t\t?.value as number;\n\t\t}\n\n\t\tconst res = await this.apiService.create(apiRoutes.todos.create, request);\n\n\t\tif (res) {\n\t\t\tconst todo = res.data as Todo;\n\t\t\tthis.recentlyCreated = todo.id;\n\t\t\tawait this.load();\n\n\t\t\tsetTimeout(() => {\n\t\t\t\tthis.recentlyCreated = null;\n\t\t\t}, 10000);\n\n\t\t\treturn Promise.resolve({ ok: true, recurrenceIgnored });\n\t\t}\n\n\t\treturn Promise.resolve({ ok: false, recurrenceIgnored: false });\n\t}\n\n\tasync delete(todo: Todo): Promise<boolean> {\n\t\tconst ok = await this.apiService.delete(apiRoutes.todos.delete, todo.id);\n\t\tif (ok) await this.load();\n\t\treturn ok;\n\t}\n\n\tasync createCategory(title: string): Promise<TodoCategory | null> {\n\t\tconst request: CreateTodoCategoryRequest = { title };\n\t\tconst res = await this.apiService.create(apiRoutes.todos.createCategory, request);\n\t\tif (res) await this.loadCategories();\n\t\treturn res ? (res.data as TodoCategory) : null;\n\t}\n\n\tasync updateCategory(\n\t\tcategory: TodoCategory,\n\t\trequest: UpdateTodoCategoryRequest\n\t): Promise<boolean> {\n\t\tconst res = await this.apiService.update(\n\t\t\tapiRoutes.todos.updateCategory,\n\t\t\tcategory.id,\n\t\t\trequest\n\t\t);\n\t\tif (res) await Promise.all([this.loadCategories(), this.loadWorkspaces()]);\n\t\treturn res;\n\t}\n\n\tasync deleteCategory(category: TodoCategory): Promise<boolean> {\n\t\tconst ok = await this.apiService.delete(apiRoutes.todos.deleteCategory, category.id);\n\t\tif (ok) await