projectId,\n\t\t\t\ttitle: project?.title ?? '',\n\t\t\t\tcolor: project?.color ?? FALLBACK_PROJECT_COLOR,\n\t\t\t\tminutes: entry.duration_minutes\n\t\t\t});\n\t\t}\n\n\t\treturn [...groups.values()].sort((a, b) => b.minutes - a.minutes);\n\t}\n}","lineStart":1,"lineEnd":46,"totalLines":46,"truncated":false}},"title":"src/lib/services/TimeTrackingGroupingService.ts","time":{"start":1791729167237,"end":1791729167407}},"id":"prt_12b616b44001gEDasQUqaOMbXd","sessionID":"ses_ed49ff389ffeIt68XBPiOrs69A","messageID":"msg_12b615b57001F3HXX6Pcv7EZ4x"}}
