CategoryIds = selectedCategoryIds.filter((c) => c !== id);\n34: \t\t} else {\n35: \t\t\tselectedCategoryIds = [...selectedCategoryIds, id];\n36: \t\t}\n37: \t\tawait loadStats();\n38: \t}\n39: \n40: \tlet filteredProjects = $derived(tt.statistics?.by_project ?? []);\n41: \n42: \tlet filteredTotal = $derived(filteredProjects.reduce((sum, p) => sum + p.total_minutes, 0));\n43: \n44: \tlet projectDonutData = $derived(\n45: \t\tfilteredProjects.map((p) => ({\n46: \t\t\tvalue: p.total_minutes,\n47: \t\t\tname: p.project_title,\n48: \t\t\tcolor: p.color\n49: \t\t}))\n50: \t);\n51: \n52: \tlet categoryBreakdown = $derived(() => {\n53: \t\tconst map = new Map<number, { title: string; minutes: number }>();\n54: \t\tfor (const stat of filteredProjects) {\n55: \t\t\tconst project = tt.projects.find((p) => p.id === stat.project_id);\n56: \t\t\tif (!project) continue;\n57: \t\t\tfor (const cat of project.categories) {\n58: \t\t\t\tconst existing = map.get(cat.id) ?? { title: cat.title, minutes: 0 };\n59: \t\t\t\texisting.minutes += stat.total_minutes;\n60: \t\t\t\tmap.set(cat.id, existing);\n61: \t\t\t}\n62: \t\t}\n63: \t\treturn [...map.values()].sort((a, b) => b.minutes - a.minutes);\n64: \t});\n65: \n66: \tlet categoryChartLabels = $derived(categoryBreakdown().map((c) => c.title));\n67: \tlet categoryChartValues = $derived(categoryBreakdown().map((c) => c.minutes));\n68: \n69: \tonMount(async () => {\n70: \t\tawait loadStats();\n71: \t});\n72: \n73: \tasync function loadStats(): Promise<void> {\n74: \t\tloadingIndicator.start();\n75: \t\tawait tt.loadStatistics(fromDate, toDate, selectedCategoryIds);\n76: \t\tloadingIndicator.stop();\n77: \t}\n78: </script>\n79: \n80: <div class=\"flex flex-col gap-6\">\n81: \t<div class=\"flex flex-col items-start justify-between gap-4 md:flex-row md:items-start\">\n82: \t\t<Heading title={ts.get.timeTracking.statistics} my={0} />\n83: \t\t<div class=\"flex flex-wrap items-end gap-4\">\n84: \t\t\t<label class=\"flex flex-col gap-1\">\n85: \t