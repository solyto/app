_category}\n246: \t\t\t\t\tclass=\"cursor-pointer rounded-full p-1.5 text-c-neutral-4 transition-colors hover:bg-c-neutral-1 hover:text-c-primary dark:hover:bg-s-dark-3\"\n247: \t\t\t\t\tonclick={async () => {\n248: \t\t\t\t\t\tstartAddCategory();\n249: \t\t\t\t\t\tawait tick();\n250: \t\t\t\t\t\taddCategoryInput?.focus();\n251: \t\t\t\t\t}}\n252: \t\t\t\t>\n253: \t\t\t\t\t<IconPlus class=\"size-4\" />\n254: \t\t\t\t</button>\n255: \t\t\t</div>\n256: \t\t\t{#if addingCategory}\n257: \t\t\t\t<div class=\"flex flex-row items-center space-x-2\">\n258: \t\t\t\t\t<TextInput\n259: \t\t\t\t\t\tbind:input={addCategoryInput}\n260: \t\t\t\t\t\tbind:value={newCategoryTitle}\n261: \t\t\t\t\t\tonblur={() => {\n262: \t\t\t\t\t\t\tkeyManager.unregisterAll(addKeyHandlers);\n263: \t\t\t\t\t\t\taddingCategory = false;\n264: \t\t\t\t\t\t\tnewCategoryTitle = '';\n265: \t\t\t\t\t\t}}\n266: \t\t\t\t\t\tplaceholder={ts.get.timeTracking.title}\n267: \t\t\t\t\t/>\n268: \t\t\t\t\t<SaveButton onClick={addCategory} />\n269: \t\t\t\t</div>\n270: \t\t\t{/if}\n271: \t\t\t{#each tt.categories as category (category.id)}\n272: \t\t\t\t<div class=\"flex flex-row items-center justify-between py-1\">\n273: \t\t\t\t\t<div class=\"flex flex-row items-center gap-2\">\n274: \t\t\t\t\t\t<div use:clickOutside={() => handleColorChange(category.id)}>\n275: \t\t\t\t\t\t\t<ColorPicker\n276: \t\t\t\t\t\t\t\thex={getCategoryHex(category.id, category.color)}\n277: \t\t\t\t\t\t\t\tonInput={(e) => { if (e.hex) setCategoryHex(category.id, e.hex); }}\n278: \t\t\t\t\t\t\t\tposition=\"responsive\"\n279: \t\t\t\t\t\t\t\tnullable={false}\n280: \t\t\t\t\t\t\t\tlabel={ts.get.timeTracking.color}\n281: \t\t\t\t\t\t\t\tisTextInput={false}\n282: \t\t\t\t\t\t\t\t--cp-border-color=\"var(--color-c-neutral-2)\"\n283: \t\t\t\t\t\t\t/>\n284: \t\t\t\t\t\t</div>\n285: \t\t\t\t\t\t{#if editingCategoryId === category.id}\n286: \t\t\t\t\t\t\t<input\n287: \t\t\t\t\t\t\t\ttype=\"text\"\n288: \t\t\t\t\t\t\t\tbind:this={editingInput}\n289: \t\