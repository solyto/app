gIndicator = getLoadingIndicator();\n29: \tconst keyManager = getKeyManager();\n30: \n31: \tlet activeTab = $derived.by(() => {\n32: \t\tconst tab = page.url.searchParams.get('tab');\n33: \t\tif (tab === 'entries' || tab === 'statistics') return tab;\n34: \t\treturn 'dashboard';\n35: \t});\n36: \n37: \tlet {\n38: \t\tonCreateProject,\n39: \t\tonEditProject,\n40: \t\tactiveProjectId = null\n41: \t} = $props<{\n42: \t\tonCreateProject: () => void;\n43: \t\tonEditProject: (id: string) => void;\n44: \t\tactiveProjectId?: string | null;\n45: \t}>();\n46: \n47: \tlet open = $state<boolean>(false);\n48: \tlet confirmDeleteProjectId = $state<string | null>(null);\n49: \tlet confirmDeleteCategoryId = $state<number | null>(null);\n50: \tlet addingCategory = $state<boolean>(false);\n51: \n52: \t// Concrete hex default for the colour picker swatch (the picker needs a\n53: \t// hex value); styling fallbacks use theme variables instead.\n54: \tconst DEFAULT_CATEGORY_COLOR = '#1dbda5';\n55: \tlet newCategoryTitle = $state<string>('');\n56: \tlet addCategoryInput = $state<HTMLInputElement | null>(null);\n57: \tlet editingCategoryId = $state<number | null>(null);\n58: \tlet editingCategoryTitle = $state<string>('');\n59: \tlet editingInput = $state<HTMLInputElement | null>(null);\n60: \tlet addKeyHandlers = $state<Record<string, string | null>>({ Enter: null, Escape: null });\n61: \tlet editKeyHandlers = $state<Record<string, string | null>>({ Enter: null, Escape: null });\n62: \tlet categoryColors = $state<Record<number, string>>({});\n63: \n64: \tfunction getCategoryHex(id: number, fallback: string | null): string {\n65: \t\treturn categoryColors[id] ?? fallback ?? DEFAULT_CATEGORY_COLOR;\n66: \t}\n67: \n68: \tfunction setCategoryHex(id: number, hex: string): void {\n69: \t\tcategoryColors[id] = hex;\n70: \t}\n71: \n72: \tfunction handleNavigation(): void {\n73: \t\topen = false;\n74: \t}\n75: \n76: \tasync function addCategory(): Promise<void> {\n77: \t\tif (!newCategoryTitle.trim()) return;\n78: \t\tkeyManager.unregisterAll(addKeyHandlers);\n79: \t\tloadingIndicator.start();\n80: \t\tawait tt.createCategory({ title: newCategoryTitle.trim() });\n81: \t\tnewCategoryTitle = '';\n82: \t\taddingCategory = false;\n83: \t\tloadingIndicator.stop();\n84: \t}\n85: \n86: \tfunction startAddCategory(): void {\n87: \t\tif (addingCategory) return;\n88: \t\taddingCategory = true;\n89: \t\taddKeyHandlers.Enter = keyManager.registerKeyDown('Enter', () => addCategory(), { priority: 2 });\n90: \t\taddKeyHandlers.Escape = keyManager.registerKeyDown('Escape', () => {\n91: \t\t\tkeyManager.unregisterAll(addKeyHandlers);\n92: \t\t\taddingCategory = false;\n93: \t\t\tnewCategoryTitle = '';\n94: \t\t});\n95: \t}\n96: \n97: \tasync function startEditCategory(id: number, title: string): Promise<void> {\n98: \t\tkeyManager.unregisterAll(editKeyHandlers);\n99: \t\teditingCategoryId = id;\n100: \t\teditingCategoryTitle = title;\n101: \t\teditKeyHandlers.Enter = keyManager.registerKeyDown('Enter', () => saveEditCategory(), { priority: 2 });\n102: \t\teditKeyHandlers.Escape = keyManager.registerKeyDown('Escape', () => cancelEditCategory());\n103: \t\tawait tick();\n104: \t\teditingInput?.focus();\n105: \t}\n106: \n107: \tasync function saveEditCategory(): Promise<void> {\n108: \t\tif (editingCategoryId === null || !editingCategoryTitle.trim()) return;\n109: \t\tkeyManager.unregisterAll(editKeyHandlers);\n110: \t\tloadingIndicator.start();\n111: \t\tawait tt.updateCategory(editingCategoryId, { title: editingCategoryTitle.trim() });\n112: \t\teditingCategoryId = null;\n113: \t\teditingCategoryTitle = '';\n114: \t\tloadingIndicator.stop();\n115: \t}\n116: \n117: \tfunction cancelEditCategory(): void {\n118: \t\tkeyManager.unregisterAll(editKeyHandlers);\n119: \t\teditingCategoryId = null;\n120: \t\teditingCategoryTitle = '';\n121: \t}\n122: \n123: \tasync function handleColorChange(id: number): Promise<void> {\n124: \t\tconst category = tt.categories.find((c) => c.id === id);\n125: \t\tconst newColor = categoryColors[id];\n126: \t\tif (!newColor || !category || newColor === (category.color ?? DEFAULT_CATEGORY_COLOR)) return;\n127: \t\tawait tt.updateCategory(id, { color: newColor });\n128: \t}\n129: \n130: \tonDestroy(() => {\n131: \t\tkeyManager.unregisterAll(addKeyHandlers);\n132: \t\tkeyManager.unregisterAll(editKeyHandlers);\n133: \t});\n134: </script>\n135: \n136: {#snippet sidebar()}\n137: \t<div class=\"flex items-center justify-between border-b border-c-neutral-2 p-4 mb-4 lg:hidden dark:border-s-dark-3\">\n138: \t\t<span class=\"text-2xl font-bold 2xl:font-normal\">\n139: \t\t\t{ts.get.timeTracking.time_tracking}\n140: \t\t</span>\n141: \t\t<CloseButton onClick={handleNavigation} inModal={false} />\n142: \t</div>\n143: \n144: \t<div class=\"p-4 lg:p-0\">\n145: \t\t<div class=\"flex flex-col gap-0.5\">\n146: \t\t\t<a\n147: \t\t\t\thref={resolve(urls.timeTracking)}\n148: \t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n149: \t\t\t\tclass:bg-c-neutral-1={!activeProjectId && activeTab === 'dashboard'}\n150: \t\t\t\tclass:dark:bg-s-dark-3={!activeProjectId && activeTab === 'dashboard'}\n151: \t\t\t\tonclick={handleNavigation}\n152: \t\t\t>\n153: \t\t\t\t<IconLayoutDashboard class=\"size-4\" />\n154: \t\t\t\t{ts.get.timeTracking.dashboard}\n155: \t\t\t</a>\n156: \t\t\t<a\n157: \t\t\t\thref=\"{resolve(urls.timeTracking)}?tab=entries\"\n158: \t\t\t\tclass=\"-mx-2 flex w-[calc(100%+1rem)] flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n159: \t\t\t\tclass:bg-c-neutral-1={!activeProjectId && activeTab === 'entries'}\n160: \t\t\t\tclass:dark:bg-s-dark-3={!activeProjectId && activeTab === 'entries'}\n161: \t\t\t\tonclick={handleNavigation}\n162: \t\t\t>\n163: \t\t\t\t<IconList class=\"size-4\" />\n164: \t\t\t\t{ts.get.timeTrack