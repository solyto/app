t<label class=\"flex flex-col gap-1\">\n\t\t\t\t<span class=\"text-xs font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n\t\t\t\t\t{ts.get.timeTracking.project}\n\t\t\t\t</span>\n\t\t\t\t<Select bind:value={timerProjectId} options={projectOptions} />\n\t\t\t</label>\n\t\t\t<label class=\"flex flex-col gap-1\">\n\t\t\t\t<span class=\"text-xs font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n\t\t\t\t\t{ts.get.timeTracking.description}\n\t\t\t\t</span>\n\t\t\t\t<TextInput bind:value={timerDescription} placeholder={ts.get.timeTracking.description} />\n\t\t\t</label>\n\t\t\t<TextButton\n\t\t\t\ttitle={ts.get.timeTracking.start_timer}\n\t\t\t\tonclick={startTimer}\n\t\t\t\tdisabled={!timerProjectId}\n\t\t\t/>\n\t\t</div>\n\t{:else}\n\t\t<p class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n\t\t\t{ts.get.timeTracking.no_projects}\n\t\t</p>\n\t{/if}\n</div>\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/src/lib/components/time-tracking/TimerWidget.svelte","exists":true,"truncated":false},"title":"src/lib/components/time-tracking/TimerWidget.svelte","time":{"start":1791627511742,"end":1791627511749}},"id":"prt_125524216001K1yOCnBZCWYNTU","sessionID":"ses_edab29d7fffe7q7IOFDa3tpcmo","messageID":"msg_12552328c00156g0ZKy38V6xRP"}}
