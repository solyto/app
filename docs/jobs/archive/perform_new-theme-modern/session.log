de flattening rule in base.css.           */\nhtml .gradient-down  { background: linear-gradient(to bottom, var(--t-gradient-colors)); }\nhtml .gradient-right { background: linear-gradient(to right, var(--t-gradient-colors)); }\n\n/* ── LOGO ─────────────────────────────────────────────────────────────────────\n   Shift S logo into the steel-blue nav.                                       */\n.logo {\n  filter: hue-rotate(168deg) saturate(1.5) brightness(1.2);\n}\n\n/* ── IE-ERA SCROLLBARS ────────────────────────────────────────────────────────\n   The iconic Windows XP silver scrollbar — beveled thumb, raised buttons.     */\n::-webkit-scrollbar        { width: 16px; height: 16px; }\n::-webkit-scrollbar-track  { background: #d4d0c8; border: 1px solid #aaaaaa; }\n::-webkit-scrollbar-thumb  {\n  background: #c0bdb5;\n  border: 2px solid;\n  border-color: #ede8e0 #908880 #908880 #ede8e0;\n}\n::-webkit-scrollbar-thumb:hover  { background: #aeaba3; }\n::-webkit-scrollbar-button {\n  background: #d4d0c8;\n  border: 2px solid;\n  border-color: #ede8e0 #908880 #908880 #ede8e0;\n  display: block;\n  height: 16px;\n}\n::-webkit-scrollbar-corner { background: #d4d0c8; }\n\n/* ── LINKS ────────────────────────────────────────────────────────────────────\n   Classic IE6 hyperlink colours. Underline always.                            */\na:not([class]), a[class=\"\"] {\n  color: #0033cc;\n  text-decoration: underline;\n}\na:not([class]):visited { color: #551a8b; }\na:not([class]):hover   { color: #cc0000; }\na:not([class]):active  { color: #cc0000; }\n\n/* ── TEXT SELECTION ──────────────────────────────────────────────────────────  */\n::selection { background: #336699; color: #ffffff; }\n","metadata":{"output":"  --color-gray-500: #888680;\n  --color-gray-600: #444240;\n  --color-gray-700: #1a1818;   /* default text — near-black, legible on any bg */\n  --color-gray-800: #0c0a0a;\n  --color-gray-900: #000000;\n\n  --color-d-lightblue:   #dde8f8;\n  --color-d-lighterblue: #eef