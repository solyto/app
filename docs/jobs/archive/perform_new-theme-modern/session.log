o hover/active fills (rgba over #f7f6f3) stay legible no matter\n+   the cascade order. */\n+.nav-desktop-container,\n+.nav-desktop {\n+\tbackground: #f7f6f3;\n+}\n+.nav-mobile-container,\n+.nav-mobile {\n+\tbackground: #f7f6f3;\n+}\n+\n+/* Mobile overflow popover — Notion-style menu: white, hairline border,\n+   whisper shadow, rounded corners kept. */\n+.nav-mobile-container .gradient-down {\n+\tbackground: #ffffff;\n+\tborder: 1px solid rgba(0, 0, 0, 0.1);\n+\tbox-shadow:\n+\t\t0 12px 28px -4px rgb(55 53 47 / 0.1),\n+\t\t0 4px 8px -4px rgb(55 53 47 / 0.06);\n+}\n+\n /* Subtle logo treatment — desaturate the colorful mark so it reads neutral */\n .logo {\n \tfilter: grayscale(0.7) brightness(1.05);\n }\n\\ No newline at end of file\n","additions":54,"deletions":0},"truncated":false},"title":"static/themes/modern/modern.css","time":{"start":1791727403252,"end":1791727403291}},"id":"prt_12b46506d0017bVWbzQEzAe0B2","sessionID":"ses_ed4c1117bffebZ7GXJEsWgJE6P","messageID":"msg_12b45ac1f001q4Wk96uq1p4Fa4"}}
