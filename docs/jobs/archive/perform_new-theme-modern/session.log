hover: #1a0040;\n\t--color-c-nav-active: #ff6600;\n\t--color-c-nav-active-text: #000000;\n\t--color-c-neutral: #1a0040;\n\t--color-c-border: #ff6600;\n\n\t/* Override s-dark palette for dark: prefixed classes */\n\t--color-s-dark: #000000;\n\t--color-s-dark-2: #0d0020;\n\t--color-s-dark-3: #1a0040;\n\t--color-s-dark-shadow: rgb(255, 102, 0);\n\n\t--color-white: #ffffff;\n\n\t--color-gray-50: #0a0010;\n\t--color-gray-100: #0d0020;\n\t--color-gray-200: #1a0040;\n\t--color-gray-300: #260060;\n\t--color-gray-400: #440080;\n\t--color-gray-500: #6600aa;\n\t--color-gray-600: #8800cc;\n\t--color-gray-700: #aa44dd;\n\t--color-gray-800: #cc88ee;\n\t--color-gray-900: #ffffff;\n\n\t--color-d-lightblue: #0d0020;\n\t--color-d-lighterblue: #0a0010;\n\n\t/* Nav gradient — deep black to dark purple */\n\t--t-gradient-colors: #000000, #0d0020;\n}\n\n/* Single mode — enforce dark regardless of light/dark toggle */\nhtml.dark {\n\t--color-c-bg: #000000;\n\t--color-c-bg-surface: #0d0020;\n\t--color-c-bg-elevated: #1a0040;\n\t--color-c-bg-modal: #0d0020;\n\t--color-c-nav-hover: #1a0040;\n\t--color-c-nav-active: #ff6600;\n\t--color-c-nav-active-text: #000000;\n\t--color-c-neutral: #1a0040;\n}\n\nhtml { font-size: 12px; }\n\n.logo { filter: grayscale(1) sepia(1) hue-rotate(0deg) saturate(8) brightness(1.2); }\n","metadata":{"output":"/* Terminal — always dark, phosphor green on black, monospace */\n\n:root {\n\t--t-font-body: 'Share Tech Mono', monospace;\n\t--t-font-heading: 'Share Tech Mono', monospace;\n\t--font-sans: 'Share Tech Mono', monospace;\n\n\t--color-c-primary: #00ff41;\n\t--color-c-heading: #00cc33;\n\t--color-c-heading-base: #00ff41;\n\t--color-c-btn: #003300;\n\t--color-c-btn-hover: #005500;\n\t--color-c-action: #00aaff;\n\t--color-c-action-hover: #33ccff;\n\t--color-c-danger: #ff0000;\n\t--color-c-danger-hover: #cc0000;\n\t--color-c-success: #00ff41;\n\t--color-c-warning: #ffff00;\n\n\t--color-c-bg: #0d0d0d;\n\t--color-c-bg-surface: #0a1a0a;\n\t--color-c-bg-elevated: #0f2a