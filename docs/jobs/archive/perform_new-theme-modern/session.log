--color-c-nav-hover: rgba(14, 14, 18, 0.7);\n53: \t--color-c-nav-active: rgba(14, 14, 18, 0.7);\n54: \t--color-c-nav-active-text: #eceff4;;\n55: \n56: \t/* Override s-dark palette for dark: prefixed classes */\n57: \t--color-s-dark: #0e0e12;\n58: \t--color-s-dark-2: #16161e;\n59: \t--color-s-dark-3: #1e1e28;\n60: \t--color-s-dark-shadow: rgb(180, 140, 60);\n61: \n62: \t/* White — keep near-white so text-white on buttons stays legible */\n63: \t--color-white: #e8e0d0;\n64: \n65: \t/* Gray scale — dark tones for backgrounds, lighter for text */\n66: \t--color-c-neutral: #1a1a24;\n67: \t--color-c-neutral-1: #22222e;\n68: \t--color-c-neutral-2: #32303c;\n69: \t--color-c-neutral-3: #44404e;\n70: \t--color-c-neutral-4: #6a6478;\n71: \t--color-c-neutral-5: #7a7488;\n72: \t--color-c-neutral-6: #9a9098;\n73: \t--color-c-neutral-7: #b8b0c0;\n74: \t--color-c-neutral-8: #ccc4d0;\n75: \t--color-c-neutral-9: #e0d8e8;\n76: \n77: \t/* Override light-blue utility colors used for borders and subtle backgrounds */\n78: \t--color-d-lightblue: transparent;\n79: \t--color-d-lighterblue: #1a1a24;\n80: \n81: \t--color-c-border: #888888;\n82: \n83: \t/* Nav — solid dark, no gradient */\n84: \t--t-gradient-colors: #0e0e12, #0e0e12;\n85: }\n86: \n87: /* Single mode — enforce dark backgrounds regardless of light/dark toggle */\n88: html.dark {\n89: \t--color-c-bg: #0e0e12;\n90: \t--color-c-bg-surface: #16161e;\n91: \t--color-c-bg-elevated: #1e1e28;\n92: \t--color-c-bg-modal: #16161e;\n93: }\n94: \n95: body {\n96: \tbackground-image: url('./wallpaper.jpg');\n97: \tbackground-size: cover;\n98: }\n99: \n100: .page-container {\n101: \tbackground: none;\n102: }\n103: \n104: .content-container {\n105: \tbackground-color: rgba(14, 14, 18, 0.9);\n106: }\n107: \n108: .nav-desktop-container {\n109: \tpadding: 0.5rem;\n110: \tbackground-color: rgba(14, 14, 18, 0.3);\n111: \tborder-right: 3px solid var(--color-c-border);\n112: }\n113: \n114: .nav-mobile-container {\n115: \tpadding: 0.5rem;\n116: \tbackground-color: rgba(14, 14, 18, 0.3);\n117: \tborder-top: 3px solid var(--color-c-border);\n118: }\n119: \n120: .nav-desktop {\n121: \tbackground: none !important;\n122: }\n123: \n124: .nav-mobile {\n125: \tbackground: none !important;\n126: }\n127: \n128: /* Secondary navigation overlays (mobile hamburger/funnel menus) — opaque so   */\n129: /* their entries stay readable over the wallpaper and the content behind them. */\n130: /* Desktop sidebars (lg: and up, sm: and up for contacts) keep the transparent */\n131: /* look, matching .nav-desktop-container. Breakpoints mirror Tailwind's        */\n132: /* lg (64rem) and sm (40rem).                                                  */\n133: @media (width < 64rem) {\n134: \t.secondary-nav-mobile-container {\n135: \t\tbackground-color: rgba(14, 14, 18, 0.9);\n136: \t}\n137: }\n138: \n139: @media (width < 40rem) {\n140: \t.secondary-nav-mobile-container-sm {\n141: \t\tbackground-color: rgba(14, 14, 18, 0.9);\n142: \t}\n143: }\n144: \n145: .logo {\n146: \tfilter: grayscale(0.7) sepia(0.5) brightness(0.85);\n147: }\n\n(End of file - total 147 lines)\n</content>","metadata":{"preview":"/* Skyrim theme — single mode (always dark)                                   */\n/* Dark cool gray palette, sharp corners, amber shadows, Cinzel font.         */\n/* Corner ornaments and textures are a future addition requiring SVG assets.  */\n\n:root {\n\t/* Fonts */\n\t--t-font-body: 'Cinzel', serif;\n\t--t-font-heading: 'Cinzel Decorative', serif;\n\t--font-sans: 'Cinzel', serif;\n\n\t/* Border radius — everything sharp */\n\t--radius-xs: 0px;\n\t--radius-sm: 0px;\n\t--radius-md: 0px;\n\t--radius-lg: 0px;\n\t--radius-xl: 0px;\n\t--radius-2xl: 0px;\n\t--radius-3xl: 0px;\n\t--radius-4xl: 0px;\n\t--radius-full: 0px;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/static/themes/skyrim/skyrim.css","text":"/* Skyrim theme — single mode (always dark)                                   */\n/* Dark cool gray palette, sharp corners, amber shadows, Cinzel font.         */\n/* Corner ornaments and textures are a future addition requiring SVG assets.  */\n\n:root {\n\t/* Fonts */\n\t--t-font-body: 'Cinzel', serif;\n\t--t-font-heading: 'Cinzel Decorative', serif;\n\t--font-sans: 'Cinzel', serif;\n\n\t/* Border radius — everything sharp */\n\t--radius-xs: 0px;\n\t--radius-sm: 0px;\n\t--radius-md: 0px;\n\t--radius-lg: 0px;\n\t--radius-xl: 0px;\n\t--radius-2xl: 0px;\n\t--radius-3xl: 0px;\n\t--radius-4xl: 0px;\n\t--radius-full: 0px;\n\n\t.rounded-full {\n\t\tborder-radius: 0;\n\t}\n\n\t/* Shadows — subtle amber glow */\n\t--shadow-xs: none;\n\t--shadow-sm: none;\n\t--shadow-md: none;\n\t--shadow-lg: none;\n\t--drop-shadow-sm: none;\n\t--drop-shadow-md: none;\n\n\t/* Semantic color tokens */\n\t--color-c-primary: #a09880;\n\t--color-c-heading: #d4cdb8;\n\t--color-c-heading-base: #e8e4dc;\n\t--color-c-btn: #2a2830;\n\t--color-c-btn-hover: #3e3a48;\n\t--color-c-action: #3a3240;\n\t--color-c-action-hover: #504860;\n\t--color-c-danger: #6b1a1a;\n\t--color-c-danger-hover: #8b2020;\n\t--color-c-success: #2a4a1a;\n\t--color-c-warning: #7a7060;\n\n\t/* Background tokens — dark cool grays */\n\t--color-c-bg: transparent;\n\t--color-c-bg-surface: transparent;\n\t--color-c-bg-elevated: transparent;\n\t--color-c-bg-modal: rgba(0, 0, 0, 0.7);\n\t--color-c-nav-hover: rgba(14, 14, 18, 0.7);\n\t--color-c-nav-active: rgba(14, 14, 18, 0.7);\n\t--color-c-nav-active-text: #eceff4;;\n\n\t/* Override s-dark palette for dark: prefixed classes */\n\t--color-s-dark: #0e0e12;\n\t--color-s-dark-2: #16161e;\n\t--color-s-dark-3: #1e1e28;\n\t--color-s-dark-shadow: rgb(180, 140, 60);\n\n\t/* White — keep near-white so text-white on buttons stays legible */\n\t--color-white: #e8e0d0;\n\n\t/* Gray scale — dark tones for backgrounds, lighter for text */\n\t--color-c-neutral: #1a1a24;\n\t--color-c-neutral-1: #22222e;\n\t--color-c-neutral-2: #32303c;\n\t--color-c-neutral-3: #44404e;\n\t--color-c-neutral-4: #6a6478;\n\t--color-c-neutral-5: #7a7488;\n\t--color-c-neutral-6: #9a9098;\n\t--color-c-neutral-7: #b8b0c0;\n\t--color-c-neutral-8: #ccc4d0;\n\t--color-c-neutral-9: #e0d8e8;\n\n\t/* Override light-blue utility colors used for borders and subtle backgrounds */\n\t--color-d-lightblue: transparent;\n\t--color-d-lighterblue: #1a1a24;\n\n\t--color-c-border: #888888;\n\n\t/* Nav — solid dark, no gradient */\n\t--t-gradient-colors: #0e0e12, #0e0e12;\n}\n\n/* Single mode — enforce dark backgrounds regardless of light/dark toggle */\nhtml.dark {\n\t--color-c-bg: #0e0e12;\n\t--color-c-bg-surface: #16161e;\n\t--color-c-bg-elevated: #1e1e28;\n\t--color-c-bg-modal: #16161e;\n}\n\nbody {\n\tbackground-image: url('./wallpaper.jpg');\n\tbackground-size: cover;\n}\n\n.page-container {\n\tbackground: none;\n}\n\n.content-container {\n\tbackground-color: rgba(14, 14, 18, 0.9);\n}\n\n.nav-desktop-container {\n\tpadding: 0.5rem;\n\tbackground-color: rgba(14, 14, 18, 0.3);\n\tborder-right: 3px solid var(--color-c-border);\n}\n\n.nav-mobile-container {\n\tpadding: 0.5rem;\n\tbackground-color: rgba(14, 14, 18, 0.3);\n\tborder-top: 3px solid var(--color-c-border);\n}\n\n.nav-desktop {\n\tbackground: none !important;\n}\n\n.nav-mobile {\n\tbackground: none !important;\n}\n\n/* Secondary navigation overlays (mobile hamburger/funnel menus) — opaque so   */\n/* their entries stay readable over the wallpaper and the content behind them. */\n/* Desktop sidebars (lg: and up, sm: and up for contacts) keep the transparent */\n/* look, matching .nav-desktop-container. Breakpoints mirror Tailwind's        */\n/* lg (64rem) and sm (40rem).                                                  */\n@media (width < 64rem) {\n\t.secondary-nav-mobile-container {\n\t\tbackground-color: rgba(14, 14, 18, 0.9);\n\t}\n}\n\n@media (width < 40rem) {\n\t.secondary-nav-mobile-container-sm {\n\t\tbackground-color: rgba(14, 14, 18, 0.9);\n\t}\n}\n\n.logo {\n\tfilter: grayscale(0.7) sepia(0.5) brightness(0.85);\n}","lineStart":1,"lineEnd":147,"tota