 #1a0040;\n45: \t--color-c-bg-modal: #0d0020;\n46: \t--color-c-nav-hover: #1a0040;\n47: \t--color-c-nav-active: #ff6600;\n48: \t--color-c-nav-active-text: #000000;\n49: \t--color-c-neutral: #1a0040;\n50: \t--color-c-border: #ff6600;\n51: \n52: \t/* Override s-dark palette for dark: prefixed classes */\n53: \t--color-s-dark: #000000;\n54: \t--color-s-dark-2: #0d0020;\n55: \t--color-s-dark-3: #1a0040;\n56: \t--color-s-dark-shadow: rgb(255, 102, 0);\n57: \n58: \t--color-white: #ffffff;\n59: \n60: \t--color-gray-50: #0a0010;\n61: \t--color-gray-100: #0d0020;\n62: \t--color-gray-200: #1a0040;\n63: \t--color-gray-300: #260060;\n64: \t--color-gray-400: #440080;\n65: \t--color-gray-500: #6600aa;\n66: \t--color-gray-600: #8800cc;\n67: \t--color-gray-700: #aa44dd;\n68: \t--color-gray-800: #cc88ee;\n69: \t--color-gray-900: #ffffff;\n70: \n71: \t--color-d-lightblue: #0d0020;\n72: \t--color-d-lighterblue: #0a0010;\n73: \n74: \t/* Nav gradient — deep black to dark purple */\n75: \t--t-gradient-colors: #000000, #0d0020;\n76: }\n77: \n78: /* Single mode — enforce dark regardless of light/dark toggle */\n79: html.dark {\n80: \t--color-c-bg: #000000;\n81: \t--color-c-bg-surface: #0d0020;\n82: \t--color-c-bg-elevated: #1a0040;\n83: \t--color-c-bg-modal: #0d0020;\n84: \t--color-c-nav-hover: #1a0040;\n85: \t--color-c-nav-active: #ff6600;\n86: \t--color-c-nav-active-text: #000000;\n87: \t--color-c-neutral: #1a0040;\n88: }\n89: \n90: html { font-size: 12px; }\n91: \n92: .logo { filter: grayscale(1) sepia(1) hue-rotate(0deg) saturate(8) brightness(1.2); }\n\n(End of file - total 92 lines)\n</content>","metadata":{"preview":"/* Atari — always dark, neon on black, pixel font, sharp corners */\n/* Inspired by the Atari 2600/800 era: pure black, blazing orange, cyan, magenta. */\n\n:root {\n\t--t-font-body: 'Press Start 2P', monospace;\n\t--t-font-heading: 'Press Start 2P', monospace;\n\t--font-sans: 'Press Start 2P', monospace;\n\n\t/* Border radius — everything sharp */\n\t--radius-xs: 0px;\n\t--radius-sm: 0px;\n\t--radius-md: 0px;\n\t--radius-lg: 0px;\n\t--radius-xl: 0px;\n\t--radius-2xl: 0px;\n\t--radius-3xl: 0px;\n\t--radius-4xl: 0px;\n\t--radius-full: 0px;\n\n\t/* Shadows — neon orange glow */","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/static/themes/atari/atari.css","text":"/* Atari — always dark, neon on black, pixel font, sharp corners */\n/* Inspired by the Atari 2600/800 era: pure black, blazing orange, cyan, magenta. */\n\n:root {\n\t--t-font-body: 'Press Start 2P', monospace;\n\t--t-font-heading: 'Press Start 2P', monospace;\n\t--font-sans: 'Press Start 2P', monospace;\n\n\t/* Border radius — everything sharp */\n\t--radius-xs: 0px;\n\t--radius-sm: 0px;\n\t--radius-md: 0px;\n\t--radius-lg: 0px;\n\t--radius-xl: 0px;\n\t--radius-2xl: 0px;\n\t--radius-3xl: 0px;\n\t--radius-4xl: 0px;\n\t--radius-full: 0px;\n\n\t/* Shadows — neon orange glow */\n\t--shadow-xs: 0 0 4px 0 rgb(255 102 0 / 0.4);\n\t--shadow-sm: 0 0 6px 0 rgb(255 102 0 / 0.4), 0 0 2px 0 rgb(255 102 0 / 0.2);\n\t--shadow-md: 0 0 12px 0 rgb(255 102 0 / 0.5), 0 0 4px 0 rgb(255 102 0 / 0.3);\n\t--shadow-lg: 0 0 20px 0 rgb(255 102 0 / 0.5), 0 0 8px 0 rgb(255 102 0 / 0.3);\n\t--drop-shadow-sm: 0 0 4px rgb(255 102 0 / 0.5);\n\t--drop-shadow-md: 0 0 8px rgb(255 102 0 / 0.5);\n\n\t/* Semantic color tokens */\n\t--color-c-primary: #ff6600;\n\t--color-c-heading: #ffcc00;\n\t--color-c-heading-base: #ffffff;\n\t--color-c-btn: #0055cc;\n\t--color-c-btn-hover: #0077ff;\n\t--color-c-action: #ff6600;\n\t--color-c-action-hover: #ffcc00;\n\t--color-c-danger: #ff0033;\n\t--color-c-danger-hover: #cc0022;\n\t--color-c-success: #00ff66;\n\t--color-c-warning: #ffcc00;\n\n\t/* Background tokens */\n\t--color-c-bg: #000000;\n\t--color-c-bg-surface: #0d0020;\n\t--color-c-bg-elevated: #1a0040;\n\t--color-c-bg-modal: #0d0020;\n\t--color-c-nav-hover: #1a0040;\n\t--color-c-nav-active: #ff6600;\n\t--color-c-nav-active-text: #000000;\n\t--color-c-neutral: #1a0040;\n\t--color-c-border: #ff6600;\n\n\t/* Override s-dark palette for dark: prefixed classes */\n\t--color-s-dark: #000000;\n\t--color-s-dark-2: #0d0020;\n\t--color-s-dark-3: #1a0040;\n\t--color-s-dark-shadow: rgb(255, 102, 0);\n\n\t--color-white: #ffffff;\n\n\t--color-gray-50: #0a0010;\n\t--color-gray-100: #0d0020;\n\t--color-gray-200: #1a0040;\n\t--color-gray-300: #260060;\n\t--color-gray-400: #440080;\n\t--color-gray-500: #6600aa;\n\t--color-gray-600: #8800cc;\n\t--color-gray-700: #aa44dd;\n\t--color-gray-800: #cc88ee;\n\t--color-gray-900: #ffffff;\n\n\t--color-d-lightblue: #0d0020;\n\t--color-d-lighterblue: #0a0010;\n\n\t/* Nav gradient — deep black to dark purple */\n\t--t-gradient-colors: #000000, #0d0020;\n}\n\n/* Single mode — enforce dark regardless of light/dark toggle */\nhtml.dark {\n\t--color-c-bg: #000000;\n\t--color-c-bg-surface: #0d0020;\n\t--color-c-bg-elevated: #1a0040;\n\t--color-c-bg-modal: #0d0020;\n\t--color-c-nav-hover: #1a0040;\n\t--color-c-nav-active: #ff6600;\n\t--color-c-nav-active-text: #000000;\n\t--color-c-neutral: #1a0040;\n}\n\nhtml { font-size: 12px; }\n\n.logo { filter: grayscale(1) sepia(1) hue-rotate(0deg) saturate(8) brightness(1.2); }","lineStart":1,"lineEnd":92,"totalLines":92,"truncated":false}},"title":"static/themes/atari/atari.css","time":{"start":1791726875244,"end":1791726875312}},"id":"prt_12b3e7200001W84njXs1KCbgZP","sessionID":"ses_ed4c30da5ffeU1tsPBc0oh0Fvg","messageID":"msg_12b3e1fb1001JVSu3Rd6Chs4Xe"}}
