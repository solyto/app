{"type":"tool_use","timestamp":1791726811948,"sessionID":"ses_ed4c30da5ffeU1tsPBc0oh0Fvg","part":{"type":"tool","tool":"read","callID":"call_01_RTJN0Sqfo6mVbzbUOERI2060","state":{"status":"completed","input":{"filePath":"/workspace/tests/unit/stores/Theme.test.ts"},"output":"<path>/workspace/tests/unit/stores/Theme.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';\n2: import { ThemeState } from '$lib/state/Theme.svelte';\n3: import { themes } from '$lib/config/themes';\n4: import { storage, resetStoreMocks } from '../setup/storeMocks';\n5: \n6: // Theme manipulates document/window/Element, none of which exist in the node\n7: // environment of the stores project — build minimal stand-ins per test.\n8: function setupDom() {\n9: \tconst classList = {\n10: \t\ttoggle: vi.fn(),\n11: \t\tcontains: vi.fn(() => false),\n12: \t\tadd: vi.fn(),\n13: \t\tremove: vi.fn()\n14: \t};\n15: \tconst linkElement = { rel: '', href: '', remove: vi.fn() };\n16: \tconst mediaQuery = {\n17: \t\tmatches: false,\n18: \t\taddEventListener: vi.fn(),\n19: \t\tremoveEventListener: vi.fn()\n20: \t};\n21: \n22: \tvi.stubGlobal('document', {\n23: \t\tdocumentElement: { classList },\n24: \t\thead: { appendChild: vi.fn() },\n25: \t\tcreateElement: vi.fn(() => linkElement)\n26: \t});\n27: \tvi.stubGlobal('window', { matchMedia: vi.fn(() => mediaQuery) });\n28: \n29: \tconst animate = vi.fn();\n30: \t// Element must stay callable (code does `x instanceof Element`), so use a\n31: \t// real class and attach the animate spy to its prototype.\n32: \tclass FakeElement {}\n33: \t(FakeElement as { prototype: { animate?: unknown } }).prototype.animate = animate;\n34: \tvi.stubGlobal('Element', FakeElement as unknown as typeof Element);\n35: \n36: \treturn { classList, linkElement, mediaQuery, animate };\n37: }\n38: \n39: function resetAnimatePatched() {\n40: \t(ThemeState as unknown as { animatePatched: boolean }).animatePatched = false;\n41: }\n42: \n43: const nord = themes.find((t) => t.id === 'nord')!;\n44: const defaultTheme = themes[0];\n45: \n46: beforeEach(() => {\n47: \tresetStoreMocks();\n48: \tresetAnimatePatched();\n49: });\n50: \n51: afterEach(() => {\n52: \tvi.restoreAllMocks();\n53: \tvi.unstubAllGlobals();\n54: });\n55: \n56: describe('Theme store', () => {\n57: \tdescribe('load', () => {\n58: \t\tit('applies the saved theme and animation preference', () => {\n59: \t\t\tconst dom = setupDom();\n60: \t\t\tstorage.get.mockReturnValue('nord');\n61: \t\t\tstorage.getBool.mockReturnValue(false);\n62: \n63: \t\t\tconst s = new ThemeState();\n64: \t\t\ts.load();\n65: \n66: \t\t\texpect(s.theme.id).toBe('nord');\n67: \t\t\texpect(document.createElement).toHaveBeenCalledWith('link');\n68: \t\t\texpect(dom.linkElement.href).toBe('/themes/nord/nord.css');\n69: \t\t\texpect(document.head.appendChild).toHaveBeenCalledWith(dom.linkElement);\n70: \t\t\texpect(s.animations).toBe(false);\n71: \t\t\texpect(dom.classList.toggle).toHaveBeenCalledWith('no-animations', true);\n72: \t\t\texpect(dom.animate).not.toHaveBeenCalled();\n73: \t\t});\n74: \n75: \t\tit('falls back to the default theme for unknown ids', () => {\n76: \t\t\tsetupDom();\n77: \t\t\tstorage.get.mockReturnValue('bogus');\n78: \t\t\tstorage.getBool.mockReturnValue(true);\n79: \n80: \t\t\tconst s = new ThemeState();\n81: \t\t\ts.load();\n82: \n83: \t\t\texpect(s.theme).toBe(defaultTheme);\n84: \t\t\t// default theme is not loaded as a stylesheet\n85: \t\t\texpect(document.createElement).not.toHaveBeenCalled();\n86: \t\t});\n87: \n88: \t\tit('does not patch animate while animations are enabled', () => {\n89: \t\t\tconst dom = setupDom();\n90: \t\t\tstorage.get.mockReturnValue(null);\n91: \t\t\tstorage.getBool.mockReturnValue(true);\n92: \n93: \t\t\tconst s = new ThemeState();\n94: \t\t\ts.load();\n95: \n96: \t\t\texpect(dom.animate).not.toHaveBeenCalled();\n97: \t\t});\n98: \t});\n99: \n100: \tdescribe('setTheme', () => {\n101: \t\tit('persis