    */\n\n:root {\n\t/* Fonts — overrides the base html font-family per theme */\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t/* Shadows — deep polar night tint */\n\t--shadow-xs: 0 1px 2px 0 rgb(46 52 64 / 0.8);\n\t--shadow-sm: 0 1px 3px 0 rgb(46 52 64 / 0.7), 0 1px 2px -1px rgb(46 52 64 / 0.5);\n\t--shadow-md: 0 4px 6px -1px rgb(46 52 64 / 0.7), 0 2px 4px -2px rgb(46 52 64 / 0.5);\n\t--shadow-lg: 0 10px 15px -3px rgb(46 52 64 / 0.7), 0 4px 6px -4px rgb(46 52 64 / 0.5);\n\t--drop-shadow-sm: 0 1px 2px rgb(46 52 64 / 0.8);\n\t--drop-shadow-md: 0 3px 3px rgb(46 52 64 / 0.6);\n\n\t/* Semantic color tokens — Frost for UI, Aurora for states */\n\t--color-c-primary: #88c0d0;\n\t--color-c-heading: #81a1c1;\n\t--color-c-heading-base: #eceff4;\n\t--color-c-btn: #4c566a;\n\t--color-c-btn-hover: #5e81ac;\n\t--color-c-action: #d08770;\n\t--color-c-action-hover: #ebcb8b;\n\t--color-c-danger: #bf616a;\n\t--color-c-danger-hover: #b48ead;\n\t--color-c-success: #a3be8c;\n\t--color-c-warning: #ebcb8b;\n\n\t/* Background tokens — Polar Night */\n\t--color-c-bg: #2e3440;\n\t--color-c-bg-surface: #3b4252;\n\t--color-c-bg-elevated: #434c5e;\n\t--color-c-bg-modal: #3b4252;\n\t--color-c-nav-hover: #4c566a;\n\t--color-c-nav-active: #5e81ac;\n\t--color-c-nav-active-text: #eceff4;\n\n\t/* Override s-dark palette for dark: prefixed classes */\n\t--color-s-dark: #2e3440;\n\t--color-s-dark-2: #3b4252;\n\t--color-s-dark-3: #434c5e;\n\t--color-s-dark-shadow: rgb(46, 52, 64);\n\n\t/* White — Snow Storm (near-white, keeps text-white legible on buttons) */\n\t--color-white: #eceff4;\n\n\t/* Gray scale — cool blue-gray to match Polar Night / Snow Storm */\n\t--color-c-neutral: #323a49;\n\t--color-c-neutral-1: #4c566a;\n\t--color-c-neutral-2: #434c5e;\n\t--color-c-neutral-3: #4c566a;\n\t--color-c-neutral-4: #616e88;\n\t--color-c-neutral-5: #7b88a1;\n\t--color-c-neutral-6: #9aa5b8;\n\t--color-c-neutral-7: #b8c5d6;\n\t--color-c-neutral-8: #d8dee9;\n\t--color-c-neutral-9: #eceff4;\n\n\t/* Override light-blue utility colors used in borders and subtle backgrounds */\n\t--color-d-lightblue: #3b4252;\n\t--color-d-lighterblue: #323a49;\n\n\t/* Nav gradient — subtle Polar Night depth */\n\t--t-gradient-colors: #3b4252, #434c5e;\n}\n\n/* Single mode — enforce dark backgrounds regardless of light/dark toggle */\nhtml.dark {\n\t--color-c-bg: #2e3440;\n\t--color-c-bg-surface: #3b4252;\n\t--color-c-bg-elevated: #434c5e;\n\t--color-c-bg-modal: #3b4252;\n\t--color-c-nav-hover: #4c566a;\n\t--color-c-nav-active: #5e81ac;\n\t--color-c-nav-active-text: #eceff4;\n\t--color-c-neutral: #4c566a;\n}\n===TESTS===\nimport { describe, it, expect } from 'vitest';\nimport { themes } from '$lib/config/themes';\n\ndescribe('themes', () => {\n\tit('exposes a non-empty list of themes', () => {\n\t\texpect(themes.length).toBeGreaterThan(0);\n\t});\n\n\tit('defaults to the default theme first', () => {\n\t\texpect(themes[0].id).toBe('default');\n\t\texpect(themes[0].name).toBe('Default');\n\t\texpect(themes[0].supportsDarkMode).toBe(true);\n\t});\n\n\tit('has unique ids', () => {\n\t\tconst ids = themes.map((t) => t.id);\n\t\texpect(new Set(ids).size).toBe(ids.length);\n\t});\n\n\tit('defines all required preview fields per theme', () => {\n\t\tfor (const theme of themes) {\n\t\t\texpect(typeof theme.previewBg).toBe('string');\n\t\t\texpect(typeof theme.previewSurface).toBe('string');\n\t\t\texpect(typeof theme.previewText).toBe('string');\n\t\t\texpect(typeof theme.previewAccent).toBe('string');\n\t\t\texpect(theme.previewBg).toMatch(/^#/);\n\t\t\texpect(theme.previewAccent).toMatch(/^#/);\n\t\t}\n\t});\n});\n","metadata":{"output":"/* Catppuccin Latte — always light, pastel accents */\n\n:root {\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t--color-c-primary: #8839ef;\n\t--color-c-heading: #7287fd;\n\t--color-c-heading-base: #4c4f69;\n\t--color-c-btn: #1e66f5;\n\t--color-c-btn-hover: #209fb5;\n\t--color-c-action: