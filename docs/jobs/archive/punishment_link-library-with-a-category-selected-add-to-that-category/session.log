{"type":"tool_use","timestamp":1791376209388,"sessionID":"ses_ee9a86284ffedma3YbQXzblH8I","part":{"type":"tool","tool":"read","callID":"call_00_tula5SgPZW0JBI7NHHj67346","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/LinkLibrary.svelte.ts"},"output":"<path>/workspace/src/lib/state/LinkLibrary.svelte.ts</path>\n<type>file</type>\n<content>\n1: import type {\n2: \tLink,\n3: \tCreateLinkRequest,\n4: \tUpdateLinkRequest,\n5: \tLinkCategory,\n6: \tCreateLinkCategoryRequest\n7: } from '$lib/types/library_link';\n8: import { getContext, setContext } from 'svelte';\n9: import { getAuth } from '$lib/state/Auth.svelte';\n10: import ApiService from '$lib/services/ApiService';\n11: import { apiRoutes } from '$lib/config/apiRoutes';\n12: import LibraryFilterService from '$lib/services/LibraryFilterService';\n13: import type { LibraryConfig } from '$lib/types/library';\n14: \n15: export class LinkLibrary {\n16: \tconfig: LibraryConfig = {\n17: \t\ttype: 'links',\n18: \t\thasCovers: false,\n19: \t\thasRatings: false,\n20: \t\thasViewSwitcher: false,\n21: \t\thasFilters: false,\n22: \t\thasGenres: false,\n23: \t\thasRecommender: false,\n24: \t\thasWishlist: false,\n25: \t\thasExternalLinks: false,\n26: \t\thasReleases: false,\n27: \t\thasShelf: false,\n28: \t\tentriesAreLinks: true\n29: \t};\n30: \tloaded = $state<boolean>(false);\n31: \tentries = $state<Link[]>([]);\n32: \tfilteredEntries = $state<Link[]>([]);\n33: \tcategories = $state<LinkCategory[]>([]);\n34: \tcategoriesCount = $state<{ id: number; count: number }[]>([]);\n35: \tactiveFilter = $state<null | number | 'favorite'>(null);\n36: \tsearchVisible = $state<boolean>(false);\n37: \tsearchTerm = $state<string>('');\n38: \tdraggedEntry = $state<Link | null>(null);\n39: \tdragTarget = $state<number | null>(null);\n40: \tauth = getAuth();\n41: \tview = 'list';\n42: \tcreateModalVisible = $state<boolean>(false);\n43: \tfilterService = new LibraryFilterService();\n44: \tapiService: ApiService;\n45: \n46: \tconstructor() {\n47: \t\tthis.apiService = new ApiService(this.auth.getToken());\n48: \t}\n49: \n50: \tasync load(): Promise<void> {\n51: \t\tconst res = await this.apiService.list(apiRoutes.libraries.links.list);\n52: \n53: \t\tif (res) {\n54: \t\t\tthis.entries = res.data as Link[];\n55: \t\t\tawait this.loadCategories();\n56: \t\t\tthis.reapplyFilter();\n57: \t\t\tthis.loaded = true;\n58: \t\t}\n59: \t}\n60: \n61: \tasync loadCategories(): Promise<void> {\n62: \t\tconst res = await this.apiService.list(apiRoutes.libraries.links.listCategories);\n63: \n64: \t\tif (res) {\n65: \t\t\tthis.categories = res.data as LinkCategory[];\n66: \n67: \t\t\tif (this.categoriesCount.length > 0) {\n68: \t\t\t\tthis.categoriesCount = [];\n69: \t\t\t}\n70: \n71: \t\t\tfor (const category of this.categories) {\n72: \t\t\t\tthis.categoriesCount.push({\n73: \t\t\t\t\tid: category.id,\n74: \t\t\t\t\tcount: this.entries.filter((link) => link.category?.id === category.id).length\n75: \t\t\t\t});\n76: \t\t\t}\n77: \t\t}\n78: \t}\n79: \n80: \tsearch(): void {\n81: \t\tthis.filteredEntries = this.filterService.search(this.entries, this.searchTerm, [\n82: \t\t\t'title',\n83: \t\t\t'url'\n84: \t\t]);\n85: \t}\n86: \n87: \tgetCategoryCount(categoryId?: number | null): number {\n88: \t\tif (categoryId === undefined) return this.entries.length;\n89: \t\tif (categoryId === null)\n90: \t\t\treturn this.entries.filter((link) => link.category === null).length;\n91: \n92: \t\treturn this.categoriesCount.find((category) => category.id === categoryId)?.count ?? 0;\n93: \t}\n94: \n95: \tgetFavoriteCount(): number {\n96: \t\treturn this.entries.filter((link) => link.is_favorite).length;\n97: \t}\n98: \n99: \topenCreateModal(): void {\n100: \t\tthis.createModalVisible = true;\n101: \t\tthis.searchVisible = false;\n102: \t}\n103: \n104: \tcloseCreateModal(): void {\n105: \t\tthis.createModalVisible = false;\n106: \t}\n107: \n108: \tfilterByCategory(categoryId: number | null): void {\n109: \t\tthis.activeFilter = categoryId;\n110: \n111: \t\tif (categoryId === null) {\n112: \t\t\tthis.filteredEntries = this.entries;\n113: \t\t} else if (categoryId === 0) {\n114: \t\t\tthis.filteredEntries = this.entries.filter((link) => link.category === null);\n115: \t\t} else {\n116: \t\t\tthis.filteredEntries = this.entries.filter((link) => link.category?.id === categoryId);\n117: \t\t}\n118: \t}\n119: \n120: \tfilterByFavorite(): void {\n121: \t\tthis.activeFilter = 'favorite';\n122: \t\tthis.filteredEntries = this.entries.filter((link) => link.is_favorite);\n123: \t}\n124: \n125: \treapplyFilter(): void {\n126: \t\tif (this.activeFilter === 'favorite') {\n127: \t\t\tthis.filterByFavorite();\n128: \t\t} else {\n129: \t\t\tthis.filterByCategory(this.activeFilter);\n130: \t\t}\n131: \t}\n132: \n133: \tasync dragToCategory(): Promise<void> {\n134: \t\tif (this.draggedEntry === null) return;\n135: \n136: \t\tconst request: UpdateLinkRequest = {\n137: \t\t\tcategory_id: this.dragTarget ? this.dragTarget : null\n138: \t\t};\n139: \t\tconst ok = await this.apiService.update(\n140: \t\t\tapiRoutes.libraries.links.update,\n141: \t\t\tthis.draggedEntry.id,\n142: \t\t\trequest\n143: \t\t);\n144: \t\tif (ok) await this.load();\n145: \t\treturn Promise.resolve();\n146: \t}\n147: \n148: \tasync create(request: CreateLinkRequest): Promise<boolean> {\n149: \t\tconst res = await this.apiService.create(apiRoutes.libraries.links.create, request);\n150: \t\tif (res) await this.load();\n151: \t\treturn Promise.resolve(res !== null);\n152: \t}\n153: \n154: \tasync update(entry: Link, request: UpdateLinkRequest): Promise<boolean> {\n155: \t\tconst res = await this.apiService.update(\n156: \t\t\tapiRoutes.libraries.links.update,\n157: \t\t\tentry.id,\n158: \t\t\trequest\n159: \t\t);\n160: \t\tif (res) await this.load();\n161: \t\treturn Promise.resolve(res !== null);\n162: \t}\n163: \n164: \tasync delete(entry: Link): Promise<boolean> {\n165: \t\tconst res = await this.apiService.delete(apiRoutes.libraries.links.delete, entry.id);\n166: \t\tif (res) await this.load();\n167: \t\treturn Promise.resolve(res !== null);\n168: \t}\n169: \n170: \tasync deleteByLink(link: string): Promise<boolean> {\n171: \t\tconst entry = this.entries.find((entry) => entry.url === link);\n172: \t\tif (entry) return await this.delete(entry);\n173: \t\treturn Promise.resolve(false);\n174: \t}\n175: \n176: \tasync createCategory(title: string, color?: string): Promise<boolean> {\n177: \t\tconst res = await this.apiService.create(apiRoutes.libraries.links.createCategory, {\n178: \t\t\ttitle,\n179: \t\t\tcolor\n180: \t\t});\n181: \t\tif (res) await this.loadCategories();\n182: \t\treturn Promise.resolve(res !== null);\n183: \t}\n184: \n185: \tasync deleteCategory(category: LinkCategory): Promise<boolean> {\n186: \t\tconst res = await this.apiService.delete(\n187: \t\t\tapiRoutes.libraries.links.deleteCategory,\n188: \t\t\tcategory.id\n189: \t\t);\n190: \t\tif (res) await this.loadCategories();\n191: \t\treturn Promise.resolve(res !== null);\n192: \t}\n193: }\n194: \n195: const LINK_LIBRARY_KEY = Symbol('SOLYTO_LINK_LIBRARY');\n196: \n197: export function setLinkLibrary(): LinkLibrary {\n198: \treturn setContext(LINK_LIBRARY_KEY, new LinkLibrary());\n199: }\n200: \n201: export function getLinkLibrary(): LinkLibrary {\n202: \treturn getContext<LinkLibrary>(LINK_LIBRARY_KEY);\n203: }\n\n(End of file - total 203 lines)\n</content>","metadata":{"preview":"import type {\n\tLink,\n\tCreateLinkRequest,\n\tUpdateLinkRequest,\n\tLinkCategory,\n\tCreateLinkCategoryRequest\n} from '$lib/types/library_link';\nimport { getContext, setContext } from 'svelte';\nimport { getAuth } from '$lib/state/Auth.svelte';\nimport ApiService from '$lib/services/ApiService';\nimport { apiRoutes } from '$lib/config/apiRoutes';\nimport LibraryFilterService from '$lib/services/LibraryFilterService';\nimport type { LibraryConfig } from '$lib/types/library';\n\nexport class LinkLibrary {\n\tconfig: LibraryConfig = {\n\