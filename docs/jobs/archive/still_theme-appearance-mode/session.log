',\n\tadd_category: 'Ajouter une catégorie',\n\tworkspaces: 'Espaces de travail',\n\tworkspace_hide_it: 'Masquer',\n\tworkspace_hide_it_description: 'Disponible dans Masquer',","lineStart":208,"lineEnd":237,"totalLines":1229,"truncated":true}},"title":"src/lib/i18n/fr.ts","time":{"start":1791709119412,"end":1791709119461}},"id":"prt_12a2f831c001dUC2MpQchiF4Xc","sessionID":"ses_ed5d0c9e0ffeDCQju8ITYpRS1R","messageID":"msg_12a2f7a95001KQgDmg75RDRpFa"}}
