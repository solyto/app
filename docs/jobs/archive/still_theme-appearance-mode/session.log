ager = getKeyManager();\n\tconst ts = getTranslation();\n\tconst notifications = getUiNotifications();\n\tconst quickAdd = getQuickAdd();\n\tconst nav = getNavigation();\n\n\tconst canAccessRoute = $derived(auth.loggedIn || isAuthRoute() || isSetupRoute());\n\n\tlet innerHeight = $state<number>(0);\n\n\t// The onMount guard below only runs once. A session that expires while the app\n\t// stays open (resume check / 401 recovery) flips loggedIn to false mid-session;\n\t// react to that transition so the user is not left on a dead page.\n\tlet wasLoggedIn = false;\n\n\t$effect(() => {\n\t\tif (!browser) return;\n\n\t\tif (auth.loggedIn) {\n\t\t\twasLoggedIn = true;\n\t\t\treturn;\n\t\t}\n\n\t\tif (isAuthRoute() || isSetupRoute()) {\n\t\t\twasLoggedIn = false;\n\t\t\treturn;\n\t\t}\n\n\t\tif (!wasLoggedIn) return;\n\t\twasLoggedIn = false;\n\n\t\tnotifications.error(ts.get.auth.session_expired);\n\n\t\tif (featureConfig.firstStartupOptions) {\n\t\t\tgoto(resolve(urls.setup));\n\t\t} else {\n\t\t\tgoto(resolve(urls.login));\n\t\t}\n\t});\n\n\tonMount(async () => {\n\t\ttheme.load();\n\n\t\tif (!canAccessRoute) {\n\t\t\tif (featureConfig.firstStartupOptions) {\n\t\t\t\tawait goto(resolve(urls.setup));\n\t\t\t} else {\n\t\t\t\tawait goto(resolve(urls.login));\n\t\t\t}\n\t\t}\n\n\t\tconst updateHeight = () => { innerHeight = window.innerHeight; };\n\t\tupdateHeight();\n\t\twindow.addEventListener('resize', updateHeight);\n\n\t\tts.loadLanguage();\n\t});\n\n\tafterNavigate(() => {\n\t\tconst feature = getPageFeature();\n\t\tif (feature) nav.addUsage(feature);\n\t});\n</script>\n\n<svelte:head>\n\t<title>solyto</title>\n\t<link rel=\"icon\" href={favicon} />\n\t<link rel=\"manifest\" href=\"/site.webmanifest\" />\n</svelte:head>\n\n<div \n\tclass=\"flex w-screen flex-col overflow-hidden 2xl:flex-row bg-c-bg page-container\"\n\tclass:pt-6={IS_DESKTOP}\n\tstyle=\"height: {innerHeight}px;\"\n>\n\t{#if IS_DESKTOP}\n\t\t<TitleBar />\n\t{/if}\n\t<LoadingIndicator />\n\t<Notifications />\n\t{#if viewPoint.isDesktop && showNavbar() && (!browser || canAccessRoute)}\n\t\t<div class=\"z-[100] hidden h-full 2xl:block\">\n\t\t\t<DesktopNavbar />\n\t\t</div>\n\t{/if}\n\t<div class=\"min-h-0 w-full grow overflow-auto content-container\">\n\t\t{#if !browser || canAccessRoute}","lineStart":1,"lineEnd":140,"totalLines":171,"truncated":true}},"title":"src/routes/+layout.svelte","time":{"start":1791709370223,"end":1791709370258}},"id":"prt_12a33568e001IQL4x2DPSbQkNo","sessionID":"ses_ed5d0c9e0ffeDCQju8ITYpRS1R","messageID":"msg_12a334f920012iLfFP1vUAg4eU"}}
