{"type":"tool_use","timestamp":1791709131505,"sessionID":"ses_ed5d0c9e0ffeDCQju8ITYpRS1R","part":{"type":"tool","tool":"read","callID":"call_00_YhB4mZZ73bBIWLSfbLUy7379","state":{"status":"completed","input":{"filePath":"/workspace/src/lib/state/Translation.svelte.ts"},"output":"<path>/workspace/src/lib/state/Translation.svelte.ts</path>\n<type>file</type>\n<content>\n1: import { setContext, getContext } from 'svelte';\n2: import type { LanguageFile, Language } from '$lib/types/translation';\n3: import { en } from '$lib/i18n/en';\n4: import { de } from '$lib/i18n/de';\n5: import { fr } from '$lib/i18n/fr';\n6: import { es } from '$lib/i18n/es';\n7: import { browser } from '$app/environment';\n8: import { type Auth, getAuth } from '$lib/state/Auth.svelte';\n9: \n10: const SUPPORTED: Language[] = ['en', 'de', 'fr', 'es'];\n11: \n12: export class Translation {\n13: \tlocale = $state<string>('en');\n14: \tget = $state<LanguageFile>(en);\n15: \tauth: Auth = getAuth();\n16: \n17: \tloadLanguage(): void {\n18: \t\tconst stored = this.auth?.user?.settings?.language;\n19: \t\tif (stored) {\n20: \t\t\tif (this.locale !== stored) this.changeLanguage(stored as Language);\n21: \t\t\treturn;\n22: \t\t}\n23: \t\tif (browser) {\n24: \t\t\tconst code = (navigator.language || 'en').split('-')[0];\n25: \t\t\tconst lang: Language = SUPPORTED.includes(code as Language) ? (code as Language) : 'en';\n26: \t\t\tif (this.locale !== lang) this.changeLanguage(lang);\n27: \t\t}\n28: \t}\n29: \n30: \tchangeLanguage(locale: Language): void {\n31: \t\tswitch (locale) {\n32: \t\t\tcase 'en':\n33: \t\t\tdefault:\n34: \t\t\t\tthis.locale = 'en';\n35: \t\t\t\tthis.get = en;\n36: \t\t\t\tbreak;\n37: \t\t\tcase 'de':\n38: \t\t\t\tthis.locale = 'de';\n39: \t\t\t\tthis.get = de;\n40: \t\t\t\tbreak;\n41: \t\t\tcase 'fr':\n42: \t\t\t\tthis.locale = 'fr';\n43: \t\t\t\tthis.get = fr;\n44: \t\t\t\tbreak;\n45: \t\t\tcase 'es':\n46: \t\t\t\tthis.locale = 'es';\n47: \t\t\t\tthis.get = es;\n48: \t\t\t\tbreak;\n49: \t\t}\n50: \t}\n51: }\n52: \n53: const TRANSLATION_KEY = Symbol('SOLYTO_TRANSLATION');\n54: \n55: export function setTranslation(): Translation {\n56: \treturn setContext(TRANSLATION_KEY, new Translation());\n57: }\n58: \n59: export function getTranslation(): Translation {\n60: \treturn getContext<Translation>(TRANSLATION_KEY);\n61: }\n\n(End of file - total 61 lines)\n</content>","metadata":{"preview":"import { setContext, getContext } from 'svelte';\nimport type { LanguageFile, Language } from '$lib/types/translation';\nimport { en } from '$lib/i18n/en';\nimport { de } from '$lib/i18n/de';\nimport { fr } from '$lib/i18n/fr';\nimport { es } from '$lib/i18n/es';\nimport { browser } from '$app/environment';\nimport { type Auth, getAuth } from '$lib/state/Auth.svelte';\n\nconst SUPPORTED: Language[] = ['en', 'de', 'fr', 'es'];\n\nexport class Translation {\n\tlocale = $state<string>('en');\n\tget = $state<LanguageFile>(en);\n\tauth: Auth = getAuth();\n\n\tloadLanguage(): void {\n\t\tconst stored = this.auth?.user?.settings?.language;\n\t\tif (stored) {\n\t\t\tif (this.locale !== stored) this.changeLanguage(stored as Language);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/lib/state/Translation.svelte.ts","text":"import { setContext, getContext } from 'svelte';\nimport type { LanguageFile, Language } from '$lib/types/translation';\nimport { en } from '$lib/i18n/en';\nimport { de } from '$lib/i18n/de';\nimport { fr } from '$lib/i18n/fr';\nimport { es } from '$lib/i18n/es';\nimport { browser } from '$app/environment';\nimport { type Auth, getAuth } from '$lib/state/Auth.svelte';\n\nconst SUPPORTED: Language[] = ['en', 'de', 'fr', 'es'];\n\nexport class Translation {\n\tlocale = $state<string>('en');\n\tget = $state<LanguageFile>(en);\n\tauth: Auth = getAuth();\n\n\tloadLanguage(): void {\n\t\tconst stored = this.auth?.user?.settings?.language;\n\t\tif (stored) {\n\t\t\tif (this.locale !== stored) this.changeLanguage(stored as Language);\n\t\t\treturn;\n\t\t}\n\t\tif (browser) {\n\t\t\tconst code = (navigator.language || 'en').split('-')[0];\n\t\t\tconst lang: Language = SUPPORTED.includes(code as Language) ? (code as Language) : 'en';\n\t\t\tif (this.locale !== lang) this.changeLanguage(lang);\n\t\t}\n\t}\n\n\tchangeLanguage(locale: Language): void {\n\t\tswitch (locale) {\n\t\t\tcase 'en':\n\t\t\tdefault:\n\t\t\t\tthis.locale = 'en';\n\t\t\t\tthis.get = en;\n\t\t\t\tbreak;\n\t\t\tcase 'de':\n\t\t\t\tthis.locale = 'de';\n\t\t\t\tthis.get = de;\n\t\t\t\tbreak;\n\t\t\tcase 'fr':\n\t\t\t\tthis.locale = 'fr';\n\t\t\t\tthis.get = fr;\n\t\t\t\tbreak;\n\t\t\tcase 'es':\n\t\t\t\tthis.locale = 'es';\n\t\t\t\tthis.get = es;\n\t\t\t\tbreak;\n\t\t}\n\t}\n}\n\nconst TRANSLATION_KEY = Symbol('SOLYTO_TRANSLATION');\n\nexport function setTranslation(): Translation {\n\treturn setContext(TRANSLATION_KEY, new Translation());\n}\n\nexport function getTranslation(): Translation {\n\treturn getContext<Translation>(TRANSLATION_KEY);\n}","lineStart":1,"lineEnd":61,"totalLines":61,"truncated":false}},"title":"src/lib/state/Translation.svelte.ts","time":{"start":1791709131446,"end":1791709131499}},"id":"prt_12a2fb2700012SKWiQf5XnKiyL","sessionID":"ses_ed5d0c9e0ffeDCQju8ITYpRS1R","messageID":"msg_12a2f8c9c001S06FAHszpTHxPC"}}
