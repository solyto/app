t-sans etc.)              */\n/* plus these extras for textures and decorative elements.                    */\n\n:root {\n\t/* Fonts — overrides the base html font-family per theme */\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t/* Gradient colors — direction is defined per usage site */\n\t--t-gradient-colors: var(--color-s-lightblue), var(--color-s-green);\n}\n\n/* Dark mode — background levels flip to dark palette */\nhtml.dark {\n\t--color-c-bg: var(--color-s-dark);\n\t--color-c-bg-surface: var(--color-s-dark-2);\n\t--color-c-bg-elevated: var(--color-s-dark-3);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/src/styles/default.css","text":"/* Default theme — only defines what Tailwind cannot express natively.       */\n/* Colors, radius, shadows, fonts etc. are covered by tokens.css + Tailwind. */\n/* Other themes override Tailwind's own CSS variables directly                */\n/* (--radius-md, --color-s-teal, --shadow-sm, --font-sans etc.)              */\n/* plus these extras for textures and decorative elements.                    */\n\n:root {\n\t/* Fonts — overrides the base html font-family per theme */\n\t--t-font-body: 'Barlow', sans-serif;\n\t--t-font-heading: 'Barlow', sans-serif;\n\n\t/* Gradient colors — direction is defined per usage site */\n\t--t-gradient-colors: var(--color-s-lightblue), var(--color-s-green);\n}\n\n/* Dark mode — background levels flip to dark palette */\nhtml.dark {\n\t--color-c-bg: var(--color-s-dark);\n\t--color-c-bg-surface: var(--color-s-dark-2);\n\t--color-c-bg-elevated: var(--color-s-dark-3);\n\t--color-c-bg-modal: var(--color-s-dark-2);\n\t--color-c-nav-hover: var(--color-s-dark-2);\n\t--color-c-nav-active: var(--color-c-btn);\n\t--color-c-nav-active-text: var(--color-gray-200);\n\t--color-c-neutral: var(--color-s-dark-3);\n\t--color-c-border: var(--color-s-dark-3);\n}","lineStart":1,"lineEnd":27,"totalLines":27,"truncated":false}},"title":"src/styles