y-2 my-4 my-8 mb-2 mb-4 mb-8 mb-12 -->\n","metadata":{"output":"=== Select ===\n<script lang=\"ts\">\n\tlet {\n\t\tinput = $bindable(),\n\t\tvalue = $bindable(),\n\t\toptions,\n\t\tonchange\n\t} = $props<{\n\t\tinput?: HTMLSelectElement | null;\n\t\tvalue: string;\n\t\toptions: { label: string; value: string }[];\n\t\tonchange?: (value: string) => void;\n\t}>();\n</script>\n\n<select\n\tclass=\"h-10 w-full rounded-lg border-1 border-c-neutral-2 text-sm shadow-xs transition-all focus:ring-2 focus:ring-d-lightblue focus:outline-none dark:border-s-dark-3 dark:bg-inherit dark:text-white dark:focus:ring-c-primary\"\n\tbind:this={input}\n\tbind:value\n\tonchange={() => onchange?.(value)}\n>\n\t{#each options as option (option.value)}\n\t\t<option class=\"dark:bg-s-dark-3 dark:text-white\" value={option.value}>{option.label}</option\n\t\t>\n\t{/each}\n</select>\n=== urls context ===\n\tdevRequests: '/dev-requests',\n\tdevRequest: '/dev-requests/[id]',\n\tfinances: '/finances',\n\twealth: '/finances/wealth',\n\tbudget: '/finances/budget',\n\tfeeds: '/feeds',\n\ttimeTracking: '/time-tracking',\n\ttimeTrackingProject: '/time-tracking/[id]',\n\tcalendar: '/calendar',\n\tcontacts: '/contacts',\n\tclipboard: '/clipboard',\n=== Heading props ===\n<script lang=\"ts\">\n\tlet {\n\t\ttitle,\n\t\tmy,\n\t\tmt = 0,\n\t\tmb = 0,\n\t\tbold = false\n\t} = $props<{ title: string; my: number; mt?: number; mb?: number; bold?: boolean }>();\n</script>\n\n<div class=\"text-2xl md:text-3xl my-{my} mt-{mt} mb-{mb}\" class:font-bold={bold}>\n\t{title}\n</div>\n\n<!-- mt-4 mt-8 mt-12 my-2 my-4 my-8 mb-2 mb-4 mb-8 mb-12 -->\n","exit":0,"truncated":false},"title":"cd /workspace && echo \"=== Select ===\"; sed -n '1,60p' src/lib/components/forms/Select.svelte; echo \"=== urls context ===\"; sed -n '40,50p' src/lib/config/urls.ts; echo \"=== Heading props ===\"; sed -n '1,40p' src/lib/components/ui/Heading.svelte","time":{"start":1791623502741,"end":1791623502822}},"id":"prt_125151b12001L1DPCZmCaa8yFr