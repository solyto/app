ata as TimeTrackingCategory[];\n46: \t}\n47: \n48: \tasync loadProjects(): Promise<void> {\n49: \t\tconst res = await this.apiService.list(apiRoutes.timeTracking.projects.list);\n50: \t\tif (res) this.projects = res.data as TimeTrackingProject[];\n51: \t}\n52: \n53: \tasync loadEntries(): Promise<void> {\n54: \t\tconst res = await this.apiService.list(apiRoutes.timeTracking.entries.list);\n55: \t\tif (res) {\n56: \t\t\tthis.entries = res.data as TimeTrackingEntry[];\n57: \t\t\tthis.activeTimer = this.entries.find((e) => e.stopped_at === null) ?? null;\n58: \t\t}\n59: \t}\n60: \n61: \tasync createCategory(request: CreateTimeTrackingCategoryRequest): Promise<boolean> {\n62: \t\tconst res = await this.apiService.create(\n63: \t\t\tapiRoutes.timeTracking.categories.create,\n64: \t\t\trequest\n65: \t\t);\n66: \t\tif (res) await this.loadCategories();\n67: \t\treturn res !== null;\n68: \t}\n69: \n70: \tasync updateCategory(id: number, request: UpdateTimeTrackingCategoryRequest): Promise<boolean> {\n71: \t\tconst res = await this.apiService.update(\n72: \t\t\tapiRoutes.timeTracking.categories.update,\n73: \t\t\tid,\n74: \t\t\trequest\n75: \t\t);\n76: \t\tif (res) await Promise.all([this.loadCategories(), this.loadProjects()]);\n77: \t\treturn res;\n78: \t}\n79: \n80: \tasync deleteCategory(id: number): Promise<boolean> {\n81: \t\tconst res = await this.apiService.delete(apiRoutes.timeTracking.categories.delete, id);\n82: \t\tif (res) await Promise.all([this.loadCategories(), this.loadProjects()]);\n83: \t\treturn res;\n84: \t}\n85: \n86: \tasync createProject(request: CreateTimeTrackingProjectRequest): Promise<boolean> {\n87: \t\tconst res = await this.apiService.create(\n88: \t\t\tapiRoutes.timeTracking.projects.create,\n89: \t\t\trequest\n90: \t\t);\n91: \t\tif (res) await this.loadProjects();\n92: \t\treturn res !== null;\n93: \t}\n94: \n95: \tasync updateProject(id: string, request: UpdateTimeTrackingProjectRequest): Promise<boolean> {\n96: \t\tconst res = await this.a