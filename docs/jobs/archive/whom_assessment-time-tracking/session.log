ort IconPlus from '@lucide/svelte/icons/plus';\n     8\t\timport IconPen from '@lucide/svelte/icons/pen';\n     9\t\timport IconTrash from '@lucide/svelte/icons/trash-2';\n    10\t\timport ColorPicker from 'svelte-awesome-color-picker';\n    11\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n    12\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n    13\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n    14\t\timport { getKeyManager } from '$lib/KeyManager.svelte';\n    15\t\timport { onDestroy } from 'svelte';\n    16\t\timport { clickOutside } from '$lib/helpers/ClickHelper';\n    17\t\timport { urls } from '$lib/config/urls';\n    18\t\timport CloseButton from '$lib/components/ui/buttons/CloseButton.svelte';\n    19\t\timport TextInput from '$lib/components/forms/TextInput.svelte';\n    20\t\timport SaveButton from '$lib/components/ui/buttons/SaveButton.svelte';\n    21\t\timport HamburgerButton from '$lib/components/ui/buttons/HamburgerButton.svelte';\n    22\t\n    23\t\tconst tt = getTimeTracking();\n    24\t\tconst ts = getTranslation();\n    25\t\tconst loadingIndicator = getLoadingIndicator();\n    26\t\tconst keyManager = getKeyManager();\n    27\t\n    28\t\tlet {\n    29\t\t\tonCreateProject,\n    30\t\t\tonEditProject,\n    31\t\t\tactiveProjectId = null\n    32\t\t} = $props<{\n    33\t\t\tonCreateProject: () => void;\n    34\t\t\tonEditProject: (id: string) => void;\n    35\t\t\tactiveProjectId?: string | null;\n    36\t\t}>();\n    37\t\n    38\t\tlet projectDurations = $derived(\n    39\t\t\tObject.fromEntries(\n    40\t\t\t\ttt.projects.map((p) => [\n    41\t\t\t\t\tp.id,\n    42\t\t\t\t\ttt.entries\n    43\t\t\t\t\t\t.filter((e) => e.project?.id === p.id && e.stopped_at !== null)\n    44\t\t\t\t\t\t.reduce((sum, e) => sum + e.duration_minutes, 0)\n    45\t\t\t\t])\n    46\t\t\t)\n    47\t\t);\n    48\t\n    49\t\tlet navigation = $state<HTMLDivElement | null>(null);\n    50\t\t