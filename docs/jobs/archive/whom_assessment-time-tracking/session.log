"h-full rounded-lg bg-c-bg-surface p-4 shadow-sm\">\n    35\t\t{#if tt.activeTimer}\n    36\t\t\t<ActiveTimer />\n    37\t\t{:else if tt.projects.length > 0}\n    38\t\t\t<div class=\"flex flex-col gap-3\">\n    39\t\t\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">\n    40\t\t\t\t\t{ts.get.timeTracking.start_timer}\n    41\t\t\t\t</span>\n    42\t\t\t\t<Select bind:value={timerProjectId} options={projectOptions} />\n    43\t\t\t\t<input\n    44\t\t\t\t\ttype=\"text\"\n    45\t\t\t\t\tbind:value={timerDescription}\n    46\t\t\t\t\tplaceholder={ts.get.timeTracking.description}\n    47\t\t\t\t\tclass=\"w-full rounded-lg border-1 border-c-neutral-2 px-3 py-2 text-sm shadow-xs transition-all focus:ring-2 focus:ring-d-lightblue focus:outline-none dark:border-s-dark-3 dark:bg-inherit dark:text-white dark:focus:ring-c-primary\"\n    48\t\t\t\t/>\n    49\t\t\t\t<TextButton title={ts.get.timeTracking.start_timer} onclick={startTimer} />\n    50\t\t\t</div>\n    51\t\t{:else}\n    52\t\t\t<p class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n    53\t\t\t\t{ts.get.timeTracking.no_projects}\n    54\t\t\t</p>\n    55\t\t{/if}\n    56\t</div>\n========== ActiveTimer ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onMount, onDestroy } from 'svelte';\n     3\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     4\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     5\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     6\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n     7\t\n     8\t\tconst tt = getTimeTracking();\n     9\t\tconst ts = getTranslation();\n    10\t\tconst loadingIndicator = getLoadingIndicator();\n    11\t\n    12\t\tlet elapsed = $state<string>('00:00:00');\n    13\t\tlet interval: ReturnType<typeof setInterval> | null = null;\n    14\t\n    15\t\tfunction updateElapsed(): void {\n    16\t\t\tif (!tt.activeTimer) return;\n    17\t\t\tconst start = new Date(tt.activeTimer.started_at).getTime();\n    18\t\t\tconst now = Date.now();\n    19\t\t\tconst diff = Math.floor((now - start) / 1000);\n    20\t\t\tconst h = Math.floor(diff / 3600);\n    21\t\t\tconst m = Math.floor((diff % 3600) / 60);\n    22\t\t\tconst s = diff % 60;\n    23\t\t\telapsed = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;\n    24\t\t}\n    25\t\n    26\t\tonMount(() => {\n    27\t\t\tupdateElapsed();\n    28\t\t\tinterval = setInterval(updateElapsed, 1000);\n    29\t\t});\n    30\t\n    31\t\tonDestroy(() => {\n    32\t\t\tif (interval) clearInterval(interval);\n    33\t\t});\n    34\t\n    35\t\tasync function stopTimer(): Promise<void> {\n    36\t\t\tif (!tt.activeTimer) return;\n    37\t\t\tloadingIndicator.start();\n    38\t\t\tawait tt.stopTimer(tt.activeTimer.id);\n    39\t\t\tloadingIndicator.stop();\n    40\t\t}\n    41\t</script>\n    42\t\n    43\t{#if tt.activeTimer}\n    44\t\t<div class=\"flex flex-row items-center justify-between rounded-md border-l-4 border-c-primary bg-c-bg-surface p-4 shadow-sm\">\n    45\t\t\t<div class=\"flex flex-col gap-1\">\n    46\t\t\t\t<div class=\"flex flex-row items-center gap-2\">\n    47\t\t\t\t\t<div class=\"h-2 w-2 animate-pulse rounded-full bg-c-primary\"></div>\n    48\t\t\t\t\t<span class=\"text-sm font-medium text-c-primary\">\n    49\t\t\t\t\t\t{ts.get.timeTracking.timer_running}\n    50\t\t\t\t\t</span>\n    51\t\t\t\t</div>\n    52\t\t\t\t<span class=\"text-2xl font-bold tabular-nums\">{elapsed}</span>\n    53\t\t\t\t{#if tt.activeTimer.project}\n    54\t\t\t\t\t<span class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n    55\t\t\t\t\t\t{tt.activeTimer.project.title}\n    56\t\t\t\t\t</span>\n    57\t\t\t\t{/if}\n    58\t\t\t\t{#if tt.activeTimer.description}\n    59\t\t\t\t\t<span class=\"text-sm text-c-neutral-4 dark:text-c-neutral-5\">\n    60\t\t\t\t\t\t{tt.activeTimer.description}\n    61\t\t\t\t\t</span>\n    62\t\t\t\t{/if}\n    63\t\t\t</div>\n    64\t\t\t<TextButton title={ts.get.timeTracking.stop_timer} type=\"danger\" onclick={stopTimer} />\n    65\t\t</div>\n    66\t{/if}\n========== PomodoroWidget ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onDestroy } from 'svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\timport Play from '@lucide/svelte/icons/play';\n     5\t\timport Pause from '@lucide/svelte/icons/pause';\n     6\t\timport SkipForward from '@lucide/svelte/icons/skip-forward';\n     7\t\timport RotateCcw from '@lucide/svelte/icons/rotate-ccw';\n     8\t\n     9\t\tconst ts = getTranslation();\n    10\t\n    11\t\ttype Phase = 'work' | 'shortBreak' | 'longBreak';\n    12\t\n    13\t\tconst WORK_SECONDS = 25 * 60;\n    14\t\tconst SHORT_BREAK_SECONDS = 5 * 60;\n    15\t\tconst LONG_BREAK_SECONDS = 15 * 60;\n    16\t\tconst SESSIONS_PER_CYCLE = 4;\n    17\t\n    18\t\tlet phase = $state<Phase>('work');\n    19\t\tlet secondsRemaining = $state<number>(WORK_SECONDS);\n    20\t\tlet running = $state<boolean>(false);\n    21\t\tlet started = $state<boolean>(false);\n    22\t\tlet sessionsCompleted = $state<number>(0);\n    23\t\tlet interval: ReturnType<typeof setInterval> | null = null;\n    24\t\n    25\t\tlet phaseLabel = $derived({\n    26\t\t\twork: ts.get.timeTracking.work_session,\n    27\t\t\tshortBreak: ts.get.timeTracking.short_break,\n    28\t\t\tlongBreak: ts.get.timeTracking.long_break,\n    29\t\t}[phase]);\n    30\t\n    31\t\tlet accentColor = $derived(phase === 'work' ? 'teal' : 'amber');\n    32\t\n    33\t\tlet display = $derived(\n    34\t\t\t`${String(Math.floor(secondsRemaining / 60)).padStart(2, '0')}:${String(secondsRemaining % 60).padStart(2, '0')}`\n    35\t\t);\n    36\t\n    37\t\tfunction getDurationForPhase(p: Phase): number {\n    38\t\t\tif (p === 'work') return WORK_SECONDS;\n    39\t\t\tif (p === 'shortBreak') return SHORT_BREAK_SECONDS;\n    40\t\t\treturn LONG_BREAK_SECONDS;\n    41\t\t}\n    42\t\n    43\t\tfunction nextPhase(): Phase {\n    44\t\t\tif (phase === 'work') {\n    45\t\t\t\tconst completed = sessionsCompleted + 1;\n    46\t\t\t\tsessionsCompleted = completed;\n    47\t\t\t\tif (completed % SESSIONS_PER_CYCLE === 0) return 'longBreak';\n    48\t\t\t\treturn 'shortBreak';\n    49\t\t\t}\n    50\t\t\treturn 'work';\n    51\t\t}\n    52\t\n    53\t\tfunction advancePhase(): void {\n    54\t\t\tconst next = nextPhase();\n    55\t\t\tphase = next;\n    56\t\t\tsecondsRemaining = getDurationForPhase(next);\n    57\t\t\trunning = false;\n    58\t\t\tstopInterval();\n    59\t\t}\n    60\t\n    61\t\tfunction playBeep(): void {\n    62\t\t\ttry {\n    63\t\t\t\tconst ctx = new AudioContext();\n    64\t\t\t\tconst oscillator = ctx.createOscillator();\n    65\t\t\t\tconst gain = ctx.createGain();\n    66\t\t\t\toscillator.connect(gain);\n    67\t\t\t\tgain.connect(ctx.destination);\n    68\t\t\t\toscillator.frequency.value = 880;\n    69\t\t\t\toscillator.type = 'sine';\n    70\t\t\t\tgain.gain.value = 0.3;\n    71\t\t\t\toscillator.start();\n    72\t\t\t\toscillator.stop(ctx.currentTime + 0.2);\n    73\t\t\t} catch {\n    74\t\t\t\t// audio not available\n    75\t\t\t}\n    76\t\t}\n    77\t\n    78\t\tfunction tick(): void {\n    79\t\t\tif (secondsRemaining <= 1) {\n    80\t\t\t\tsecondsRemaining = 0;\n    81\t\t\t\tplayBeep();\n    82\t\t\t\tadvancePhase();\n    83\t\t\t\treturn;\n    84\t\t\t}\n    85\t\t\tsecondsRemaining--;\n    86\t\t}\n    87\t\n    88\t\tfunction startInterval(): void {\n    89\t\t\tif (interval) return;\n    90\t\t\tinterval = setInterval(tick, 1000);\n    91\t\t}\n    92\t\n    93\t\tfunction stopInterval(): void {\n    94\t\t\tif (interval) {\n    95\t\t\t\tclearInterval(interval);\n    96\t\t\t\tinterval = null;\n    97\t\t\t}\n    98\t\t}\n    99\t\n   100\t\tfunction toggleRunning(): void {\n   101\t\t\trunning = !running;\n   102\t\t\tif (running) {\n   103\t\t\t\tstarted = true;\n   104\t\t\t\tstartInterval();\n   105\t\t\t} else {\n   106\t\t\t\tstopInterval();\n   107\t\t\t}\n   108\t\t}\n   109\t\n   110\t\tfunction skip(): void {\n   111\t\t\tadvancePhase();\n   112\t\t}\n   113\t\n   114\t\tfunction reset(): void {\n   115\t\t\tstopInterval();\n   116\t\t\tphase = 'work';\n   117\t\t\tsecondsRemaining = WORK_SECONDS;\n   118\t\t\trunning = false;\n   119\t\t\tstarted = false;\n   120\t\t\tsessionsCompleted = 0;\n   121\t\t}\n   122\t\n   123\t\tonDestroy(() => {\n   124\t\t\tstopInterval();\n   125\t\t});\n   126\t</script>\n   127\t\n   128\t<div\n   129\t\tclass=\"flex h-full flex-col gap-3 rounded-lg bg-c-bg-surface p-4 shadow-sm\"\n   130\t>\n   131\t\t<div class=\"flex flex-row items-center justify-between\">\n   132\t\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">\n   133\t\t\t\t{ts.get.timeTracking.pomodoro}\n   134\t\t\t</span>\n   135\t\t\t<div class=\"flex flex-row items-center gap-2\">\n   136\t\t\t\t{#if started}\n   137\t\t\t\t\t{#if running}\n   138\t\t\t\t\t\t<div\n   139\t\t\t\t\t\t\tclass=\"h-2 w-2 animate-pulse rounded-full\"\n   140\t\t\t\t\t\t\tclass:bg-c-primary={accentColor === 'teal'}\n   141\t\t\t\t\t\t\tclass:bg-amber-500={accentColor === 'amber'}\n   142\t\t\t\t\t\t></div>\n   143\t\t\t\t\t{/if}\n   144\t\t\t\t\t<span\n   145\t\t\t\t\t\tclass=\"text-xs font-medium\"\n   146\t\t\t\t\t\tclass:text-c-primary={accentColor === 'teal'}\n   147\t\t\t\t\t\tclass:text-amber-500={accentColor === 'amber'}\n   148\t\t\t\t\t>\n   149\t\t\t\t\t\t{phaseLabel}\n   150\t\t\t\t\t</span>\n   151\t\t\t\t\t<button\n   152\t\t\t\t\t\tonclick={reset}\n   153\t\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 text-xs text-c-neutral-4 transition-all hover:text-c-neutral-6 dark:text-c-neutral-5 dark:hover:text-c-neutral-3\"\n   154\t\t\t\t\t>\n   155\t\t\t\t\t\t<RotateCcw size={13} />\n   156\t\t\t\t\t\t{ts.get.timeTracking.reset}\n   157\t\t\t\t\t</button>\n   158\t\t\t\t{/if}\n   159\t\t\t</div>\n   160\t\t</div>\n   161\t\n   162\t\t<div class=\"flex flex-col items-center gap-3 mt-4\">\n   163\t\t\t<span\n   164\t\t\t\tclass=\"text-4xl font-bold tabular-nums\"\n   165\t\t\t\tclass:text-c-primary={accentColor === 'teal'}\n   166\t\t\t\tclass:text-amber-500={accentColor === 'amber'}\n   167\t\t\t>\n   168\t\t\t\t{display}\n   169\t\t\t</span>\n   170\t\n   171\t\t\t<div class=\"flex flex-row items-center gap-1\">\n   172\t\t\t\t{#each Array(SESSIONS_PER_CYCLE) as _, i}\n   173\t\t\t\t\t<div\n   174\t\t\t\t\t\tclass=\"h-2.5 w-2.5 rounded-full\"\n   175\t\t\t\t\t\tclass:bg-c-primary={i < sessionsCompleted % SESSIONS_PER_CYCLE}\n   176\t\t\t\t\t\tclass:bg-c-neutral-2={i >= sessionsCompleted % SESSIONS_PER_CYCLE}\n   177\t\t\t\t\t></div>\n   178\t\t\t\t{/each}\n   179\t\t\t\t<span class=\"ml-1 text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n   180\t\t\t\t\t{sessionsCompleted} {ts.get.timeTracking.sessions_completed}\n   181\t\t\t\t</span>\n   182\t\t\t</div>\n   183\t\n   184\t\t\t<div class=\"flex flex-row items-center gap-2 mt-4\">\n   185\t\t\t\t<button\n   186\t\t\t\t\tonclick={toggleRunning}\n   187\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-white transition-all hover:shadow-xs\"\n   188\t\t\t\t\tclass:bg-c-primary={accentColor === 'teal'}\n   189\t\t\t\t\tclass:bg-amber-500={accentColor === 'amber'}\n   190\t\t\t\t>\n   191\t\t\t\t\t{#if running}\n   192\t\t\t\t\t\t<Pause size={14} />\n   193\t\t\t\t\t\t{ts.get.timeTracking.pause}\n   194\t\t\t\t\t{:else if secondsRemaining < getDurationForPhase(phase)}\n   195\t\t\t\t\t\t<Play size={14} />\n   196\t\t\t\t\t\t{ts.get.timeTracking.resume}\n   197\t\t\t\t\t{:else}\n   198\t\t\t\t\t\t<Play size={14} />\n   199\t\t\t\t\t\t{ts.get.timeTracking.start}\n   200\t\t\t\t\t{/if}\n   201\t\t\t\t</button>\n   202\t\t\t\t<button\n   203\t\t\t\t\tonclick={skip}\n   204\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 rounded-md bg-c-neutral-1 px-3 py-1.5 text-sm text-c-neutral-6 transition-all hover:bg-c-neutral-2 dark:bg-s-dark-3 dark:text-c-neutral-3 dark:hover:bg-s-dark\"\n   205\t\t\t\t>\n   206\t\t\t\t\t<SkipForward size={14} />\n   207\t\t\t\t\t{ts.get.timeTracking.skip}\n   208\t\t\t\t</button>\n   209\t\t\t</div>\n   210\t\t</div>\n   211\t</div>\n========== TimeBreakdownWidget ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\n     5\t\tinterface Breakdown {\n     6\t\t\ttitle: string;\n     7\t\t\tcolor: string;\n     8\t\t\tminutes: number;\n     9\t\t}\n    10\t\n    11\t\tlet { title, breakdown, total }: { title: string; breakdown: Breakdown[]; total: number } =\n    12\t\t\t$props();\n    13\t\n    14\t\tconst tt = getTimeTracking();\n    15\t\tconst ts = getTranslation();\n    16\t</script>\n    17\t\n    18\t<div class=\"flex flex-col gap-3 rounded-lg bg-c-bg-surface p-4 shadow-sm lg:col-span-1\">\n    19\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">{title}</span>\n    20\t\t<div class=\"flex flex-col gap-2.5\">\n    21\t\t\t<div class=\"flex flex-row items-center justify-between\">\n    22\t\t\t\t<span class=\"text-xs font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    23\t\t\t\t\t{ts.get.timeTracking.total_time}\n    24\t\t\t\t</span>\n    25\t\t\t\t<span class=\"text-xs font-medium tabular-nums text-c-primary\">\n    26\t\t\t\t\t{tt.formatDuration(total)}\n    27\t\t\t\t</span>\n    28\t\t\t</div>\n    29\t\t\t{#each breakdown as category (category.title)}\n    30\t\t\t\t<div class=\"flex flex-col gap-0.5\">\n    31\t\t\t\t\t<div class=\"flex flex-row items-center justify-between\">\n    32\t\t\t\t\t\t<div class=\"flex flex-row items-center gap-1.5\">\n    33\t\t\t\t\t\t\t<div class=\"h-2.5 w-2.5 shrink-0 rounded-full\" style=\"background-color: {category.color}\"></div>\n    34\t\t\t\t\t\t\t<span class=\"truncate text-xs\">{category.title}</span>\n    35\t\t\t\t\t\t</div>\n    36\t\t\t\t\t\t<span class=\"text-xs tabular-nums text-c-neutral-4 dark:text-c-neutral-5\">\n    37\t\t\t\t\t\t\t{tt.formatDuration(category.minutes)}\n    38\t\t\t\t\t\t</span>\n    39\t\t\t\t\t</div>\n    40\t\t\t\t\t<div class=\"h-1 w-full rounded-full bg-c-neutral-1 dark:bg-s-dark-3\">\n    41\t\t\t\t\t\t<div\n    42\t\t\t\t\t\t\tclass=\"h-1 rounded-full\"\n    43\t\t\t\t\t\t\tstyle=\"width: {total > 0 ? (category.minutes / total) * 100 : 0}%; background-color: {category.color}\"\n    44\t\t\t\t\t\t></div>\n    45\t\t\t\t\t</div>\n    46\t\t\t\t</div>\n    47\t\t\t{:else}\n    48\t\t\t\t<span class=\"text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n    49\t\t\t\t\t{ts.get.timeTracking.no_entries}\n    50\t\t\t\t</span>\n    51\t\t\t{/each}\n    52\t\t</div>\n    53\t</div>\n========== DashboardView ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\timport Entry from '$lib/components/time-tracking/Entry.svelte';\n     5\t\timport TimerWidget from '$lib/components/time-tracking/TimerWidget.svelte';\n     6\t\timport PomodoroWidget from '$lib/components/time-tracking/PomodoroWidget.svelte';\n     7\t\timport TimeBreakdownWidget from '$lib/components/time-tracking/TimeBreakdownWidget.svelte';\n     8\t\timport StatisticsView from '$lib/components/time-tracking/StatisticsView.svelte';\n     9\t\timport Heading from '$lib/components/ui/Heading.svelte';\n    10\t\n    11\t\tconst tt = getTimeTracking();\n    12\t\tconst ts = getTranslation();\n    13\t\n    14\t\tlet recentEntries = $derived(\n    15\t\t\ttt.entries\n    16\t\t\t\t.filter((e) => e.stopped_at !== null)\n    17\t\t\t\t.slice(0, 10)\n    18\t\t);\n    19\t\n    20\t\tinterface ProjectBreakdown {\n    21\t\t\ttitle: string;\n    22\t\t\tcolor: string;\n    23\t\t\tminutes: number;\n    24\t\t}\n    25\t\n    26\t\tfunction groupByProject(\n    27\t\t\tentries: { project: { id: string } | null; duration_minutes: number }[]\n    28\t\t): ProjectBreakdown[] {\n    29\t\t\tconst map = new Map<string, { color: string; minutes: number }>();\n    30\t\t\tfor (const e of entries) {\n    31\t\t\t\tconst project = e.project ? tt.projects.find((p) => p.id === e.project!.id) : null;\n    32\t\t\t\tconst key = project?.title ?? ts.get.timeTracking.uncategorized;\n    33\t\t\t\tconst color = project?.categories?.[0]?.color ?? '#9ca3af';\n    34\t\t\t\tconst existing = map.get(key) ?? { color, minutes: 0 };\n    35\t\t\t\texisting.minutes += e.duration_minutes;\n    36\t\t\t\tmap.set(key, existing);\n    37\t\t\t}\n    38\t\t\treturn [...map.entries()]\n    39\t\t\t\t.map(([title, { color, minutes }]) => ({ title, color, minutes }))\n    40\t\t\t\t.sort((a, b) => b.minutes - a.minutes);\n    41\t\t}\n    42\t\n    43\t\tlet weekBreakdown = $derived(() => {\n    44\t\t\tconst now = new Date();\n    45\t\t\tconst startOfWeek = new Date(now);\n    46\t\t\tstartOfWeek.setDate(now.getDate() - now.getDay() + (now.getDay() === 0 ? -6 : 1));\n    47\t\t\tstartOfWeek.setHours(0, 0, 0, 0);\n    48\t\t\tconst filtered = tt.entries.filter(\n    49\t\t\t\t(e) => e.stopped_at !== null && new Date(e.started_at) >= startOfWeek\n    50\t\t\t);\n    51\t\t\treturn groupByProject(filtered);\n    52\t\t});\n    53\t\n    54\t\tlet weekTotal = $derived(() => weekBreakdown().reduce((s, c) => s + c.minutes, 0));\n    55\t\n    56\t\tlet todayBreakdown = $derived(() => {\n    57\t\t\tconst now = new Date();\n    58\t\t\tconst startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n    59\t\t\tconst filtered = tt.entries.filter(\n    60\t\t\t\t(e) => e.stopped_at !== null && new Date(e.started_at) >= startOfToday\n    61\t\t\t);\n    62\t\t\treturn groupByProject(filtered);\n    63\t\t});\n    64\t\n    65\t\tlet todayTotal = $derived(() => todayBreakdown().reduce((s, c) => s + c.minutes, 0));\n    66\t</script>\n    67\t\n    68\t<div class=\"flex flex-col gap-8\">\n    69\t\t<div class=\"grid grid-cols-1 items-start gap-4 md:grid-cols-2 lg:grid-cols-4\">\n    70\t\t\t<div class=\"lg:col-span-1\">\n    71\t\t\t\t<TimerWidget />\n    72\t\t\t</div>\n    73\t\t\t<div class=\"lg:col-span-1\">\n    74\t\t\t\t<PomodoroWidget />\n    75\t\t\t</div>\n    76\t\t\t<TimeBreakdownWidget\n    77\t\t\t\ttitle={ts.get.timeTracking.today}\n    78\t\t\t\tbreakdown={todayBreakdown()}\n    79\t\t\t\ttotal={todayTotal()}\n    80\t\t\t/>\n    81\t\t\t<TimeBreakdownWidget\n    82\t\t\t\ttitle={ts.get.timeTracking.this_week}\n    83\t\t\t\tbreakdown={weekBreakdown()}\n    84\t\t\t\ttotal={weekTotal()}\n    85\t\t\t/>\n    86\t\t</div>\n    87\t\n    88\t\t{#if recentEntries.length > 0}\n    89\t\t\t<div class=\"flex flex-col gap-2\">\n    90\t\t\t\t<Heading title={ts.get.timeTracking.recent_entries} my={0} />\n    91\t\t\t\t{#each recentEntries as entry (entry.id)}\n    92\t\t\t\t\t<Entry {entry} showProject showDate />\n    93\t\t\t\t{/each}\n    94\t\t\t</div>\n    95\t\t{/if}\n    96\t\n    97\t\t<StatisticsView />\n    98\t</div>\n========== StatisticsView ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onMount } from 'svelte';\n     3\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     4\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     5\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     6\t\timport DoughnutChart from '$lib/components/charts/DoughnutChart.svelte';\n     7\t\timport BarChart from '$lib/components/charts/BarChart.svelte';\n     8\t\timport Heading from '$lib/components/ui/Heading.svelte';\n     9\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n    10\t\n    11\t\tconst tt = getTimeTracking();\n    12\t\tconst ts = getTranslation();\n    13\t\tconst loadingIndicator = getLoadingIndicator();\n    14\t\n    15\t\tconst today = new Date();\n    16\t\tconst thirtyDaysAgo = new Date(today.getTime() - 30 * 24 * 60 * 60 * 1000);\n    17\t\n    18\t\tlet fromDate = $state<string>(thirtyDaysAgo.toISOString().split('T')[0]);\n    19\t\tlet toDate = $state<string>(today.toISOString().split('T')[0]);\n    20\t\tlet selectedCategoryIds = $state<number[]>([]);\n    21\t\n    22\t\tfunction toggleCategory(id: number): void {\n    23\t\t\tif (selectedCategoryIds.includes(id)) {\n    24\t\t\t\tselectedCategoryIds = selectedCategoryIds.filter((c) => c !== id);\n    25\t\t\t} else {\n    26\t\t\t\tselectedCategoryIds = [...selectedCategoryIds, id];\n    27\t\t\t}\n    28\t\t}\n    29\t\n    30\t\tlet filteredProjects = $derived(() => {\n    31\t\t\tconst all = tt.statistics?.by_project ?? [];\n    32\t\t\tif (selectedCategoryIds.length === 0) return all;\n    33\t\t\treturn all.filter((p) => {\n    34\t\t\t\tconst project = tt.projects.find((proj) => proj.id === p.project_id);\n    35\t\t\t\treturn project?.categories.some((c) => selectedCategoryIds.includes(c.id)) ?? false;\n    36\t\t\t});\n    37\t\t});\n    38\t\n    39\t\tlet filteredTotal = $derived(() =>\n    40\t\t\tfilteredProjects().reduce((sum, p) => sum + p.total_minutes, 0)\n    41\t\t);\n    42\t\n    43\t\tlet projectDonutData = $derived(\n    44\t\t\tfilteredProjects().map((p) => ({\n    45\t\t\t\tvalue: p.total_minutes,\n    46\t\t\t\tname: p.project_title,\n    47\t\t\t\tcolor: p.color\n    48\t\t\t}))\n    49\t\t);\n    50\t\n    51\t\tlet categoryBreakdown = $derived(() => {\n    52\t\t\tconst map = new Map<number, { title: string; minutes: number }>();\n    53\t\t\tfor (const stat of filteredProjects()) {\n    54\t\t\t\tconst project = tt.projects.find((p) => p.id === stat.project_id);\n    55\t\t\t\tif (!project) continue;\n    56\t\t\t\tfor (const cat of project.categories) {\n    57\t\t\t\t\tconst existing = map.get(cat.id) ?? { title: cat.title, minutes: 0 };\n    58\t\t\t\t\texisting.minutes += stat.total_minutes;\n    59\t\t\t\t\tmap.set(cat.id, existing);\n    60\t\t\t\t}\n    61\t\t\t}\n    62\t\t\treturn [...map.values()].sort((a, b) => b.minutes - a.minutes);\n    63\t\t});\n    64\t\n    65\t\tlet categoryChartLabels = $derived(categoryBreakdown().map((c) => c.title));\n    66\t\tlet categoryChartValues = $derived(\n    67\t\t\tcategoryBreakdown().map((c) => Math.round((c.minutes / 60) * 10) / 10)\n    68\t\t);\n    69\t\n    70\t\tonMount(async () => {\n    71\t\t\tawait loadStats();\n    72\t\t});\n    73\t\n    74\t\tasync function loadStats(): Promise<void> {\n    75\t\t\tloadingIndicator.start();\n    76\t\t\tawait tt.loadStatistics(fromDate, toDate);\n    77\t\t\tloadingIndicator.stop();\n    78\t\t}\n    79\t</script>\n    80\t\n    81\t<div class=\"flex flex-col gap-6\">\n    82\t\t<div class=\"flex flex-col items-start justify-between gap-4 md:flex-row md:items-center\">\n    83\t\t\t<Heading title={ts.get.timeTracking.statistics} my={0} />\n    84\t\t\t<div class=\"flex flex-wrap items-end gap-4\">\n    85\t\t\t\t<div class=\"flex flex-col gap-1\">\n    86\t\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    87\t\t\t\t\t\t{ts.get.timeTracking.from}\n    88\t\t\t\t\t</span>\n    89\t\t\t\t\t<input\n    90\t\t\t\t\t\ttype=\"date\"\n    91\t\t\t\t\t\tbind:value={fromDate}\n    92\t\t\t\t\t\tclass=\"rounded-lg border-1 border-c-neutral-2 px-3 py-2 text-sm shadow-xs dark:border-s-dark-3 dark:bg-inherit dark:text-white\"\n    93\t\t\t\t\t/>\n    94\t\t\t\t</div>\n    95\t\t\t\t<div class=\"flex flex-col gap-1\">\n    96\t\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    97\t\t\t\t\t\t{ts.get.timeTracking.to}\n    98\t\t\t\t\t</span>\n    99\t\t\t\t\t<input\n   100\t\t\t\t\t\ttype=\"date\"\n   101\t\t\t\t\t\tbind:value={toDate}\n   102\t\t\t\t\t\tclass=\"rounded-lg border-1 border-c-neutral-2 px-3 py-2 text-sm shadow-xs dark:border-s-dark-3 dark:bg-inherit dark:text-white\"\n   103\t\t\t\t\t/>\n   104\t\t\t\t</div>\n   105\t\t\t\t<TextButton title={ts.get.layout.apply} onclick={loadStats} />\n   106\t\t\t</div>\n   107\t\t</div>\n   108\t\n   109\t\t{#if tt.categories.length > 0}\n   110\t\t\t<div class=\"flex flex-col gap-2\">\n   111\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n   112\t\t\t\t\t{ts.get.timeTracking.filter_by_category}\n   113\t\t\t\t</span>\n   114\t\t\t\t<div class=\"flex flex-wrap gap-2\">\n   115\t\t\t\t\t<button\n   116\t\t\t\t\t\ttype=\"button\"\n   117\t\t\t\t\t\tonclick={() => (selectedCategoryIds = [])}\n   118\t\t\t\t\t\tclass=\"rounded-full border px-3 py-1 text-xs font-medium transition-colors\n   119\t\t\t\t\t\t\t{selectedCategoryIds.length === 0\n   120\t\t\t\t\t\t\t? 'border-c-primary bg-c-primary text-white'\n   121\t\t\t\t\t\t\t: 'border-c-neutral-2 text-c-neutral-5 hover:border-c-primary dark:border-s-dark dark:text-c-neutral-4'}\"\n   122\t\t\t\t\t>\n   123\t\t\t\t\t\t{ts.get.timeTracking.all_categories}\n   124\t\t\t\t\t</button>\n   125\t\t\t\t\t{#each tt.categories as category (category.id)}\n   126\t\t\t\t\t\t<button\n   127\t\t\t\t\t\t\ttype=\"button\"\n   128\t\t\t\t\t\t\tonclick={() => toggleCategory(category.id)}\n   129\t\t\t\t\t\t\tclass=\"flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-colors\n   130\t\t\t\t\t\t\t\t{selectedCategoryIds.includes(category.id)\n   131\t\t\t\t\t\t\t\t? 'border-transparent text-white'\n   132\t\t\t\t\t\t\t\t: 'border-c-neutral-2 text-c-neutral-5 hover:border-c-primary dark:border-s-dark dark:text-c-neutral-4'}\"\n   133\t\t\t\t\t\t\tstyle={selectedCategoryIds.includes(category.id)\n   134\t\t\t\t\t\t\t\t? `background-color: ${category.color ?? '#1dbda5'}; border-color: ${category.color ?? '#1dbda5'}`\n   135\t\t\t\t\t\t\t\t: ''}\n   136\t\t\t\t\t\t>\n   137\t\t\t\t\t\t\t<span\n   138\t\t\t\t\t\t\t\tclass=\"h-2 w-2 shrink-0 rounded-full\"\n   139\t\t\t\t\t\t\t\tstyle=\"background-color: {category.color ?? '#1dbda5'}\"\n   140\t\t\t\t\t\t\t></span>\n   141\t\t\t\t\t\t\t{category.title}\n   142\t\t\t\t\t\t</button>\n   143\t\t\t\t\t{/each}\n   144\t\t\t\t</div>\n   145\t\t\t</div>\n   146\t\t{/if}\n   147\t\n   148\t\t{#if tt.statistics}\n   149\t\t\t<div class=\"flex flex-row items-center gap-2\">\n   150\t\t\t\t<span class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n   151\t\t\t\t\t{ts.get.timeTracking.total_time}:\n   152\t\t\t\t</span>\n   153\t\t\t\t<span class=\"text-lg font-bold text-c-primary\">\n   154\t\t\t\t\t{tt.formatDuration(filteredTotal())}\n   155\t\t\t\t</span>\n   156\t\t\t</div>\n   157\t\n   158\t\t\t<div class=\"flex w-full flex-row gap-8 max-md:flex-col\">\n   159\t\t\t\t{#if projectDonutData.length > 0}\n   160\t\t\t\t\t<div class=\"w-full md:w-1/2\">\n   161\t\t\t\t\t\t<span class=\"text-lg font-medium\">{ts.get.timeTracking.projects}</span>\n   162\t\t\t\t\t\t<DoughnutChart\n   163\t\t\t\t\t\t\tvalues={projectDonutData}\n   164\t\t\t\t\t\t\tcenterFormatter={tt.formatDuration}\n   165\t\t\t\t\t\t\tvalueFormatter={tt.formatDuration}\n   166\t\t\t\t\t\t/>\n   167\t\t\t\t\t</div>\n   168\t\t\t\t{/if}\n   169\t\t\t\t{#if categoryChartLabels.length > 0}\n   170\t\t\t\t\t<div class=\"w-full md:w-1/2\">\n   171\t\t\t\t\t\t<span class=\"text-lg font-medium\">{ts.get.timeTracking.categories}</span>\n   172\t\t\t\t\t\t<BarChart\n   173\t\t\t\t\t\t\tcategories={categoryChartLabels}\n   174\t\t\t\t\t\t\tvalues={categoryChartValues}\n   175\t\t\t\t\t\t\tvalueFormatter={(v) => tt.formatDuration(Math.round(v * 60))}\n   176\t\t\t\t\t\t/>\n   177\t\t\t\t\t</div>\n   178\t\t\t\t{/if}\n   179\t\t\t</div>\n   180\t\t{/if}\n   181\t</div>\n","metadata":{"output":"========== TimerWidget ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     5\t\timport ActiveTimer from '$lib/components/time-tracking/ActiveTimer.svelte';\n     6\t\timport Select from '$lib/components/forms/Select.svelte';\n     7\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n     8\t\timport type { StartTimerRequest } from '$lib/types/time_tracking';\n     9\t\n    10\t\tconst tt = getTimeTracking();\n    11\t\tconst ts = getTranslation();\n    12\t\tconst loadingIndicator = getLoadingIndicator();\n    13\t\n    14\t\tlet timerProjectId = $state<string>(tt.projects.length > 0 ? tt.projects[0].id : '');\n    15\t\tlet timerDescription = $state<string>('');\n    16\t\n    17\t\tlet projectOptions = $derived(\n    18\t\t\ttt.projects.map((p) => ({ label: p.title, value: p.id }))\n    19\t\t);\n    20\t\n    21\t\tasync function startTimer(): Promise<void> {\n    22\t\t\tif (!timerProjectId) return;\n    23\t\t\tloadingIndicator.start();\n    24\t\t\tconst request: StartTimerRequest = {\n    25\t\t\t\tproject_id: timerProjectId,\n    26\t\t\t\tdescription: timerDescription.trim() || null\n    27\t\t\t};\n    28\t\t\tawait tt.startTimer(request);\n    29\t\t\ttimerDescription = '';\n    30\t\t\tloadingIndicator.stop();\n    31\t\t}\n    32\t</script>\n    33\t\n    34\t<div class=\"h-full rounded-lg bg-c-bg-surface p-4 shadow-sm\">\n    35\t\t{#if tt.activeTimer}\n    36\t\t\t<ActiveTimer />\n    37\t\t{:else if tt.projects.length > 0}\n    38\t\t\t<div class=\"flex flex-col gap-3\">\n    39\t\t\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">\n    40\t\t\t\t\t{ts.get.timeTracking.start_timer}\n    41\t\t\t\t</span>\n    42\t\t\t\t<Select bind:value={timerProjectId} options={projectOptions} />\n    43\t\t\t\t<input\n    44\t\t\t\t\ttype=\"text\"\n    45\t\t\t\t\tbind:value={timerDescription}\n    46\t\t\t\t\tplaceholder={ts.get.timeTracking.description}\n    47\t\t\t\t\tclass=\"w-full rounded-lg border-1 border-c-neutral-2 px-3 py-2 text-sm shadow-xs transition-all focus:ring-2 focus:ring-d-lightblue focus:outline-none dark:border-s-dark-3 dark:bg-inherit dark:text-white dark:focus:ring-c-primary\"\n    48\t\t\t\t/>\n    49\t\t\t\t<TextButton title={ts.get.timeTracking.start_timer} onclick={startTimer} />\n    50\t\t\t</div>\n    51\t\t{:else}\n    52\t\t\t<p class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n    53\t\t\t\t{ts.get.timeTracking.no_projects}\n    54\t\t\t</p>\n    55\t\t{/if}\n    56\t</div>\n========== ActiveTimer ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onMount, onDestroy } from 'svelte';\n     3\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     4\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     5\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     6\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n     7\t\n     8\t\tconst tt = getTimeTracking();\n     9\t\tconst ts = getTranslation();\n    10\t\tconst loadingIndicator = getLoadingIndicator();\n    11\t\n    12\t\tlet elapsed = $state<string>('00:00:00');\n    13\t\tlet interval: ReturnType<typeof setInterval> | null = null;\n    14\t\n    15\t\tfunction updateElapsed(): void {\n    16\t\t\tif (!tt.activeTimer) return;\n    17\t\t\tconst start = new Date(tt.activeTimer.started_at).getTime();\n    18\t\t\tconst now = Date.now();\n    19\t\t\tconst diff = Math.floor((now - start) / 1000);\n    20\t\t\tconst h = Math.floor(diff / 3600);\n    21\t\t\tconst m = Math.floor((diff % 3600) / 60);\n    22\t\t\tconst s = diff % 60;\n    23\t\t\telapsed = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;\n    24\t\t}\n    25\t\n    26\t\tonMount(() => {\n    27\t\t\tupdateElapsed();\n    28\t\t\tinterval = setInterval(updateElapsed, 1000);\n    29\t\t});\n    30\t\n    31\t\tonDestroy(() => {\n    32\t\t\tif (interval) clearInterval(interval);\n    33\t\t});\n    34\t\n    35\t\tasync function stopTimer(): Promise<void> {\n    36\t\t\tif (!tt.activeTimer) return;\n    37\t\t\tloadingIndicator.start();\n    38\t\t\tawait tt.stopTimer(tt.activeTimer.id);\n    39\t\t\tloadingIndicator.stop();\n    40\t\t}\n    41\t</script>\n    42\t\n    43\t{#if tt.activeTimer}\n    44\t\t<div class=\"flex flex-row items-center justify-between rounded-md border-l-4 border-c-primary bg-c-bg-surface p-4 shadow-sm\">\n    45\t\t\t<div class=\"flex flex-col gap-1\">\n    46\t\t\t\t<div class=\"flex flex-row items-center gap-2\">\n    47\t\t\t\t\t<div class=\"h-2 w-2 animate-pulse rounded-full bg-c-primary\"></div>\n    48\t\t\t\t\t<span class=\"text-sm font-medium text-c-primary\">\n    49\t\t\t\t\t\t{ts.get.timeTracking.timer_running}\n    50\t\t\t\t\t</span>\n    51\t\t\t\t</div>\n    52\t\t\t\t<span class=\"text-2xl font-bold tabular-nums\">{elapsed}</span>\n    53\t\t\t\t{#if tt.activeTimer.project}\n    54\t\t\t\t\t<span class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n    55\t\t\t\t\t\t{tt.activeTimer.project.title}\n    56\t\t\t\t\t</span>\n    57\t\t\t\t{/if}\n    58\t\t\t\t{#if tt.activeTimer.description}\n    59\t\t\t\t\t<span class=\"text-sm text-c-neutral-4 dark:text-c-neutral-5\">\n    60\t\t\t\t\t\t{tt.activeTimer.description}\n    61\t\t\t\t\t</span>\n    62\t\t\t\t{/if}\n    63\t\t\t</div>\n    64\t\t\t<TextButton title={ts.get.timeTracking.stop_timer} type=\"danger\" onclick={stopTimer} />\n    65\t\t</div>\n    66\t{/if}\n========== PomodoroWidget ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onDestroy } from 'svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\timport Play from '@lucide/svelte/icons/play';\n     5\t\timport Pause from '@lucide/svelte/icons/pause';\n     6\t\timport SkipForward from '@lucide/svelte/icons/skip-forward';\n     7\t\timport RotateCcw from '@lucide/svelte/icons/rotate-ccw';\n     8\t\n     9\t\tconst ts = getTranslation();\n    10\t\n    11\t\ttype Phase = 'work' | 'shortBreak' | 'longBreak';\n    12\t\n    13\t\tconst WORK_SECONDS = 25 * 60;\n    14\t\tconst SHORT_BREAK_SECONDS = 5 * 60;\n    15\t\tconst LONG_BREAK_SECONDS = 15 * 60;\n    16\t\tconst SESSIONS_PER_CYCLE = 4;\n    17\t\n    18\t\tlet phase = $state<Phase>('work');\n    19\t\tlet secondsRemaining = $state<number>(WORK_SECONDS);\n    20\t\tlet running = $state<boolean>(false);\n    21\t\tlet started = $state<boolean>(false);\n    22\t\tlet sessionsCompleted = $state<number>(0);\n    23\t\tlet interval: ReturnType<typeof setInterval> | null = null;\n    24\t\n    25\t\tlet phaseLabel = $derived({\n    26\t\t\twork: ts.get.timeTracking.work_session,\n    27\t\t\tshortBreak: ts.get.timeTracking.short_break,\n    28\t\t\tlongBreak: ts.get.timeTracking.long_break,\n    29\t\t}[phase]);\n    30\t\n    31\t\tlet accentColor = $derived(phase === 'work' ? 'teal' : 'amber');\n    32\t\n    33\t\tlet display = $derived(\n    34\t\t\t`${String(Math.floor(secondsRemaining / 60)).padStart(2, '0')}:${String(secondsRemaining % 60).padStart(2, '0')}`\n    35\t\t);\n    36\t\n    37\t\tfunction getDurationForPhase(p: Phase): number {\n    38\t\t\tif (p === 'work') return WORK_SECONDS;\n    39\t\t\tif (p === 'shortBreak') return SHORT_BREAK_SECONDS;\n    40\t\t\treturn LONG_BREAK_SECONDS;\n    41\t\t}\n    42\t\n    43\t\tfunction nextPhase(): Phase {\n    44\t\t\tif (phase === 'work') {\n    45\t\t\t\tconst completed = sessionsCompleted + 1;\n    46\t\t\t\tsessionsCompleted = completed;\n    47\t\t\t\tif (completed % SESSIONS_PER_CYCLE === 0) return 'longBreak';\n    48\t\t\t\treturn 'shortBreak';\n    49\t\t\t}\n    50\t\t\treturn 'work';\n    51\t\t}\n    52\t\n    53\t\tfunction advancePhase(): void {\n    54\t\t\tconst next = nextPhase();\n    55\t\t\tphase = next;\n    56\t\t\tsecondsRemaining = getDurationForPhase(next);\n    57\t\t\trunning = false;\n    58\t\t\tstopInterval();\n    59\t\t}\n    60\t\n    61\t\tfunction playBeep(): void {\n    62\t\t\ttry {\n    63\t\t\t\tconst ctx = new AudioContext();\n    64\t\t\t\tconst oscillator = ctx.createOscillator();\n    65\t\t\t\tconst gain = ctx.createGain();\n    66\t\t\t\toscillator.connect(gain);\n    67\t\t\t\tgain.connect(ctx.destination);\n    68\t\t\t\toscillator.frequency.value = 880;\n    69\t\t\t\toscillator.type = 'sine';\n    70\t\t\t\tgain.gain.value = 0.3;\n    71\t\t\t\toscillator.start();\n    72\t\t\t\toscillator.stop(ctx.currentTime + 0.2);\n    73\t\t\t} catch {\n    74\t\t\t\t// audio not available\n    75\t\t\t}\n    76\t\t}\n    77\t\n    78\t\tfunction tick(): void {\n    79\t\t\tif (secondsRemaining <= 1) {\n    80\t\t\t\tsecondsRemaining = 0;\n    81\t\t\t\tplayBeep();\n    82\t\t\t\tadvancePhase();\n    83\t\t\t\treturn;\n    84\t\t\t}\n    85\t\t\tsecondsRemaining--;\n    86\t\t}\n    87\t\n    88\t\tfunction startInterval(): void {\n    89\t\t\tif (interval) return;\n    90\t\t\tinterval = setInterval(tick, 1000);\n    91\t\t}\n    92\t\n    93\t\tfunction stopInterval(): void {\n    94\t\t\tif (interval) {\n    95\t\t\t\tclearInterval(interval);\n    96\t\t\t\tinterval = null;\n    97\t\t\t}\n    98\t\t}\n    99\t\n   100\t\tfunction toggleRunning(): void {\n   101\t\t\trunning = !running;\n   102\t\t\tif (running) {\n   103\t\t\t\tstarted = true;\n   104\t\t\t\tstartInterval();\n   105\t\t\t} else {\n   106\t\t\t\tstopInterval();\n   107\t\t\t}\n   108\t\t}\n   109\t\n   110\t\tfunction skip(): void {\n   111\t\t\tadvancePhase();\n   112\t\t}\n   113\t\n   114\t\tfunction reset(): void {\n   115\t\t\tstopInterval();\n   116\t\t\tphase = 'work';\n   117\t\t\tsecondsRemaining = WORK_SECONDS;\n   118\t\t\trunning = false;\n   119\t\t\tstarted = false;\n   120\t\t\tsessionsCompleted = 0;\n   121\t\t}\n   122\t\n   123\t\tonDestroy(() => {\n   124\t\t\tstopInterval();\n   125\t\t});\n   126\t</script>\n   127\t\n   128\t<div\n   129\t\tclass=\"flex h-full flex-col gap-3 rounded-lg bg-c-bg-surface p-4 shadow-sm\"\n   130\t>\n   131\t\t<div class=\"flex flex-row items-center justify-between\">\n   132\t\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">\n   133\t\t\t\t{ts.get.timeTracking.pomodoro}\n   134\t\t\t</span>\n   135\t\t\t<div class=\"flex flex-row items-center gap-2\">\n   136\t\t\t\t{#if started}\n   137\t\t\t\t\t{#if running}\n   138\t\t\t\t\t\t<div\n   139\t\t\t\t\t\t\tclass=\"h-2 w-2 animate-pulse rounded-full\"\n   140\t\t\t\t\t\t\tclass:bg-c-primary={accentColor === 'teal'}\n   141\t\t\t\t\t\t\tclass:bg-amber-500={accentColor === 'amber'}\n   142\t\t\t\t\t\t></div>\n   143\t\t\t\t\t{/if}\n   144\t\t\t\t\t<span\n   145\t\t\t\t\t\tclass=\"text-xs font-medium\"\n   146\t\t\t\t\t\tclass:text-c-primary={accentColor === 'teal'}\n   147\t\t\t\t\t\tclass:text-amber-500={accentColor === 'amber'}\n   148\t\t\t\t\t>\n   149\t\t\t\t\t\t{phaseLabel}\n   150\t\t\t\t\t</span>\n   151\t\t\t\t\t<button\n   152\t\t\t\t\t\tonclick={reset}\n   153\t\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 text-xs text-c-neutral-4 transition-all hover:text-c-neutral-6 dark:text-c-neutral-5 dark:hover:text-c-neutral-3\"\n   154\t\t\t\t\t>\n   155\t\t\t\t\t\t<RotateCcw size={13} />\n   156\t\t\t\t\t\t{ts.get.timeTracking.reset}\n   157\t\t\t\t\t</button>\n   158\t\t\t\t{/if}\n   159\t\t\t</div>\n   160\t\t</div>\n   161\t\n   162\t\t<div class=\"flex flex-col items-center gap-3 mt-4\">\n   163\t\t\t<span\n   164\t\t\t\tclass=\"text-4xl font-bold tabular-nums\"\n   165\t\t\t\tclass:text-c-primary={accentColor === 'teal'}\n   166\t\t\t\tclass:text-amber-500={accentColor === 'amber'}\n   167\t\t\t>\n   168\t\t\t\t{display}\n   169\t\t\t</span>\n   170\t\n   171\t\t\t<div class=\"flex flex-row items-center gap-1\">\n   172\t\t\t\t{#each Array(SESSIONS_PER_CYCLE) as _, i}\n   173\t\t\t\t\t<div\n   174\t\t\t\t\t\tclass=\"h-2.5 w-2.5 rounded-full\"\n   175\t\t\t\t\t\tclass:bg-c-primary={i < sessionsCompleted % SESSIONS_PER_CYCLE}\n   176\t\t\t\t\t\tclass:bg-c-neutral-2={i >= sessionsCompleted % SESSIONS_PER_CYCLE}\n   177\t\t\t\t\t></div>\n   178\t\t\t\t{/each}\n   179\t\t\t\t<span class=\"ml-1 text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n   180\t\t\t\t\t{sessionsCompleted} {ts.get.timeTracking.sessions_completed}\n   181\t\t\t\t</span>\n   182\t\t\t</div>\n   183\t\n   184\t\t\t<div class=\"flex flex-row items-center gap-2 mt-4\">\n   185\t\t\t\t<button\n   186\t\t\t\t\tonclick={toggleRunning}\n   187\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 rounded-md px-3 py-1.5 text-sm font-medium text-white transition-all hover:shadow-xs\"\n   188\t\t\t\t\tclass:bg-c-primary={accentColor === 'teal'}\n   189\t\t\t\t\tclass:bg-amber-500={accentColor === 'amber'}\n   190\t\t\t\t>\n   191\t\t\t\t\t{#if running}\n   192\t\t\t\t\t\t<Pause size={14} />\n   193\t\t\t\t\t\t{ts.get.timeTracking.pause}\n   194\t\t\t\t\t{:else if secondsRemaining < getDurationForPhase(phase)}\n   195\t\t\t\t\t\t<Play size={14} />\n   196\t\t\t\t\t\t{ts.get.timeTracking.resume}\n   197\t\t\t\t\t{:else}\n   198\t\t\t\t\t\t<Play size={14} />\n   199\t\t\t\t\t\t{ts.get.timeTracking.start}\n   200\t\t\t\t\t{/if}\n   201\t\t\t\t</button>\n   202\t\t\t\t<button\n   203\t\t\t\t\tonclick={skip}\n   204\t\t\t\t\tclass=\"flex cursor-pointer items-center gap-1 rounded-md bg-c-neutral-1 px-3 py-1.5 text-sm text-c-neutral-6 transition-all hover:bg-c-neutral-2 dark:bg-s-dark-3 dark:text-c-neutral-3 dark:hover:bg-s-dark\"\n   205\t\t\t\t>\n   206\t\t\t\t\t<SkipForward size={14} />\n   207\t\t\t\t\t{ts.get.timeTracking.skip}\n   208\t\t\t\t</button>\n   209\t\t\t</div>\n   210\t\t</div>\n   211\t</div>\n========== TimeBreakdownWidget ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\n     5\t\tinterface Breakdown {\n     6\t\t\ttitle: string;\n     7\t\t\tcolor: string;\n     8\t\t\tminutes: number;\n     9\t\t}\n    10\t\n    11\t\tlet { title, breakdown, total }: { title: string; breakdown: Breakdown[]; total: number } =\n    12\t\t\t$props();\n    13\t\n    14\t\tconst tt = getTimeTracking();\n    15\t\tconst ts = getTranslation();\n    16\t</script>\n    17\t\n    18\t<div class=\"flex flex-col gap-3 rounded-lg bg-c-bg-surface p-4 shadow-sm lg:col-span-1\">\n    19\t\t<span class=\"text-sm font-bold text-c-neutral-5 dark:text-c-neutral-4\">{title}</span>\n    20\t\t<div class=\"flex flex-col gap-2.5\">\n    21\t\t\t<div class=\"flex flex-row items-center justify-between\">\n    22\t\t\t\t<span class=\"text-xs font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    23\t\t\t\t\t{ts.get.timeTracking.total_time}\n    24\t\t\t\t</span>\n    25\t\t\t\t<span class=\"text-xs font-medium tabular-nums text-c-primary\">\n    26\t\t\t\t\t{tt.formatDuration(total)}\n    27\t\t\t\t</span>\n    28\t\t\t</div>\n    29\t\t\t{#each breakdown as category (category.title)}\n    30\t\t\t\t<div class=\"flex flex-col gap-0.5\">\n    31\t\t\t\t\t<div class=\"flex flex-row items-center justify-between\">\n    32\t\t\t\t\t\t<div class=\"flex flex-row items-center gap-1.5\">\n    33\t\t\t\t\t\t\t<div class=\"h-2.5 w-2.5 shrink-0 rounded-full\" style=\"background-color: {category.color}\"></div>\n    34\t\t\t\t\t\t\t<span class=\"truncate text-xs\">{category.title}</span>\n    35\t\t\t\t\t\t</div>\n    36\t\t\t\t\t\t<span class=\"text-xs tabular-nums text-c-neutral-4 dark:text-c-neutral-5\">\n    37\t\t\t\t\t\t\t{tt.formatDuration(category.minutes)}\n    38\t\t\t\t\t\t</span>\n    39\t\t\t\t\t</div>\n    40\t\t\t\t\t<div class=\"h-1 w-full rounded-full bg-c-neutral-1 dark:bg-s-dark-3\">\n    41\t\t\t\t\t\t<div\n    42\t\t\t\t\t\t\tclass=\"h-1 rounded-full\"\n    43\t\t\t\t\t\t\tstyle=\"width: {total > 0 ? (category.minutes / total) * 100 : 0}%; background-color: {category.color}\"\n    44\t\t\t\t\t\t></div>\n    45\t\t\t\t\t</div>\n    46\t\t\t\t</div>\n    47\t\t\t{:else}\n    48\t\t\t\t<span class=\"text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n    49\t\t\t\t\t{ts.get.timeTracking.no_entries}\n    50\t\t\t\t</span>\n    51\t\t\t{/each}\n    52\t\t</div>\n    53\t</div>\n========== DashboardView ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\timport Entry from '$lib/components/time-tracking/Entry.svelte';\n     5\t\timport TimerWidget from '$lib/components/time-tracking/TimerWidget.svelte';\n     6\t\timport PomodoroWidget from '$lib/components/time-tracking/PomodoroWidget.svelte';\n     7\t\timport TimeBreakdownWidget from '$lib/components/time-tracking/TimeBreakdownWidget.svelte';\n     8\t\timport StatisticsView from '$lib/components/time-tracking/StatisticsView.svelte';\n     9\t\timport Heading from '$lib/components/ui/Heading.svelte';\n    10\t\n    11\t\tconst tt = getTimeTracking();\n    12\t\tconst ts = getTranslation();\n    13\t\n    14\t\tlet recentEntries = $derived(\n    15\t\t\ttt.entries\n    16\t\t\t\t.filter((e) => e.stopped_at !== null)\n    17\t\t\t\t.slice(0, 10)\n    18\t\t);\n    19\t\n    20\t\tinterface ProjectBreakdown {\n    21\t\t\ttitle: string;\n    22\t\t\tcolor: string;\n    23\t\t\tminutes: number;\n    24\t\t}\n    25\t\n    26\t\tfunction groupByProject(\n    27\t\t\tentries: { project: { id: string } | null; duration_minutes: number }[]\n    28\t\t): ProjectBreakdown[] {\n    29\t\t\tconst map = new Map<string, { color: string; minutes: number }>();\n    30\t\t\tfor (const e of entries) {\n    31\t\t\t\tconst project = e.project ? tt.projects.find((p) => p.id === e.project!.id) : null;\n    32\t\t\t\tconst key = project?.title ?? ts.get.timeTracking.uncategorized;\n    33\t\t\t\tconst color = project?.categories?.[0]?.color ?? '#9ca3af';\n    34\t\t\t\tconst existing = map.get(key) ?? { color, minutes: 0 };\n    35\t\t\t\texisting.minutes += e.duration_minutes;\n    36\t\t\t\tmap.set(key, existing);\n    37\t\t\t}\n    38\t\t\treturn [...map.entries()]\n    39\t\t\t\t.map(([title, { color, minutes }]) => ({ title, color, minutes }))\n    40\t\t\t\t.sort((a, b) => b.minutes - a.minutes);\n    41\t\t}\n    42\t\n    43\t\tlet weekBreakdown = $derived(() => {\n    44\t\t\tconst now = new Date();\n    45\t\t\tconst startOfWeek = new Date(now);\n    46\t\t\tstartOfWeek.setDate(now.getDate() - now.getDay() + (now.getDay() === 0 ? -6 : 1));\n    47\t\t\tstartOfWeek.setHours(0, 0, 0, 0);\n    48\t\t\tconst filtered = tt.entries.filter(\n    49\t\t\t\t(e) => e.stopped_at !== null && new Date(e.started_at) >= startOfWeek\n    50\t\t\t);\n    51\t\t\treturn groupByProject(filtered);\n    52\t\t});\n    53\t\n    54\t\tlet weekTotal = $derived(() => weekBreakdown().reduce((s, c) => s + c.minutes, 0));\n    55\t\n    56\t\tlet todayBreakdown = $derived(() => {\n    57\t\t\tconst now = new Date();\n    58\t\t\tconst startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n    59\t\t\tconst filtered = tt.entries.filter(\n    60\t\t\t\t(e) => e.stopped_at !== null && new Date(e.started_at) >= startOfToday\n    61\t\t\t);\n    62\t\t\treturn groupByProject(filtered);\n    63\t\t});\n    64\t\n    65\t\tlet todayTotal = $derived(() => todayBreakdown().reduce((s, c) => s + c.minutes, 0));\n    66\t</script>\n    67\t\n    68\t<div class=\"flex flex-col gap-8\">\n    69\t\t<div class=\"grid grid-cols-1 items-start gap-4 md:grid-cols-2 lg:grid-cols-4\">\n    70\t\t\t<div class=\"lg:col-span-1\">\n    71\t\t\t\t<TimerWidget />\n    72\t\t\t</div>\n    73\t\t\t<div class=\"lg:col-span-1\">\n    74\t\t\t\t<PomodoroWidget />\n    75\t\t\t</div>\n    76\t\t\t<TimeBreakdownWidget\n    77\t\t\t\ttitle={ts.get.timeTracking.today}\n    78\t\t\t\tbreakdown={todayBreakdown()}\n    79\t\t\t\ttotal={todayTotal()}\n    80\t\t\t/>\n    81\t\t\t<TimeBreakdownWidget\n    82\t\t\t\ttitle={ts.get.timeTracking.this_week}\n    83\t\t\t\tbreakdown={weekBreakdown()}\n    84\t\t\t\ttotal={weekTotal()}\n    85\t\t\t/>\n    86\t\t</div>\n    87\t\n    88\t\t{#if recentEntries.length > 0}\n    89\t\t\t<div class=\"flex flex-col gap-2\">\n    90\t\t\t\t<Heading title={ts.get.timeTracking.recent_entries} my={0} />\n    91\t\t\t\t{#each recentEntries as entry (entry.id)}\n    92\t\t\t\t\t<Entry {entry} showProject showDate />\n    93\t\t\t\t{/each}\n    94\t\t\t</div>\n    95\t\t{/if}\n    96\t\n    97\t\t<StatisticsView />\n    98\t</div>\n========== StatisticsView ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { onMount } from 'svelte';\n     3\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     4\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     5\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     6\t\timport DoughnutChart from '$lib/components/charts/DoughnutChart.svelte';\n     7\t\timport BarChart from '$lib/components/charts/BarChart.svelte';\n     8\t\timport Heading from '$lib/components/ui/Heading.svelte';\n     9\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n    10\t\n    11\t\tconst tt = getTimeTracking();\n    12\t\tconst ts = getTranslation();\n    13\t\tconst loadingIndicator = getLoadingIndicator();\n    14\t\n    15\t\tconst today = new Date();\n    16\t\tconst thirtyDaysAgo = new Date(today.getTime() - 30 * 24 * 60 * 60 * 1000);\n    17\t\n    18\t\tlet fromDate = $state<string>(thirtyDaysAgo.toISOString().split('T')[0]);\n    19\t\tlet toDate = $state<string>(today.toISOString().split('T')[0]);\n    20\t\tlet selectedCategoryIds = $state<number[]>([]);\n    21\t\n    22\t\tfunction toggleCategory(id: number): void {\n    23\t\t\tif (selectedCategoryIds.includes(id)) {\n    24\t\t\t\tselectedCategoryIds = selectedCategoryIds.filter((c) => c !== id);\n    25\t\t\t} else {\n    26\t\t\t\tselectedCategoryIds = [...selectedCategoryIds, id];\n    27\t\t\t}\n    28\t\t}\n    29\t\n    30\t\tlet filteredProjects = $derived(() => {\n    31\t\t\tc