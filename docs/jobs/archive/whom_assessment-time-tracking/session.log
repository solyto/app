edAt) {\n    53\t\t\t\tconst start = new Date(startedAt).getTime();\n    54\t\t\t\tconst stop = new Date(stoppedAt).getTime();\n    55\t\t\t\tif (stop > start) {\n    56\t\t\t\t\tconst mins = Math.round((stop - start) / 60000);\n    57\t\t\t\t\tdurationUnit = 'minutes';\n    58\t\t\t\t\tdurationAmount = mins;\n    59\t\t\t\t}\n    60\t\t\t}\n    61\t\t}\n    62\t\n    63\t\tasync function onSave(): Promise<void> {\n    64\t\t\tif (!projectId || durationMinutes <= 0) return;\n    65\t\n    66\t\t\tloadingIndicator.start();\n    67\t\n    68\t\t\tconst request: UpdateTimeTrackingEntryRequest = {\n    69\t\t\t\tdescription: description || null,\n    70\t\t\t\tduration_minutes: durationMinutes,\n    71\t\t\t\tproject_id: projectId\n    72\t\t\t};\n    73\t\n    74\t\t\tif (showExactTimes && startedAt && stoppedAt) {\n    75\t\t\t\trequest.started_at = new Date(startedAt).toISOString();\n    76\t\t\t\trequest.stopped_at = new Date(stoppedAt).toISOString();\n    77\t\t\t}\n    78\t\n    79\t\t\tconst res = await tt.updateEntry(entry.id, request);\n    80\t\t\tif (res) onClose();\n    81\t\n    82\t\t\tloadingIndicator.stop();\n    83\t\t}\n    84\t</script>\n    85\t\n    86\t<ContentModal title={ts.get.timeTracking.edit_entry} rounded=\"2xl\" p=\"8\" {onClose}>\n    87\t\t<div class=\"flex flex-col gap-3\">\n    88\t\t\t<div class=\"flex flex-col gap-1\">\n    89\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    90\t\t\t\t\t{ts.get.timeTracking.project}\n    91\t\t\t\t</span>\n    92\t\t\t\t<Select bind:value={projectId} options={projectOptions} />\n    93\t\t\t</div>\n    94\t\t\t<div class=\"flex flex-col gap-1\">\n    95\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    96\t\t\t\t\t{ts.get.timeTracking.description}\n    97\t\t\t\t</span>\n    98\t\t\t\t<TextInput bind:value={description} placeholder={ts.get.timeTracking.description} />\n    99\t\t\t</div>\n   100\t\t\t<div class=\"flex flex-co