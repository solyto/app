\n    58\t\tfunction groupByDate(\n    59\t\t\tentries: TimeTrackingEntry[]\n    60\t\t): { date: string; entries: TimeTrackingEntry[] }[] {\n    61\t\t\tconst groups: Record<string, TimeTrackingEntry[]> = {};\n    62\t\n    63\t\t\tfor (const entry of entries) {\n    64\t\t\t\tconst date = auth.getDateWithWeekdayInUserPreferredFormat(entry.started_at);\n    65\t\t\t\tif (!groups[date]) groups[date] = [];\n    66\t\t\t\tgroups[date].push(entry);\n    67\t\t\t}\n    68\t\n    69\t\t\treturn Object.entries(groups).map(([date, entries]) => ({ date, entries }));\n    70\t\t}\n    71\t\n    72\t\tasync function onDelete(): Promise<void> {\n    73\t\t\tif (!project) return;\n    74\t\t\tloadingIndicator.start();\n    75\t\t\tawait tt.deleteProject(project.id);\n    76\t\t\tloadingIndicator.stop();\n    77\t\t\tawait goto(resolve(urls.timeTracking));\n    78\t\t}\n    79\t</script>\n    80\t\n    81\t{#if editModal && project}\n    82\t\t<ProjectCreate\n    83\t\t\tprojectId={project.id}\n    84\t\t\tonClose={() => {\n    85\t\t\t\teditModal = false;\n    86\t\t\t}}\n    87\t\t/>\n    88\t{/if}\n    89\t\n    90\t{#if deleteModal}\n    91\t\t<ConfirmationModal\n    92\t\t\ttitle={ts.get.timeTracking.deletion_title}\n    93\t\t\tdescription={ts.get.timeTracking.deletion_description}\n    94\t\t\ttype=\"confirm\"\n    95\t\t\tonConfirm={onDelete}\n    96\t\t\tonCancel={() => {\n    97\t\t\t\tdeleteModal = false;\n    98\t\t\t}}\n    99\t\t/>\n   100\t{/if}\n   101\t\n   102\t{#if project}\n   103\t\t<div class=\"flex h-full flex-1 flex-col\" in:fade>\n   104\t\t\t<div\n   105\t\t\t\tclass=\"flex-shrink-0 border-b border-c-neutral-1 bg-c-bg-surface/80 px-4 py-4 backdrop-blur-sm lg:px-8 dark:border-s-dark-3\"\n   106\t\t\t>\n   107\t\t\t\t<div class=\"flex w-full flex-row items-center justify-between\">\n   108\t\t\t\t\t<div class=\"flex flex-row items-center gap-4\">\n   109\t\t\t\t\t\t<a\n   110\t\t\t\t\t\t\thref={resolve(urls.timeTracking)}\n   111\t\t\t\t\t\t\tclass=\"flex