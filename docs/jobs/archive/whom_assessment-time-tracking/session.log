} = $props<{\n     5\t\t\tonclick: () => void;\n     6\t\t\ttop?: number;\n     7\t\t\tleft?: number;\n     8\t\t}>();\n     9\t</script>\n    10\t\n    11\t<button\n    12\t\tclass=\"absolute z-40 cursor-pointer rounded-full shadow-md p-2 not-dark:bg-c-primary hover:bg-c-neutral-2 lg:hidden dark:hover:bg-s-dark-3 {top ? `top-${top}` : 'top-4'} {left ? `left-${left}` : 'left-4'}\"\n    13\t\t{onclick}\n    14\t>\n    15\t\t<IconMenu class=\"text-c-neutral-1\" />\n    16\t</button>\n    17\t\n    18\t<!-- top-2 top-4 top-6 top-8 left-2 left-4 left-6 left-8 -->=== QuickGlance ===\n     1\t<script lang=\"ts\">\n     2\t\timport { blur } from 'svelte/transition';\n     3\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     4\t\n     5\t\timport TimeTrackingWidget from '$lib/components/dashboard/widgets/TimeTrackingWidget.svelte';\n     6\t\timport CheckInWidget from '$lib/components/dashboard/widgets/CheckInWidget.svelte';\n     7\t\timport ShortcutsWidget from '$lib/components/dashboard/widgets/ShortcutsWidget.svelte';\n     8\t\n     9\t\tconst ts = getTranslation();\n    10\t</script>\n    11\t\n    12\t<div class=\"flex flex-col gap-12\" in:blur>\n    13\t\t<CheckInWidget {ts} />\n    14\t\t<TimeTrackingWidget {ts} />\n    15\t\t<ShortcutsWidget {ts} />\n    16\t</div>","exit":0,"truncated":false},"title":"cd /workspace && cat -n src/lib/components/ui/buttons/HamburgerButton.svelte; echo \"=== QuickGlance ===\"; cat -n src/lib/components/dashboard/QuickGlance.svelte","time":{"start":1791623482909,"end":1791623482973}},"id":"prt_12514cd8f001S0Z215b4WJd8bF","sessionID":"ses_edaec2704ffeWB9idQ36MdrQEO","messageID":"msg_12514bff0001rQ7Z1YilqfjXGY"}}
