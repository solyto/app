19\t\tlet { onClose, projectId: initialProjectId = null } = $props<{\n    20\t\t\tonClose: () => void;\n    21\t\t\tprojectId?: string | null;\n    22\t\t}>();\n    23\t\n    24\t\ttype DurationUnit = 'minutes' | 'hours';\n    25\t\n    26\t\tlet description = $state<string>('');\n    27\t\tlet durationAmount = $state<number>(0);\n    28\t\tlet durationUnit = $state<DurationUnit>('minutes');\n    29\t\tlet date = $state<string>(new Date().toISOString().slice(0, 10));\n    30\t\tlet showExactTimes = $state<boolean>(false);\n    31\t\tlet startedAt = $state<string>('');\n    32\t\tlet stoppedAt = $state<string>('');\n    33\t\tlet projectId = $state<string>(initialProjectId ?? (tt.projects.length > 0 ? tt.projects[0].id : ''));\n    34\t\n    35\t\tlet startInput = $state<HTMLInputElement | null>(null);\n    36\t\tlet stopInput = $state<HTMLInputElement | null>(null);\n    37\t\n    38\t\tlet projectOptions = $derived(\n    39\t\t\ttt.projects.map((p) => ({ label: p.title, value: p.id }))\n    40\t\t);\n    41\t\n    42\t\tlet unitOptions: { label: string; value: DurationUnit }[] = [\n    43\t\t\t{ label: ts.get.timeTracking.minutes, value: 'minutes' },\n    44\t\t\t{ label: ts.get.timeTracking.hours, value: 'hours' }\n    45\t\t];\n    46\t\n    47\t\tlet durationMinutes = $derived(\n    48\t\t\tdurationUnit === 'hours' ? Math.round(durationAmount * 60) : Math.round(durationAmount)\n    49\t\t);\n    50\t\n    51\t\tfunction computeDurationFromTimes(): void {\n    52\t\t\tif (startedAt && stoppedAt) {\n    53\t\t\t\tconst start = new Date(startedAt).getTime();\n    54\t\t\t\tconst stop = new Date(stoppedAt).getTime();\n    55\t\t\t\tif (stop > start) {\n    56\t\t\t\t\tconst mins = Math.round((stop - start) / 60000);\n    57\t\t\t\t\tdurationUnit = 'minutes';\n    58\t\t\t\t\tdurationAmount = mins;\n    59\t\t\t\t}\n    60\t\t\t}\n    61\t\t}\n    62\t\n    63\t\tlet hasExactTimes = $derived(showExactTimes && !!(startedAt && stoppedAt));\n    64\t\n    65\t\tfunction