ject.title}\n    38\t\t\t\t</span>\n    39\t\t\t{/if}\n    40\t\t\t{#if entry.description}\n    41\t\t\t\t<span class=\"text-sm text-c-neutral-5 dark:text-c-neutral-4\">\n    42\t\t\t\t\t{entry.description}\n    43\t\t\t\t</span>\n    44\t\t\t{:else if showDescriptionFallback}\n    45\t\t\t\t<span class=\"text-sm italic text-c-neutral-4 dark:text-c-neutral-5\">\n    46\t\t\t\t\t{ts.get.timeTracking.no_description}\n    47\t\t\t\t</span>\n    48\t\t\t{/if}\n    49\t\t\t{#if showDate || entry.has_exact_times}\n    50\t\t\t\t<span class=\"text-xs text-c-neutral-4 dark:text-c-neutral-5\">\n    51\t\t\t\t\t{#if showDate}{auth.getDateWithWeekdayInUserPreferredFormat(entry.started_at)}{/if}{#if showDate && entry.has_exact_times}&nbsp;&middot;&nbsp;{/if}{#if entry.has_exact_times}{auth.getTimeInUserPreferredFormat(entry.started_at)} - {entry.stopped_at\n    52\t\t\t\t\t\t? auth.getTimeInUserPreferredFormat(entry.stopped_at)\n    53\t\t\t\t\t\t: '...'}{/if}\n    54\t\t\t\t</span>\n    55\t\t\t{/if}\n    56\t\t</div>\n    57\t\t<div class=\"flex flex-row items-center gap-0 self-center\">\n    58\t\t\t<span class=\"mr-4 text-base tabular-nums text-c-primary\">\n    59\t\t\t\t{tt.formatDuration(entry.duration_minutes)}\n    60\t\t\t</span>\n    61\t\t\t{#if showEdit}\n    62\t\t\t\t<InlineEditButton onClick={() => onEdit?.(entry)} />\n    63\t\t\t{/if}\n    64\t\t\t{#if showDelete}\n    65\t\t\t\t<InlineDeleteButton onClick={() => { tt.deleteEntry(entry.id); }} />\n    66\t\t\t{/if}\n    67\t\t</div>\n    68\t</div>\n========== GroupedEntries ==========\n     1\t<script lang=\"ts\">\n     2\t\timport { fade } from 'svelte/transition';\n     3\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     4\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     5\t\timport { getAuth } from '$lib/state/Auth.svelte';\n     6\t\timport EntryEdit from '$lib/components/time-tracking/EntryEdit.svelte';\n     7\t\timport Entry from '$lib/components/time-tracking/Entry.svelte';\n     8\t\timport type { TimeTrackingEntry } from '$lib/types/time_tracking';\n     9\t\n    10\t\tconst tt = getTimeTracking();\n    11\t\tconst ts = getTranslation();\n    12\t\tconst auth = getAuth();\n    13\t\n    14\t\tlet editingEntry = $state<TimeTrackingEntry | null>(null);\n    15\t\n    16\t\tlet groupedEntries = $derived(groupByDate(tt.entries.filter((e) => e.stopped_at !== null)));\n    17\t\n    18\t\tfunction groupByDate(\n    19\t\t\tentries: TimeTrackingEntry[]\n    20\t\t): { date: string; entries: TimeTrackingEntry[] }[] {\n    21\t\t\tconst groups: Record<string, TimeTrackingEntry[]> = {};\n    22\t\n    23\t\t\tfor (const entry of entries) {\n    24\t\t\t\tconst date = auth.getDateWithWeekdayInUserPreferredFormat(entry.started_at);\n    25\t\t\t\tif (!groups[date]) groups[date] = [];\n    26\t\t\t\tgroups[date].push(entry);\n    27\t\t\t}\n    28\t\n    29\t\t\treturn Object.entries(groups).map(([date, entries]) => ({ date, entries }));\n    30\t\t}\n    31\t</script>\n    32\t\n    33\t{#if editingEntry}\n    34\t\t<EntryEdit entry={editingEntry} onClose={() => (editingEntry = null)} />\n    35\t{/if}\n    36\t\n    37\t{#if groupedEntries.length === 0}\n    38\t\t<p class=\"text-c-neutral-5 dark:text-c-neutral-4\">{ts.get.timeTracking.no_entries}</p>\n    39\t{:else}\n    40\t\t<div class=\"flex flex-col gap-4\" in:fade>\n    41\t\t\t{#each groupedEntries as group (group.date)}\n    42\t\t\t\t<div class=\"flex flex-col gap-2\">\n    43\t\t\t\t\t<div class=\"flex flex-row items-center gap-3\">\n    44\t\t\t\t\t\t<span class=\"text-base font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    45\t\t\t\t\t\t\t{group.date}\n    46\t\t\t\t\t\t</span>\n    47\t\t\t\t\t\t<div class=\"h-px flex-1 bg-c-neutral-2 dark:bg-s-dark-3\"></div>\n    48\t\t\t\t\t</div>\n    49\t\t\t\t\t{#each group.entries as entry (entry.id)}\n    50\t\t\t\t\t\t<Entry\n    51\t\t\t\t\t\t\t{entry}\n    52\t\t\t\t\t\t\tshowProject\n    53\t\t\t\t\t\t\tshowEdit\n    54\t\t\t\t\t\t\tshowDelete\n    55\t\t\t\t\t\t\tonEdit={(e) => (editingEntry = e)}\n    56\t\t\t\t\t\t/>\n    57\t\t\t\t\t{/each}\n    58\t\t\t\t</div>\n    59\t\t\t{/each}\n    60\t\t</div>\n    61\t{/if}\n","metadata":{"output":"========== ProjectCreate ==========\n     1\t<script lang=\"ts\">\n     2\t\timport ContentModal from '$lib/components/ui/ContentModal.svelte';\n     3\t\timport TextInput from '$lib/components/forms/TextInput.svelte';\n     4\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n     5\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     6\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n     7\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n     8\t\n     9\t\tconst tt = getTimeTracking();\n    10\t\tconst ts = getTranslation();\n    11\t\tconst loadingIndicator = getLoadingIndicator();\n    12\t\n    13\t\tlet { onClose, projectId = null } = $props<{\n    14\t\t\tonClose: () => void;\n    15\t\t\tprojectId?: string | null;\n    16\t\t}>();\n    17\t\n    18\t\tconst existingProject = projectId ? tt.projects.find((p) => p.id === projectId) : null;\n    19\t\n    20\t\tlet title = $state<string>(existingProject?.title ?? '');\n    21\t\tlet description = $state<string>(existingProject?.description ?? '');\n    22\t\tlet selectedCategoryIds = $state<number[]>(\n    23\t\t\texistingProject?.categories.map((c) => c.id) ?? []\n    24\t\t);\n    25\t\tlet showCategoryDropdown = $state<boolean>(false);\n    26\t\n    27\t\tlet availableCategories = $derived(\n    28\t\t\ttt.categories.filter((c) => !selectedCategoryIds.includes(c.id))\n    29\t\t);\n    30\t\n    31\t\tlet selectedCategories = $derived(\n    32\t\t\ttt.categories.filter((c) => selectedCategoryIds.includes(c.id))\n    33\t\t);\n    34\t\n    35\t\tfunction addCategory(id: number): void {\n    36\t\t\tselectedCategoryIds = [...selectedCategoryIds, id];\n    37\t\t\tshowCategoryDropdown = false;\n    38\t\t}\n    39\t\n    40\t\tfunction removeCategory(id: number): void {\n    41\t\t\tselectedCategoryIds = selectedCategoryIds.filter((cid) => cid !== id);\n    42\t\t}\n    43\t\n    44\t\tasync function onSave(): Promise<void> {\n    45\t\t\tif (!title.trim()) return;\n    46\t\n    47\t\t\tloadingIndicator.start();\n    48\t\n    49\t\t\tif (existingProject) {\n    50\t\t\t\tawait tt.updateProject(existingProject.id, {\n    51\t\t\t\t\ttitle: title.trim(),\n    52\t\t\t\t\tdescription: description.trim() || null,\n    53\t\t\t\t\tcategory_ids: selectedCategoryIds\n    54\t\t\t\t});\n    55\t\t\t} else {\n    56\t\t\t\tawait tt.createProject({\n    57\t\t\t\t\ttitle: title.trim(),\n    58\t\t\t\t\tdescription: description.trim() || null,\n    59\t\t\t\t\tcategory_ids: selectedCategoryIds\n    60\t\t\t\t});\n    61\t\t\t}\n    62\t\n    63\t\t\tloadingIndicator.stop();\n    64\t\t\tonClose();\n    65\t\t}\n    66\t</script>\n    67\t\n    68\t<ContentModal\n    69\t\ttitle={existingProject ? ts.get.timeTracking.edit_project : ts.get.timeTracking.add_project}\n    70\t\trounded=\"2xl\"\n    71\t\tp=\"8\"\n    72\t\t{onClose}\n    73\t>\n    74\t\t<div class=\"flex flex-col gap-3\">\n    75\t\t\t<div class=\"flex flex-col gap-1\">\n    76\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    77\t\t\t\t\t{ts.get.timeTracking.title}\n    78\t\t\t\t</span>\n    79\t\t\t\t<TextInput bind:value={title} placeholder={ts.get.timeTracking.title} />\n    80\t\t\t</div>\n    81\t\t\t<div class=\"flex flex-col gap-1\">\n    82\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n    83\t\t\t\t\t{ts.get.timeTracking.description}\n    84\t\t\t\t</span>\n    85\t\t\t\t<TextInput bind:value={description} placeholder={ts.get.timeTracking.description} />\n    86\t\t\t</div>\n    87\t\t\t<div class=\"flex flex-col gap-1\">\n    88\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\"\n    89\t\t\t\t\t>{ts.get.timeTracking.categories}</span\n    90\t\t\t\t>\n    91\t\t\t\t<div class=\"flex flex-row flex-wrap items-center gap-1.5\">\n    92\t\t\t\t\t{#each selectedCategories as cat (cat.id)}\n    93\t\t\t\t\t\t<span\n    94\t\t\t\t\t\t\tclass=\"flex flex-row items-center gap-1 rounded-md px-2 py-1 text-xs text-white\"\n    95\t\t\t\t\t\t\tstyle=\"background-color: {cat.color ?? '#888'}\"\n    96\t\t\t\t\t\t>\n    97\t\t\t\t\t\t\t{cat.title}\n    98\t\t\t\t\t\t\t<button\n    99\t\t\t\t\t\t\t\tclass=\"cursor-pointer text-white/80 hover:text-white\"\n   100\t\t\t\t\t\t\t\tonclick={() => removeCategory(cat.id)}\n   101\t\t\t\t\t\t\t>\n   102\t\t\t\t\t\t\t\t&times;\n   103\t\t\t\t\t\t\t</button>\n   104\t\t\t\t\t\t</span>\n   105\t\t\t\t\t{/each}\n   106\t\t\t\t\t{#if availableCategories.length > 0}\n   107\t\t\t\t\t\t<div class=\"relative\">\n   108\t\t\t\t\t\t\t<button\n   109\t\t\t\t\t\t\t\tclass=\"cursor-pointer rounded-md border-1 border-dashed border-c-neutral-3 px-2 py-1 text-xs text-c-neutral-5 transition-all hover:border-c-primary hover:text-c-primary dark:border-s-dark-3 dark:text-c-neutral-4\"\n   110\t\t\t\t\t\t\t\tonclick={() => (showCategoryDropdown = !showCategoryDropdown)}\n   111\t\t\t\t\t\t\t>\n   112\t\t\t\t\t\t\t\t+\n   113\t\t\t\t\t\t\t</button>\n   114\t\t\t\t\t\t\t{#if showCategoryDropdown}\n   115\t\t\t\t\t\t\t\t<div class=\"absolute top-8 left-0 z-10 max-h-40 min-w-36 overflow-y-auto rounded-md border-1 border-c-neutral-2 bg-c-bg-modal shadow-md dark:border-s-dark-3\">\n   116\t\t\t\t\t\t\t\t\t{#each availableCategories as cat (cat.id)}\n   117\t\t\t\t\t\t\t\t\t\t<button\n   118\t\t\t\t\t\t\t\t\t\t\tclass=\"flex w-full cursor-pointer flex-row items-center gap-2 px-3 py-2 text-left text-sm transition-all hover:bg-c-neutral-1 dark:hover:bg-s-dark-3\"\n   119\t\t\t\t\t\t\t\t\t\t\tonclick={() => addCategory(cat.id)}\n   120\t\t\t\t\t\t\t\t\t\t>\n   121\t\t\t\t\t\t\t\t\t\t\t{#if cat.color}\n   122\t\t\t\t\t\t\t\t\t\t\t\t<div\n   123\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"h-2.5 w-2.5 rounded-full\"\n   124\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=\"background-color: {cat.color}\"\n   125\t\t\t\t\t\t\t\t\t\t\t\t></div>\n   126\t\t\t\t\t\t\t\t\t\t\t{/if}\n   127\t\t\t\t\t\t\t\t\t\t\t{cat.title}\n   128\t\t\t\t\t\t\t\t\t\t</button>\n   129\t\t\t\t\t\t\t\t\t{/each}\n   130\t\t\t\t\t\t\t\t</div>\n   131\t\t\t\t\t\t\t{/if}\n   132\t\t\t\t\t\t</div>\n   133\t\t\t\t\t{/if}\n   134\t\t\t\t</div>\n   135\t\t\t</div>\n   136\t\t\t<div class=\"mt-4 flex w-full justify-end\">\n   137\t\t\t\t<TextButton title={ts.get.layout.save} onclick={onSave} />\n   138\t\t\t</div>\n   139\t\t</div>\n   140\t</ContentModal>\n========== EntryCreate ==========\n     1\t<script lang=\"ts\">\n     2\t\timport ContentModal from '$lib/components/ui/ContentModal.svelte';\n     3\t\timport TextInput from '$lib/components/forms/TextInput.svelte';\n     4\t\timport DateTimeInput from '$lib/components/forms/DateTimeInput.svelte';\n     5\t\timport Select from '$lib/components/forms/Select.svelte';\n     6\t\timport TextButton from '$lib/components/ui/buttons/TextButton.svelte';\n     7\t\timport IconChevronDown from '@lucide/svelte/icons/chevron-down';\n     8\t\timport { getTimeTracking } from '$lib/state/TimeTracking.svelte';\n     9\t\timport { getTranslation } from '$lib/state/Translation.svelte';\n    10\t\timport { getLoadingIndicator } from '$lib/state/LoadingIndicator.svelte';\n    11\t\timport { getUiNotifications } from '$lib/state/UiNotifications.svelte';\n    12\t\timport type { CreateTimeTrackingEntryRequest } from '$lib/types/time_tracking';\n    13\t\n    14\t\tconst tt = getTimeTracking();\n    15\t\tconst ts = getTranslation();\n    16\t\tconst loadingIndicator = getLoadingIndicator();\n    17\t\tconst notifications = getUiNotifications();\n    18\t\n    19\t\tlet { onClose, projectId: initialProjectId = null } = $props<{\n    20\t\t\tonClose: () => void;\n    21\t\t\tprojectId?: string | null;\n    22\t\t}>();\n    23\t\n    24\t\ttype DurationUnit = 'minutes' | 'hours';\n    25\t\n    26\t\tlet description = $state<string>('');\n    27\t\tlet durationAmount = $state<number>(0);\n    28\t\tlet durationUnit = $state<DurationUnit>('minutes');\n    29\t\tlet date = $state<string>(new Date().toISOString().slice(0, 10));\n    30\t\tlet showExactTimes = $state<boolean>(false);\n    31\t\tlet startedAt = $state<string>('');\n    32\t\tlet stoppedAt = $state<string>('');\n    33\t\tlet projectId = $state<string>(initialProjectId ?? (tt.projects.length > 0 ? tt.projects[0].id : ''));\n    34\t\n    35\t\tlet startInput = $state<HTMLInputElement | null>(null);\n    36\t\tlet stopInput = $state<HTMLInputElement | null>(null);\n    37\t\n    38\t\tlet projectOptions = $derived(\n    39\t\t\ttt.projects.map((p) => ({ label: p.title, value: p.id }))\n    40\t\t);\n    41\t\n    42\t\tlet unitOptions: { label: string; value: DurationUnit }[] = [\n    43\t\t\t{ label: ts.get.timeTracking.minutes, value: 'minutes' },\n    44\t\t\t{ label: ts.get.timeTracking.hours, value: 'hours' }\n    45\t\t];\n    46\t\n    47\t\tlet durationMinutes = $derived(\n    48\t\t\tdurationUnit === 'hours' ? Math.round(durationAmount * 60) : Math.round(durationAmount)\n    49\t\t);\n    50\t\n    51\t\tfunction computeDurationFromTimes(): void {\n    52\t\t\tif (startedAt && stoppedAt) {\n    53\t\t\t\tconst start = new Date(startedAt).getTime();\n    54\t\t\t\tconst stop = new Date(stoppedAt).getTime();\n    55\t\t\t\tif (stop > start) {\n    56\t\t\t\t\tconst mins = Math.round((stop - start) / 60000);\n    57\t\t\t\t\tdurationUnit = 'minutes';\n    58\t\t\t\t\tdurationAmount = mins;\n    59\t\t\t\t}\n    60\t\t\t}\n    61\t\t}\n    62\t\n    63\t\tlet hasExactTimes = $derived(showExactTimes && !!(startedAt && stoppedAt));\n    64\t\n    65\t\tfunction buildTimestamps(): { started_at: string; stopped_at: string } {\n    66\t\t\tif (hasExactTimes) {\n    67\t\t\t\treturn { started_at: startedAt, stopped_at: stoppedAt };\n    68\t\t\t}\n    69\t\t\tconst now = new Date();\n    70\t\t\tconst end = new Date(`${date}T${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:00`);\n    71\t\t\tconst start = new Date(end.getTime() - durationMinutes * 60000);\n    72\t\t\treturn {\n    73\t\t\t\tstarted_at: start.toISOString(),\n    74\t\t\t\tstopped_at: end.toISOString()\n    75\t\t\t};\n    76\t\t}\n    77\t\n    78\t\tasync function onSave(): Promise<void> {\n    79\t\t\tif (!projectId || durationMinutes <= 0) return;\n    80\t\n    81\t\t\tloadingIndicator.start();\n    82\t\n    83\t\t\tconst timestamps = buildTimestamps();\n    84\t\t\tconst request: CreateTimeTrackingEntryRequest = {\n    85\t\t\t\tdescription: description || null,\n    86\t\t\t\tstarted_at: timestamps.started_at,\n    87\t\t\t\tstopped_at: timestamps.stopped_at,\n    88\t\t\t\tduration_minutes: durationMinutes,\n    89\t\t\t\thas_exact_times: hasExactTimes,\n    90\t\t\t\tproject_id: projectId\n    91\t\t\t};\n    92\t\n    93\t\t\tconst res = await tt.createEntry(request);\n    94\t\t\tif (res) onClose();\n    95\t\n    96\t\t\tloadingIndicator.stop();\n    97\t\t}\n    98\t</script>\n    99\t\n   100\t<ContentModal title={ts.get.timeTracking.manual_entry} rounded=\"2xl\" p=\"8\" {onClose}>\n   101\t\t<div class=\"flex flex-col gap-3\">\n   102\t\t\t<div class=\"flex flex-col gap-1\">\n   103\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n   104\t\t\t\t\t{ts.get.timeTracking.project}\n   105\t\t\t\t</span>\n   106\t\t\t\t<Select bind:value={projectId} options={projectOptions} />\n   107\t\t\t</div>\n   108\t\t\t<div class=\"flex flex-col gap-1\">\n   109\t\t\t\t<span class=\"text-sm font-medium text-c-neutral-5 dark:text-c-neutral-4\">\n   110\t\t\t\t\t{ts.get.timeTracking.description}\n   111\t\t\t\t</span>\n   112\t\t\t\t<TextInput bind:value={description} placeholder={ts.get.timeTracking.description} />\n   113\t\t\t</div>\n   114\t